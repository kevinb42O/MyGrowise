# MyGrowise runtime configuration
PUBLIC_SITE_URL=http://localhost:4321

# Supabase — public values are safe in the browser; server/database values are not.
# Copy this file to .env and fill the keys from Supabase Dashboard → Settings → API.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Optional: required only to run `npm run supabase:types` against the Management API.
# Create a personal access token in Supabase Account → Access Tokens; never deploy it.
SUPABASE_ACCESS_TOKEN=
# Set to `supabase` only after creating and verifying the first Superadmin account.
# Existing practitioner/customer flows remain on their dedicated migration paths.
ADMIN_AUTH_MODE=local
# For local migrations/admin scripts only. Never expose this to the browser or deploy it
# as a client-side variable. URL-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Checkout remains disabled until the payment decision is approved and tested.
# Do not add real credentials to this file.
# WISE_PAYMENT_URL=
# PAYMENT_PROVIDER_API_KEY=

# Local admin authentication. Generate a unique scrypt salt/hash and a random
# session secret per environment. Never commit actual values.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_SALT=replace-with-random-hex
ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# One individual salt/hash pair per local practitioner account.
MARGOT_PASSWORD_SALT=replace-with-random-hex
MARGOT_PASSWORD_HASH=replace-with-scrypt-hash
AMY_PASSWORD_SALT=replace-with-random-hex
AMY_PASSWORD_HASH=replace-with-scrypt-hash
