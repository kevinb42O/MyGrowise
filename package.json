{
  "name": "mygrowise",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "security:audit": "npm audit --omit=dev",
    "audit:public": "node scripts/audit-public-site.mjs",
    "supabase:link": "supabase link --project-ref bwkqkehumzpfodmcesab",
    "supabase:push": "dotenv -e .env -- sh -c 'supabase db push --db-url \"$SUPABASE_DB_URL\" \"$@\"' --",
    "supabase:push:dry-run": "dotenv -e .env -- sh -c 'supabase db push --dry-run --db-url \"$SUPABASE_DB_URL\"'",
    "supabase:pull": "dotenv -e .env -- sh -c 'supabase db pull --db-url \"$SUPABASE_DB_URL\"'",
    "supabase:types": "dotenv -e .env -- sh -c 'generated_types=$(mktemp); if supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" > \"$generated_types\"; then mv \"$generated_types\" src/lib/supabase/database.types.ts; else rm -f \"$generated_types\"; exit 1; fi'",
    "supabase:migrate-catalog": "dotenv -e .env -- node scripts/migrate-local-catalog-to-supabase.mjs",
    "supabase:migrate-practice": "dotenv -e .env -- node scripts/migrate-local-practice-to-supabase.mjs",
    "supabase:migrate-identities": "dotenv -e .env -- node scripts/migrate-local-identities-to-supabase.mjs",
    "test:catalog": "node --experimental-strip-types --test tests/catalog-pricing.test.ts tests/questionnaire-landings.test.ts",
    "test:catalog:db": "dotenv -e .env -- node tests/catalog-database.mjs",
    "test:appointments:db": "dotenv -e .env -- node tests/appointments-database.mjs",
    "test:appointments": "node --experimental-strip-types --test tests/appointments.test.ts",
    "test:questionnaires:db": "dotenv -e .env -- node tests/questionnaire-landings-database.mjs",
    "test:modules": "node --experimental-strip-types --test tests/modules.test.ts",
    "test:modules:db": "dotenv -e .env -- node tests/modules-database.mjs",
    "test:modules:http": "dotenv -e .env -- node tests/modules-http.mjs",
    "test:commerce:db": "node tests/commerce-database.mjs",
    "test:commerce:http": "dotenv -e .env -- node tests/commerce-http.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:profiles:db": "node tests/profiles-database.mjs",
    "check:artifact": "node scripts/check-release-artifact.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/vercel": "^11.0.10",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/luxon3": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/functions": "3.9.8",
    "astro": "^7.2.4",
    "framer-motion": "^13.3.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "dotenv-cli": "^11.0.0",
    "pg": "^8.23.1",
    "supabase": "^2.117.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "zod": "4.6.7"
  }
}
