---
import AppIcons from '../components/astro/AppIcons.astro';
import '../styles/global.css';
import '../styles/purchases.css';
interface Props { title: string; access?: boolean }
const { title, access = false } = Astro.props;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#fbf8f2" />
    <AppIcons />
    <title>{title} — MyGrowise</title>
  </head>
  <body class="purchase-page">
    <a class="skip-link" href="#inhoud">Ga naar de inhoud</a>
    <header class="purchase-header">
      <a class="purchase-brand" href="/" aria-label="MyGrowise, naar de startpagina"><img src="/images/logo-lelie.webp" alt="" width="382" height="289" /><span><em>My</em>Growise</span></a>
      <nav aria-label="Aankoopnavigatie">
        {!access && <a href="/aankopen" aria-current={Astro.url.pathname === '/aankopen' ? 'page' : undefined}>Mijn aankopen</a>}
        <a href="/contact">Hulp nodig?</a>
        <a class="purchase-site-link" href="/">Naar de website <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
      </nav>
    </header>
    <main id="inhoud" class:list={['purchase-main', { 'purchase-main--access': access }]}><slot /></main>
    <footer class="purchase-footer"><span>© {new Date().getFullYear()} MyGrowise</span><div><a href="/privacy">Privacy</a><a href="/voorwaarden">Voorwaarden</a><a href="/contact">Contact</a></div></footer>
  </body>
</html>
