---
import AdminLoadingMotion from '../components/admin/AdminLoadingMotion.astro';
import AgendaNavigation from '../components/admin/AgendaNavigation.astro';
import AdminNavigation from '../components/admin/AdminNavigation.astro';
import ClientSearch from '../components/admin/ClientSearch';
import AppIcons from '../components/astro/AppIcons.astro';
import FormProtection from '../components/practice/FormProtection.astro';
import AdminIcon from '../components/admin/AdminIcon.astro';
import AttentionStatus from '../components/admin/AttentionStatus.astro';
import NotificationBell from '../components/admin/NotificationBell.astro';
import '../styles/admin.css';
import '../styles/practice-management.css';
import '../styles/practice-improvements.css';
import '../styles/agenda-workspace.css';
import { hasPermission } from '../lib/adminAuth';
import { requiredAdminPermission } from '../lib/adminPermissions';
import { userPortrait } from '../lib/headshotPresentation';

interface Props {
  title: string;
  description?: string;
  agendaWorkspace?: boolean;
}

const { title, agendaWorkspace = false, description = 'Beheer MyGrowise' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const adminUser = Astro.locals.adminUser;
const portrait = userPortrait(adminUser);
const userInitials = (adminUser?.name || 'MyGrowise').split(/\s+/).filter(Boolean).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
if (currentPath.startsWith('/admin')) {
  Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
  Astro.response.headers.set('Referrer-Policy', 'no-referrer');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
}
const roleLabel: Record<string, string> = { super_admin: 'Eigenaar', admin: 'Beheerder', content_editor: 'Contentredacteur', clinical_reviewer: 'Klinisch reviewer', support: 'Support', analyst: 'Analist', practitioner: 'Professional', employee: 'Medewerker' };

const navGroups = [
  {
    label: 'Overzicht',
    items: [
      { label: 'Dashboard', href: '/admin', icon: 'overview', exact: true },
      { label: 'Mailopvolging', href: '/admin/mail', icon: 'messages' },
      { label: 'Analytics', href: '/admin/analytics', icon: 'analytics' },
    ],
  },
  {
    label: 'Verkoop',
    items: [
      { label: 'Bestellingen', href: '/admin/bestellingen', icon: 'orders' },
      { label: 'Klanten', href: '/admin/klanten', icon: 'customers' },
      { label: 'Afnames & rapporten', href: '/admin/afnames', icon: 'content' },
    ],
  },
  {
    label: 'Begeleiding',
    items: [
      { label: 'Agenda', href: '/admin/agenda', icon: 'calendar' },
      { label: 'Boekingen', href: '/admin/boekingen', icon: 'calendar' },
      { label: 'Cliëntendossiers', href: '/admin/clienten', icon: 'customers' },
      { label: 'Therapeuten', href: '/admin/therapeuten', icon: 'professionals' },
      { label: 'Afspraaktypes', href: '/admin/afspraaktypes', icon: 'calendar' },
      { label: 'Boekingslinks', href: '/admin/boekingslinks', icon: 'external' },
    ],
  },
  {
    label: 'Aanbod & content',
    items: [
      { label: 'Vragenlijsten & profielen', href: '/admin/vragenlijsten', icon: 'profiles' },
      { label: 'Productoverzicht', href: '/admin/producten', icon: 'products' },
      { label: 'Modules', href: '/admin/modules', icon: 'modules' },
      { label: 'Website & blogs', href: '/admin/content', icon: 'content' },
    ],
  },
  {
    label: 'Organisatie',
    items: [
      { label: 'Berichten', href: '/admin/berichten', icon: 'messages' },
      { label: 'Privacy & retentie', href: '/admin/privacy', icon: 'lock' },
      { label: 'Mijn account', href: '/admin/account', icon: 'professionals' },
      { label: 'Instellingen', href: '/admin/instellingen', icon: 'settings' },
    ],
  },
];

const attentionKeys: Record<string, string> = {
  '/admin': '*', '/admin/mail': 'mail', '/admin/bestellingen': 'payments disputes',
  '/admin/boekingen': 'bookings', '/admin/agenda': 'bookings', '/admin/berichten': 'messages support supportNotifications',
  '/admin/afnames': 'assessmentsPending assessmentsReceived', '/admin/producten': 'products', '/admin/content': 'content', '/admin/privacy': 'privacy',
  '/admin/instellingen': 'tasks costs integrations',
};
const isActive = (item: { href: string; exact?: boolean }) =>
  item.exact ? currentPath === item.href : currentPath.startsWith(item.href);
const canOpen = (href: string) => {
  const permission = requiredAdminPermission(href);
  return Boolean(permission && hasPermission(adminUser, permission));
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#173d35" />
    <AppIcons />
    <AdminNavigation agenda={agendaWorkspace} />
    <meta name="description" content={description} />
    <title>{title} · MyGrowise Admin</title>
  </head>
  <body class:list={["admin-body", "navigation-shell", { "agenda-workspace": agendaWorkspace }]} data-navigation-scope="admin">
    <a class="admin-skip-link" href="#admin-main">Naar de hoofdinhoud</a>
    <div class="admin-shell">
      <div class="admin-sidebar-scrim" data-sidebar-close></div>
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Beheernavigatie">
        <div class="admin-brand">
          <a href="/admin" aria-label="MyGrowise dashboard">
            <img class="admin-brand__mark" src="/images/logo-lelie.webp" alt="" width="382" height="289" />
            <span><strong>MyGrowise</strong><small>Beheeromgeving</small></span>
          </a>
          <button class="admin-icon-button admin-sidebar__close" type="button" aria-label="Menu sluiten" data-sidebar-close>
            <AdminIcon name="close" />
          </button>
        </div>

        <nav class="admin-nav">
          {navGroups.filter((group) => group.items.some((item) => canOpen(item.href))).map((group) => (
            <section class="admin-nav__group" aria-labelledby={`nav-${group.label.toLowerCase().replaceAll(' ', '-')}`}>
              <h2 id={`nav-${group.label.toLowerCase().replaceAll(' ', '-')}`}>{group.label}</h2>
              <ul>
                {group.items.filter((item) => canOpen(item.href)).map((item) => (
                  <li>
                    <a href={item.href} aria-label={item.label} title={item.label} class:list={{ 'is-active': isActive(item) }} aria-current={isActive(item) ? 'page' : undefined}>
                      <AdminIcon name={item.icon} />
                      <span>{item.label}</span>
                      <span class="admin-attention-dot" data-attention-keys={attentionKeys[item.href] || ""} role="img" aria-label="Aandacht nodig" hidden></span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </nav>

        {agendaWorkspace && <AgendaNavigation practice={false} user={adminUser} />}
        <div class="admin-sidebar__footer">
          {adminUser?.roles.includes('practitioner') && <a class="practice-switch" href="/praktijk" aria-label="Naar mijn praktijk" title="Naar mijn praktijk"><AdminIcon name="calendar" /> Naar mijn praktijk</a>}
          <a href="/" aria-label="Website bekijken" title="Website bekijken" target="_blank" rel="noreferrer">
            <AdminIcon name="external" />
            Website bekijken
          </a>
          <div class="admin-user">
            <span class="admin-user__avatar" role="img" aria-label={`Profielfoto van ${adminUser?.name || 'MyGrowise'}`}>
              {portrait ? <img class:list={{ 'user-headshot--original': portrait.original }} src={portrait.src} alt="" width="30" height="30" /> : userInitials}
            </span>
            <span><strong>{adminUser?.name || 'MyGrowise'}</strong><small>{adminUser ? roleLabel[adminUser.roles.find((role) => roleLabel[role]) || ''] || 'Medewerker' : 'Beheerder'}</small></span>
            <form action="/api/admin/logout" method="post">
              <button type="submit" aria-label="Afmelden" title="Afmelden"><AdminIcon name="logout" size={16} /></button>
            </form>
          </div>
        </div>
      </aside>

      <div class="admin-workspace">
        {!agendaWorkspace && <header class="admin-topbar">
          <div class="admin-topbar__left">
            <button class="admin-icon-button admin-menu-button" type="button" aria-label="Menu openen" aria-controls="admin-sidebar" aria-expanded="false" data-sidebar-open>
              <AdminIcon name="menu" /><span class="admin-attention-dot" data-attention-keys="*" role="img" aria-label="Aandacht nodig" hidden></span>
            </button>
            <span class="admin-topbar__crumb">MyGrowise</span>
            <span aria-hidden="true">/</span>
            <strong>{title}</strong>
          </div>
          <div class="admin-topbar__right">{hasPermission(adminUser, 'client_records.read') && <ClientSearch practice={false} client:only="react" />}
            {adminUser && <NotificationBell userId={adminUser.sub} basePath="/admin/berichten" />}
          </div>
        </header>}

        <main id="admin-main" class="admin-main">
          {!agendaWorkspace && <AttentionStatus surface="admin" />}
          <slot />
        </main>
      </div>
    </div>

    <FormProtection/>
    <AdminLoadingMotion />
  </body>
</html>
