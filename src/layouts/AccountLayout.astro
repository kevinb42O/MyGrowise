---
import '../styles/global.css';
import '../styles/account.css';
import AccountNavIcon from '../components/account/AccountNavIcon.astro';
import { countUnreadCustomerBookingNotifications } from '../lib/supabase/accounts';
import { countUnreadCustomerSupport } from '../lib/supportInbox';

interface Props { title: string }
const { title } = Astro.props;
const user = Astro.locals.currentUser!;
const currentPath = Astro.url.pathname;
const [unreadNotifications, unreadSupport] = await Promise.all([countUnreadCustomerBookingNotifications(user.sub), countUnreadCustomerSupport(user.sub)]);
const nav = [
  { href: '/account', label: 'Vandaag', icon: 'home' as const, exact: true },
  { href: '/account/bibliotheek', label: 'Mijn bibliotheek', icon: 'library' as const },
  { href: '/account/begeleiding', label: 'Mijn begeleiding', icon: 'care' as const },
  { href: '/account/notificaties', label: 'Notificaties', icon: 'notifications' as const },
  { href: '/account/ondersteuning', label: 'Berichten', icon: 'messages' as const },
  { href: '/account/transacties', label: 'Transacties', icon: 'receipt' as const },
  { href: '/account/instellingen', label: 'Account', icon: 'settings' as const },
];
const active = (item: { href: string; exact?: boolean }) => item.exact ? currentPath === item.href : currentPath.startsWith(item.href);
const initials = user.name.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase();
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" /><meta name="theme-color" content="#173d35" />
    <link rel="icon" type="image/png" href="/images/logo-lelie.png" /><title>{title} · Mijn MyGrowise</title>
  </head>
  <body class="account-body">
    <a class="skip-link" href="#account-main">Ga naar de inhoud</a>
    <header class="account-header"><div class="account-header__inner"><a href="/account" class="account-brand"><img src="/images/logo-lelie.webp" alt="" width="382" height="289" /><span>MyGrowise</span></a><span class="account-header__context"><i></i>Mijn ruimte</span><div class="account-header__right"><span class="account-header__avatar" aria-label={`Aangemeld als ${user.name}`}>{initials}</span><form action="/api/account/logout" method="post"><button type="submit">Afmelden</button></form></div></div></header>
    <div class="account-shell">
      <aside class="account-sidebar"><div class="account-person"><span>{initials}</span><div><strong>{user.name}</strong><small>Mijn MyGrowise</small></div></div><nav aria-label="Mijn MyGrowise"><ul>{nav.map((item) => <li><a href={item.href} class:list={{ 'is-active': active(item) }} aria-current={active(item) ? 'page' : undefined}><AccountNavIcon name={item.icon}/>{item.label}{item.icon === 'notifications' && <span class="account-nav-badge" data-account-notification-badge aria-label={`${unreadNotifications} ongelezen ${unreadNotifications === 1 ? 'melding' : 'meldingen'}`} hidden={unreadNotifications === 0}>{unreadNotifications > 99 ? '99+' : unreadNotifications}</span>}{item.icon === 'messages' && <span class="account-nav-badge" data-account-support-badge aria-label={`${unreadSupport} ongelezen ${unreadSupport === 1 ? 'gesprek' : 'gesprekken'}`} hidden={unreadSupport === 0}>{unreadSupport > 99 ? '99+' : unreadSupport}</span>}</a></li>)}</ul></nav><a href="/" class="account-back">← Naar MyGrowise</a></aside>
      <main id="account-main" class="account-main"><slot /></main>
    </div>
    <script>
      const supportBadge = document.querySelector<HTMLSpanElement>('[data-account-support-badge]');
      if (supportBadge) {
        const refreshSupport = async () => {
          if (document.visibilityState !== 'visible') return;
          try {
            const response = await fetch('/api/account/support/ongelezen', { credentials: 'same-origin', cache: 'no-store' });
            if (!response.ok) return;
            const result = await response.json() as { unread?: unknown };
            if (typeof result.unread !== 'number' || !Number.isFinite(result.unread)) return;
            const count = Math.max(0, Math.floor(result.unread));
            supportBadge.textContent = count > 99 ? '99+' : String(count);
            supportBadge.hidden = count === 0;
            supportBadge.setAttribute('aria-label', `${count} ongelezen ${count === 1 ? 'gesprek' : 'gesprekken'}`);
          } catch { /* Keep server-rendered count. */ }
        };
        const supportTimer = window.setInterval(refreshSupport, 60_000);
        document.addEventListener('visibilitychange', refreshSupport);
        window.addEventListener('pagehide', () => { window.clearInterval(supportTimer); document.removeEventListener('visibilitychange', refreshSupport); }, { once: true });
      }
      const badge = document.querySelector<HTMLSpanElement>('[data-account-notification-badge]');
      if (badge) {
        const refreshUnreadCount = async () => {
          if (document.visibilityState !== 'visible') return;
          try {
            const response = await fetch('/api/account/notificaties/ongelezen', { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' } });
            if (!response.ok) return;
            const result = await response.json() as { unread?: unknown };
            if (typeof result.unread !== 'number' || !Number.isFinite(result.unread)) return;
            const count = Math.max(0, Math.floor(result.unread));
            badge.textContent = count > 99 ? '99+' : String(count);
            badge.hidden = count === 0;
            badge.setAttribute('aria-label', `${count} ongelezen ${count === 1 ? 'melding' : 'meldingen'}`);
          } catch {
            // Keep the server-rendered count visible if a background refresh fails.
          }
        };
        const timer = window.setInterval(refreshUnreadCount, 60_000);
        document.addEventListener('visibilitychange', refreshUnreadCount);
        window.addEventListener('pagehide', () => {
          window.clearInterval(timer);
          document.removeEventListener('visibilitychange', refreshUnreadCount);
        }, { once: true });
      }
    </script>
  </body>
</html>
