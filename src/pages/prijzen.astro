---
import {publicCatalog,getPricing} from '../lib/catalog/server';
import {money} from '../lib/catalog/pricing';
import MainLayout from '../layouts/MainLayout.astro';
import { formatPublicPrice, listPublishedProfiles, profileUrl } from '../lib/publicProducts';
const [profiles,catalog,settings] = await Promise.all([listPublishedProfiles(),publicCatalog(),getPricing()]);
const moduleProducts=catalog.filter(p=>p.type==='module'&&p.availability!=='paused'&&p.priceCents!==null);
const modulePrices=moduleProducts.map(p=>p.priceCents!);
const moduleAvailable=moduleProducts.some(p=>p.availability==='available');
const questionPrices=catalog.filter(p=>p.type==='questionnaire'&&p.availability==='available'&&p.priceCents!==null).map(p=>p.priceCents!);
---
<MainLayout title="Prijzen — MyGrowise" description="Een transparant overzicht van het beschikbare MyGrowise-aanbod.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Transparante prijzen</span><h1 class="heading-xl">Weten wat een stap kost, vóór je ze zet.</h1><p class="lead">Je ziet per aanbod de prijs en beschikbaarheid. Bij modules in ontwikkeling vermelden we een geplande prijs. Een productbestelling is nog geen betaalbevestiging. Een geslaagde afspraakboeking wordt direct bevestigd.</p></div></section>
  <section class="section"><div class="container pricing">
    {profiles.map((product) => <article><span>Persoonlijk profiel</span><h2>{product.title}</h2><p>{product.summary}</p><div><strong>{formatPublicPrice(product)}</strong><a class="button button-primary" href={profileUrl(product.slug)}>Bekijk profiel</a></div></article>)}
    {questionPrices.length>0&&<article class="muted"><span>Los of gecombineerd</span><h2>Vragenlijsten op jouw maat</h2><p>Kies een vragenlijst of combineer met modules. Vanaf {settings.mediumMin} verschillende producten {settings.mediumPercent}% korting, vanaf {settings.largeMin} {settings.largePercent}%. Vaste profielen behouden hun eigen prijs.</p><div><strong>Vanaf {money(Math.min(...questionPrices))}</strong><a class="button button-primary" href="/vragenlijsten">Ontdek vragenlijsten</a></div></article>}
    {modulePrices.length>0&&<article class="muted"><span>Online modules · {moduleAvailable?'Beschikbaar aanbod':'In ontwikkeling'}</span><h2>Ontdek jouw innerlijke landschap</h2><p>Zelfstandig te volgen modules met een PDF, oefeningen en audio. Bekijk bij elke module de actuele beschikbaarheid.</p><div><strong>{!moduleAvailable&&<small style="display:block;font:400 .75rem 'DM Sans',sans-serif">Geplande prijs</small>}Vanaf {money(Math.min(...modulePrices))}</strong><a class="button button-primary" href="/modules">Ontdek de modules</a></div></article>}
    <article class="guide"><span>Persoonlijke begeleiding</span><h2>Online therapiesessie</h2><p>Begeleiding via een beveiligde online verbinding, afgestemd op jouw hulpvraag en tempo. Een sessie duurt gemiddeld 50 minuten.</p><div><strong>€80</strong><a class="button button-light" href="/begeleiding">Kies een professional</a></div></article>
  </div></section>
</MainLayout>
<style>.pricing{display:grid;gap:1rem}.pricing article{display:flex;min-height:28rem;flex-direction:column;padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--pink-soft)}.pricing article.muted{background:var(--cream)}.pricing article.guide{background:var(--ink);color:white}.pricing article>span{color:var(--pink);font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.pricing h2{margin:3rem 0 1rem;font-size:2.5rem}.pricing p{color:var(--muted);font-size:.88rem;line-height:1.65}.pricing .guide p{color:rgba(255,255,255,.65)}.pricing article>div{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem;margin-top:auto;padding-top:2rem}.pricing strong{font-family:'DM Serif Display',Georgia,serif;font-size:2.4rem;font-weight:400}.pricing .guide .button{border-color:white;background:white;color:var(--ink)}@media(min-width:900px){.pricing{grid-template-columns:repeat(3,1fr)}}</style>
