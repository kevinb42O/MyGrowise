---
import {publicCatalog,getPricing} from '../lib/catalog/server';
import {money} from '../lib/catalog/pricing';
import MainLayout from '../layouts/MainLayout.astro';
import { formatPublicPrice, listPublishedProfiles, profileUrl } from '../lib/publicProducts';
const [profiles,catalog,settings] = await Promise.all([listPublishedProfiles(),publicCatalog(),getPricing()]);
const moduleProducts=catalog.filter(p=>p.type==='module'&&p.availability!=='paused'&&p.priceCents!==null);
const modulePrices=moduleProducts.map(p=>p.priceCents!);
const moduleAvailable=moduleProducts.some(p=>p.availability==='available');
const questionPrices=catalog.filter(p=>p.type==='questionnaire'&&p.availability==='available'&&p.priceCents!==null).map(p=>p.priceCents!);
---
<MainLayout title="Prijzen — MyGrowise" description="Een transparant overzicht van het beschikbare MyGrowise-aanbod.">
  <section class="price-intro" data-no-motion><div class="container" data-no-motion><h1>Weten wat een stap kost, <br /><em>vóór je ze zet.</em></h1><p>Vergelijk het aanbod en kies wat bij jouw vraag past. Je ziet steeds de prijs en actuele beschikbaarheid op de productpagina.</p><nav aria-label="Prijscategorieën"><a href="#profielen">Persoonlijke profielen</a><a href="#zelfstandig">Vragenlijsten en modules</a><a href="#begeleiding">Begeleiding</a></nav></div></section>
  <section class="price-section" id="profielen" data-no-motion><div class="container price-layout" data-no-motion><header><h2>Persoonlijke profielen</h2><p>Een vaste pakketprijs voor een samenhangend profiel. Bekijk per profiel wat je ontvangt en voor wie het bedoeld is.</p></header><div class="price-profiles">{profiles.map(product=><article class="price-row"><div><h3><a href={profileUrl(product.slug)}>{product.title}</a></h3><p>{product.summary}</p></div><div class="price-row-action"><strong>{formatPublicPrice(product)}</strong><a href={profileUrl(product.slug)} aria-label={`Bekijk ${product.title}`}>Bekijk profiel <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></div></article>)}</div></div></section>
  <section class="price-section price-section--soft" id="zelfstandig" data-no-motion><div class="container price-layout" data-no-motion><header><h2>Zelf kiezen.<br />Slim combineren.</h2><p>Beschikbare modules en losse vragenlijsten tellen samen voor de combinatiekorting: {settings.mediumPercent}% vanaf {settings.mediumMin} verschillende producten, {settings.largePercent}% vanaf {settings.largeMin}. Vaste profielen behouden hun eigen prijs.</p><a class="price-link" href="/samenstellen">Stel je combinatie samen <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></header><div class="price-profiles">
    {questionPrices.length>0&&<article class="price-row"><div><h3>Losse vragenlijsten</h3><p>Kies een vragenlijst op basis van je vraag, of combineer met ander beschikbaar aanbod.</p></div><div class="price-row-action"><strong><small>Vanaf</small>{money(Math.min(...questionPrices))}</strong><a href="/vragenlijsten">Bekijk vragenlijsten <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></div></article>}
    {modulePrices.length>0&&<article class="price-row"><div><h3>Online modules</h3><p>Zelfstandig te volgen met een PDF, oefeningen en audio. {moduleAvailable?'Bekijk per module de actuele beschikbaarheid.':'De modules zijn in ontwikkeling en nog niet te bestellen.'}</p></div><div class="price-row-action"><strong><small>{moduleAvailable?'Vanaf':'Geplande prijs vanaf'}</small>{money(Math.min(...modulePrices))}</strong><a href="/modules">Bekijk modules <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></div></article>}
  </div></div></section>
  <section class="price-section" id="begeleiding" data-no-motion><div class="container price-care" data-no-motion><div><h2>Persoonlijke begeleiding</h2><p class="price-session"><strong>€ 80,00</strong><span>Online therapiesessie · gemiddeld 50 minuten</span></p><p>Kies een professional en bekijk de beschikbare afspraaktypes en duur op de profielpagina. Een geslaagde afspraakboeking wordt direct bevestigd.</p><a class="button button-primary" href="/begeleiding">Kies een professional <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></div><aside><h3>Een vraag over de prijs?</h3><p>Wil je eerst weten wat jouw begeleiding kost? Neem contact op voordat je boekt.</p><a class="price-link" href="/contact">Vraag praktische informatie <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a></aside></div></section>
</MainLayout>
<style>
.price-intro{padding:clamp(2.5rem,6vw,5rem) 0 2rem;background:var(--cream)}.price-intro h1{font-size:clamp(2.8rem,5vw,4.8rem);line-height:1.04;margin:0 0 1.5rem;text-wrap:balance}.price-intro h1 em{color:#823f49}.price-intro p{max-width:62ch;font-size:1.05rem;line-height:1.8;color:var(--muted)}.price-intro nav{display:flex;flex-wrap:wrap;gap:.25rem 2rem;margin-top:1.5rem}.price-intro nav a,.price-link,.price-row-action>a{display:inline-flex;align-items:center;gap:.65rem;min-height:44px;font-size:.875rem;font-weight:600;text-underline-offset:.25rem}.price-section{padding:clamp(3rem,6vw,5rem) 0;scroll-margin-top:6rem}.price-section--soft{background:#e8eee7}.price-layout{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:clamp(2rem,5vw,5rem)}.price-layout header h2,.price-care h2{font-size:2.8rem;line-height:1.08;margin:0 0 1rem}.price-layout header p,.price-care p{color:var(--muted);font-size:.95rem;line-height:1.8;max-width:55ch}.price-profiles{border-top:1px solid var(--line);min-width:0}.price-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--line)}.price-row h3{font-size:1.5rem;line-height:1.25;margin:0 0 .65rem;overflow-wrap:anywhere}.price-row h3 a{text-decoration:none}.price-row h3 a:hover{text-decoration:underline;text-underline-offset:.2em}.price-row p{font-size:.875rem;color:var(--muted);line-height:1.75;margin:0;max-width:46ch}.price-row-action{display:flex;flex-direction:column;align-items:end;justify-content:space-between;gap:1rem}.price-row-action strong{font-size:1.15rem;font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums}.price-row-action small{display:block;font-size:.75rem;font-weight:400;color:var(--muted);margin-bottom:.35rem}.price-row-action>a{font-size:.8rem;white-space:nowrap}.price-row-action svg,.price-link svg,.price-care .button svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;flex-shrink:0}.price-care{display:grid;grid-template-columns:1.2fr .8fr;gap:4rem}.price-care>aside{padding:2rem;background:var(--pink-soft);border-radius:12px;align-self:start}.price-care h3{font-size:1.8rem;margin:0 0 1rem}.price-session{display:grid;gap:.4rem;margin:1.5rem 0}.price-session strong{font-size:1.75rem;color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}.price-session span{font-size:.875rem}.price-care .button{border-radius:8px;box-shadow:none;gap:1rem}
@media(max-width:900px){.price-layout{grid-template-columns:1fr;gap:1.5rem}.price-layout header p{max-width:65ch}.price-care{gap:2rem}.price-layout header h2,.price-care h2{font-size:2.4rem}}
@media(max-width:600px){.price-intro h1{font-size:2.7rem}.price-intro h1 br{display:none}.price-intro p{font-size:.95rem}.price-intro nav{gap:0 1rem}.price-intro nav a{font-size:.8rem}.price-row{grid-template-columns:1fr;gap:1rem}.price-row-action{flex-direction:row;align-items:center;flex-wrap:wrap;gap:.5rem}.price-row h3{font-size:1.45rem}.price-care{grid-template-columns:1fr}.price-care>aside{padding:1.5rem}.price-layout header h2,.price-care h2{font-size:2.1rem}}
</style>
