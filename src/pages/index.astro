---
import MainLayout from '../layouts/MainLayout.astro';
import BrandVideo from '../components/astro/BrandVideo.astro';
import { products, practitioners, homeFaqs, recognitionItems } from '../content/site';
const featured = products[0];
---

<MainLayout activeNav="home" title="MyGrowise — psychologisch inzicht en online begeleiding" description="Begrijp wat er bij jou gebeurt en kies ondersteuning die past: zelfstandig met een persoonlijk profiel of samen met een professional.">
  <section class="hero" data-parallax-section>
    <div class="container hero-grid">
      <div class="hero-copy motion-hero">
        <span class="eyebrow">Psychologisch inzicht en online begeleiding</span>
        <h1>Begrijp wat er speelt.<br /><em>Vind een stap die bij je past.</em></h1>
        <p class="lead">MyGrowise helpt je patronen rond stress en emoties te begrijpen. Start op je eigen tempo met een persoonlijk profiel of ga in gesprek met een professional.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/startpunt">Vind je startpunt <span aria-hidden="true">→</span></a>
          <a class="button button-light" href="/begeleiding">Bekijk begeleiding</a>
        </div>
        <p class="hero-principle">Eerst begrijpen. Dan kiezen wat bij je past.</p>
      </div>

      <div class="hero-visual motion-hero">
        <div class="hero-image"><img src="/images/editorial/mygrowise-74.jpg" alt="Virginie werkt online vanuit haar praktijk" width="1920" height="1529" fetchpriority="high" /></div>
        <div class="hero-note"><span>Jouw vertrekpunt</span><p>Je hoeft nog niet precies te weten wat je nodig hebt.</p></div>
        <div class="hero-stamp" aria-hidden="true">rust · inzicht · richting</div>
      </div>
    </div>
  </section>

  <section class="recognition section-sm">
    <div class="container recognition-grid">
      <div data-reveal>
        <span class="eyebrow">Misschien herken je dit</span>
        <h2 class="heading-lg">Je houdt veel vol. Maar niet zonder kost.</h2>
      </div>
      <ol>
        {recognitionItems.map((item, index) => <li data-reveal style={`--reveal-delay: ${index * 90}ms`}><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="routes section" id="start">
    <div class="container">
      <div class="section-head" data-reveal>
        <div><span class="eyebrow">Twee manieren om te starten</span><h2 class="heading-lg">Niet iedereen heeft vandaag hetzelfde nodig.</h2></div>
        <p class="lead">Daarom maken we het verschil tussen zelfstandig inzicht en persoonlijke begeleiding meteen duidelijk.</p>
      </div>
      <div class="route-grid">
        <article class="route-card self-route" data-reveal>
          <div class="route-number">01</div>
          <div class="route-content">
            <span class="route-label">Zelfstandig</span>
            <h3>Ik wil eerst begrijpen wat er gebeurt.</h3>
            <p>Werk op je eigen tempo met een persoonlijk profiel, een module of verdiepende informatie.</p>
            <ul><li>Geen afspraak nodig</li><li>Rustig en discreet starten</li><li>Een concreet overzicht als resultaat</li></ul>
            <span class="route-cta">Bekijk profielen <b aria-hidden="true">→</b></span>
          </div>
          <img src="/images/editorial/mygrowise-50.jpg" alt="Zelfstandig werken met MyGrowise" loading="lazy" />
          <a class="route-card-hit" data-tilt href="/profielen" aria-label="Bekijk profielen: ik wil eerst begrijpen wat er gebeurt."></a>
        </article>
        <article class="route-card guide-route" data-reveal style="--reveal-delay: 110ms">
          <div class="route-number">02</div>
          <div class="route-content">
            <span class="route-label">Samen</span>
            <h3>Ik wil mijn verhaal met iemand bespreken.</h3>
            <p>Kies een professional die aansluit bij je hulpvraag en vraag rechtstreeks een online afspraak aan via MyGrowise.</p>
            <ul><li>Online vanuit een vertrouwde plek</li><li>Zelf je professional kiezen</li><li>Heldere praktische informatie</li></ul>
            <span class="route-cta">Ontdek begeleiding <b aria-hidden="true">→</b></span>
          </div>
          <img src="/images/editorial/mygrowise-46.jpg" alt="Psychologische begeleiding bij MyGrowise" loading="lazy" />
          <a class="route-card-hit" data-tilt href="/begeleiding" aria-label="Ontdek begeleiding: ik wil mijn verhaal met iemand bespreken."></a>
        </article>
      </div>
    </div>
  </section>

  <BrandVideo />

  <section class="featured section">
    <div class="container featured-grid">
      <div class="featured-visual" data-reveal data-parallax="0.035">
        <img src={featured.image} alt="Uitleg bij het stress- en emotieprofiel" loading="lazy" />
        <span class="visual-caption">Persoonlijk inzicht, helder vertaald</span>
      </div>
      <div class="featured-copy" data-reveal style="--reveal-delay: 120ms">
        <span class="eyebrow">Aanbevolen vertrekpunt</span>
        <h2 class="heading-lg">Het stress- en emotieprofiel</h2>
        <p class="lead">{featured.summary}</p>
        <div class="feature-list">
          {featured.features.map((feature, index) => <div><span>{index + 1}</span><p>{feature}</p></div>)}
        </div>
        <div class="price-row">
          <div><small>Prijs</small><strong>€{featured.price}</strong></div>
          <a class="button button-primary" href={`/profielen/${featured.slug}`}>Bekijk wat je ontvangt <span aria-hidden="true">→</span></a>
        </div>
        <p class="disclaimer">Een persoonlijk profiel ondersteunt inzicht en oriëntatie. Het is geen diagnose en vervangt geen individueel klinisch onderzoek.</p>
      </div>
    </div>
  </section>

  <section class="journey section" id="werkwijze">
    <div class="container journey-layout">
      <div class="journey-visual" data-reveal><img src="/images/editorial/mygrowise-13.jpg" alt="Een rustig moment in de praktijk van MyGrowise" loading="lazy" /><div class="journey-visual__note"><span>Jouw tempo</span><p>Geen vast programma. Wel een richting die kan meegroeien.</p></div></div>
      <div class="journey-content">
        <div class="journey-head" data-reveal><span class="eyebrow">Hoe MyGrowise samenhangt</span><h2 class="heading-lg">Eerst inzicht. Daarna kies jij hoe je verdergaat.</h2><p class="lead">Je hoeft niet alles tegelijk aan te pakken. Elk onderdeel kan op zichzelf helpen, maar samen vormen ze een rustige, heldere route.</p></div>
        <ol class="journey-list">
          <li data-reveal>
            <span class="journey-number">01</span><div><span class="journey-label">Start met inzicht</span><h3>Breng je patronen in kaart.</h3><p>Een persoonlijkheidsprofiel geeft zicht op stress, emoties, draagkracht en de strategieën die je inzet onder druk.</p><a class="text-link" href="/profielen">Ontdek de profielen</a></div>
          </li>
          <li data-reveal style="--reveal-delay: 90ms">
            <span class="journey-number">02</span><div><span class="journey-label">Kies je verdieping</span><h3>Werk zelfstandig of samen.</h3><p>Gebruik modules rond stress en regulatie, of verdiep wat je ontdekt in persoonlijke online begeleiding.</p><div class="journey-links"><a href="/modules">Bekijk modules</a><a href="/begeleiding">Ontdek begeleiding</a></div></div>
          </li>
          <li data-reveal style="--reveal-delay: 180ms">
            <span class="journey-number">03</span><div><span class="journey-label">Blijf verbonden</span><h3>Een rustige plek naast je proces.</h3><p>Na je profiel kan je terecht in de besloten community voor herkenning, reflecties en extra ondersteuning.</p><a class="text-link" href="/community">Meer over de community</a></div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="team section">
    <div class="container">
      <div class="section-head team-head" data-reveal>
        <div><span class="eyebrow">Persoonlijke begeleiding</span><h2 class="heading-lg">Een mens tegenover je. Niet nóg een systeem.</h2></div>
        <a class="text-link" href="/begeleiding">Bekijk alle begeleiding</a>
      </div>
      <div class="team-grid">
        {practitioners.map((person, index) => (
          <article class="person-card" data-reveal style={`--reveal-delay: ${index * 100}ms`}>
            <a class="person-image" href={`/begeleiding/${person.slug}`} aria-label={`Bekijk het profiel en de momenten van ${person.name}`}><img src={person.image} alt={person.name} loading="lazy" /><span>{String(index + 1).padStart(2, '0')}</span><i aria-hidden="true">Bekijk profiel <b>↗</b></i></a>
            <div><h3>{person.name}</h3><p class="person-role">{person.role}</p><p>{person.focus}</p><a href={`/begeleiding/${person.slug}`}>Bekijk profiel en momenten <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="founder section">
    <div class="container founder-grid">
      <div class="founder-copy" data-reveal>
        <span class="eyebrow">Ontstaan vanuit de praktijk</span>
        <blockquote>“Mensen hebben niet altijd méér informatie nodig. Ze hebben vooral nood aan inzicht dat ergens naartoe leidt.”</blockquote>
        <p class="body-copy">MyGrowise werd opgericht door Virginie vanuit haar ervaring met stress, emotionele belasting en trauma. Het platform brengt zelfstandig inzicht en professionele begeleiding samen, zodat je niet langer hoeft te zoeken tussen losse antwoorden.</p>
        <a class="text-link" href="/over-ons">Lees het verhaal van MyGrowise</a>
      </div>
      <div class="founder-image" data-reveal data-parallax="0.045" style="--reveal-delay: 120ms"><img src="/images/editorial/mygrowise-17.jpg" alt="Virginie, oprichter van Mygrowise" loading="lazy" /></div>
    </div>
  </section>

  <section class="faq section">
    <div class="container faq-grid">
      <div data-reveal><span class="eyebrow">Veelgestelde vragen</span><h2 class="heading-lg">Eerst nog even weten hoe het zit?</h2><p class="lead">Logisch. Goede hulp begint met duidelijke informatie.</p></div>
      <div class="faq-list">
        {homeFaqs.map((item, index) => (
          <details open={index === 0} data-reveal style={`--reveal-delay: ${index * 80}ms`}><summary><span>{String(index + 1).padStart(2, '0')}</span>{item.question}<i aria-hidden="true"></i></summary><p>{item.answer}</p></details>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(3.5rem, 6vw, 5rem); background: var(--cream); }
  .hero::before { position: absolute; z-index: -1; inset: 0; opacity: .36; background-image: linear-gradient(rgba(23,61,53,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(23,61,53,.045) 1px, transparent 1px); background-size: 5rem 5rem; mask-image: linear-gradient(90deg, transparent 25%, black 100%); content: ''; pointer-events: none; }
  .hero::after { position: absolute; z-index: -1; top: -12rem; right: -10rem; width: 38rem; height: 38rem; border-radius: 50%; background: radial-gradient(circle, rgba(242,111,129,.18), rgba(242,111,129,0) 70%); content: ''; pointer-events: none; }
  .hero-grid { position: relative; display: grid; gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .hero-copy h1 { max-width: 14ch; margin-bottom: 1.3rem; color: var(--ink-deep); font-size: clamp(3.2rem, 5.1vw, 5.25rem); line-height: .99; }
  .hero-copy h1 em { color: var(--pink); font-weight: 400; }
  .hero-copy .lead { max-width: 50ch; margin-bottom: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1.6rem 0 0; }
  .hero-principle { margin: 1.5rem 0 0; padding-left: .85rem; border-left: 2px solid var(--pink); color: var(--muted); font-size: .8rem; font-weight: 600; line-height: 1.5; }
  .hero-visual { position: relative; min-height: clamp(21rem, 65vw, 34rem); }
  .hero-visual::before { position: absolute; inset: -2rem -2rem 2rem 3rem; border: 1px solid rgba(23,61,53,.2); border-radius: 48% 52% 35% 65%; content: ''; transform: rotate(9deg); pointer-events: none; }
  .hero-image { position: absolute; inset: 0; overflow: hidden; border-radius: 10rem 10rem var(--radius-lg) var(--radius-lg); background: var(--pink-soft); box-shadow: var(--shadow); }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; object-position: 62% center; }
  .hero-note { position: absolute; bottom: -1.2rem; left: -1.2rem; display: grid; gap: .35rem; width: min(17rem, 72%); padding: 1rem 1.15rem; border: 1px solid rgba(23,61,53,.3); border-radius: var(--radius-sm); background: var(--yellow); box-shadow: 0 12px 28px rgba(14,43,37,.14); }
  .hero-note span { color: var(--ink-deep); font-size: .62rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .hero-note p { margin: 0; color: var(--ink-deep); font-family: 'DM Serif Display', Georgia, serif; font-size: 1rem; line-height: 1.2; }
  .hero-stamp { position: absolute; top: 1.4rem; right: -1rem; display: grid; width: 5.8rem; height: 5.8rem; place-content: center; padding: .8rem; border: 1px solid rgba(255,255,255,.55); border-radius: 50%; background: var(--pink); color: white; box-shadow: 0 8px 22px rgba(14,43,37,.14); font-size: .57rem; font-weight: 700; letter-spacing: .1em; line-height: 1.5; text-align: center; text-transform: uppercase; transform: rotate(8deg); }
  .recognition { border-block: 1px solid var(--line); background: var(--white); }
  .recognition-grid { display: grid; gap: 2.5rem; }
  .recognition ol { margin: 0; padding: 0; list-style: none; }
  .recognition li { display: grid; grid-template-columns: 2.6rem 1fr; gap: 1rem; padding: 1.2rem 0; border-top: 1px solid var(--line); }
  .recognition li:last-child { border-bottom: 1px solid var(--line); }
  .recognition li span { color: var(--pink); font-size: .72rem; font-weight: 700; }
  .recognition li p { margin: 0; color: var(--ink); font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.5; }
  .routes { background: var(--paper); }
  .section-head { display: grid; gap: 1.5rem; align-items: end; margin-bottom: 3rem; }
  .section-head h2 { margin-bottom: 0; }
  .route-grid { display: grid; gap: 1rem; }
  .route-card { position: relative; display: grid; min-height: 42rem; overflow: hidden; border-radius: var(--radius-lg); transform-style:preserve-3d; }
  .route-card::before { position:absolute; z-index:1; inset:0; opacity:0; background:radial-gradient(26rem circle at var(--pointer-x,50%) var(--pointer-y,50%),rgba(255,255,255,.2),transparent 42%); content:''; mix-blend-mode:soft-light; transition:opacity 400ms ease; pointer-events:none; }
  .route-card::after { z-index:1; content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 10%, rgba(14,43,37,.8) 84%); transition:background 500ms ease; }
  .route-card > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition:transform 800ms cubic-bezier(.16,1,.3,1),filter 700ms ease; }
  .route-number { position: absolute; z-index: 2; top: 1.4rem; right: 1.4rem; display: grid; width: 3.2rem; height: 3.2rem; place-content: center; border: 1px solid rgba(255,255,255,.7); border-radius: 50%; color: white; font-size: .75rem; }
  .route-content { position: relative; z-index: 2; align-self: end; padding: 2rem; color: white; transform:translateZ(24px); }
  .route-label { display: inline-block; margin-bottom: .8rem; color: var(--yellow); font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .route-content h3 { max-width: 13ch; margin-bottom: 1rem; font-size: clamp(2.1rem, 4vw, 3.5rem); line-height: 1; }
  .route-content > p { max-width: 46ch; color: rgba(255,255,255,.8); font-size: .9rem; line-height: 1.6; }
  .route-content ul { display: flex; flex-wrap: wrap; gap: .45rem; margin: 1.2rem 0 1.7rem; padding: 0; list-style: none; }
  .route-content li { padding: .45rem .65rem; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; background: rgba(14,43,37,.22); font-size: .68rem; }
  .route-cta { display:inline-flex; min-height:3.35rem; align-items:center; gap:.95rem; padding:.86rem 1rem 0.86rem 1.3rem; border-radius:999px; background:var(--white); color:var(--ink-deep); box-shadow:0 .8rem 1.7rem rgba(0,0,0,.16); font-size:.88rem; font-weight:700; }
  .route-cta b { display:grid; width:1.65rem; height:1.65rem; place-content:center; border-radius:50%; background:var(--ink); color:white; font-size:1rem; line-height:1; transition:transform 350ms cubic-bezier(.16,1,.3,1),background 300ms ease; }
  .route-card-hit { position:absolute; z-index:3; inset:0; border-radius:inherit; cursor:pointer; }
  .route-card-hit:focus-visible { outline:3px solid var(--yellow); outline-offset:-.55rem; }
  .featured { background: var(--pink-soft); }
  .featured-grid { display: grid; gap: 3.5rem; align-items: center; }
  .featured-visual { position: relative; min-height: 30rem; overflow: hidden; border-radius: 10rem 10rem var(--radius-md) var(--radius-md); }
  .featured-visual img { width: 100%; height: 100%; object-fit: cover; position: absolute; transform:scale(1.035); transition:transform 1.2s cubic-bezier(.16,1,.3,1); }
  .visual-caption { position: absolute; right: 1rem; bottom: 1rem; left: 1rem; padding: .85rem 1rem; border-radius: .8rem; background: rgba(255,253,249,.9); color: var(--ink); font-size: .75rem; font-weight: 700; backdrop-filter: blur(8px); }
  .feature-list { margin-block: 2rem; border-top: 1px solid var(--line); }
  .feature-list div { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); transition:padding 350ms ease,background 350ms ease; }
  .feature-list span { display: grid; width: 1.55rem; height: 1.55rem; place-content: center; border-radius: 50%; background: var(--yellow); font-size: .65rem; font-weight: 700; }
  .feature-list p { margin: 0; font-size: .9rem; font-weight: 600; }
  .price-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; }
  .price-row div { display: flex; flex-direction: column; }
  .price-row small { color: var(--muted); font-size: .7rem; text-transform: uppercase; }
  .price-row strong { font-family: 'DM Serif Display', Georgia, serif; font-size: 2.4rem; font-weight: 400; }
  .disclaimer { margin: 1.3rem 0 0; color: var(--muted); font-size: .68rem; line-height: 1.6; }
  .journey { border-block: 1px solid var(--line); background: var(--paper); }
  .journey-layout { display: block; }
  .journey-visual { display: none; }
  .journey-content { display: grid; grid-template-columns: minmax(16rem, .82fr) minmax(0, 1.18fr); gap: clamp(2.5rem, 5vw, 6rem); align-items: start; }
  .journey-head { position: sticky; top: 7rem; min-width: 0; max-width: 48rem; margin-bottom: 0; }
  .journey-head h2 { margin-bottom: 1.2rem; }
  .journey-list { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .journey-list li { display: grid; grid-template-columns: 3.4rem 1fr; gap: .9rem; padding: 1.55rem 0; border-bottom: 1px solid var(--line); }
  .journey-number { display: grid; width: 2.3rem; height: 2.3rem; place-content: center; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: .68rem; font-weight: 700; }
  .journey-label { display:block; margin: .1rem 0 .5rem; color: var(--pink); font-size: .66rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .journey-list h3 { position:relative; display:table; width:fit-content; max-width:100%; margin-bottom: .8rem; color: var(--ink-deep); font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1; }
  .journey-list h3::after { content:''; position:absolute; right:0; bottom:-.25rem; left:0; height:1.5px; background:linear-gradient(90deg,var(--pink),rgba(241,101,121,.2)); transform:scaleX(0); transform-origin:left center; transition:transform 820ms cubic-bezier(.22,1,.36,1); }
  .journey-list p { max-width: 47ch; margin-bottom: 1rem; color: var(--muted); font-size: .87rem; line-height: 1.65; }
  .journey-links { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
  .journey-links a { border-bottom: 1px solid var(--ink); color: var(--ink); font-size: .78rem; font-weight: 700; text-decoration: none; }
  .team { background: var(--ink); color: white; }
  .team .eyebrow, .team .heading-lg { color: white; }
  .team .text-link { color: var(--yellow); }
  .team-grid { display: grid; gap: 2rem; }
  .person-image { position: relative; display:block; aspect-ratio: 4 / 5; overflow: hidden; margin-bottom: 1.3rem; border-radius: var(--radius-md); background: var(--cream); box-shadow:0 0 0 rgba(0,0,0,0); transition:box-shadow 450ms ease,transform 450ms cubic-bezier(.16,1,.3,1); }
  .person-image img { width: 100%; height: 100%; object-fit: cover; object-position: top; filter: saturate(.92); transition: transform 500ms ease; }
  .person-card:hover img { transform: scale(1.025); }
  .person-image span { position: absolute; right: .8rem; bottom: .8rem; display: grid; width: 2.4rem; height: 2.4rem; place-content: center; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: .68rem; font-weight: 700; transition:transform 450ms cubic-bezier(.16,1,.3,1); }
  .person-image i { position:absolute; right:1rem; bottom:1rem; left:1rem; display:flex; align-items:center; justify-content:space-between; padding:.72rem .8rem; border:1px solid rgba(255,255,255,.45); border-radius:.65rem; background:rgba(14,43,37,.72); color:white; font-size:.7rem; font-style:normal; font-weight:700; opacity:0; transform:translateY(.75rem); backdrop-filter:blur(8px); transition:opacity 350ms ease,transform 450ms cubic-bezier(.16,1,.3,1); }
  .person-image i b { display:grid; width:1.3rem; height:1.3rem; place-content:center; border-radius:50%; background:var(--yellow); color:var(--ink); font-size:.72rem; }
  .person-image:focus-visible { outline:3px solid var(--yellow); outline-offset:4px; }
  .person-card h3 { margin-bottom: .15rem; font-size: 2rem; }
  .person-card p { color: rgba(255,255,255,.65); font-size: .83rem; line-height: 1.55; }
  .person-card .person-role { margin-bottom: .7rem; color: var(--pink); font-weight: 700; }
  .person-card a { display: inline-flex; gap: .45rem; color: white; font-size: .78rem; font-weight: 700; text-decoration: none; }
  .founder { background: var(--yellow-soft); }
  .founder-grid { display: grid; gap: 3rem; align-items: center; }
  .founder-copy blockquote { max-width: 15ch; margin: 0 0 2rem; color: var(--ink-deep); font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1.02; }
  .founder-copy .body-copy { max-width: 55ch; }
