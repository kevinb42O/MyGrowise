    html.motion-enabled [data-reveal] { opacity:0; transform:translate3d(var(--tilt-x,0),calc(3rem + var(--parallax-y,0px)),0) rotateX(var(--tilt-rx,0deg)) rotateY(var(--tilt-ry,0deg)); transition:opacity 800ms cubic-bezier(.16,1,.3,1) var(--reveal-delay,0ms),transform 950ms cubic-bezier(.16,1,.3,1) var(--reveal-delay,0ms); will-change:transform,opacity; }
    html.motion-enabled [data-reveal].is-visible { opacity:1; transform:translate3d(var(--tilt-x,0),var(--parallax-y,0px),0) rotateX(var(--tilt-rx,0deg)) rotateY(var(--tilt-ry,0deg)); }
