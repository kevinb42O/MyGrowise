---
import MainLayout from '../../layouts/MainLayout.astro';
import ModuleCover from '../../components/modules/ModuleCover.astro';
import ModuleRecommendations from '../../components/modules/ModuleRecommendations.astro';
import {publicModules,hasModuleAccess} from '../../lib/modules/server';
import {resolveCatalogSlug} from '../../lib/catalog/server';
import {money} from '../../lib/catalog/pricing';
import {isCustomerAccount} from '../../lib/adminAuth';
import '../../styles/modules.css';
const modules=await publicModules();const p=modules.find(p=>p.slug===Astro.params.slug);
if(!p){const alias=await resolveCatalogSlug(Astro.params.slug||'');return Astro.redirect(alias||'/modules',alias?301:302);}
const owned=isCustomerAccount(Astro.locals.currentUser)&&await hasModuleAccess(Astro.locals.currentUser!.sub,p.id);
if(Astro.locals.currentUser)Astro.response.headers.set('Cache-Control','private, no-store');
const available=p.availability==='available'&&p.priceCents!==null;
---
<MainLayout activeNav="zelf" title={`${p.title} — ${p.module.subtitle} | MyGrowise`} description={p.summary}><section class="module-hero"><div class="container"><a class="module-detail-back" href="/modules">← Alle modules</a><div class="module-hero-grid"><div><span class="eyebrow">Module {String(p.module.number).padStart(2,'0')} · {p.module.tagline}</span><h1>{p.title}</h1><h2>{p.module.subtitle}</h2><p>{p.summary}</p><div class="module-facts"><span>PDF en audio</span><span>Zelfstandig te volgen</span></div>{owned?<a href={`/account/modules/${p.slug}`} class="button button-primary">Open mijn module →</a>:available?<a href={`/bestellen?producten=${p.id}`} class="button button-primary">Kies deze module →</a>:<p class="module-status">{p.availability==='paused'?'Tijdelijk niet bestelbaar':'In ontwikkeling · nog niet bestelbaar'}</p>}</div><ModuleCover image={p.image} alt={p.module.image_alt} hero number={p.module.number} slug={p.slug}/></div></div></section><section class="module-section"><div class="container module-two"><div class="module-copy"><h2>Verken dit deel van jouw landschap.</h2>{p.module.introduction.map(text=><p>{text}</p>)}<h3>Wat je verkent</h3><ul class="module-measures">{p.module.topics.map(t=><li>{t}</li>)}</ul><h3>Het volledige werkboek</h3><p>Een PDF met uitleg en oefeningen, met bijbehorende audio. Na bevestiging van je betaling open je het werkboek en de audio via een beveiligde e-maillink. Een account is optioneel.</p><h3>Jouw tempo</h3><p>Deze module is zelfstandig te volgen. De zes modules hebben een logische opbouw, maar je hoeft geen eerdere module te kopen of af te ronden.</p>{p.module.audience_text&&<><h3>Voor wie?</h3><p>{p.module.audience_text}</p></>}{p.module.access_text&&<><h3>Toegang</h3><p>{p.module.access_text}</p></>}{p.module.support_text&&<><h3>Ondersteuning</h3><p>{p.module.support_text}</p></>}</div><aside class="module-purchase"><span class="module-label">{available?'Eenmalige prijs':'Geplande prijs'}</span><strong>{p.priceCents!==null?money(p.priceCents):'Binnenkort'}</strong><p>PDF met uitleg en oefeningen, met bijbehorende audio.</p>{owned?<a class="button button-primary" href={`/account/modules/${p.slug}`}>Open mijn module →</a>:available?<><a class="button button-primary" href={`/bestellen?producten=${p.id}`}>Kies deze module →</a><a href={`/samenstellen?voegtoe=${p.id}&type=modules`}>Voeg toe aan mijn combinatie →</a></>:<p class="module-status">{p.availability==='paused'?'Tijdelijk niet bestelbaar':'In ontwikkeling'}</p>}<a href="/contact">Hulp bij je keuze →</a></aside></div></section><ModuleRecommendations productId={p.id}/></MainLayout>
