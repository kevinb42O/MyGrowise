---
import MainLayout from '../../layouts/MainLayout.astro';
import { getGuestConversationId, getGuestThread, SUPPORT_GUEST_COOKIE } from '../../lib/supportGuest';
import { isCustomerAccount } from '../../lib/adminAuth';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
const id = await getGuestConversationId(Astro.cookies.get(SUPPORT_GUEST_COOKIE)?.value);
const thread = id ? await getGuestThread(id) : null;
const customer = isCustomerAccount(Astro.locals.currentUser) ? Astro.locals.currentUser : null;
const canClaim = Boolean(thread && customer?.emailConfirmed && customer.email.toLowerCase() === thread.email.toLowerCase());
const error = Astro.url.searchParams.get('error');
const date = (value: string) => new Intl.DateTimeFormat('nl-BE',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/Brussels'}).format(new Date(value));
---
<MainLayout title="Je gesprek — MyGrowise" noindex={true}><section class="section"><div class="container guest-wrap"><span class="eyebrow">MyGrowise berichten</span>{thread ? <><div class="guest-head"><div><h1>Je gesprek</h1><p>Referentie {thread.reference} · {thread.email}</p></div><form action="/api/berichten/afmelden" method="post"><button type="submit" class="guest-link">Sluit veilige toegang</button></form></div>{canClaim && <form class="guest-claim" action="/api/account/support/claim" method="post"><p>Dit e-mailadres hoort bij je klantaccount. Voeg dit gesprek toe aan je berichtenoverzicht.</p><button class="button button-light" type="submit">Bewaar in mijn account</button></form>}{!customer && <p class="guest-claim">Heb je al een klantaccount met dit adres? <a href="/account/inloggen?next=%2Fberichten%2Fgesprek">Log in</a> om dit gesprek aan je account toe te voegen.</p>}{Astro.url.searchParams.get('sent') === '1' && <p class="guest-alert" role="status">Je antwoord is verstuurd.</p>}{error && <p class="guest-alert" role="alert">Het versturen lukte niet. Controleer je bericht en probeer opnieuw.</p>}<div class="guest-thread">{thread.messages.map((message) => <article class:list={{ 'is-own': message.own }}><small>{message.own ? 'Jij' : 'MyGrowise'} · {date(message.createdAt)}</small>{message.body.split(/\n{2,}/).map((paragraph) => <p>{paragraph}</p>)}</article>)}</div><form class="guest-reply" action="/api/berichten/antwoord" method="post"><label>Je antwoord<textarea name="body" required maxlength="4000" rows="5" placeholder="Schrijf je antwoord…"></textarea></label><button class="button button-primary" type="submit">Verstuur antwoord</button></form><p class="guest-note">Gebruik dit gesprek alleen voor praktische vragen. Deel geen medische of sessie-informatie.</p></> : <><h1>Vraag een nieuwe toegangslink aan.</h1><p>Vul het e-mailadres en de referentie uit je eerdere bevestigingsmail in. Als ze overeenkomen, sturen we een nieuwe link.</p>{error === 'expired' && <p class="guest-alert" role="alert">Deze link is verlopen of al gebruikt. Vraag hieronder een nieuwe aan.</p>}{error === 'limited' && <p class="guest-alert" role="alert">Te veel pogingen. Probeer het later opnieuw.</p>}{Astro.url.searchParams.get('requested') === '1' && <p class="guest-alert" role="status">Als de gegevens overeenkomen, ontvang je binnenkort een nieuwe link.</p>}<form class="guest-reply" action="/api/berichten/link" method="post"><label>E-mailadres<input name="email" type="email" required autocomplete="email" maxlength="254"/></label><label>Referentie<input name="reference" required maxlength="10" autocomplete="off" placeholder="Bijvoorbeeld 8A1B2C3D4E"/></label><button class="button button-primary" type="submit">Stuur nieuwe link</button></form><p>Geen referentie meer? <a href="mailto:info@mygrowise.be">Mail info@mygrowise.be</a>.</p></>}</div></section></MainLayout>
<style>.guest-wrap{max-width:52rem}.guest-wrap h1{font-size:clamp(2.5rem,6vw,4rem);line-height:1}.guest-head{display:flex;flex-wrap:wrap;align-items:start;justify-content:space-between;gap:1rem}.guest-head p,.guest-wrap>p{color:var(--muted);line-height:1.6}.guest-link{padding:.5rem 0;border:0;background:none;color:var(--ink);font:inherit;font-size:.75rem;font-weight:800;text-decoration:underline;cursor:pointer}.guest-claim{margin:1.2rem 0;padding:1rem;border:1px solid var(--line);border-radius:.8rem;background:var(--white);font-size:.85rem}.guest-claim p{margin:0 0 .7rem}.guest-thread{display:grid;gap:1rem;margin:2rem 0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);border-radius:1rem;background:var(--white)}.guest-thread article{max-width:85%;padding:1rem;border-radius:.9rem .9rem .9rem .2rem;background:var(--paper)}.guest-thread article.is-own{justify-self:end;border-radius:.9rem .9rem .2rem .9rem;background:var(--pink-soft)}.guest-thread small{color:var(--muted);font-size:.68rem}.guest-thread p{margin:.5rem 0 0;line-height:1.6;white-space:pre-wrap}.guest-reply{display:grid;gap:1rem;max-width:38rem}.guest-reply label{display:grid;gap:.4rem;font-size:.75rem;font-weight:800}.guest-reply input,.guest-reply textarea{width:100%;padding:.8rem;border:1px solid var(--line);border-radius:.6rem;background:var(--white);font:inherit}.guest-reply button{justify-self:start}.guest-alert{padding:1rem;border-left:4px solid var(--pink);background:var(--pink-soft)}.guest-note{margin-top:1rem;font-size:.75rem}</style>
