---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import InternalInbox from '../../components/admin/InternalInbox.astro';
import SupportInbox from '../../components/admin/SupportInbox.astro';
import { hasPermission } from '../../lib/adminAuth';

const user = Astro.locals.currentUser!;
const canSupport = hasPermission(user, 'support.read');
const view = canSupport && Astro.url.searchParams.get('view') !== 'team' ? 'support' : 'team';
const thread = Astro.url.searchParams.get('thread') || '';
const conversation = Astro.url.searchParams.get('conversation') || '';
const compose = Astro.url.searchParams.get('compose') === '1';
const page = Math.max(1, Math.min(1000, Number.parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1));
const created = Astro.url.searchParams.get('created') === '1';
const sent = Astro.url.searchParams.get('sent') === '1';
const updated = Astro.url.searchParams.get('updated') === '1';
const error = Astro.url.searchParams.get('error') || '';
---
<PracticeLayout title="Berichten" description="Klantvragen en interne communicatie">
  <div class="admin-page">
    <section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn praktijk</p><h1>Berichten</h1><p>{canSupport ? 'Behandel algemene klantvragen en stem apart af met je collega’s.' : 'Communiceer veilig met je collega’s binnen MyGrowise.'}</p></div></section>
    {canSupport && <nav class="support-view-tabs" aria-label="Berichtenweergave"><a class:list={{ 'is-active': view === 'support' }} href="/praktijk/berichten">Klantvragen</a><a class:list={{ 'is-active': view === 'team' }} href="/praktijk/berichten?view=team">Teamcommunicatie</a></nav>}
    {(created || sent || updated) && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>{updated ? 'Gesprek bijgewerkt.' : created ? 'Gesprek gestart; ontvangers kregen een notificatie.' : 'Bericht verstuurd.'}</div>}
    {error && <div class="admin-login__alert admin-login__alert--error" role="alert"><AdminIcon name="warning" size={17}/>Controleer de invoer en probeer opnieuw.</div>}
    {view === 'support' ? <SupportInbox userId={user.sub} selectedId={conversation} page={page} basePath="/praktijk/berichten"/> : <InternalInbox userId={user.sub} surface="practice" selectedThreadId={thread} compose={compose}/>}
  </div>
</PracticeLayout>
