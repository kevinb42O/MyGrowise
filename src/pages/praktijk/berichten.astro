---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import InternalInbox from '../../components/admin/InternalInbox.astro';
const thread = Astro.url.searchParams.get('thread') || '';
const compose = Astro.url.searchParams.get('compose') === '1';
const created = Astro.url.searchParams.get('created') === '1'; const sent = Astro.url.searchParams.get('sent') === '1'; const error = Astro.url.searchParams.get('error') || '';
---
<PracticeLayout title="Berichten" description="Interne communicatie met het MyGrowise-team"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn praktijk</p><h1>Berichten</h1><p>Communiceer veilig met Virginie en andere collega’s die een MyGrowise-account hebben.</p></div></section>{(created || sent) && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>{created ? 'Gesprek gestart; ontvangers kregen een notificatie.' : 'Bericht verstuurd; ontvangers kregen een notificatie.'}</div>}{error && <div class="admin-login__alert admin-login__alert--error" role="alert"><AdminIcon name="warning" size={17}/>{error}</div>}<InternalInbox userId={Astro.locals.currentUser!.sub} surface="practice" selectedThreadId={thread} compose={compose}/></div></PracticeLayout>
