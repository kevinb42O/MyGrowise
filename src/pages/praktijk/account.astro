---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { getNotificationPreferences, getUserById, getUserLastLogin, listOwnSecurityActivity } from '../../lib/practiceDb';

const user = Astro.locals.currentUser!; const account = getUserById(user.sub)!; const preferences = getNotificationPreferences(user.sub); const activity = listOwnSecurityActivity(user.sub);
const notice = Astro.url.searchParams.get('email_saved') === '1' ? 'E-mailadres aangepast en huidige sessie beveiligd vernieuwd.' : Astro.url.searchParams.get('password_saved') === '1' ? 'Nieuw wachtwoord opgeslagen. Andere oude sessies zijn nu ongeldig.' : Astro.url.searchParams.get('preferences_saved') === '1' ? 'Meldingsvoorkeuren opgeslagen.' : '';
const error = Astro.url.searchParams.get('email_error') === '1' ? 'Je huidige wachtwoord klopt niet.' : Astro.url.searchParams.get('email_taken') === '1' ? 'Dit e-mailadres is al gekoppeld aan een account.' : Astro.url.searchParams.get('email_invalid') === '1' ? 'Vul een geldig e-mailadres in.' : Astro.url.searchParams.get('password_error') === 'current' ? 'Je huidige wachtwoord klopt niet.' : Astro.url.searchParams.get('password_error') === 'match' ? 'De nieuwe wachtwoorden komen niet overeen.' : Astro.url.searchParams.get('password_error') === 'weak' ? 'Kies een wachtwoord van minstens 12 tekens.' : '';
const actionLabels: Record<string, string> = { 'account.login': 'Aangemeld', 'account.email_updated': 'E-mailadres gewijzigd', 'account.password_updated': 'Wachtwoord gewijzigd', 'account.notifications_updated': 'Meldingsvoorkeuren aangepast', 'account.sessions_revoked': 'Alle sessies afgemeld' };
const date = (value: string | null) => value ? new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Brussels' }).format(new Date(value)) : 'Nog niet aangemeld';
---
<PracticeLayout title="Account" description="Beheer je inloggegevens, meldingen en sessiebeveiliging."><div class="admin-page admin-page--form practice-account-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn praktijk · Privé</p><h1>Account & beveiliging</h1><p>Deze instellingen zijn alleen voor jou. Ze wijzigen niets aan je publieke therapieprofiel.</p></div></section>
{notice && <div class="practice-feedback is-success"><AdminIcon name="check" size={16}/><span><strong>Gelukt.</strong> {notice}</span></div>}{error && <div class="practice-feedback is-error"><AdminIcon name="warning" size={16}/><span><strong>Niet opgeslagen.</strong> {error}</span></div>}
<div class="practice-account-layout"><div class="practice-account-forms"><section class="admin-panel"><header class="admin-panel__header"><div><h2>Inlog-e-mailadres</h2><p>Gebruik een persoonlijk werkadres waar je toegang toe hebt.</p></div><span class="admin-state">Beveiligd</span></header><form class="practice-inline-form" action="/api/praktijk/account/email" method="post"><label><span>E-mailadres</span><input type="email" name="email" required maxlength="254" autocomplete="email" value={account.email}/></label><label><span>Huidig wachtwoord</span><input type="password" name="current_password" required autocomplete="current-password"/></label><button class="admin-button" type="submit">E-mail aanpassen</button></form></section>
<section class="admin-panel"><header class="admin-panel__header"><div><h2>Wachtwoord</h2><p>Kies een uniek wachtwoord van minstens 12 tekens.</p></div></header><form class="practice-inline-form practice-password-form" action="/api/praktijk/account/password" method="post"><label><span>Huidig wachtwoord</span><input type="password" name="current_password" required autocomplete="current-password"/></label><label><span>Nieuw wachtwoord</span><input type="password" name="new_password" required minlength="12" maxlength="256" autocomplete="new-password"/></label><label><span>Herhaal nieuw wachtwoord</span><input type="password" name="confirm_password" required minlength="12" maxlength="256" autocomplete="new-password"/></label><button class="admin-button" type="submit">Wachtwoord wijzigen</button></form></section>
<section class="admin-panel"><header class="admin-panel__header"><div><h2>Meldingen</h2><p>Je mailbox is de enige plaats waar we hierover communiceren.</p></div></header><form class="practice-preferences" action="/api/praktijk/account/preferences" method="post"><label class="practice-switch-row"><input type="checkbox" name="booking_email_enabled" checked={preferences.bookingEmailEnabled}/><span><strong>Nieuwe boekingsaanvragen</strong><small>Ontvang een e-mail wanneer een cliënt een moment aanvraagt.</small></span></label><label class="practice-switch-row"><input type="checkbox" name="booking_reminder_enabled" checked={preferences.bookingReminderEnabled}/><span><strong>Herinnering voor bevestigde afspraken</strong><small>Een praktische herinnering voor je volgende afspraak.</small></span></label><label class="practice-switch-row"><input type="checkbox" name="weekly_digest_enabled" checked={preferences.weeklyDigestEnabled}/><span><strong>Wekelijks overzicht</strong><small>Een samenvatting van aanvragen en aankomende afspraken.</small></span></label><p class="practice-field-help"><AdminIcon name="lock" size={14}/> Tijdzone: {preferences.timezone}. E-mailverzending wordt bij de uiteindelijke e-mailkoppeling geactiveerd.</p><button class="admin-button" type="submit">Voorkeuren opslaan</button></form></section></div>
<aside class="practice-account-side"><section class="practice-security-card"><div><span class="practice-preview-label">Accountstatus</span><h2>{account.name}</h2><p>{account.email}</p></div><dl><div><dt>Rol</dt><dd>{account.roles.includes('super_admin') ? 'Superadmin & professional' : 'Professional'}</dd></div><div><dt>Laatste aanmelding</dt><dd>{date(getUserLastLogin(user.sub))}</dd></div><div><dt>Sessie</dt><dd>Verloopt na 8 uur inactiviteit</dd></div></dl><form action="/api/praktijk/account/sessions" method="post"><button class="admin-button admin-button--danger" type="submit">Meld alle apparaten af</button><small>Je wordt ook op dit apparaat opnieuw uitgelogd.</small></form></section><section class="practice-activity-card"><header><h2>Recente accountactiviteit</h2><span>Privé</span></header>{activity.length ? <ol>{activity.map((item) => <li><AdminIcon name={item.action === 'account.login' ? 'lock' : 'settings'} size={14}/><span><strong>{actionLabels[item.action] || 'Account gewijzigd'}</strong><small>{date(item.occurredAt)}</small></span></li>)}</ol> : <p>Nog geen accountactiviteit.</p>}</section></aside></div></div></PracticeLayout>
