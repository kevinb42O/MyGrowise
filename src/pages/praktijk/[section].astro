---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
const content:Record<string,{title:string;description:string;items:string[]}>={profiel:{title:'Mijn profiel',description:'Bekijk welke professionele informatie publiek verschijnt en bereid wijzigingen voor.',items:['Naam, foto en professionele rol','Expertise en begeleidingsfocus','Publieke beschikbaarheidsstatus','Wijzigingen worden door Virginie gepubliceerd']},account:{title:'Account',description:'Beheer de beveiliging en meldingsvoorkeuren van je praktijkaccount.',items:['Persoonlijk e-mailadres','Wachtwoord en actieve sessies','Boekingsmeldingen per e-mail','Account kan door superadmin worden geblokkeerd']}};
const data=content[Astro.params.section||'']; if(!data)return Astro.redirect('/praktijk');
---
<PracticeLayout title={data.title}><div class="admin-page admin-page--form"><section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn praktijk</p><h1>{data.title}</h1><p>{data.description}</p></div></section><section class="admin-panel"><header class="admin-panel__header"><div><h2>Functies</h2><p>Afgebakend binnen je eigen professionalprofiel</p></div><span class="admin-state">Volgende module</span></header><ol class="admin-setup-list">{data.items.map((item,index)=><li><span class="admin-setup-list__number">{index+1}</span><span><strong>{item}</strong><small>Geen toegang tot organisatiecontent of andere professionals</small></span><AdminIcon name="check" size={14}/></li>)}</ol></section></div></PracticeLayout>
