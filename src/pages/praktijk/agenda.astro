---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { getBookableSlots, listBookings } from '../../lib/practiceStore';
const user=Astro.locals.currentUser!;
const [slots, allBookings] = await Promise.all([getBookableSlots(user.practitionerId!,7), listBookings(user.practitionerId!)]);
const bookings=allBookings.filter((booking)=>['pending','confirmed'].includes(booking.status)&&booking.startsAt>=new Date().toISOString());
const grouped=Map.groupBy(slots,(slot)=>slot.dateLabel);
const confirmed=bookings.filter((booking)=>booking.status==='confirmed').sort((a,b)=>a.startsAt.localeCompare(b.startsAt));
const date=(value:string)=>new Intl.DateTimeFormat('nl-BE',{timeZone:'Europe/Brussels',weekday:'long',day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'}).format(new Date(value));
---
<PracticeLayout title="Mijn agenda"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn week</p><h1>Agenda</h1><p>Een privé-overzicht van afspraken en de vrije momenten die de website mag aanbieden.</p></div><div class="admin-page-actions"><a class="admin-button admin-button--primary" href="/praktijk/beschikbaarheid"><AdminIcon name="clock" size={16}/> Schema aanpassen</a></div></section>
<div class="practice-calendar-summary"><span><i class="is-confirmed"></i>{bookings.filter(b=>b.status==='confirmed').length} bevestigd</span><span><i class="is-pending"></i>{bookings.filter(b=>b.status==='pending').length} aangevraagd</span><span><i class="is-free"></i>{slots.length} boekbaar</span></div>
<section class="admin-panel practice-calendar-bookings"><header class="admin-panel__header"><div><h2>Ingeboekte sessies</h2><p>Elke geaccepteerde aanvraag wordt hier automatisch toegevoegd.</p></div></header>{confirmed.length?<div class="practice-bookings">{confirmed.map((booking)=><article><div class="practice-booking__person"><span class="admin-avatar">{booking.clientName.charAt(0).toUpperCase()}</span><div><strong>{booking.clientName}</strong><small>{booking.clientEmail}</small></div></div><div class="practice-booking__time"><AdminIcon name="calendar" size={15}/><span><strong>{date(booking.startsAt)}</strong><small>Automatisch ingeboekt</small></span></div><span class="admin-product-status admin-product-status--published"><i></i>Bevestigd</span></article>)}</div>:<div class="admin-empty-row"><div><span><AdminIcon name="calendar" size={17}/></span><strong>Nog geen ingeplande sessies</strong><p>Accepteer een aanvraag en ze verschijnt meteen in dit overzicht.</p></div></div>}</section>
<section class="admin-panel"><header class="admin-panel__header"><div><h2>Boekbare momenten · komende 7 dagen</h2><p>Bezoekers zien alleen deze vrije tijdstippen, nooit je bezette blokken.</p></div></header>{slots.length?<div class="practice-agenda-days">{Array.from(grouped.entries()).map(([day,daySlots])=><section><h3>{day}</h3><div>{daySlots.map(slot=><span>{slot.timeLabel}</span>)}</div></section>)}</div>:<div class="admin-empty-row"><div><span><AdminIcon name="calendar" size={17}/></span><strong>Geen boekbare momenten</strong><p>Stel je beschikbaarheid in om vrije slots te genereren.</p></div></div>}</section></div></PracticeLayout>
