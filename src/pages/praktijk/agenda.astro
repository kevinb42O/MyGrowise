---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import UnifiedAgenda from '../../components/admin/UnifiedAgenda';
import { getPractitionerProfile } from '../../lib/practiceStore';
const profile = await getPractitionerProfile(Astro.locals.currentUser!.practitionerId!);
const canUseItransform = profile?.slug === 'virginie';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<PracticeLayout agendaWorkspace title="Mijn agenda" description="Beheer je afspraken en beschikbaarheid in één agenda.">
  <div class="admin-page agenda-page">
    <h1 class="sr-only" id="practice-agenda-title">Mijn agenda</h1>
    <UnifiedAgenda preferenceKey={Astro.locals.currentUser!.sub} mode="practice" allowItransform={canUseItransform} client:only="react"><p slot="fallback" role="status">Agenda laden…</p></UnifiedAgenda>
  </div>
</PracticeLayout>
