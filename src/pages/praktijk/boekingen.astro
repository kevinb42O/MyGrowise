---
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listBookings, type BookingStatus } from '../../lib/practiceStore';
const user=Astro.locals.currentUser!;
const selected=(Astro.url.searchParams.get('status') || '') as BookingStatus | '';
const bookings=await listBookings(user.practitionerId!, selected || undefined);
const saved=Astro.url.searchParams.get('updated') === '1';
const labels:Record<string,string>={pending:'Aangevraagd',confirmed:'Bevestigd',declined:'Geweigerd',cancelled:'Geannuleerd',completed:'Afgerond',no_show:'Niet verschenen'};
const date=(value:string)=>new Intl.DateTimeFormat('nl-BE',{timeZone:'Europe/Brussels',weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(value));
---
<PracticeLayout title="Boekingsaanvragen"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn praktijk</p><h1>Boekingsaanvragen</h1><p>Accepteer of weiger uitsluitend aanvragen die aan jouw professionalprofiel gekoppeld zijn.</p></div></section>{saved&&<div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>Boeking bijgewerkt. Een geaccepteerde sessie staat automatisch in je agenda.</div>}
<nav class="practice-filter-tabs" aria-label="Boekingsstatus"><a class:list={{'is-active':!selected}} href="/praktijk/boekingen">Alles</a><a class:list={{'is-active':selected==='pending'}} href="?status=pending">Nieuw</a><a class:list={{'is-active':selected==='confirmed'}} href="?status=confirmed">Bevestigd</a><a class:list={{'is-active':selected==='completed'}} href="?status=completed">Afgerond</a></nav>
<section class="admin-panel">{bookings.length?<div class="practice-bookings">{bookings.map((booking)=><article><div class="practice-booking__person"><span class="admin-avatar">{booking.clientName.charAt(0).toUpperCase()}</span><div><strong>{booking.clientName}</strong><small>{booking.clientEmail}</small></div></div><div class="practice-booking__time"><AdminIcon name="calendar" size={15}/><span><strong>{date(booking.startsAt)}</strong><small>{booking.origin === 'staff' ? 'Handmatig ingepland' : 'Online aanvraag'} · {Math.round((Date.parse(booking.endsAt) - Date.parse(booking.startsAt)) / 60000)} min.</small></span></div><span class={`admin-product-status admin-product-status--${booking.status==='confirmed'?'published':booking.status==='pending'?'review':'archived'}`}><i></i>{labels[booking.status]}</span>{booking.patientId ? <a class="admin-row-action" href={`/admin/clienten/${booking.patientId}`}>Open dossier <AdminIcon name="arrow" size={13}/></a> : ['confirmed','completed','no_show'].includes(booking.status) ? <a class="admin-row-action" href={`/admin/clienten?boeking=${booking.id}`}>Dossier maken <AdminIcon name="arrow" size={13}/></a> : null}{booking.status==='pending'&&<div class="practice-booking__actions"><form action={`/api/praktijk/boekingen/${booking.id}`} method="post"><input type="hidden" name="status" value="declined"/><button class="admin-button" type="submit">Weigeren</button></form><form action={`/api/praktijk/boekingen/${booking.id}`} method="post"><input type="hidden" name="status" value="confirmed"/><button class="admin-button admin-button--primary" type="submit"><AdminIcon name="check" size={15}/> Accepteren & inboeken</button></form></div>}</article>)}</div>:<div class="admin-empty-row"><div><span><AdminIcon name="messages" size={17}/></span><strong>Geen boekingen in deze weergave</strong><p>Nieuwe aanvragen verschijnen automatisch zodra de publieke boekingsflow actief wordt gebruikt.</p></div></div>}</section></div></PracticeLayout>
