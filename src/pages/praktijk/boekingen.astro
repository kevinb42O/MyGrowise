---
import {bookingOutcomeLabel} from '../../lib/bookingOutcome';
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listBookings, type BookingStatus } from '../../lib/practiceStore';
const user=Astro.locals.currentUser!;
const requestedStatus=Astro.url.searchParams.get('status')||'';
const selected=(['pending','confirmed','completed','cancelled','no_show','declined'].includes(requestedStatus)?requestedStatus:'') as BookingStatus|'';
const requestedPage=Number(Astro.url.searchParams.get('pagina')||1);
const page=Number.isSafeInteger(requestedPage)&&requestedPage>0?Math.min(10000,requestedPage):1;
const rows=await listBookings(user.practitionerId!, selected || undefined,page);
const hasMore=rows.length>50,bookings=rows.slice(0,50);
const pageHref=(next:number)=>`?${new URLSearchParams({pagina:String(next),...(selected?{status:selected}:{})})}`;
const saved=Astro.url.searchParams.get('updated') === '1';
const labels:Record<string,string>={pending:'Aangevraagd',confirmed:'Bevestigd',declined:'Geweigerd',cancelled:'Geannuleerd',completed:'Afgerond',no_show:'Niet verschenen'};
const date=(value:string)=>new Intl.DateTimeFormat('nl-BE',{timeZone:'Europe/Brussels',weekday:'short',day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(value));
---
<PracticeLayout title="Afspraken"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Mijn praktijk</p><h1>Afspraken</h1><p>Online boekingen zijn meteen bevestigd. Volg hier je afspraken en eventuele oudere aanvragen op.</p></div></section>{saved&&<div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>Boeking bijgewerkt. Een geboekte afspraak staat automatisch in je agenda.</div>}
<nav class="practice-filter-tabs" aria-label="Boekingsstatus"><a class:list={{'is-active':!selected}} href="/praktijk/boekingen">Alles</a><a class:list={{'is-active':selected==='pending'}} href="?status=pending">Oude aanvragen</a><a class:list={{'is-active':selected==='confirmed'}} href="?status=confirmed">Bevestigd</a><a class:list={{'is-active':selected==='completed'}} href="?status=completed">Afgerond</a><a class:list={{'is-active':selected==='cancelled'}} href="?status=cancelled">Geannuleerd</a><a class:list={{'is-active':selected==='no_show'}} href="?status=no_show">No-show</a></nav>
<section class="admin-panel">{bookings.length?<div class="practice-bookings">{bookings.map((booking)=><article><div class="practice-booking__person"><span class="admin-avatar">{booking.clientName.charAt(0).toUpperCase()}</span><div><strong>{booking.clientName}</strong><small>{booking.appointmentName}</small><small>{booking.clientEmail}</small></div></div><div class="practice-booking__time"><AdminIcon name="calendar" size={15}/><span><strong>{date(booking.startsAt)}</strong><small>{booking.origin === 'staff' ? 'Handmatig ingepland' : 'Online boeking'} · {Math.round((Date.parse(booking.endsAt) - Date.parse(booking.startsAt)) / 60000)} min.</small></span></div><span class={`admin-product-status admin-product-status--${booking.status==='confirmed'?'published':booking.status==='pending'?'review':'archived'}`}><i></i>{bookingOutcomeLabel(booking)}</span><a class="admin-row-action" href={`/praktijk/afspraken/${booking.id}`}>Afspraakdetails</a>{booking.patientId ? <a class="admin-row-action" href={`/praktijk/clienten/${booking.patientId}`}>Open dossier <AdminIcon name="arrow" size={13}/></a> : ['confirmed','completed','no_show'].includes(booking.status) ? <a class="admin-row-action" href={`/praktijk/clienten?boeking=${booking.id}`}>Dossier maken <AdminIcon name="arrow" size={13}/></a> : null}{booking.status==='pending'&&<div class="practice-booking__actions"><form action={`/api/praktijk/boekingen/${booking.id}`} method="post"><input type="hidden" name="status" value="declined"/><button class="admin-button" type="submit">Weigeren</button></form><form action={`/api/praktijk/boekingen/${booking.id}`} method="post"><input type="hidden" name="status" value="confirmed"/><button class="admin-button admin-button--primary" type="submit"><AdminIcon name="check" size={15}/> Accepteren & inboeken</button></form></div>}</article>)}</div>:<div class="admin-empty-row"><div><span><AdminIcon name="messages" size={17}/></span><strong>Geen boekingen in deze weergave</strong><p>Nieuwe boekingen verschijnen automatisch in je agenda en in dit overzicht.</p></div></div>}</section></div><nav class="practice-filter" aria-label="Afspraken doorbladeren">{page>1&&<a class="admin-button" href={pageHref(page-1)}>Vorige</a>}<span>Pagina {page}</span>{hasMore&&<a class="admin-button" href={pageHref(page+1)}>Volgende</a>}</nav></PracticeLayout>
