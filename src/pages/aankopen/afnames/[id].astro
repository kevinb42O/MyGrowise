---
import PurchaseUnavailable from '../../../components/purchases/PurchaseUnavailable.astro';
import PurchaseLayout from '../../../layouts/PurchaseLayout.astro';
import Icon from '../../../components/purchases/PurchaseIcon.astro';
import {purchaseOwner,purchaseDeliveries,privateHeaders} from '../../../lib/commerce/purchases';
import {deliveryStatusLabel} from '../../../lib/catalog/server';
Object.entries(privateHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
const owner=await purchaseOwner(Astro.cookies,Astro.locals.currentUser);if(!owner)return Astro.redirect(`/aankopen/toegang?next=${encodeURIComponent(Astro.url.pathname)}`,303);
const d=(await purchaseDeliveries(owner)).find(d=>d.id===Astro.params.id);if(!d)Astro.response.status=404;
---
{d ? <PurchaseLayout title={`${d.title} — Mijn aankopen`}>
  <div class="purchase-detail">
    <a class="purchase-text-link purchase-back" href="/aankopen"><Icon name="back" /> Mijn aankopen</a>
    <header class="purchase-heading"><h1>{d.title}</h1><span class="purchase-status">{deliveryStatusLabel[d.status] || 'In behandeling'}</span></header>
    <div class="purchase-detail-layout"><div class="purchase-detail-body">
      <section class="purchase-material"><h2>Jouw instructies</h2>{d.instructions ? <p class="purchase-instructions">{d.instructions}</p> : <p>Er staan nog geen instructies klaar. Je vindt de actuele voortgang bovenaan deze pagina.</p>}{d.external_url&&<div class="purchase-actions"><a class="purchase-button" href={d.external_url} target="_blank" rel="noopener noreferrer">Open vragenlijst <Icon name="arrow" /></a></div>}</section>
      {d.report_path&&<section class="purchase-material"><h2>Je persoonlijke rapport</h2><p>Je rapport is beschikbaar. Download het om het op je eigen tempo te lezen.</p><a class="purchase-button" href={`/api/aankopen/rapport?id=${d.id}`}>Download rapport <Icon name="file" /></a></section>}
    </div><aside class="purchase-help"><h2>Een praktische vraag?</h2><p>Hulp nodig bij je afname of het openen van je rapport?</p><a class="purchase-text-link" href="/contact">Neem contact op <Icon name="arrow" /></a></aside></div>
  </div>
</PurchaseLayout> : <PurchaseUnavailable />}
