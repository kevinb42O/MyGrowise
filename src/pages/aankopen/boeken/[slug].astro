---
import PurchaseLayout from '../../../layouts/PurchaseLayout.astro';
import PurchaseUnavailable from '../../../components/purchases/PurchaseUnavailable.astro';
import {purchaseOwner,hasPurchase,privateHeaders} from '../../../lib/commerce/purchases';
import {ebookProduct,ebookActivated,hasBookSession} from '../../../lib/ebooks/server';
import {BOOK_SLUG,BOOK_COVER,BOOK_TITLE} from '../../../lib/ebooks/book';
Object.entries(privateHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
const owner=await purchaseOwner(Astro.cookies,Astro.locals.currentUser);
const product=Astro.params.slug===BOOK_SLUG?await ebookProduct():null;
const bookSession=Boolean(product&&await hasBookSession(Astro.cookies,product.id));
if(!owner&&!bookSession)return Astro.redirect('/boeken/activeren',303);
const owned=bookSession||Boolean(product&&owner&&await hasPurchase(owner,product.id));
const active=bookSession||Boolean(product&&owner&&owned&&await ebookActivated(owner,product.id));
if(!owned)Astro.response.status=404;
---
{owned?<PurchaseLayout title="Jouw boek — Mijn aankopen"><div class="book-library"><a class="book-library-back" href="/aankopen">← Mijn aankopen</a><div class="book-library-grid"><img src={BOOK_COVER} alt={BOOK_TITLE} width="1100" height="778"/><section><h1>Jij, Fien en een toverkist vol superkrachten.</h1>{active?<><p>Jouw boek, op jouw tempo. Open het hier of bewaar een exemplaar op je iPad, computer of telefoon.</p><div class="book-library-actions"><a class="button button-primary" href="/api/boeken/download/pdf?open=1" target="_blank" rel="noopener noreferrer">Lees de PDF →</a><a class="book-library-download" href="/api/boeken/download/pdf">Download PDF · 14 MB ↓</a><a class="book-library-download" href="/api/boeken/download/epub">Download EPUB · 12 MB ↓</a></div><p class="book-library-note">De EPUB heeft dezelfde vaste opmaak als het boek. Open hem in een leesapp die dit ondersteunt. Je kunt inzoomen; de tekstgrootte is niet apart instelbaar.</p><div class="book-library-future"><h2>Er komt nog iets moois bij.</h2><p>Een interactieve leeservaring met pagina’s die onder je vinger omslaan is in voorbereiding. Die verschijnt later in deze boekomgeving. Je PDF en EPUB zijn nu al beschikbaar.</p></div></>:<><p>Je betaling is bevestigd. Activeer je boek eerst met de persoonlijke code uit je e-mail.</p><a class="button button-primary" href="/boeken/activeren">Vul mijn activatiecode in →</a><form method="post" action="/api/boeken/code-opnieuw"><button class="book-library-download" type="submit">Stuur mijn activatiecode opnieuw →</button></form>{Astro.url.searchParams.has('sent')&&<p role="status">Je code is opnieuw naar het e-mailadres van je bestelling verstuurd.</p>}{Astro.url.searchParams.has('error')&&<p role="alert">De mail kon niet worden verzonden. Probeer later opnieuw.</p>}</>}</section></div></div></PurchaseLayout>:<PurchaseUnavailable/>}
<style>
.book-library{padding:1rem 0 4rem}.book-library-back{display:inline-block;margin-bottom:2.5rem;text-underline-offset:4px}.book-library-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,5rem);align-items:start}.book-library-grid>img{width:100%;height:auto;border-radius:4px}.book-library h1{font-size:clamp(2.3rem,3.8vw,3.5rem);line-height:1.12}.book-library p{font-size:1rem;line-height:1.75;color:var(--muted)}.book-library-actions{display:grid;justify-items:start;gap:1.1rem;margin:2rem 0}.book-library-download{display:inline-block;padding:.5rem 0;min-height:44px;color:var(--ink);text-decoration:underline;text-underline-offset:5px;background:none;border:0;font:inherit;cursor:pointer}.book-library .book-library-note{font-size:.875rem}.book-library-future{margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--line)}.book-library-future h2{font-size:1.5rem}.book-library-future p{font-size:.9375rem}@media(max-width:760px){.book-library-grid{grid-template-columns:1fr;gap:2rem}.book-library-grid>img{max-width:520px}.book-library h1{font-size:2.3rem}}
</style>
