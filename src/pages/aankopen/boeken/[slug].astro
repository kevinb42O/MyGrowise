---
import PurchaseLayout from '../../../layouts/PurchaseLayout.astro';
import {purchaseOwner,purchaseOrders,privateHeaders} from '../../../lib/commerce/purchases';
import {ebookProduct,hasPaidBook,hasBookSession} from '../../../lib/ebooks/server';
import {BOOK_SLUG,BOOK_COVER,BOOK_TITLE,BOOK_READER_PATH,BOOK_LIBRARY_PATH} from '../../../lib/ebooks/book';
Object.entries(privateHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
if(Astro.params.slug!==BOOK_SLUG)return new Response('Niet beschikbaar.',{status:404,headers:privateHeaders});
const owner=await purchaseOwner(Astro.cookies,Astro.locals.currentUser);
const product=await ebookProduct();
const bookSession=Boolean(product&&await hasBookSession(Astro.cookies,product.id));
const recovery=`/aankopen/toegang?next=${encodeURIComponent(BOOK_LIBRARY_PATH)}`;
if(!owner&&!bookSession)return Astro.redirect(recovery,303);
const active=bookSession||Boolean(product&&owner&&await hasPaidBook(owner,product.id));
const orders=!active&&owner?await purchaseOrders(owner):[];
const bookOrders=orders.filter(o=>o.order_items.some(i=>i.product_id===product?.id));
const pending=bookOrders.find(o=>o.status==='pending_payment');
const refunded=bookOrders.some(o=>o.status==='refunded');
const cancelled=bookOrders.some(o=>o.status==='cancelled');
if(!active)Astro.response.status=pending?200:404;
---
<PurchaseLayout title="Jouw boek" bookOnly={!owner}>
 <div class="book-library">
  {owner?<a class="book-library-back" href="/aankopen">← Mijn aankopen</a>:<a class="book-library-back" href={recovery}>Je boek op een ander apparaat openen →</a>}
  <div class="book-library-grid">
   <img src={BOOK_COVER} alt={BOOK_TITLE} width="1100" height="778"/>
   <section>
    <h1>Jij, Fien en een toverkist vol superkrachten.</h1>
    {active?<>
     <p>Je boek staat klaar. Lees samen in de interactieve editie of bewaar een exemplaar voor offline gebruik.</p>
     <div class="book-library-actions">
      <a class="button button-primary" href={BOOK_READER_PATH}>Open het interactieve boek →</a>
      <a class="book-library-download" href="/api/boeken/download/pdf?open=1" target="_blank" rel="noopener noreferrer">Lees de PDF ↗</a>
      <a class="book-library-download" href="/api/boeken/download/pdf">Download PDF · 14 MB ↓</a>
      <a class="book-library-download" href="/api/boeken/download/epub">Download EPUB · 12 MB ↓</a>
     </div>
     <p class="book-library-note">De EPUB heeft dezelfde vaste opmaak als het boek. Open hem in een leesapp die dit ondersteunt. Je kunt inzoomen; de tekstgrootte is niet apart instelbaar.</p>
     <p class="book-library-note">Je aankoop blijft behouden. Op een ander apparaat of als je toegang verlopen is, <a href={recovery}>open je je boek opnieuw via e-mail</a>. Je hoeft het niet opnieuw te kopen.</p>
    </>:<div class="book-library-status" role="status">
     <h2>{pending?'Je boek wacht op betaalbevestiging.':refunded?'Deze aankoop is terugbetaald.':cancelled?'Deze bestelling is geannuleerd.':'Je boek is nog niet beschikbaar.'}</h2>
     <p>{pending?'Virginie controleert de overschrijving binnen 1 werkdag na ontvangst. Pas nadat zij de betaling handmatig bevestigt, kun je het volledige boek openen en downloaden. Je krijgt dan een e-mail met een persoonlijke link.':refunded?'De toegang tot deze aankoop is afgesloten. Heb je nog een andere aankoop van het boek? Open die met het bijbehorende e-mailadres.':cancelled?'Voor deze bestelling is geen boektoegang beschikbaar. Heb je toch al betaald? Neem contact op met je bestelreferentie.':'Controleer of je het e-mailadres van je bestelling gebruikt. Heb je betaald en is je betaling al bevestigd? Neem contact op, zodat we je toegang kunnen nakijken.'}</p>
     {pending&&<a class="button button-primary" href={`/bestellen?order=${pending.id}`}>Bekijk betaalgegevens en bestelstatus →</a>}
     <p><a href={recovery}>Gebruik een ander aankoopadres →</a></p>
     <p><a href="/contact">Hulp bij je bestelling →</a></p>
    </div>}
   </section>
  </div>
 </div>
</PurchaseLayout>
<style>
.book-library{padding:1rem 0 4rem}.book-library-back{display:inline-block;margin-bottom:2.5rem;text-underline-offset:4px}.book-library-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,5rem);align-items:start}.book-library-grid>img{width:100%;height:auto;border-radius:4px}.book-library h1{font-size:clamp(2.3rem,3.8vw,3.5rem);line-height:1.12}.book-library-status h2{font:600 1.2rem/1.4 var(--font-body,'DM Sans'),sans-serif;margin:1.5rem 0 .75rem}.book-library a{text-underline-offset:4px}.book-library p{font-size:1rem;line-height:1.75;color:var(--muted)}.book-library-actions{display:grid;justify-items:start;gap:1.1rem;margin:2rem 0}.book-library-download{display:inline-block;padding:.5rem 0;min-height:44px;color:var(--ink);text-decoration:underline;text-underline-offset:5px;background:none;border:0;font:inherit;cursor:pointer}.book-library .book-library-note{font-size:.875rem}@media(max-width:760px){.book-library-grid{grid-template-columns:1fr;gap:2rem}.book-library-grid>img{max-width:520px}.book-library h1{font-size:2.3rem}}
</style>
