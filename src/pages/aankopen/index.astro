---
import MainLayout from '../../layouts/MainLayout.astro';
import {purchaseOwner,purchaseOrders,purchasedProducts,purchaseDeliveries,guestEmail,privateHeaders} from '../../lib/commerce/purchases';
import {isCustomerAccount} from '../../lib/adminAuth';
import {money} from '../../lib/catalog/pricing';
import {deliveryStatusLabel} from '../../lib/catalog/server';
const owner=await purchaseOwner(Astro.cookies,Astro.locals.currentUser);if(!owner)return Astro.redirect('/aankopen/toegang',303);
Object.entries(privateHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
const [orders,products,deliveries]=await Promise.all([purchaseOrders(owner),purchasedProducts(owner),purchaseDeliveries(owner)]);
const linkedAccount=isCustomerAccount(Astro.locals.currentUser);const verifiedGuest=await guestEmail(Astro.cookies);
---
<MainLayout title="Mijn aankopen — MyGrowise" noindex><section class="section"><div class="container"><span class="eyebrow">Jouw aankopen</span><h1>Verder op jouw tempo.</h1><p>Bekijk je bestellingen en open je betaalde inhoud. Een account is optioneel.</p>{Astro.url.searchParams.has('error')&&<p role="alert">Koppelen is niet gelukt. Controleer of je aankoop en je bevestigde account hetzelfde e-mailadres gebruiken.</p>}<h2>Bestellingen</h2><div class="purchase-grid">{orders.map(o=><article><h3>{o.order_items.map((i:any)=>i.product_title).join(' · ')}</h3><p>{money(o.total_cents)} · {({pending_payment:'Wacht op betaling',paid:'Betaald',fulfilled:'Geleverd',cancelled:'Geannuleerd',refunded:'Terugbetaald'} as Record<string,string>)[o.status]||'In behandeling'}</p><a href={`/bestellen?order=${o.id}`}>Bekijk bestelling en betaalgegevens →</a></article>)}</div>{products.some(p=>['module','guide'].includes(p.product_type))&&<><h2>Werkboeken en audio</h2><div class="purchase-grid">{products.filter(p=>['module','guide'].includes(p.product_type)).map(p=><article><h3>{p.product_title}</h3><a href={`/aankopen/modules/${p.product_slug}`}>Open mijn inhoud →</a></article>)}</div></>}{deliveries.length>0&&<><h2>Vragenlijsten en rapporten</h2><div class="purchase-grid">{deliveries.map(d=><article><h3>{d.title}</h3><p>{deliveryStatusLabel[d.status]}</p><a href={`/aankopen/afnames/${d.id}`}>Bekijk instructies en resultaat →</a></article>)}</div></>}{!orders.length&&<p>Er staan nog geen aankopen in dit overzicht.</p>}<aside><h2>Een account gebruiken?</h2>{linkedAccount&&verifiedGuest?<form method="post" action="/api/aankopen/koppelen"><p>Bewaar deze aankopen vrijwillig in je bevestigde klantaccount met hetzelfde e-mailadres.</p><button class="button button-primary">Koppel mijn aankopen aan mijn account</button></form>:<p>Je kunt hier zonder account blijven verdergaan. Wil je je aankopen ook in een account bewaren? <a href="/account/inloggen?next=%2Faankopen">Log in</a> of <a href="/account/aanmaken?next=%2Faankopen">maak vrijwillig een account aan</a>, open daarna je aankoopmail en kies koppelen.</p>}<a href="/contact">Hulp nodig?</a>{verifiedGuest&&<form method="post" action="/api/aankopen/afsluiten"><button class="button">Aankooplink afsluiten</button></form>}</aside></div></section></MainLayout>
<style>h1{font-size:clamp(3rem,6vw,5rem)}h2{margin:2.5rem 0 1rem}.purchase-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem}.purchase-grid article,aside{padding:1.5rem;border:1px solid var(--line);border-radius:1rem}h3{font-size:1.6rem;margin:0 0 1rem}p{line-height:1.8;color:var(--muted)}aside{margin-top:3rem;background:var(--cream)}</style>
