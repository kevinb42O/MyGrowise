---
import PurchaseLayout from '../../layouts/PurchaseLayout.astro';
import PurchaseOverview from '../../components/purchases/PurchaseOverview.astro';
import {purchaseOwner,purchaseOrders,purchasedProducts,purchaseDeliveries,guestEmail,privateHeaders} from '../../lib/commerce/purchases';
import {isCustomerAccount} from '../../lib/adminAuth';
const owner=await purchaseOwner(Astro.cookies,Astro.locals.currentUser);if(!owner)return Astro.redirect('/aankopen/toegang',303);
Object.entries(privateHeaders).forEach(([k,v])=>Astro.response.headers.set(k,v));
const [orders,products,deliveries]=await Promise.all([purchaseOrders(owner),purchasedProducts(owner),purchaseDeliveries(owner)]);
const linkedAccount=isCustomerAccount(Astro.locals.currentUser);const verifiedGuest=await guestEmail(Astro.cookies);
---
<PurchaseLayout title="Mijn aankopen"><PurchaseOverview orders={orders} products={products} deliveries={deliveries} linkedAccount={linkedAccount} verifiedGuest={verifiedGuest} linkError={Astro.url.searchParams.has('error')} /></PurchaseLayout>
