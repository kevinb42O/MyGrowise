---
import MainLayout from '../../layouts/MainLayout.astro';
import { practitioners } from '../../content/site';
import { getBookableSlots, getPractitionerBySlug } from '../../lib/practiceStore';

const availability = Object.fromEntries(practitioners.map((person) => {
  const practitioner = getPractitionerBySlug(person.slug);
  return [person.slug, practitioner ? getBookableSlots(practitioner.id, 21).slice(0, 3) : []];
}));
const themes = [
  ['Stress & emotionele belasting', 'Wanneer je systeem lang “aan” blijft staan, kan begeleiding helpen om stressreacties, lichaamssignalen en terugkerende patronen stap voor stap te begrijpen.'],
  ['Trauma & ingrijpende ervaringen', 'Bij traumagerichte begeleiding, waaronder online EMDR wanneer dat passend is, staan stabiliteit, veiligheid en draagkracht steeds voorop.'],
  ['Relaties, intimiteit & seksualiteit', 'Voor vragen rond verbinding, intimiteit, verlangen, pijn, onzekerheid of relationele spanningen is er ruimte voor een gesprek zonder oordeel.'],
];
---

<MainLayout activeNav="begeleiding" title="Online psychologische begeleiding — MyGrowise" description="Kies een professional die aansluit bij jouw hulpvraag en vraag online een afspraak aan via MyGrowise.">
  <section class="guide-hero"><div class="container guide-grid"><div class="reveal"><span class="eyebrow">Online psychologische begeleiding</span><h1>Je hoeft het niet eerst alleen uit te zoeken.</h1><p class="lead">Professionele online therapie, afgestemd op jouw hulpvraag, tempo en draagkracht. Vanuit een plek waar jij je vertrouwd voelt.</p><div class="guide-facts"><span>Beveiligde videoverbinding</span><span>Gemiddeld 50 minuten</span><span>Erkende professionals</span></div><a class="button button-primary" href="#professionals">Ontmoet de professionals <span aria-hidden="true">↓</span></a></div><div class="guide-image"><img src="/images/editorial/mygrowise-46.jpg" alt="Een persoonlijk gesprek bij MyGrowise" /><div><strong>Online</strong><span>persoonlijk, zorgvuldig en vanuit je eigen omgeving</span></div></div></div></section>

  <section class="section-sm principles"><div class="container principles-grid"><article><span>01</span><h2>Je kiest zelf</h2><p>Bekijk rustig wie past bij je hulpvraag en manier van werken.</p></article><article><span>02</span><h2>Je vraagt rechtstreeks aan</h2><p>Kies een vrij online moment via MyGrowise. Een aanvraag is nog geen definitieve afspraak.</p></article><article><span>03</span><h2>Je begint helder</h2><p>Je professional bevestigt je afspraak en bezorgt de praktische informatie.</p></article></div></section>

  <section class="section themes"><div class="container"><div class="head-grid"><div><span class="eyebrow">Waarvoor kan je terecht?</span><h2 class="heading-lg">Er is ruimte voor wat vandaag speelt.</h2></div><p class="lead">Therapie gaat niet alleen over praten. Het gaat ook over begrijpen wat onder de oppervlakte gebeurt en leren hoe je daar anders mee kan omgaan.</p></div><div class="theme-grid">{themes.map(([title, copy], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>

  <section class="section professionals" id="professionals"><div class="container"><div class="head-grid"><div><span class="eyebrow">Wie kan je begeleiden?</span><h2 class="heading-lg">Kies niet de eerste vrije plek. Kies wie bij je past.</h2></div><p class="lead">Elke professional werkt vanuit een eigen expertise. Bekijk het profiel en vraag je afspraak rechtstreeks aan via MyGrowise.</p></div><div class="professional-list">
    {practitioners.map((person,index)=>{const slots=availability[person.slug]||[];return <article class="professional-card"><div class="number">{String(index+1).padStart(2,'0')}</div><div class="portrait"><img src={person.image} alt={person.name} loading="lazy" /></div><div class="professional-copy"><span>{person.role}</span><h3>{person.name}</h3><p>{person.focus}</p><div class="public-availability"><strong>Volgende online momenten</strong>{slots.length?<div>{slots.map((slot)=><span><b>{slot.dateLabel}</b>{slot.timeLabel}</span>)}</div>:<small>Nog geen momenten gepubliceerd.</small>}</div><a class="button button-primary button-arrow" href={`/begeleiding/${person.slug}`}>{slots.length?'Kies een vrij moment':'Bekijk profiel'}</a><small>{slots.length?'Je vraagt eerst een moment aan; pas na bevestiging is je afspraak definitief.':'Bekijk expertise en kom later terug voor nieuwe momenten.'}</small></div></article>})}
  </div></div></section>

  <section class="expect section"><div class="container expect-grid"><div><span class="eyebrow">Wat je kan verwachten</span><h2 class="heading-lg">Een eerste gesprek hoeft nog niets op te lossen.</h2></div><div class="expect-copy"><p class="lead">Het eerste contact is bedoeld om te begrijpen wat je bezighoudt en of de gekozen begeleiding passend is. Je hoeft je verhaal vooraf niet perfect te ordenen.</p><ul><li>Online gesprek vanuit een plek die voor jou vertrouwd voelt</li><li>Ruimte om je hulpvraag samen te verhelderen</li><li>Een persoonlijkheidsprofiel kan als gedeeld vertrekpunt dienen</li><li>Transparantie over werkwijze en mogelijke vervolgstappen</li></ul><div class="notice"><strong>Acute nood?</strong> MyGrowise is geen crisisdienst. Bel bij onmiddellijk gevaar 112. Voor ondersteuning bij zelfmoordgedachten kan je in België terecht bij Zelfmoordlijn 1813.</div></div></div></section>
</MainLayout>

<style>
  .guide-hero{padding-block:clamp(3rem,8vw,7rem);background:var(--cream)}.guide-grid{display:grid;gap:3rem;align-items:center}.guide-grid h1{max-width:10ch;margin-bottom:1.5rem;font-size:clamp(3.5rem,8vw,7.5rem);line-height:.9}.guide-grid .button{margin-top:1rem}.guide-facts{display:flex;flex-wrap:wrap;gap:.45rem;margin:1.6rem 0}.guide-facts span{padding:.45rem .65rem;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:.7rem;font-weight:700}.guide-image{position:relative;min-height:38rem;overflow:hidden;border-radius:var(--radius-lg);box-shadow:var(--shadow)}.guide-image img{position:absolute;width:100%;height:100%;object-fit:cover}.guide-image>div{position:absolute;right:1rem;bottom:1rem;left:1rem;display:flex;align-items:center;gap:1rem;padding:1rem;border-radius:var(--radius-sm);background:var(--yellow)}.guide-image strong{font-family:'DM Serif Display',Georgia,serif;font-size:2rem;font-weight:400}.guide-image span{max-width:20ch;font-size:.72rem;font-weight:700;line-height:1.4}.principles{border-block:1px solid var(--line);background:var(--white)}.principles-grid{display:grid;gap:1px;background:var(--line)}.principles article{padding:2rem;background:var(--white)}.principles article>span{color:var(--pink);font-size:.7rem;font-weight:700}.principles h2{margin:1.8rem 0 .6rem;font-size:1.8rem}.principles p{margin:0;color:var(--muted);font-size:.84rem;line-height:1.6}.themes{background:var(--paper)}.head-grid{display:grid;gap:1.5rem;align-items:end;margin-bottom:3.5rem}.theme-grid{display:grid;gap:1rem}.theme-grid article{min-height:18rem;padding:1.6rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--white)}.theme-grid span{color:var(--pink);font-size:.7rem;font-weight:700}.theme-grid h3{margin:3.5rem 0 .8rem;font-size:2rem;line-height:1}.theme-grid p{margin:0;color:var(--muted);font-size:.88rem;line-height:1.65}.professionals{background:var(--ink);color:white}.professionals .eyebrow,.professionals .heading-lg{color:white}.professionals .lead{color:rgba(255,255,255,.65)}.professional-list{display:grid;gap:1rem}.professional-card{position:relative;display:grid;gap:1.5rem;padding:1rem;border:1px solid rgba(255,255,255,.18);border-radius:var(--radius-lg);background:rgba(255,255,255,.04)}.portrait{min-height:26rem;overflow:hidden;border-radius:calc(var(--radius-lg) - .5rem);background:var(--cream)}.portrait img{width:100%;height:100%;object-fit:cover;object-position:top}.number{position:absolute;z-index:2;top:2rem;left:2rem;display:grid;width:2.7rem;height:2.7rem;place-content:center;border-radius:50%;background:var(--yellow);color:var(--ink);font-size:.68rem;font-weight:700}.professional-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:1rem}.professional-copy>span{color:var(--pink);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.professional-copy h3{margin:.45rem 0 1rem;font-size:clamp(2.4rem,5vw,4rem)}.professional-copy p{max-width:42ch;margin-bottom:1.7rem;color:rgba(255,255,255,.68);line-height:1.7}.professional-copy .button{border-color:white;background:white;color:var(--ink)}.professional-copy small{margin-top:.8rem;color:rgba(255,255,255,.45);font-size:.65rem}.expect{background:var(--pink-soft)}.expect-grid{display:grid;gap:3rem}.expect-copy>ul{margin:2rem 0;padding:0;list-style:none}.expect-copy li{padding:.9rem 0;border-top:1px solid var(--line);font-size:.9rem;font-weight:600}.expect-copy li:last-child{border-bottom:1px solid var(--line)}.expect-copy li::before{content:'✓';margin-right:.7rem;color:var(--pink)}@media(min-width:760px){.principles-grid,.theme-grid{grid-template-columns:repeat(3,1fr)}.professional-card{grid-template-columns:.8fr 1.2fr}}@media(min-width:900px){.guide-grid{grid-template-columns:1.08fr .92fr}.head-grid{grid-template-columns:1.2fr .8fr}.expect-grid{grid-template-columns:.9fr 1.1fr}}
  .guide-hero{padding-block:clamp(3rem,6vw,5.5rem)}
  .guide-grid h1{font-size:clamp(3.5rem,6.2vw,6.25rem)}
  .public-availability{width:100%;margin:0 0 1.4rem;padding:1rem;border:1px solid rgba(255,255,255,.14);border-radius:.8rem;background:rgba(255,255,255,.04)}.public-availability>strong{display:block;margin-bottom:.7rem;color:white;font-size:.7rem;letter-spacing:.06em;text-transform:uppercase}.public-availability>div{display:flex;flex-wrap:wrap;gap:.45rem}.public-availability>div span{display:flex;gap:.4rem;padding:.45rem .6rem;border-radius:.5rem;background:rgba(255,255,255,.1);color:rgba(255,255,255,.72);font-size:.68rem}.public-availability b{color:white}.public-availability>small{margin:0;color:rgba(255,255,255,.5)}
</style>
