---
import MainLayout from '../../layouts/MainLayout.astro';
import {getPractitionerBySlug} from '../../lib/practiceStore';
import {listOffers,bookingPath} from '../../lib/appointmentCatalog';
import '../../styles/practice-management.css';
let person:Awaited<ReturnType<typeof getPractitionerBySlug>>=null;let offers:Awaited<ReturnType<typeof listOffers>>=[];let unavailable=false;
try{person=await getPractitionerBySlug(Astro.params.slug||'');if(!person?.active)return Astro.redirect('/begeleiding');offers=await listOffers({practitionerId:person.id,publicOnly:true});}catch{unavailable=true;Astro.response.status=503;}

---
<MainLayout activeNav="begeleiding" title={`Begeleiding${person?` bij ${person.name}`:''} — MyGrowise`} description={person?.bio}><section class="section"><div class="container practice-stack" style="max-width:1000px"><a href="/begeleiding">← Alle therapeuten</a>{person&&<header><span class="eyebrow">{person.publicRole}</span><h1>{person.name}</h1><p class="lead">{person.bio}</p><p>{person.expertise.join(' · ')}</p></header>}{unavailable&&<p role="alert">De afspraken zijn tijdelijk niet bereikbaar. Probeer later opnieuw of <a href="/contact">neem contact op</a>. Er is geen afspraak vastgelegd.</p>}<h2>Kies je afspraaktype</h2><div class="practice-grid">{offers.map(o=><article class="practice-card" style={`--treatment-color:${o.color}`}><span class="practice-dot"></span><span>{o.kind==='intake'?'Intake':o.kind==='follow_up'?'Vervolgsessie':'Afspraak'}</span><h2>{o.name}</h2><p>{o.duration} minuten · {o.channel==='online'?'Online':o.location}</p><a class="practice-button" href={bookingPath(o)}>Kies een vrij moment</a></article>)}</div>{!offers.length&&<p>Er zijn momenteel geen afspraaktypes beschikbaar. Neem contact op met de praktijk.</p>}</div></section></MainLayout>
