---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import InternalInbox from '../../components/admin/InternalInbox.astro';
const thread = Astro.url.searchParams.get('thread') || '';
const created = Astro.url.searchParams.get('created') === '1'; const sent = Astro.url.searchParams.get('sent') === '1'; const error = Astro.url.searchParams.get('error') || '';
---
<AdminLayout title="Berichten" description="Interne communicatie binnen het MyGrowise-team"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Organisatie</p><h1>Berichten</h1><p>Interne communicatie met medewerkers en professionals die een MyGrowise-account hebben.</p></div></section>{(created || sent) && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>{created ? 'Gesprek gestart; ontvangers kregen een notificatie.' : 'Bericht verstuurd; ontvangers kregen een notificatie.'}</div>}{error && <div class="admin-login__alert admin-login__alert--error" role="alert"><AdminIcon name="warning" size={17}/>{error}</div>}<InternalInbox userId={Astro.locals.currentUser!.sub} surface="admin" selectedThreadId={thread}/></div></AdminLayout>
