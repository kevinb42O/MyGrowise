---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import InternalInbox from '../../components/admin/InternalInbox.astro';
import SupportInbox from '../../components/admin/SupportInbox.astro';
import { hasPermission } from '../../lib/adminAuth';
const thread = Astro.url.searchParams.get('thread') || ''; const conversation = Astro.url.searchParams.get('conversation') || '';
const compose = Astro.url.searchParams.get('compose') === '1';
const view = Astro.url.searchParams.get('view') === 'team' ? 'team' : 'support'; const created = Astro.url.searchParams.get('created') === '1'; const sent = Astro.url.searchParams.get('sent') === '1'; const updated = Astro.url.searchParams.get('updated') === '1'; const error = Astro.url.searchParams.get('error') || '';
const canSupport = hasPermission(Astro.locals.adminUser, 'support.read');
---
<AdminLayout title="Berichten" description="Klantondersteuning en interne communicatie"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Opvolging</p><h1>Berichten</h1><p>Behandel klantvragen met eigenaar, status en interne notities — en houd teamafstemming apart maar dichtbij.</p></div></section><nav class="support-view-tabs" aria-label="Berichtenweergave">{canSupport && <a class:list={{ 'is-active': view === 'support' }} href="/admin/berichten">Klantberichten</a>}<a class:list={{ 'is-active': view === 'team' || !canSupport }} href="/admin/berichten?view=team">Teamcommunicatie</a></nav>{(created || sent || updated) && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>{updated ? 'Gesprek bijgewerkt.' : created ? 'Gesprek gestart; ontvangers kregen een notificatie.' : 'Bericht verstuurd.'}</div>}{error && <div class="admin-login__alert admin-login__alert--error" role="alert"><AdminIcon name="warning" size={17}/>Controleer de invoer en probeer opnieuw.</div>}{view === 'support' && canSupport ? <SupportInbox userId={Astro.locals.currentUser!.sub} selectedId={conversation}/> : <InternalInbox userId={Astro.locals.currentUser!.sub} surface="admin" selectedThreadId={thread} compose={compose}/>}</div></AdminLayout>
