---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAdminTasks, listIntegrationChecks } from '../../lib/superAdmin';
const [integrations, tasks] = await Promise.all([listIntegrationChecks(), listAdminTasks()]);
const saved = Astro.url.searchParams.get('message') === 'work-item-updated';
const stateLabel = { healthy: 'Gezond', degraded: 'Vertraagd', not_configured: 'Niet gekoppeld', failed: 'Fout' };
---
<AdminLayout title="Instellingen" description="Integraties, veiligheid en operationele opvolging">
  <div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Organisatie</p><h1>Instellingen</h1><p>Secrets blijven buiten deze interface. Deze pagina rapporteert alleen verbindingsstatus en operationele opvolging.</p></div><div class="admin-page-actions"><a class="admin-button" href="/admin/privacy"><AdminIcon name="lock" size={16}/> Privacy & retentie</a><a class="admin-button admin-button--primary" href="/admin/gebruikers"><AdminIcon name="customers" size={16}/> Gebruikers & rollen</a></div></section>{saved && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/> Werkitem bijgewerkt.</div>}
  <div class="admin-dashboard-grid"><section class="admin-panel"><header class="admin-panel__header"><div><h2>Integraties</h2><p>Geen geheime waarden worden weergegeven</p></div></header><div class="analytics-quality">{integrations.map((integration) => <div class="analytics-quality__row"><span>{integration.label}<small>{integration.detail || 'Geen detail beschikbaar'}</small></span><span class:list={['admin-state', integration.state === 'healthy' ? 'admin-state--ready' : 'admin-state--blocked']}>{stateLabel[integration.state]}</span></div>)}</div></section><section class="admin-panel"><header class="admin-panel__header"><div><h2>Actiecentrum</h2><p>Gekoppeld aan auditbare werkitems</p></div></header>{tasks.length ? <ol class="admin-setup-list">{tasks.map((task, index) => <li><span class="admin-setup-list__number">{index + 1}</span><span><strong>{task.title}</strong><small>{task.category} · prioriteit {task.priority}{task.dueAt ? ` · deadline ${new Intl.DateTimeFormat('nl-BE', { dateStyle: 'short' }).format(new Date(task.dueAt))}` : ''}</small></span><form method="post" action={`/api/admin/work-items/${task.id}`}><input type="hidden" name="status" value={task.status === 'open' ? 'in_progress' : 'resolved'}/><button class="admin-button" type="submit">{task.status === 'open' ? 'Start' : 'Afronden'}</button></form></li>)}</ol> : <div class="admin-empty-row"><div><span><AdminIcon name="check" size={17}/></span><strong>Geen openstaande werkitems</strong><p>Nieuwe operationele uitzonderingen worden hier als auditbare taken geplaatst.</p></div></div>}</section></div>
  <div class="admin-lock-note"><strong>Veilig beheerd:</strong> gebruikers- en integratiegegevens zijn alleen beschikbaar in deze beveiligde beheeromgeving.</div></div>
</AdminLayout>
