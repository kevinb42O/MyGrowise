---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { getSuperadminOverview } from '../../lib/superAdmin';

const overview = await getSuperadminOverview();

const metrics = [
  { label: 'Netto-omzet', value: overview.netRevenue, detail: 'Betaald en geleverd, exclusief refunds', icon: 'euro' },
  { label: 'Betaalde bestellingen', value: String(overview.paidOrders), detail: 'Op basis van gevalideerde orderstatus', icon: 'cart' },
  { label: 'Aankoopconversie', value: overview.conversion === null ? '—' : new Intl.NumberFormat('nl-BE', { style: 'percent', maximumFractionDigits: 1 }).format(overview.conversion), detail: overview.conversion === null ? 'Nog onvoldoende consent-data' : 'Betaling per consented sessie', icon: 'trend' },
  { label: 'Boekingsaanvragen', value: String(overview.pendingBookings), detail: 'Openstaande aanvragen om op te volgen', icon: 'heart' },
];

const setup = [
  { title: 'Supabase & toegangsmodel', detail: 'RLS, audittrail en server-only credentials', state: 'Actief', tone: 'ready' },
  { title: 'Productbeheer', detail: `${overview.productCount} producten · ${overview.publishedProducts} gepubliceerd`, state: 'Actief', tone: 'ready' },
  { title: 'Betaling & levering', detail: overview.integrations.find((item) => item.key === 'payments')?.detail || 'Controle vereist', state: overview.integrations.find((item) => item.key === 'payments')?.state === 'healthy' ? 'Actief' : 'Actie nodig', tone: overview.integrations.find((item) => item.key === 'payments')?.state === 'healthy' ? 'ready' : 'blocked' },
  { title: 'E-mail & uitnodigingen', detail: overview.integrations.find((item) => item.key === 'email')?.detail || 'Controle vereist', state: overview.integrations.find((item) => item.key === 'email')?.state === 'healthy' ? 'Actief' : 'Actie nodig', tone: overview.integrations.find((item) => item.key === 'email')?.state === 'healthy' ? 'ready' : 'blocked' },
  { title: 'Privacyvriendelijke analytics', detail: `${overview.analyticsEvents} consented events in de laatste 30 dagen`, state: overview.analyticsEvents ? 'Ontvangt data' : 'Klaar om te koppelen', tone: 'ready' },
];
---

<AdminLayout title="Dashboard" description="Operationeel overzicht voor MyGrowise">
  <div class="admin-page">
    <section class="admin-page-heading" aria-labelledby="admin-title">
      <div>
        <p class="admin-eyebrow">Operationeel overzicht</p>
        <h1 id="admin-title">Goedemiddag, Virginie.</h1>
        <p>Hier zie je straks wat verkoopt, waar klanten afhaken en welke acties vandaag aandacht nodig hebben.</p>
      </div>
      <div class="admin-page-actions">
        <a class="admin-button" href="/" target="_blank" rel="noreferrer"><AdminIcon name="external" size={16} /> Website bekijken</a>
        <a class="admin-button admin-button--primary" href="/admin/producten/nieuw"><AdminIcon name="plus" size={16} /> Nieuw product</a>
      </div>
    </section>

    <div class="admin-preview-notice" role="status">
      <AdminIcon name="warning" size={18} />
      <div><strong>Operationele status</strong>Financiële cijfers worden pas gevuld door een gevalideerde betaalwebhook. Het dashboard toont nooit browserredirects als betaalbewijs.</div>
    </div>

    <section class="admin-metrics" aria-label="Kerncijfers">
      {metrics.map((metric) => (
        <article class="admin-metric">
          <div class="admin-metric__head">
            <span class="admin-metric__label">{metric.label}</span>
            <span class="admin-metric__icon"><AdminIcon name={metric.icon} size={15} /></span>
          </div>
          <strong>{metric.value}</strong>
          <small class="status-waiting">{metric.detail}</small>
        </article>
      ))}
    </section>

    <div class="admin-dashboard-grid">
      <section class="admin-panel" aria-labelledby="revenue-title">
        <header class="admin-panel__header">
          <div><h2 id="revenue-title">Omzetontwikkeling</h2><p>Betaalde bestellingen, exclusief terugbetalingen</p></div>
          <div class="admin-panel__header-actions">
            <select class="admin-select" aria-label="Periode"><option>Laatste 30 dagen</option><option>Laatste 7 dagen</option><option>Dit jaar</option></select>
            <a class="admin-text-link" href="/admin/analytics">Details <AdminIcon name="arrow" size={13} /></a>
          </div>
        </header>
        <div class="admin-chart">
          <div class="admin-chart__summary"><strong>{overview.netRevenue}</strong><span>Betaalde en geleverde orders</span></div>
          <div class="admin-chart__empty">
            <div><span><AdminIcon name="analytics" size={18} /></span><strong>Nog geen omzetdata</strong><p>Zodra een eerste testbetaling en webhook succesvol zijn verwerkt, verschijnt hier de tijdlijn.</p></div>
          </div>
        </div>
      </section>

      <section class="admin-panel" aria-labelledby="setup-title">
        <header class="admin-panel__header"><div><h2 id="setup-title">Lancering gereedmaken</h2><p>5 essentiële bouwblokken</p></div></header>
        <ol class="admin-setup-list">
          {setup.map((item, index) => (
            <li>
              <span class="admin-setup-list__number">{index + 1}</span>
              <span><strong>{item.title}</strong><small>{item.detail}</small></span>
              <span class:list={['admin-state', item.tone && `admin-state--${item.tone}`]}>{item.state}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <section class="admin-panel admin-activity" aria-labelledby="activity-title">
      <header class="admin-panel__header">
        <div><h2 id="activity-title">Recente activiteit</h2><p>Bestellingen, boekingen, berichten en contentwijzigingen</p></div>
        <a class="admin-text-link" href="/admin/producten">Producten bekijken <AdminIcon name="arrow" size={13} /></a>
      </header>
      {overview.activity.length ? (
        <div class="admin-activity-list">
          {overview.activity.map((event) => (
            <a href={event.objectType === 'product' ? `/admin/producten/${event.objectId}` : '/admin'} class="admin-activity-row">
              <span class="admin-activity-row__icon"><AdminIcon name="products" size={16} /></span>
              <span class="admin-activity-row__main"><strong>{event.action}</strong><small>{event.objectType} · {event.objectId}</small></span>
              <span class="admin-activity-row__meta"><strong>Superadmin</strong><time datetime={event.occurredAt}>{new Intl.DateTimeFormat('nl-BE', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(event.occurredAt))}</time></span>
              <AdminIcon name="arrow" size={14} />
            </a>
          ))}
        </div>
      ) : (
        <div class="admin-empty-row"><div><span><AdminIcon name="clock" size={17} /></span><strong>Nog geen activiteit</strong><p>Nieuwe gebeurtenissen verschijnen hier chronologisch en met verantwoordelijke gebruiker.</p></div></div>
      )}
    </section>
  </div>
</AdminLayout>
