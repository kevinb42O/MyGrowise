---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DashboardIsland from '../../components/admin/DashboardIsland.astro';

const period = ['alles', '30d', '7d', 'jaar'].includes(Astro.url.searchParams.get('periode') || '') ? Astro.url.searchParams.get('periode')! : 'alles';
const periodLabel: Record<string, string> = { alles: 'Alle tijd', '30d': 'Laatste 30 dagen', '7d': 'Laatste 7 dagen', jaar: 'Dit jaar' };
---
<AdminLayout title="Dashboard" description="Operationeel overzicht voor MyGrowise">
  <DashboardIsland server:defer period={period}>
    <div slot="fallback" class="admin-page dashboard-home" aria-busy="true">
      <header class="admin-page-heading dashboard-home__heading">
        <div><p class="admin-eyebrow">MyGrowise</p><h1>Dashboard</h1><p>Verkoop, afspraken en wat nu aandacht vraagt.</p></div>
        <nav class="dashboard-home__period" aria-label="Periode omzet">{Object.entries(periodLabel).map(([key, label]) => <a href={`/admin?periode=${key}`} class:list={{ 'is-active': period === key }} aria-current={period === key ? 'page' : undefined}>{label}</a>)}</nav>
      </header>
      <p class="admin-loading-label" role="status">Dashboardgegevens laden…</p>
      <section class="dashboard-home__stats" aria-label="Kerncijfers laden">{Array.from({ length: 4 }, () => <article class="admin-skeleton-card"><span class="admin-skeleton-line"></span><span class="admin-skeleton-number"></span><span class="admin-skeleton-line admin-skeleton-line--short"></span></article>)}</section>
      <div class="dashboard-home__main">
        <section class="admin-panel dashboard-home__revenue admin-skeleton-panel" aria-label="Omzetgrafiek laden"><span class="admin-skeleton-line"></span><div class="admin-skeleton-chart"></div></section>
        <section class="admin-panel dashboard-home__attention admin-skeleton-panel" aria-label="Open acties laden"><span class="admin-skeleton-line"></span><span class="admin-skeleton-line"></span><span class="admin-skeleton-line admin-skeleton-line--short"></span></section>
      </div>
      <div class="dashboard-home__lower">{Array.from({ length: 2 }, () => <section class="admin-panel admin-skeleton-panel" aria-label="Overzicht laden"><span class="admin-skeleton-line"></span><span class="admin-skeleton-line"></span><span class="admin-skeleton-line admin-skeleton-line--short"></span></section>)}</div>
    </div>
  </DashboardIsland>
</AdminLayout>
