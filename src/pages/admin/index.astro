---
import AdminLoadingPanel from '../../components/admin/AdminLoadingPanel.astro';
import AdminSkeleton from '../../components/admin/AdminSkeleton';
import AdminLayout from '../../layouts/AdminLayout.astro';
import DashboardIsland from '../../components/admin/DashboardIsland.astro';

const period = ['alles', '30d', '7d', 'jaar'].includes(Astro.url.searchParams.get('periode') || '') ? Astro.url.searchParams.get('periode')! : 'alles';
const periodLabel: Record<string, string> = { alles: 'Alle tijd', '30d': 'Laatste 30 dagen', '7d': 'Laatste 7 dagen', jaar: 'Dit jaar' };
---
<AdminLayout title="Dashboard" description="Operationeel overzicht voor MyGrowise">
  <DashboardIsland server:defer period={period}>
    <div slot="fallback" class="admin-page dashboard-home" aria-busy="true">
      <header class="admin-page-heading dashboard-home__heading">
        <div><p class="admin-eyebrow">MyGrowise</p><h1>Dashboard</h1><p>Verkoop, afspraken en wat nu aandacht vraagt.</p></div>
        <nav class="dashboard-home__period" aria-label="Periode omzet">{Object.entries(periodLabel).map(([key, label]) => <a href={`/admin?periode=${key}`} class:list={{ 'is-active': period === key }} aria-current={period === key ? 'page' : undefined}>{label}</a>)}</nav>
      </header>
      <p class="sr-only" role="status">Dashboardgegevens laden…</p>
      <section class="dashboard-home__stats" aria-label="Kerncijfers laden">{[
        `Omzet · ${periodLabel[period].toLowerCase()}`, 'Betaalde bestellingen', 'Open boekingsaanvragen', 'Paginaweergaven',
      ].map((label) => <article class="admin-skeleton-card"><span>{label}</span><AdminSkeleton variant="metric" /></article>)}</section>
      <div class="dashboard-home__main">
        <AdminLoadingPanel class="dashboard-home__revenue" title="Omzetontwikkeling" description={`${periodLabel[period]} · betaalde en geleverde bestellingen`} variant="chart" />
        <AdminLoadingPanel class="dashboard-home__attention" title="Aandacht nodig" description="Open acties uit verkoop en planning" appearance="people" />
      </div>
      <div class="dashboard-home__lower">
        <AdminLoadingPanel title="Recente bestellingen" description="Laatste transacties en hun status" />
        <AdminLoadingPanel title="Komende afspraken" description="Bevestigde afspraken en aanvragen" appearance="people" />
      </div>
    </div>
  </DashboardIsland>
</AdminLayout>
