---
import AdminPagination from '../../components/admin/AdminPagination.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAdminCustomers } from '../../lib/superAdmin';
const q = (Astro.url.searchParams.get('q') || '').trim().slice(0,120);
const result = await listAdminCustomers(Astro.url.searchParams.get('pagina'), q);
const customers = result.items;
const money = (value: number) => new Intl.NumberFormat('nl-BE', { style: 'currency', currency: 'EUR' }).format(value / 100);
---
<AdminLayout title="Klanten" description="Minimaal klantbeeld voor support en verkoop">
  <div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Relaties</p><h1>Klanten</h1><p>Toont alleen operationele account- en aankoopinformatie. Vragenlijst- en gezondheidsinformatie horen hier niet thuis.</p></div></section>
  <section class="admin-panel"><form class="admin-filterbar" method="get"><label class="admin-search"><span class="sr-only">Zoek klant op naam</span><input type="search" name="q" value={q} placeholder="Zoek op naam…"/></label><button class="admin-button">Zoeken</button>{q && <a class="admin-button" href="/admin/klanten">Wissen</a>}</form>{customers.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Klant</th><th>E-mailadres</th><th>Account sinds</th><th>Bestellingen</th><th>Besteed</th><th>Referentie</th><th><span class="sr-only">Actie</span></th></tr></thead><tbody>{customers.map((customer) => <tr><td data-label="Klant"><strong>{customer.name}</strong></td><td data-label="E-mailadres">{customer.email}</td><td data-label="Account sinds"><time datetime={customer.createdAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(customer.createdAt))}</time></td><td data-label="Bestellingen">{customer.orderCount}</td><td data-label="Besteed"><strong class="admin-table-price">{money(customer.totalCents)}</strong></td><td data-label="Referentie"><code>{customer.id.slice(0, 8)}…</code></td><td data-label="Actie"><a class="admin-row-action" href={`/admin/klanten/${customer.id}`}>Bekijken <AdminIcon name="arrow" size={13}/></a></td></tr>)}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="customers" size={17}/></span><strong>{q ? 'Geen klanten voor deze zoekterm' : 'Nog geen klantaccounts'}</strong><p>Accounts die via Supabase Auth worden aangemaakt verschijnen hier automatisch.</p></div></div>}<AdminPagination {...result} label="Klanten"/></section></div>
</AdminLayout>
