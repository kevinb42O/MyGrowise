---
import AdminLayout from '../../layouts/AdminLayout.astro';
import UnifiedAgenda from '../../components/admin/UnifiedAgenda';
---

<AdminLayout title="Agenda" description="Één krachtige planning voor MyGrowise en Praktijk Itransform">
  <div class="admin-page agenda-page">
    <section class="admin-page-heading agenda-heading" aria-labelledby="agenda-title">
      <div>
        <p class="admin-eyebrow">Planning & capaciteit</p>
        <h1 id="agenda-title">Agenda</h1>
        <p>MyGrowise-afspraken worden automatisch ingeladen. Plan Praktijk Itransform zelfstandig, met dezelfde snelle bediening als een moderne agenda.</p>
      </div>
    </section>
    <section class="agenda-product-note" aria-label="Zo werkt deze agenda">
      <div><strong>MyGrowise</strong><span>Automatisch uit boekingen · klik voor beheer</span></div>
      <div><strong>Praktijk Itransform</strong><span>Klik, selecteer, sleep of resize om te plannen</span></div>
      <div><strong>Privacy</strong><span>Alleen planning — geen therapienotities of gezondheidsgegevens</span></div>
    </section>
    <UnifiedAgenda client:only="react" />
  </div>
</AdminLayout>
