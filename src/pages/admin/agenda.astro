---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAgendaEvents } from '../../lib/adminAgenda';

const now = new Date();
const day = now.getDay() || 7;
const weekStart = new Date(now);
weekStart.setDate(now.getDate() - day + 1);
weekStart.setHours(0, 0, 0, 0);
const weekEnd = new Date(weekStart);
weekEnd.setDate(weekEnd.getDate() + 7);
const events = await listAgendaEvents(weekStart.toISOString(), weekEnd.toISOString());
const serializedEvents = JSON.stringify(events).replaceAll('<', '\\u003c');
const formatDate = new Intl.DateTimeFormat('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<AdminLayout title="Agenda" description="Eén operationeel overzicht voor MyGrowise en Praktijk Itransform">
  <div class="admin-page agenda-page" data-agenda data-initial-start={weekStart.toISOString()}>
    <section class="admin-page-heading agenda-heading" aria-labelledby="agenda-title">
      <div>
        <p class="admin-eyebrow">Planning & capaciteit</p>
        <h1 id="agenda-title">Agenda</h1>
        <p>Plan je fysieke praktijk los van MyGrowise, maar bekijk beide agenda’s samen wanneer dat helpt.</p>
      </div>
      <div class="admin-page-actions">
        <a class="admin-button" href="/admin/boekingen"><AdminIcon name="calendar" size={16} /> MyGrowise-boekingen</a>
        <button class="admin-button admin-button--primary" type="button" data-open-event><AdminIcon name="plus" size={16} /> Itransform-moment</button>
      </div>
    </section>

    <section class="agenda-controlbar" aria-label="Agendafilters">
      <div class="agenda-source-switch" role="group" aria-label="Agenda's tonen">
        <button type="button" class="is-active" data-source="all" aria-pressed="true"><span class="agenda-source-dot agenda-source-dot--all"></span>Alles</button>
        <button type="button" data-source="mygrowise" aria-pressed="false"><span class="agenda-source-dot agenda-source-dot--mygrowise"></span>MyGrowise</button>
        <button type="button" data-source="itransform" aria-pressed="false"><span class="agenda-source-dot agenda-source-dot--itransform"></span>Praktijk Itransform</button>
      </div>
      <div class="agenda-controlbar__right">
        <label class="agenda-search"><span class="sr-only">Zoek in agenda</span><AdminIcon name="search" size={15} /><input type="search" data-search placeholder="Zoek afspraak…" autocomplete="off" /></label>
        <div class="agenda-view-switch" role="group" aria-label="Weergave">
        <button class="is-active" type="button" data-view="week" aria-pressed="true">Week</button>
        <button type="button" data-view="day" aria-pressed="false">Dag</button>
        <button type="button" data-view="month" aria-pressed="false">Maand</button>
        </div>
      </div>
    </section>

    <section class="agenda-insights" aria-label="Agenda-inzichten">
      <article><span class="agenda-insights__icon agenda-insights__icon--mygrowise"><AdminIcon name="calendar" size={15} /></span><span><small>MyGrowise</small><strong data-count="mygrowise">—</strong><em>bevestigd of aangevraagd</em></span></article>
      <article><span class="agenda-insights__icon agenda-insights__icon--itransform"><AdminIcon name="heart" size={15} /></span><span><small>Praktijk Itransform</small><strong data-count="itransform">—</strong><em>eigen momenten deze periode</em></span></article>
      <article><span class="agenda-insights__icon agenda-insights__icon--time"><AdminIcon name="clock" size={15} /></span><span><small>Volgende afspraak</small><strong class="agenda-next" data-next>—</strong><em data-next-detail>Geen afspraak gepland</em></span></article>
      <div class="agenda-sync-state"><span><i></i> Live gekoppeld</span><p>MyGrowise-afspraken komen automatisch uit het boekingssysteem.</p></div>
    </section>

    <section class="admin-panel agenda-calendar" aria-label="Weekagenda">
      <header class="agenda-calendar__toolbar">
        <div class="agenda-navigation">
          <button type="button" class="admin-icon-button" data-prev aria-label="Vorige periode"><span aria-hidden="true">←</span></button>
          <button type="button" class="admin-icon-button" data-next aria-label="Volgende periode"><span aria-hidden="true">→</span></button>
          <button type="button" class="agenda-today" data-today>Vandaag</button>
          <strong data-range>{formatDate.format(weekStart)} – {formatDate.format(new Date(weekEnd.getTime() - 1))}</strong>
        </div>
        <div class="agenda-legend" aria-label="Legenda"><span><i class="agenda-source-dot--mygrowise"></i>MyGrowise</span><span><i class="agenda-source-dot--itransform"></i>Praktijk Itransform</span></div>
      </header>
      <div class="agenda-scroll" tabindex="0" aria-label="Agenda met tijden van 7 tot 20 uur">
        <div class="agenda-grid" data-calendar></div>
      </div>
      <footer class="agenda-calendar__footer"><span><AdminIcon name="lock" size={14} /> Alleen planningsinformatie. Bewaar geen therapienotities of gezondheidsgegevens in deze agenda.</span><span class="agenda-shortcuts"><kbd>C</kbd> nieuw moment <kbd>T</kbd> vandaag <kbd>/</kbd> zoeken</span><a href="/admin/boekingen">Beheer MyGrowise-boekingen <AdminIcon name="arrow" size={13} /></a></footer>
    </section>

    <section class="agenda-guide" aria-label="Hoe deze agenda werkt">
      <div><span class="agenda-guide__number">1</span><p><strong>MyGrowise is automatisch</strong>Publieke aanvragen en bevestigde begeleidingen verschijnen vanzelf. Pas ze aan via Boekingen.</p></div>
      <div><span class="agenda-guide__number">2</span><p><strong>Itransform blijft apart</strong>Voeg fysieke afspraken, blokken en persoonlijke momenten hier toe zonder klantdata tussen systemen te kopiëren.</p></div>
      <div><span class="agenda-guide__number">3</span><p><strong>Samen wanneer nodig</strong>Filter per agenda of gebruik Alles om je werkweek en beschikbare capaciteit in één oogopslag te zien.</p></div>
    </section>

    <dialog class="agenda-dialog" data-event-dialog aria-labelledby="event-dialog-title">
      <form class="agenda-dialog__card" data-event-form>
        <header><div><p class="admin-eyebrow">Praktijk Itransform</p><h2 id="event-dialog-title" data-event-form-title>Nieuw moment</h2><p>Maak een privé planningsblok. Vermeld geen therapeutische inhoud.</p></div><button class="admin-icon-button" type="button" data-close-event aria-label="Sluiten"><AdminIcon name="close" size={18} /></button></header>
        <div class="agenda-dialog__fields">
          <input name="eventId" type="hidden" />
          <label class="admin-field"><span>Label <i>*</i></span><input name="title" required minlength="2" maxlength="100" autocomplete="off" placeholder="Bijv. cliëntafspraak of teamoverleg" /><small>Gebruik een neutrale omschrijving; geen diagnose of dossiernotitie.</small></label>
          <label class="admin-field"><span>Type <i>*</i></span><select name="kind"><option value="appointment">Afspraak</option><option value="block">Niet beschikbaar</option><option value="personal">Persoonlijk</option></select></label>
          <label class="admin-field"><span>Van <i>*</i></span><input name="startsAt" type="datetime-local" required /></label>
          <label class="admin-field"><span>Tot <i>*</i></span><input name="endsAt" type="datetime-local" required /></label>
          <label class="admin-field admin-field--wide"><span>Locatie</span><input name="location" maxlength="120" autocomplete="off" placeholder="Bijv. Itransform · praktijkruimte 1" /></label>
        </div>
        <p class="agenda-form-error" data-form-error hidden></p>
        <footer><button class="admin-button" type="button" data-close-event>Annuleren</button><button class="admin-button admin-button--primary" type="submit"><span data-submit-label>Moment toevoegen</span></button></footer>
      </form>
    </dialog>

    <dialog class="agenda-dialog agenda-dialog--detail" data-detail-dialog aria-labelledby="detail-dialog-title">
      <div class="agenda-dialog__card agenda-detail-card">
        <header><div><p class="admin-eyebrow" data-detail-source>Agenda</p><h2 id="detail-dialog-title" data-detail-title>Afspraak</h2><p data-detail-description></p></div><button class="admin-icon-button" type="button" data-close-detail aria-label="Sluiten"><AdminIcon name="close" size={18} /></button></header>
        <div class="agenda-detail-meta"><span><AdminIcon name="clock" size={16} /><span data-detail-time></span></span><span data-detail-location><AdminIcon name="calendar" size={16} /><span data-detail-location-text></span></span></div>
        <footer><a class="admin-button" data-detail-bookings href="/admin/boekingen">Naar boekingen</a><button class="admin-button" type="button" data-edit-event hidden>Bewerken</button><button class="admin-button admin-button--danger" type="button" data-delete-event hidden>Verwijderen</button><button class="admin-button admin-button--primary" type="button" data-close-detail>Sluiten</button></footer>
      </div>
    </dialog>
  </div>

  <script id="agenda-initial-events" type="application/json" set:html={serializedEvents}></script>
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-agenda]');
      if (!root) return;
      const zone = 'Europe/Brussels';
      const calendar = root.querySelector('[data-calendar]');
      const range = root.querySelector('[data-range]');
      const sourceButtons = [...root.querySelectorAll('[data-source]')];
      const viewButtons = [...root.querySelectorAll('[data-view]')];
      const eventDialog = root.querySelector('[data-event-dialog]');
      const detailDialog = root.querySelector('[data-detail-dialog]');
      const form = root.querySelector('[data-event-form]');
      const error = root.querySelector('[data-form-error]');
      const searchInput = root.querySelector('[data-search]');
      const initial = JSON.parse(document.querySelector('#agenda-initial-events')?.textContent || '[]');
      const HOURS = Array.from({ length: 14 }, (_, index) => index + 7);
      const dateFormatter = new Intl.DateTimeFormat('nl-BE', { timeZone: zone, weekday: 'short', day: 'numeric', month: 'short' });
      const longDateFormatter = new Intl.DateTimeFormat('nl-BE', { timeZone: zone, weekday: 'long', day: 'numeric', month: 'long' });
      const rangeFormatter = new Intl.DateTimeFormat('nl-BE', { timeZone: zone, day: 'numeric', month: 'long', year: 'numeric' });
      const timeFormatter = new Intl.DateTimeFormat('nl-BE', { timeZone: zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
      let view = localStorage.getItem('mygrowise-agenda-view') || 'week'; let source = localStorage.getItem('mygrowise-agenda-source') || 'all'; if (!['week', 'day', 'month'].includes(view)) view = 'week'; if (!['all', 'mygrowise', 'itransform'].includes(source)) source = 'all'; let search = ''; let events = initial; let selected = null;
      let start = new Date(root.dataset.initialStart);
      const isSameDate = (a, b) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
      const localDate = (value) => new Date(value).toLocaleDateString('en-CA', { timeZone: zone });
      const days = () => Array.from({ length: view === 'day' ? 1 : 7 }, (_, index) => new Date(start.getTime() + index * 86400000));
      const weekStart = (value = new Date()) => { const result = new Date(value); const weekday = result.getDay() || 7; result.setDate(result.getDate() - weekday + 1); result.setHours(0, 0, 0, 0); return result; };
      const monthStart = (value = new Date()) => new Date(value.getFullYear(), value.getMonth(), 1);
      const getTimeParts = (value) => { const parts = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(value)); return Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, Number(part.value)])); };
      const inputDateTime = (value) => { const parts = new Intl.DateTimeFormat('en-CA', { timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(value)); const data = Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value])); return `${data.year}-${data.month}-${data.day}T${data.hour}:${data.minute}`; };
      const escape = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
      const updateStats = () => {
        const active = events.filter((item) => source === 'all' || item.source === source);
        root.querySelector('[data-count="mygrowise"]').textContent = String(events.filter((item) => item.source === 'mygrowise').length);
        root.querySelector('[data-count="itransform"]').textContent = String(events.filter((item) => item.source === 'itransform').length);
        const next = active.find((item) => new Date(item.endsAt) > new Date());
        root.querySelector('[data-next]').textContent = next ? timeFormatter.format(new Date(next.startsAt)) : '—';
        root.querySelector('[data-next-detail]').textContent = next ? `${next.title} · ${longDateFormatter.format(new Date(next.startsAt))}` : 'Geen afspraak gepland';
      };
      const render = () => {
        if (view === 'month') { renderMonth(); return; }
        const visibleDays = days();
        const visible = events.filter((item) => (source === 'all' || item.source === source) && (!search || `${item.title} ${item.subtitle} ${item.location}`.toLowerCase().includes(search)) && visibleDays.some((day) => localDate(item.startsAt) === localDate(day)));
        const header = visibleDays.map((day) => `<div class="agenda-day-heading ${isSameDate(day, new Date()) ? 'is-today' : ''}"><span>${escape(dateFormatter.format(day).split(' ')[0])}</span><strong>${new Intl.DateTimeFormat('nl-BE', { timeZone: zone, day: 'numeric' }).format(day)}</strong></div>`).join('');
        const hourLabels = HOURS.map((hour) => `<span class="agenda-time-label" style="grid-row:${hour - 6}">${String(hour).padStart(2, '0')}:00</span>`).join('');
        const columns = visibleDays.map((day, index) => {
          const dayEvents = visible.filter((item) => localDate(item.startsAt) === localDate(day));
          const entries = dayEvents.map((item) => {
            const startParts = getTimeParts(item.startsAt); const endParts = getTimeParts(item.endsAt);
            const top = ((startParts.hour - 7) * 60 + startParts.minute) / 60 * 56;
            const duration = Math.max(28, (((endParts.hour - startParts.hour) * 60) + endParts.minute - startParts.minute) / 60 * 56 - 3);
            return `<button class="agenda-event agenda-event--${item.source} agenda-event--${item.kind}" style="top:${top}px;height:${duration}px" data-event-id="${escape(item.id)}" type="button"><span>${escape(item.title)}</span><small>${escape(timeFormatter.format(new Date(item.startsAt)))} · ${escape(item.subtitle)}</small></button>`;
          }).join('');
          return `<div class="agenda-day-column" style="grid-column:${index + 2}">${entries}</div>`;
        }).join('');
        calendar.className = `agenda-grid agenda-grid--${view}`;
        calendar.style.setProperty('--agenda-days', visibleDays.length);
        calendar.innerHTML = `<div class="agenda-grid__head"><div></div>${header}</div><div class="agenda-grid__body"><div class="agenda-time-axis">${hourLabels}</div>${columns}</div>`;
        range.textContent = view === 'day' ? longDateFormatter.format(start) : `${rangeFormatter.format(start)} – ${rangeFormatter.format(new Date(start.getTime() + 6 * 86400000))}`;
        updateStats();
      };
      const renderMonth = () => {
        const first = monthStart(start); const gridStart = weekStart(first); const visibleDays = Array.from({ length: 42 }, (_, index) => new Date(gridStart.getTime() + index * 86400000));
        const visible = events.filter((item) => (source === 'all' || item.source === source) && (!search || `${item.title} ${item.subtitle} ${item.location}`.toLowerCase().includes(search)));
        const headings = ['Ma', 'Di', 'Wo', 'Do', 'Vr', 'Za', 'Zo'].map((label) => `<div class="agenda-month-heading">${label}</div>`).join('');
        const cells = visibleDays.map((day) => { const dayKey = localDate(day); const dayEvents = visible.filter((item) => localDate(item.startsAt) === dayKey); const extra = dayEvents.length > 3 ? `<button type="button" class="agenda-month-more" data-month-day="${day.toISOString()}">+${dayEvents.length - 3} meer</button>` : ''; return `<section class="agenda-month-cell ${day.getMonth() !== first.getMonth() ? 'is-outside' : ''} ${isSameDate(day, new Date()) ? 'is-today' : ''}"><header><strong>${new Intl.DateTimeFormat('nl-BE', { timeZone: zone, day: 'numeric' }).format(day)}</strong><button type="button" data-month-day="${day.toISOString()}" aria-label="Moment toevoegen op ${escape(longDateFormatter.format(day))}">+</button></header><div>${dayEvents.slice(0, 3).map((item) => `<button class="agenda-month-event agenda-month-event--${item.source}" data-event-id="${escape(item.id)}" type="button"><span>${escape(timeFormatter.format(new Date(item.startsAt)))}</span>${escape(item.title)}</button>`).join('')}${extra}</div></section>`; }).join('');
        calendar.className = 'agenda-grid agenda-grid--month'; calendar.innerHTML = `<div class="agenda-month-grid">${headings}${cells}</div>`; range.textContent = new Intl.DateTimeFormat('nl-BE', { timeZone: zone, month: 'long', year: 'numeric' }).format(first); updateStats();
      };
      const load = async () => {
        calendar.setAttribute('aria-busy', 'true');
        const from = view === 'month' ? weekStart(monthStart(start)) : start;
        const end = view === 'month' ? new Date(from.getTime() + 42 * 86400000) : new Date(start.getTime() + (view === 'day' ? 86400000 : 7 * 86400000));
        try { const response = await fetch(`/api/admin/agenda?from=${encodeURIComponent(from.toISOString())}&to=${encodeURIComponent(end.toISOString())}`); const payload = await response.json(); if (!response.ok) throw new Error(payload.error); events = payload.events; render(); }
        catch { calendar.innerHTML = '<div class="agenda-load-error">De agenda kon niet worden geladen. Vernieuw de pagina om opnieuw te proberen.</div>'; }
        finally { calendar.removeAttribute('aria-busy'); }
      };
      const setViewState = () => { sourceButtons.forEach((item) => { const active = item.dataset.source === source; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); }); viewButtons.forEach((item) => { const active = item.dataset.view === view; item.classList.toggle('is-active', active); item.setAttribute('aria-pressed', String(active)); }); };
      sourceButtons.forEach((button) => button.addEventListener('click', () => { source = button.dataset.source; localStorage.setItem('mygrowise-agenda-source', source); setViewState(); render(); }));
      viewButtons.forEach((button) => button.addEventListener('click', () => { view = button.dataset.view; localStorage.setItem('mygrowise-agenda-view', view); if (view === 'week') start = weekStart(start); if (view === 'month') start = monthStart(start); setViewState(); load(); }));
      searchInput.addEventListener('input', () => { search = searchInput.value.trim().toLowerCase(); render(); });
      const movePeriod = (amount) => { if (view === 'month') start = new Date(start.getFullYear(), start.getMonth() + amount, 1); else start = new Date(start.getTime() + amount * (view === 'day' ? 1 : 7) * 86400000); load(); };
      root.querySelector('[data-prev]').addEventListener('click', () => movePeriod(-1));
      root.querySelector('[data-next]').addEventListener('click', () => movePeriod(1));
      root.querySelector('[data-today]').addEventListener('click', () => { start = view === 'day' ? new Date() : view === 'month' ? monthStart() : weekStart(); start.setHours(0, 0, 0, 0); load(); });
      const closeEvent = () => eventDialog.close(); const closeDetail = () => detailDialog.close();
      const openEventForm = (eventToEdit = null, selectedDay = start) => { const startValue = eventToEdit ? new Date(eventToEdit.startsAt) : new Date(selectedDay); const endValue = eventToEdit ? new Date(eventToEdit.endsAt) : new Date(startValue.getTime() + 3600000); if (!eventToEdit) startValue.setHours(9, 0, 0, 0); if (!eventToEdit) endValue.setHours(10, 0, 0, 0); form.reset(); form.elements.eventId.value = eventToEdit?.id || ''; form.elements.title.value = eventToEdit?.title || ''; form.elements.kind.value = eventToEdit?.kind || 'appointment'; form.elements.startsAt.value = inputDateTime(startValue); form.elements.endsAt.value = inputDateTime(endValue); form.elements.location.value = eventToEdit?.location || ''; root.querySelector('[data-event-form-title]').textContent = eventToEdit ? 'Moment bewerken' : 'Nieuw moment'; root.querySelector('[data-submit-label]').textContent = eventToEdit ? 'Wijzigingen opslaan' : 'Moment toevoegen'; error.hidden = true; eventDialog.showModal(); form.elements.title.focus(); };
      root.querySelector('[data-open-event]').addEventListener('click', () => openEventForm());
      root.querySelectorAll('[data-close-event]').forEach((button) => button.addEventListener('click', closeEvent)); root.querySelectorAll('[data-close-detail]').forEach((button) => button.addEventListener('click', closeDetail));
      const openDetail = (eventId) => { selected = events.find((item) => item.id === eventId); if (!selected) return; root.querySelector('[data-detail-source]').textContent = selected.source === 'mygrowise' ? 'MyGrowise' : 'Praktijk Itransform'; root.querySelector('[data-detail-title]').textContent = selected.title; root.querySelector('[data-detail-description]').textContent = selected.subtitle; root.querySelector('[data-detail-time]').textContent = `${longDateFormatter.format(new Date(selected.startsAt))} · ${timeFormatter.format(new Date(selected.startsAt))} – ${timeFormatter.format(new Date(selected.endsAt))}`; const location = root.querySelector('[data-detail-location]'); location.hidden = !selected.location; root.querySelector('[data-detail-location-text]').textContent = selected.location; root.querySelector('[data-detail-bookings]').hidden = selected.source !== 'mygrowise'; root.querySelector('[data-edit-event]').hidden = !selected.editable; root.querySelector('[data-delete-event]').hidden = !selected.editable; detailDialog.showModal(); };
      calendar.addEventListener('click', (event) => { const target = event.target.closest('[data-event-id]'); if (target) { openDetail(target.dataset.eventId); return; } const day = event.target.closest('[data-month-day]'); if (day) { const nextDay = new Date(day.dataset.monthDay); if (event.target.classList.contains('agenda-month-more')) { view = 'day'; start = nextDay; localStorage.setItem('mygrowise-agenda-view', view); setViewState(); load(); } else openEventForm(null, nextDay); } });
      root.querySelector('[data-edit-event]').addEventListener('click', () => { if (selected?.editable) { closeDetail(); openEventForm(selected); } });
      form.addEventListener('submit', async (event) => { event.preventDefault(); const data = new FormData(form); const button = form.querySelector('[type="submit"]'); const startsAt = new Date(data.get('startsAt')).toISOString(); const endsAt = new Date(data.get('endsAt')).toISOString(); const conflicting = events.filter((item) => item.id !== data.get('eventId') && new Date(item.startsAt) < new Date(endsAt) && new Date(item.endsAt) > new Date(startsAt)); if (conflicting.length && !confirm(`Dit moment overlapt met ${conflicting.length} item${conflicting.length === 1 ? '' : 's'} in de zichtbare agenda. Toch opslaan?`)) return; button.disabled = true; error.hidden = true; try { const id = String(data.get('eventId') || ''); const response = await fetch(id ? `/api/admin/agenda?id=${encodeURIComponent(id)}` : '/api/admin/agenda', { method: id ? 'PATCH' : 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ title: data.get('title'), kind: data.get('kind'), startsAt, endsAt, location: data.get('location') }) }); const payload = await response.json(); if (!response.ok) throw new Error(payload.error); closeEvent(); form.reset(); await load(); } catch (reason) { error.textContent = reason.message || 'Opslaan is niet gelukt.'; error.hidden = false; } finally { button.disabled = false; } });
      root.querySelector('[data-delete-event]').addEventListener('click', async () => { if (!selected || !selected.editable || !confirm(`Verwijder “${selected.title}” uit Praktijk Itransform?`)) return; const response = await fetch(`/api/admin/agenda?id=${encodeURIComponent(selected.id)}`, { method: 'DELETE' }); if (response.ok) { closeDetail(); await load(); } });
      eventDialog.addEventListener('click', (event) => { if (event.target === eventDialog) closeEvent(); }); detailDialog.addEventListener('click', (event) => { if (event.target === detailDialog) closeDetail(); });
      document.addEventListener('keydown', (event) => { if (event.metaKey || event.ctrlKey || event.altKey || eventDialog.open || detailDialog.open) return; if (event.key === '/' && document.activeElement !== searchInput) { event.preventDefault(); searchInput.focus(); } if (event.key.toLowerCase() === 'c' && document.activeElement?.tagName !== 'INPUT') { event.preventDefault(); openEventForm(); } if (event.key.toLowerCase() === 't') { event.preventDefault(); start = view === 'day' ? new Date() : view === 'month' ? monthStart() : weekStart(); start.setHours(0, 0, 0, 0); load(); } if (event.key === 'ArrowLeft' && document.activeElement?.tagName !== 'INPUT') movePeriod(-1); if (event.key === 'ArrowRight' && document.activeElement?.tagName !== 'INPUT') movePeriod(1); });
      setViewState(); if (view === 'month') start = monthStart(start); if (view !== 'week') load(); else render();
    })();
  </script>
</AdminLayout>
