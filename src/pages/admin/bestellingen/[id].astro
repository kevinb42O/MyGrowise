---
import {isEbook} from '../../../lib/ebooks/book';
import {hasPermission} from '../../../lib/adminAuth';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {getSupabaseAdmin} from '../../../lib/supabase/server';
import {money,isUuid} from '../../../lib/catalog/pricing';
import '../../../styles/catalog-admin.css';
if(!isUuid(Astro.params.id))return Astro.redirect('/admin/bestellingen');
const {data:order,error}=await getSupabaseAdmin().from('orders').select('id,status,total_cents,currency,provider,provider_reference,customer_user_id,contact_snapshot,commerce_buyers!orders_buyer_id_fkey(email,first_name,last_name),catalog_quote,created_at,payment_verified_at,order_items(id,product_title,product_type,product_slug,price_cents,list_price_cents,catalog_snapshot),profiles!orders_customer_user_id_fkey(full_name)').eq('id',Astro.params.id).maybeSingle();
if(error)throw new Error('Bestelling tijdelijk niet beschikbaar.');if(!order)return Astro.redirect('/admin/bestellingen');
const {data:paymentMails,error:mailError}=await getSupabaseAdmin().from('commerce_mail_jobs').select('status,sent_at,last_error').eq('order_id',order.id).eq('event','paid').eq('target','buyer');
const sentPaymentMail=paymentMails?.some(mail=>mail.status==='sent'&&mail.sent_at&&!mail.last_error);
const bookOnly=order.order_items.length===1&&isEbook(order.order_items[0]);
const customer=order.profiles as any;const buyer=order.commerce_buyers as any;const contact=order.contact_snapshot as any;const quote=order.catalog_quote as any;
Astro.response.headers.set('Cache-Control','private, no-store');
---
<AdminLayout title="Besteloverzicht"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">{order.provider_reference}</p><h1>Besteloverzicht</h1><p>{customer?.full_name||buyer?.email||'Gast'} · {order.status} · {new Intl.DateTimeFormat('nl-BE').format(new Date(order.created_at))}</p></div><div class="admin-page-actions"><a class="admin-button" href="/admin/bestellingen">Alle bestellingen</a>{order.customer_user_id?<a class="admin-button" href={`/admin/klanten/${order.customer_user_id}`}>Klant bekijken</a>:<span>Gastbestelling</span>}</div></section><section class="catalog-admin-section"><h2>Bestelcontact</h2><p>{contact?.email||buyer?.email}</p>{contact?.first_name&&<p>{bookOnly?'Besteller':'Deelnemer'}: {contact.first_name} {contact.last_name}{!bookOnly&&<> · {contact.birth_date} · {contact.gender} {contact.participant==='child'?'(ouder/verzorger bestelt)':''}</>}</p>}<h2>Directe digitale levering</h2>{contact?.digital_delivery_consent?<><p>Afzonderlijke toestemming en erkenning vastgelegd bij deze bestelling. Versie: {contact.digital_delivery_consent.revision}.</p><p>{contact.digital_delivery_consent.statement}</p><p>Dit geldt alleen voor de digitale inhoud waarvoor toestemming is gegeven. Controleer bij een herroepingsverzoek ook de aanvang van levering en de verzonden bestelbevestiging.</p></>:<p>Geen afzonderlijke toestemming en erkenning voor directe digitale levering vastgelegd. Ga niet automatisch uit van verval van het herroepingsrecht.</p>}{['paid','fulfilled'].includes(order.status)&&<section aria-label="Betaalbevestiging en e-mail"><h2>Betaling en toegang</h2><p>{order.payment_verified_at?'De handmatige betaalbevestiging is vastgelegd.':'Let op: er is geen handmatige betaalbevestiging vastgelegd. Het e-book blijft geblokkeerd.'}</p><p>{mailError?'De status van de bevestigingsmail is tijdelijk niet bereikbaar.':sentPaymentMail?'De bevestigingsmail is verzonden.':'De bevestigingsmail is nog niet als verzonden geregistreerd. De klant kan een nieuwe aankooplink aanvragen; controleer ook de mailwachtrij.'}</p>{!sentPaymentMail&&hasPermission(Astro.locals.adminUser,'integrations.read')&&<a class="admin-button" href="/admin/mail?queue=commerce_mail_jobs&status=pending">Controleer bevestigingsmails →</a>}</section>}<h2>Gekochte inhoud</h2><p>De prijzen en onderdelen hieronder zijn vastgelegd bij de bestelling. Latere cataloguswijzigingen passen deze aankoop niet aan.</p><div class="catalog-admin-scroll"><table class="catalog-admin-table"><thead><tr><th>Product</th><th>Oorspronkelijke prijs</th><th>Betaalbare prijs</th></tr></thead><tbody>{order.order_items.map((item:any)=><tr><td><strong>{item.product_title}</strong>{item.catalog_snapshot?.components?.length>0&&<small>{item.catalog_snapshot.components.map((c:any)=>c.title).join(' · ')}</small>}</td><td>{money(item.list_price_cents??item.price_cents)}</td><td>{money(item.price_cents)}</td></tr>)}</tbody></table></div>{quote&&<p>Subtotaal {money(quote.subtotalCents)} · combinatiekorting {quote.discountPercent}% ({money(quote.discountCents)})</p>}<h2 style="margin-top:1.5rem">Totaal {money(order.total_cents)}</h2>{order.status==='pending_payment'&&order.provider==='wise_manual'&&hasPermission(Astro.locals.adminUser,'orders.verify')&&<form method="post" action={`/api/admin/wise-reconciliation/${order.id}`}><p>Controleer de overschrijving op je bankrekening. Pas na deze bevestiging wordt betaalde inhoud vrijgegeven.</p><label class="payment-verification"><input type="checkbox" name="payment_received" value="confirmed" required/><span>Ik heb {money(order.total_cents)} met mededeling <strong>{order.provider_reference}</strong> op de bankrekening ontvangen en gecontroleerd.</span></label><button class="admin-button admin-button--primary">Bevestig ontvangen betaling</button></form>}{['paid','fulfilled'].includes(order.status)&&<>{order.order_items.some((i:any)=>['questionnaire','profile'].includes(i.product_type))&&<a class="admin-button admin-button--primary" href={`/admin/afnames?order=${order.id}`}>Beheer de afnames →</a>}{order.order_items.some((i:any)=>i.product_type==='module')&&<p>De modules zijn via de actieve aankooprechten beschikbaar via de beveiligde aankooptoegang van de klant.{hasPermission(Astro.locals.adminUser,'products.read')&&<> <a href="/admin/modules">Beheer modulemateriaal →</a></>}</p>}</>}</section></div></AdminLayout>

<style>
.payment-verification{display:flex;align-items:flex-start;gap:.75rem;max-width:65ch;line-height:1.7;margin:1rem 0;min-height:44px;padding:.5rem 0;cursor:pointer}.payment-verification input{width:20px;height:20px;flex-shrink:0;margin:.2rem 0;accent-color:var(--ink)}
</style>
