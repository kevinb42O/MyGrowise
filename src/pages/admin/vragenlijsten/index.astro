---
import {getSupabaseAdmin} from '../../../lib/supabase/server';
import {supportMailReady} from '../../../lib/supportMail';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {listCatalog,getPricing} from '../../../lib/catalog/server';
import {money} from '../../../lib/catalog/pricing';
import '../../../styles/catalog-admin.css';
const [all,pricing]=await Promise.all([listCatalog(true),getPricing()]);
const {data:mailRows}=await getSupabaseAdmin().from('commerce_mail_jobs').select('status,last_error').neq('status','sent');
const mailCount=mailRows?.length||0;
const mailFailed=mailRows?.filter(x=>x.status==='failed').length||0;
const q=(Astro.url.searchParams.get('q')||'').toLowerCase();const type=Astro.url.searchParams.get('type')||'';
const rows=all.filter(p=>(!type||p.type===type)&&(!q||`${p.title} ${p.category}`.toLowerCase().includes(q)));
---
<AdminLayout title="Vragenlijsten & profielen"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Volledig aanbodbeheer</p><h1>Vragenlijsten & profielen</h1><p>{all.filter(p=>p.type==='questionnaire').length} vragenlijsten · {all.filter(p=>p.type==='profile').length} profielen. Verkoopprijzen en interne kosten blijven gescheiden.</p></div><div class="admin-page-actions"><a class="admin-button admin-button--primary" href="/admin/vragenlijsten/nieuw">Nieuw aanbod +</a><a class="admin-button" href="/vragenlijsten" target="_blank">Website bekijken ↗</a></div></section>{Astro.url.searchParams.has('opgeslagen')&&<div class="catalog-admin-alert" role="status">Prijsstructuur opgeslagen.</div>}<section class="admin-panel"><form class="admin-filterbar"><input type="search" name="q" value={q} placeholder="Zoek een naam of thema" aria-label="Aanbod zoeken"/><select name="type" aria-label="Type"><option value="">Alle types</option><option value="questionnaire" selected={type==='questionnaire'}>Losse vragenlijsten</option><option value="profile" selected={type==='profile'}>Vaste profielen</option></select><button class="admin-button">Filteren</button></form><div class="catalog-admin-scroll"><table class="catalog-admin-table"><thead><tr><th>Aanbod</th><th>Status</th><th>Verkoop</th><th>Uitgever excl. btw</th><th>Inhoud</th><th>Beheer</th></tr></thead><tbody>{rows.map(p=><tr><td><strong>{p.title}</strong><small>{p.category} · {p.ageLabel}</small>{p.reviewNote&&<small>⚑ Professionele controlepunten aanwezig</small>}</td><td>{p.status}<small>{({available:'Beschikbaar',upcoming:'In ontwikkeling',paused:'Gepauzeerd'})[p.availability]}</small></td><td>{p.priceCents===null?'Onbekend':money(p.priceCents)}</td><td>{p.costCents===null?'Onbekend':money(p.costCents)}</td><td>{p.type==='profile'?`${p.components.length} onderdelen`:'Losse vragenlijst'}</td><td><a href={`/admin/vragenlijsten/${p.id}`}>Alles bewerken →</a></td></tr>)}</tbody></table></div></section><section class="catalog-admin-section" style="margin-top:2rem"><h2>Prijsstructuur voor eigen combinaties</h2><p>Vaste profielprijzen krijgen geen extra korting. De korting op losse vragenlijsten wordt toegepast op het totaal en eenmaal afgerond op eurocenten.</p><form method="post" action="/api/admin/catalog/pricing" class="catalog-admin-form"><div class="catalog-admin-grid"><label class="catalog-admin-field"><span>Eerste kortingsdrempel (aantal)</span><input type="number" name="mediumMin" min="2" max="29" required value={pricing.mediumMin}/></label><label class="catalog-admin-field"><span>Korting bij deze drempel (%)</span><input type="number" name="mediumPercent" min="0" max="99" required value={pricing.mediumPercent}/></label><label class="catalog-admin-field"><span>Tweede kortingsdrempel (aantal)</span><input type="number" name="largeMin" min="3" max="30" required value={pricing.largeMin}/></label><label class="catalog-admin-field"><span>Korting vanaf deze drempel (%)</span><input type="number" name="largePercent" min="0" max="99" required value={pricing.largePercent}/></label><label class="catalog-admin-field catalog-admin-wide"><span>Publiek prijslabel</span><input name="priceLabel" value={pricing.priceLabel} required maxlength="80"/><small>Gebruik pas een btw-vermelding nadat de fiscale behandeling bevestigd is.</small></label></div><button class="admin-button admin-button--primary" style="justify-self:start">Prijsstructuur opslaan</button></form></section><section class="catalog-admin-section" style="margin-top:2rem"><h2>Bestel- en afnamemeldingen</h2><p>{supportMailReady()?'SMTP is geconfigureerd. Klanten ontvangen een neutrale melding bij bestellen, bevestigde betaling en afname-updates.':'SMTP is nog niet geverifieerd in de bestaande mailconfiguratie. Meldingen blijven bewaard totdat verzending beschikbaar is.'}</p><p>{mailCount} meldingen wachten op verzending, waarvan {mailFailed} na meerdere pogingen zijn vastgelopen. Gewone verzending gebeurt meteen; de bestaande geplande mailtaak probeert resterende meldingen opnieuw.</p><form action="/api/admin/catalog/mail" method="post"><button class="admin-button">Wachtende meldingen verwerken / fouten opnieuw proberen</button></form></section></div></AdminLayout>
