---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { getAdminCustomer } from '../../../lib/superAdmin';
import { hasPermission } from '../../../lib/adminAuth';
const customer = await getAdminCustomer(Astro.params.id || '');
if (!customer) return Astro.redirect('/admin/klanten');
const canManagePrivacy = hasPermission(Astro.locals.adminUser, 'privacy.manage');
const money = (value: number, currency: string) => new Intl.NumberFormat('nl-BE', { style: 'currency', currency }).format(value / 100);
const date = (value: string) => new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));
const types: Record<string, string> = { access: 'Inzage', correction: 'Correctie', erasure: 'Verwijdering', portability: 'Overdraagbaarheid', objection: 'Bezwaar' };
---
<AdminLayout title={customer.name} description="Minimaal klantbeeld en privacyopvolging"><div class="admin-page"><a class="admin-back-link" href="/admin/klanten">← Terug naar klanten</a><section class="admin-page-heading"><div><p class="admin-eyebrow">Klantdetail</p><h1>{customer.name}</h1><p>{customer.email} · Account sinds {new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(customer.createdAt))} · {customer.timezone}</p></div></section><div class="admin-dashboard-grid"><section class="admin-panel"><header class="admin-panel__header"><div><h2>Bestellingen</h2><p>Financiële status wordt uitsluitend door providerwebhooks bepaald.</p></div></header>{customer.orders.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Datum</th><th>Producten</th><th>Status</th><th>Totaal</th></tr></thead><tbody>{customer.orders.map((order) => <tr><td>{date(order.createdAt)}</td><td>{order.items.length ? order.items.map((item) => <div><strong>{item.title}</strong><small>/{item.slug}</small></div>) : 'Geen orderregels'}</td><td><span class="admin-state">{order.status}</span></td><td>{money(order.totalCents, order.currency)}</td></tr>)}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="cart" size={17}/></span><strong>Geen bestellingen</strong></div></div>}</section><section class="admin-panel"><header class="admin-panel__header"><div><h2>Actieve toegang</h2><p>Geleverde digitale producten</p></div></header>{customer.entitlements.length ? <div class="practice-list">{customer.entitlements.map((item) => <div class="practice-list-row"><span class="admin-avatar"><AdminIcon name="products" size={15}/></span><span><strong>{item.title}</strong><small>Toegekend {date(item.grantedAt)}</small></span><span class="admin-state">{item.status}</span></div>)}</div> : <div class="admin-empty-row"><div><span><AdminIcon name="lock" size={17}/></span><strong>Geen toegang verleend</strong></div></div>}</section></div><div class="admin-dashboard-grid"><section class="admin-panel"><header class="admin-panel__header"><div><h2>Begeleiding</h2><p>Alleen operationele afspraakgegevens</p></div></header>{customer.bookings.length ? <div class="practice-list">{customer.bookings.map((booking) => <div class="practice-list-row"><span class="admin-avatar"><AdminIcon name="calendar" size={15}/></span><span><strong>{booking.practitionerName}</strong><small>{date(booking.startsAt)}</small></span><span class="admin-state">{booking.status}</span></div>)}</div> : <div class="admin-empty-row"><div><span><AdminIcon name="calendar" size={17}/></span><strong>Geen boekingen</strong></div></div>}</section><section class="admin-panel"><header class="admin-panel__header"><div><h2>AVG-verzoeken</h2><p>Status en deadline; geen gevoelige inhoud.</p></div></header>{canManagePrivacy && <form class="admin-inline-form" action="/api/admin/privacy" method="post"><input type="hidden" name="customer_user_id" value={customer.id}/><label><span class="sr-only">Type AVG-verzoek</span><select name="request_type">{Object.entries(types).map(([value, label]) => <option value={value}>{label}</option>)}</select></label><button class="admin-button" type="submit">Verzoek registreren</button></form>}{customer.privacyRequests.length ? <div class="analytics-quality">{customer.privacyRequests.map((request) => <div class="analytics-quality__row"><span>{types[request.type] || request.type}<small>Uiterlijk {new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(request.dueAt))}</small></span><span class="admin-state">{request.status}</span></div>)}</div> : <div class="admin-empty-row"><div><span><AdminIcon name="lock" size={17}/></span><strong>Geen AVG-verzoeken</strong></div></div>}</section></div></div></AdminLayout>
