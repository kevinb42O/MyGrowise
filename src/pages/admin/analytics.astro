---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminAnalytics } from '../../lib/adminAnalytics';

const ranges = [
  { key: '1d', label: '24 uur', days: 1, hourly: true },
  { key: '7d', label: '7 dagen', days: 7, hourly: false },
  { key: '30d', label: '30 dagen', days: 30, hourly: false },
  { key: '90d', label: '90 dagen', days: 90, hourly: false },
  { key: '365d', label: '12 maanden', days: 365, hourly: false },
];
const selectedRange = ranges.find((range) => range.key === Astro.url.searchParams.get('periode')) || ranges[1];
const metric = Astro.url.searchParams.get('grafiek') === 'pageviews' ? 'pageviews' : 'visitors';
const metricLabel = metric === 'pageviews' ? 'Paginaweergaven' : 'Unieke bezoekers';
const analytics = await getAdminAnalytics({ days: selectedRange.days, hourly: selectedRange.hourly });
const formatNumber = (value: number) => new Intl.NumberFormat('nl-BE').format(value);
const dateFormat = new Intl.DateTimeFormat('nl-BE', { timeZone: 'Europe/Brussels', day: 'numeric', month: 'short' });
const hourFormat = new Intl.DateTimeFormat('nl-BE', { timeZone: 'Europe/Brussels', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' });
const formatPoint = (timestamp: string) => (selectedRange.hourly ? hourFormat : dateFormat).format(new Date(timestamp));
const chartWidth = 960;
const chartHeight = 260;
const left = 43;
const right = 13;
const top = 13;
const bottom = 31;
const baseline = chartHeight - bottom;
const values = analytics.trend.map((point) => point[metric]);
const maxValue = Math.max(1, ...values);
const chartPoints = analytics.trend.map((point, index) => {
  const x = left + (analytics.trend.length === 1 ? 0 : index / (analytics.trend.length - 1) * (chartWidth - left - right));
  const y = top + (1 - point[metric] / maxValue) * (baseline - top);
  return { x: Number(x.toFixed(2)), y: Number(y.toFixed(2)), label: formatPoint(point.timestamp), value: point[metric] };
});
const line = chartPoints.map((point) => `${point.x},${point.y}`).join(' ');
const area = chartPoints.length ? `${left},${baseline} ${line} ${chartPoints[chartPoints.length - 1].x},${baseline}` : '';
const chartData = JSON.stringify(chartPoints);
const tickStep = Math.max(1, Math.ceil(analytics.trend.length / 6));
const ticks = analytics.trend.filter((_, index) => index === 0 || index === analytics.trend.length - 1 || index % tickStep === 0);
const periodUrl = (range: string) => `/admin/analytics?periode=${range}&grafiek=${metric}`;
const metricUrl = (next: string) => `/admin/analytics?periode=${selectedRange.key}&grafiek=${next}`;
---

<AdminLayout title="Websiteanalytics" description="Bezoekers en paginaweergaven van MyGrowise">
  <div class="admin-page analytics-simple">
    <header class="analytics-simple__head">
      <div><p class="admin-eyebrow">Website</p><h1>Analytics</h1><p>Bezoek aan de publieke website, met toestemming gemeten.</p></div>
      <div class="analytics-simple__updated">{analytics.lastEventAt ? `Laatste paginaweergave ${hourFormat.format(new Date(analytics.lastEventAt))}` : 'Nog geen paginaweergaven in deze periode'}</div>
    </header>

    <nav class="analytics-simple__period" aria-label="Periode">
      {ranges.map((range) => <a href={periodUrl(range.key)} class:list={{ 'is-active': range.key === selectedRange.key }} aria-current={range.key === selectedRange.key ? 'page' : undefined}>{range.label}</a>)}
    </nav>

    <section class="analytics-simple__stats" aria-label="Kerncijfers">
      <article><span>Unieke bezoekers</span><strong>{formatNumber(analytics.visitors)}</strong><small>Verschillende anonieme browsers in deze periode</small></article>
      <article><span>Paginaweergaven</span><strong>{formatNumber(analytics.pageviews)}</strong><small>Elke geladen publieke pagina met toestemming</small></article>
    </section>

    <section class="analytics-simple__panel" aria-labelledby="analytics-chart-title">
      <div class="analytics-simple__panel-head">
        <div><h2 id="analytics-chart-title">{metricLabel} doorheen de tijd</h2><p>Per {selectedRange.hourly ? 'uur' : 'dag'} · tijdzone Brussel</p></div>
        <nav class="analytics-simple__switch" aria-label="Grafiekcijfer">
          <a href={metricUrl('visitors')} class:list={{ 'is-active': metric === 'visitors' }} aria-current={metric === 'visitors' ? 'page' : undefined}>Bezoekers</a>
          <a href={metricUrl('pageviews')} class:list={{ 'is-active': metric === 'pageviews' }} aria-current={metric === 'pageviews' ? 'page' : undefined}>Paginaweergaven</a>
        </nav>
      </div>
      {analytics.pageviews ? <>
        <div class="analytics-simple__chart" data-analytics-chart data-points={chartData} data-unit={metric === 'pageviews' ? 'paginaweergaven' : 'bezoekers'}>
          <div class="analytics-simple__readout" data-chart-readout aria-live="off">Beweeg over de grafiek of gebruik de pijltjestoetsen voor een tijdvak.</div>
          <svg viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img" aria-label={`${metricLabel} per ${selectedRange.hourly ? 'uur' : 'dag'}`} preserveAspectRatio="none">
            {[0, .5, 1].map((ratio) => { const y = top + ratio * (baseline - top); return <g><line class="analytics-simple__grid" x1={left} x2={chartWidth - right} y1={y} y2={y}/><text x={left - 9} y={y + 4}>{formatNumber(Math.round(maxValue * (1 - ratio)))}</text></g>; })}
            <polygon points={area} class="analytics-simple__area"/><polyline points={line} class="analytics-simple__line"/>
            <line class="analytics-simple__guide" data-chart-guide x1="0" x2="0" y1={top} y2={baseline} style="display:none"/>
            <circle class="analytics-simple__dot" data-chart-dot cx="0" cy="0" r="5" style="display:none"/>
            <rect class="analytics-simple__capture" data-chart-capture x={left} y={top} width={chartWidth - left - right} height={baseline - top} tabindex="0" aria-label={`${metricLabel} grafiek. Gebruik links en rechts om tijdvakken te bekijken.`}/>
          </svg>
          <div class="analytics-simple__ticks">{ticks.map((point) => <span>{formatPoint(point.timestamp)}</span>)}</div>
        </div>
        {metric === 'visitors' && <p class="analytics-simple__note">Dezelfde bezoeker kan op meerdere dagen voorkomen. Het totaal hierboven telt die bezoeker één keer binnen de hele periode.</p>}
        <details class="analytics-simple__details"><summary>Bekijk cijfers per {selectedRange.hourly ? 'uur' : 'dag'}</summary><div>{analytics.trend.map((point) => <p><span>{formatPoint(point.timestamp)}</span><strong>{formatNumber(point[metric])} {metric === 'pageviews' ? 'paginaweergaven' : 'bezoekers'}</strong></p>)}</div></details>
      </> : <div class="analytics-simple__empty"><strong>Nog geen bezoekgegevens</strong><p>De grafiek verschijnt zodra een bezoeker toestemming geeft en een publieke pagina bekijkt.</p></div>}
    </section>

    {analytics.topPages.length > 0 && <section class="analytics-simple__panel analytics-simple__pages" aria-labelledby="top-pages-title">
      <div class="analytics-simple__panel-head"><div><h2 id="top-pages-title">Meest bekeken pagina’s</h2><p>Paginaweergaven binnen de gekozen periode</p></div></div>
      <ol>{analytics.topPages.map((page) => <li><span>{page.path}</span><strong>{formatNumber(page.views)}</strong></li>)}</ol>
    </section>}
  </div>
</AdminLayout>

<script is:inline>
  document.querySelectorAll('[data-analytics-chart]').forEach((chart) => {
    const points = JSON.parse(chart.dataset.points || '[]');
    const capture = chart.querySelector('[data-chart-capture]');
    const readout = chart.querySelector('[data-chart-readout]');
    const guide = chart.querySelector('[data-chart-guide]');
    const dot = chart.querySelector('[data-chart-dot]');
    if (!points.length || !capture || !readout || !guide || !dot) return;
    let activeIndex = -1;
    const show = (index) => {
      activeIndex = Math.max(0, Math.min(points.length - 1, index));
      const point = points[activeIndex];
      guide.setAttribute('x1', point.x);
      guide.setAttribute('x2', point.x);
      dot.setAttribute('cx', point.x);
      dot.setAttribute('cy', point.y);
      guide.style.display = '';
      dot.style.display = '';
      readout.textContent = `${point.label} · ${new Intl.NumberFormat('nl-BE').format(point.value)} ${chart.dataset.unit}`;
    };
    const hide = () => {
      if (document.activeElement === capture) return;
      activeIndex = -1;
      guide.style.display = 'none';
      dot.style.display = 'none';
      readout.textContent = 'Beweeg over de grafiek of gebruik de pijltjestoetsen voor een tijdvak.';
    };
    const showAtPointer = (event) => {
      const rect = capture.getBoundingClientRect();
      const position = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
      show(Math.round(position * (points.length - 1)));
    };
    capture.addEventListener('pointermove', showAtPointer);
    capture.addEventListener('pointerdown', showAtPointer);
    capture.addEventListener('pointerleave', hide);
    capture.addEventListener('focus', () => { readout.setAttribute('aria-live', 'polite'); show(activeIndex < 0 ? points.length - 1 : activeIndex); });
    capture.addEventListener('blur', () => { readout.setAttribute('aria-live', 'off'); hide(); });
    capture.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      if (event.key === 'Home') show(0);
      else if (event.key === 'End') show(points.length - 1);
      else show((activeIndex < 0 ? points.length - 1 : activeIndex) + (event.key === 'ArrowRight' ? 1 : -1));
    });
  });
</script>
