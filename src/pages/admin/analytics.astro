---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { getSuperadminOverview } from '../../lib/superAdmin';
import { getAdminAnalytics } from '../../lib/adminAnalytics';

const [overview, analytics] = await Promise.all([getSuperadminOverview(), getAdminAnalytics()]);

const metrics = [
  { label: 'Consented sessies', value: String(analytics.sessions), detail: 'First-party, laatste 30 dagen', icon: 'customers' },
  { label: 'Producten gepubliceerd', value: String(overview.publishedProducts), detail: 'Catalogus in Supabase', icon: 'products' },
  { label: 'Checkout gestart', value: String(analytics.checkoutStarted), detail: 'Nog geen betaalstatus afgeleid', icon: 'cart' },
  { label: 'Boeking geklikt', value: String(analytics.bookingClicks), detail: 'First-party event', icon: 'trend' },
];

const width = (value: number, base: number) => base ? Math.max(4, Math.round(value / base * 100)) : 0;
const commerceFunnel = [['Sessies', 100, String(analytics.self.sessions)], ['Route “zelf aan de slag”', width(analytics.self.route, analytics.self.sessions), String(analytics.self.route)], ['Product bekeken', width(analytics.self.product, analytics.self.sessions), String(analytics.self.product)], ['Checkout gestart', width(analytics.self.checkout, analytics.self.sessions), String(analytics.self.checkout)], ['Betaling geslaagd', 0, '—']];
const careFunnel = [['Sessies', 100, String(analytics.care.sessions)], ['Route “begeleiding”', width(analytics.care.route, analytics.care.sessions), String(analytics.care.route)], ['Professional bekeken', width(analytics.care.professional, analytics.care.sessions), String(analytics.care.professional)], ['Boeking geklikt', width(analytics.care.booking, analytics.care.sessions), String(analytics.care.booking)], ['Boeking bevestigd', 0, '—']];
---

<AdminLayout title="Analytics" description="Privacyvriendelijke groei- en conversieanalytics voor MyGrowise">
  <div class="admin-page">
    <section class="admin-page-heading" aria-labelledby="analytics-title">
      <div>
        <p class="admin-eyebrow">Groei & conversie</p>
        <h1 id="analytics-title">Analytics</h1>
        <p>Volg acquisitie, gedrag en conversie over beide klantroutes—zonder antwoorden, scores of therapeutische informatie te verzamelen.</p>
      </div>
      <div class="admin-page-actions">
        <a class="admin-button" href="/admin/instellingen"><AdminIcon name="content" size={16} /> Meetinstellingen</a>
      </div>
    </section>

    <div class="admin-preview-notice" role="status"><AdminIcon name="check" size={18} /><div><strong>First-party eventlaag actief</strong>Alleen na expliciete toestemming worden route- en conversie-events verzameld. Geen inhoud van berichten, profielen of gezondheidsinformatie.</div></div>

    <div class="analytics-toolbar">
      <nav class="analytics-tabs" aria-label="Analyticsweergaven">
        <a class="is-active" href="/admin/analytics" aria-current="page">Overzicht</a>
        <a href="/admin/analytics#acquisitie">Acquisitie</a>
        <a href="/admin/analytics#funnels">Funnels</a>
        <a href="/admin/analytics#content">Content</a>
        <a href="/admin/analytics#kwaliteit">Datakwaliteit</a>
      </nav>
      <label class="analytics-range">Periode <select><option>Laatste 30 dagen</option><option>Laatste 7 dagen</option><option>Laatste 90 dagen</option><option>Dit jaar</option></select></label>
    </div>

    <section class="admin-metrics" aria-label="Analytics kerncijfers">
      {metrics.map((metric) => (
        <article class="admin-metric">
          <div class="admin-metric__head"><span class="admin-metric__label">{metric.label}</span><span class="admin-metric__icon"><AdminIcon name={metric.icon} size={15} /></span></div>
          <strong>{metric.value}</strong><small class="status-waiting">{metric.detail}</small>
        </article>
      ))}
    </section>

    <section class="admin-panel" aria-labelledby="traffic-title">
      <header class="admin-panel__header"><div><h2 id="traffic-title">Sessies & conversie</h2><p>Dagelijkse trend voor de geselecteerde periode</p></div><span class="admin-state">{analytics.events} events</span></header>
      <div class="admin-chart">
        {analytics.trend.length ? <div class="analytics-trend">{analytics.trend.map((point) => <div title={`${point.date}: ${point.value} sessies`}><i style={`height:${Math.max(8, Math.round(point.value / Math.max(...analytics.trend.map((item) => item.value)) * 100))}%`}></i><small>{point.date.slice(5)}</small></div>)}</div> : <div class="admin-chart__empty"><div><span><AdminIcon name="analytics" size={18} /></span><strong>Nog geen consented sessies</strong><p>De meetlaag is actief; de grafiek vult zodra een bezoeker toestemming geeft.</p></div></div>}
      </div>
    </section>

    <div class="analytics-grid" id="funnels">
      <section class="admin-panel" aria-labelledby="self-funnel-title">
        <header class="admin-panel__header"><div><h2 id="self-funnel-title">Funnel · Zelf aan de slag</h2><p>Van eerste bezoek tot veilige digitale levering</p></div></header>
        <div class="analytics-funnel">
          {commerceFunnel.map(([label, width, value]) => (
            <div class="analytics-funnel__row"><span class="analytics-funnel__label">{label}</span><span class="analytics-funnel__bar"><i style={`width:${width}%`}></i></span><span class="analytics-funnel__value">{value}</span></div>
          ))}
        </div>
      </section>

      <section class="admin-panel" aria-labelledby="care-funnel-title">
        <header class="admin-panel__header"><div><h2 id="care-funnel-title">Funnel · Begeleiding</h2><p>Van oriëntatie tot externe boeking</p></div></header>
        <div class="analytics-funnel">
          {careFunnel.map(([label, width, value]) => (
            <div class="analytics-funnel__row"><span class="analytics-funnel__label">{label}</span><span class="analytics-funnel__bar"><i style={`width:${width}%`}></i></span><span class="analytics-funnel__value">{value}</span></div>
          ))}
        </div>
      </section>

      <section class="admin-panel" aria-labelledby="privacy-title">
        <header class="admin-panel__header"><div><h2 id="privacy-title">Privacygrens</h2><p>Wat analytics expliciet nooit registreert</p></div></header>
        <div class="analytics-privacy"><span><AdminIcon name="heart" size={17} /></span><div><h3>Commerciële events, geen gezondheidsdossier</h3><p>Geen antwoorden, vragenlijstscores, vermoedelijke diagnoses, intakegegevens, berichtinhoud of sessienotities. Producten krijgen neutrale interne ID’s; rapportages zijn geaggregeerd.</p></div></div>
      </section>

      <section class="admin-panel" id="kwaliteit" aria-labelledby="quality-title">
        <header class="admin-panel__header"><div><h2 id="quality-title">Datakwaliteit</h2><p>Voorwaarden voordat cijfers beslissingen mogen sturen</p></div></header>
        <div class="analytics-quality">
          <div class="analytics-quality__row"><span>Consent & cookiestatus</span><span class="admin-state">Actief</span></div>
          <div class="analytics-quality__row"><span>First-party route-events</span><span class="admin-state">Actief</span></div>
          <div class="analytics-quality__row"><span>Checkout-events gevalideerd</span><span class="admin-state admin-state--blocked">Volgende stap</span></div>
          <div class="analytics-quality__row"><span>Laatste event ontvangen</span><small>{analytics.lastEventAt ? new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(analytics.lastEventAt)) : 'Nog geen'}</small></div>
        </div>
      </section>
    </div>

    <div class="admin-lock-note"><strong>Definitiekeuze:</strong> “Boeking bevestigd” verschijnt alleen wanneer de gekozen afsprakenprovider dit via een betrouwbare webhook terugkoppelt. Tot dan rapporteren we uitsluitend de aantoonbare klik naar de externe boekingsflow.</div>
  </div>
</AdminLayout>
