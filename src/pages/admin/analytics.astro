---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AnalyticsIsland from '../../components/admin/AnalyticsIsland.astro';

const ranges = [
  { key: '1d', label: '24 uur' },
  { key: '7d', label: '7 dagen' },
  { key: '30d', label: '30 dagen' },
  { key: '90d', label: '90 dagen' },
  { key: '365d', label: '12 maanden' },
];
const period = ranges.find((range) => range.key === Astro.url.searchParams.get('periode'))?.key || '7d';
const metric = Astro.url.searchParams.get('grafiek') === 'pageviews' ? 'pageviews' : 'visitors';
---
<AdminLayout title="Websiteanalytics" description="Bezoekers, paginaweergaven en landen van MyGrowise">
  <AnalyticsIsland server:defer period={period} metric={metric}>
    <div slot="fallback" class="admin-page analytics-studio" aria-busy="true">
      <header class="analytics-studio__heading"><h1>Website in cijfers</h1><small>Gegevens laden…</small></header>
      <div class="analytics-studio__toolbar"><span>Periode</span><nav aria-label="Periode">{ranges.map((range) => <a href={`/admin/analytics?periode=${range.key}&grafiek=${metric}`} class:list={{ 'is-active': range.key === period }} aria-current={range.key === period ? 'page' : undefined}>{range.label}</a>)}</nav></div>
      <p class="admin-loading-label" role="status">Analytics laden…</p>
      <section class="analytics-studio__stats" aria-label="Kerncijfers laden">{Array.from({ length: 2 }, () => <article class="analytics-studio__stat admin-skeleton-card"><span class="admin-skeleton-line"></span><span class="admin-skeleton-number"></span><span class="admin-skeleton-line admin-skeleton-line--short"></span></article>)}</section>
      <section class="analytics-studio__panel analytics-studio__trend admin-skeleton-panel" aria-label="Verloopgrafiek laden"><span class="admin-skeleton-line"></span><div class="admin-skeleton-chart"></div></section>
      <div class="analytics-studio__lower">{Array.from({ length: 2 }, () => <section class="analytics-studio__panel admin-skeleton-panel" aria-label="Analyticsgegevens laden"><span class="admin-skeleton-line"></span><span class="admin-skeleton-line"></span><span class="admin-skeleton-line admin-skeleton-line--short"></span></section>)}</div>
    </div>
  </AnalyticsIsland>
  <script is:inline>
    const initAnalyticsCharts = () => {
    document.querySelectorAll('[data-country-chart]').forEach((chart) => {
      if (chart.dataset.chartInitialized) return;
      chart.dataset.chartInitialized = 'true';
      if (!chart.querySelector('.analytics-studio__country-slice')) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      const observer = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        chart.classList.add('is-visible');
        observer.disconnect();
      }, { threshold: 0.3 });
      observer.observe(chart);
    });
    document.querySelectorAll('[data-analytics-chart]').forEach((chart) => {
      if (chart.dataset.chartInitialized) return;
      chart.dataset.chartInitialized = 'true';
      const points = JSON.parse(chart.dataset.points || '[]');
      const capture = chart.querySelector('[data-chart-capture]');
      const plot = chart.querySelector('.analytics-studio__plot');
      const tooltip = chart.querySelector('[data-chart-tooltip]');
      const label = chart.querySelector('[data-tooltip-label]');
      const value = chart.querySelector('[data-tooltip-value]');
      const status = chart.querySelector('[data-chart-status]');
      const guide = chart.querySelector('[data-chart-guide]');
      const dot = chart.querySelector('[data-chart-dot]');
      if (!points.length || !capture || !plot || !tooltip || !label || !value || !status || !guide || !dot) return;
      let activeIndex = -1;
      let keyboardMode = false;
      let pointerFocusing = false;
      const show = (index, clientX, clientY) => {
        activeIndex = Math.max(0, Math.min(points.length - 1, index));
        const point = points[activeIndex];
        guide.setAttribute('x1', point.x);
        guide.setAttribute('x2', point.x);
        dot.setAttribute('cx', point.x);
        dot.setAttribute('cy', point.y);
        guide.style.display = '';
        dot.style.display = '';
        label.textContent = point.label;
        value.textContent = `${new Intl.NumberFormat('nl-BE').format(point.value)} ${chart.dataset.unit}`;
        status.textContent = `${point.label}: ${value.textContent}`;
        tooltip.hidden = false;
        const rect = plot.getBoundingClientRect();
        const x = clientX === undefined ? point.x / 960 * rect.width : clientX - rect.left;
        const y = clientY === undefined ? point.y / 260 * rect.height : clientY - rect.top;
        const width = tooltip.offsetWidth;
        const height = tooltip.offsetHeight;
        tooltip.style.left = `${Math.max(8, Math.min(rect.width - width - 8, x + 14))}px`;
        tooltip.style.top = `${y - height - 14 < 8 ? Math.min(rect.height - height - 8, y + 18) : y - height - 14}px`;
      };
      const hide = () => {
        if (keyboardMode) return;
        activeIndex = -1;
        guide.style.display = 'none';
        dot.style.display = 'none';
        tooltip.hidden = true;
      };
      const showAtPointer = (event) => {
        const rect = capture.getBoundingClientRect();
        const position = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        show(Math.round(position * (points.length - 1)), event.clientX, event.clientY);
      };
      capture.addEventListener('pointermove', (event) => { keyboardMode = false; showAtPointer(event); });
      capture.addEventListener('pointerdown', (event) => { pointerFocusing = true; keyboardMode = event.pointerType !== 'mouse'; showAtPointer(event); });
      capture.addEventListener('pointerleave', hide);
      capture.addEventListener('focus', () => {
        if (pointerFocusing) { pointerFocusing = false; return; }
        keyboardMode = true;
        status.setAttribute('aria-live', 'polite');
        show(activeIndex < 0 ? points.length - 1 : activeIndex);
      });
      capture.addEventListener('blur', () => {
        keyboardMode = false;
        status.setAttribute('aria-live', 'off');
        hide();
      });
      capture.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        keyboardMode = true;
        status.setAttribute('aria-live', 'polite');
        if (event.key === 'Home') show(0);
        else if (event.key === 'End') show(points.length - 1);
        else show((activeIndex < 0 ? points.length - 1 : activeIndex) + (event.key === 'ArrowRight' ? 1 : -1));
      });
    });
    };
    initAnalyticsCharts();
    const analyticsRoot = document.querySelector('.admin-main');
    if (analyticsRoot) new MutationObserver(initAnalyticsCharts).observe(analyticsRoot, { childList: true, subtree: true });
  </script>
</AdminLayout>
