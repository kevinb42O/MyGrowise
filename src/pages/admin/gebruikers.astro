---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAdminUsers, STAFF_ROLES } from '../../lib/adminUsers';
import { hasPermission } from '../../lib/adminAuth';

const allUsers = await listAdminUsers();
const users = allUsers.filter((user) => user.roles.some((role) => STAFF_ROLES.includes(role as typeof STAFF_ROLES[number])));
const message = Astro.url.searchParams.get('message') || '';
const alerts: Record<string, string> = {
  created: 'Account aangemaakt. Deel het tijdelijke wachtwoord via een veilig kanaal.',
  role_changed: 'Rol gewijzigd en geaudit.',
  suspended: 'Toegang is ingetrokken en geaudit.', reactivated: 'Toegang is hersteld en geaudit.',
  email_taken: 'Dit e-mailadres heeft al een account.', invalid_input: 'Controleer naam, rol en tijdelijk wachtwoord.',
  create_failed: 'Account kon niet worden aangemaakt.', role_failed: 'De rol kon niet worden gewijzigd. Controleer het auditlog.',
  access_failed: 'De toegang kon niet worden aangepast.', self_change_forbidden: 'Je kan je eigen toegang niet vanuit deze sessie wijzigen.',
  last_owner_protected: 'De laatste superadmin kan niet worden gedegradeerd of geschorst.', not_staff: 'Dit account is geen medewerker.', not_found: 'Account niet gevonden.',
};
const labels: Record<typeof STAFF_ROLES[number], string> = { super_admin: 'Superadmin', support: 'Support', employee: 'Medewerker' };
const canManage = hasPermission(Astro.locals.adminUser, 'users.manage');
---

<AdminLayout title="Team & toegang" description="Beheer de drie MyGrowise-rollen en hun toegang">
  <div class="admin-page admin-page--form">
    <a class="admin-back-link" href="/admin/instellingen">← Terug naar instellingen</a>
    <section class="admin-page-heading"><div><p class="admin-eyebrow">Organisatie</p><h1>Team & toegang</h1><p>Drie duidelijke rollen, zonder verborgen beheerlagen. Professionals behouden alleen de toegang die ze voor hun eigen praktijk nodig hebben.</p></div></section>
    {alerts[message] && <div class:list={['admin-login__alert', message === 'created' ? 'admin-login__alert--success' : 'admin-login__alert--error']} role="status"><AdminIcon name={message === 'created' ? 'check' : 'warning'} size={17}/>{alerts[message]}</div>}

    <section class="team-role-guide" aria-label="Rolverdeling">
      <article><span><AdminIcon name="lock" size={17}/></span><div><strong>Superadmin</strong><p>Volledig organisatiebeheer en eindverantwoordelijkheid.</p></div></article>
      <article><span><AdminIcon name="settings" size={17}/></span><div><strong>Support</strong><p>Technische en operationele ondersteuning, zonder eigenaarschap.</p></div></article>
      <article><span><AdminIcon name="professionals" size={17}/></span><div><strong>Medewerker</strong><p>Toegang tot toegewezen cliëntendossiers, verslagen en interne teamcommunicatie.</p></div></article>
    </section>

    {canManage && <section class="admin-panel admin-form-panel team-create-panel">
      <header class="admin-panel__header"><div><h2>Account toevoegen</h2><p>Er wordt een bevestigd Supabase Auth-account gemaakt; er vertrekt geen e-mail.</p></div></header>
      <form class="team-create-form" method="post" action="/api/admin/users">
        <input type="hidden" name="operation" value="create"/>
        <label><span>Naam</span><input name="full_name" required minlength="2" maxlength="120" autocomplete="name" placeholder="Voor- en achternaam"/></label>
        <label><span>Werk e-mail</span><input name="email" type="email" required maxlength="254" autocomplete="email" placeholder="naam@mygrowise.com"/></label>
        <label><span>Rol</span><select name="role" required>{STAFF_ROLES.map((role) => <option value={role}>{labels[role]}</option>)}</select></label>
        <label><span>Tijdelijk wachtwoord</span><input name="temporary_password" type="password" required minlength="12" maxlength="256" autocomplete="new-password"/><small>Wordt hier nooit bewaard.</small></label>
        <footer><p><AdminIcon name="lock" size={14}/> Deel het tijdelijke wachtwoord uitsluitend via een veilig kanaal.</p><button class="admin-button admin-button--primary" type="submit"><AdminIcon name="plus" size={16}/> Account aanmaken</button></footer>
      </form>
    </section>}

    <section class="admin-panel admin-activity team-table-panel">
      <header class="admin-panel__header"><div><h2>Teamaccounts</h2><p>{users.length} actief account{users.length === 1 ? '' : 's'} met een organisatierol</p></div></header>
      {users.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Medewerker</th><th>Rol</th><th>Toegang</th><th>Bevestigd</th><th>Laatste login</th>{canManage && <th><span class="sr-only">Acties</span></th>}</tr></thead><tbody>{users.map((user) => {
        const role = STAFF_ROLES.find((candidate) => user.roles.includes(candidate));
        const suspended = Boolean(user.suspendedUntil && new Date(user.suspendedUntil).getTime() > Date.now());
        return <tr><td data-label="Medewerker"><strong>{user.fullName || user.email}</strong><small>{user.email}</small></td><td data-label="Rol">{role ? <span class="admin-state">{labels[role]}</span> : <span class="admin-state admin-state--blocked">Geen organisatierol</span>}</td><td data-label="Toegang"><span class:list={['admin-state', suspended && 'admin-state--blocked']}>{suspended ? 'Geschorst' : 'Actief'}</span></td><td data-label="Bevestigd">{user.confirmed ? 'Ja' : 'Nee'}</td><td data-label="Laatste login">{user.lastSignInAt ? <time datetime={user.lastSignInAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(user.lastSignInAt))}</time> : 'Nog nooit'}</td>{canManage && <td data-label="Acties"><div class="admin-table-actions"><form method="post" action="/api/admin/users"><input type="hidden" name="operation" value="change_role"/><input type="hidden" name="user_id" value={user.id}/><select name="role" aria-label={`Rol voor ${user.email}`}>{STAFF_ROLES.map((candidate) => <option value={candidate} selected={candidate === role}>{labels[candidate]}</option>)}</select><button class="admin-button" type="submit">Opslaan</button></form><form method="post" action="/api/admin/users"><input type="hidden" name="operation" value="set_access"/><input type="hidden" name="user_id" value={user.id}/><input type="hidden" name="suspended" value={suspended ? 'false' : 'true'}/><button class:list={['admin-button', suspended && 'admin-button--primary']} type="submit">{suspended ? 'Heractiveer' : 'Schors'}</button></form></div></td>}</tr>;
      })}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="customers" size={17}/></span><strong>Nog geen teamaccounts</strong><p>Maak je eerste medewerker aan om toegang zorgvuldig te verdelen.</p></div></div>}
    </section>
  </div>
</AdminLayout>
