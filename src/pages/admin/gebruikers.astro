---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAdminUsers, STAFF_ROLES } from '../../lib/adminUsers';

const users = await listAdminUsers();
const message = Astro.url.searchParams.get('message') || '';
const alerts: Record<string, string> = { created: 'Medewerker aangemaakt. Deel het tijdelijke wachtwoord via een veilig kanaal.', email_taken: 'Dit e-mailadres heeft al een account.', invalid_input: 'Controleer naam, rol en tijdelijk wachtwoord.', create_failed: 'Account kon niet worden aangemaakt.', role_failed: 'Account is aangemaakt maar de rol kon niet worden toegekend. Controleer het auditlog.' };
const labels: Record<string, string> = { super_admin: 'Superadmin', admin: 'Beheerder', content_editor: 'Contentredacteur', clinical_reviewer: 'Klinisch reviewer', support: 'Support', analyst: 'Analist', practitioner: 'Professional', customer: 'Klant' };
---
<AdminLayout title="Gebruikers & rollen" description="Beheer Supabase Auth-stafaccounts met minimale rechten">
  <div class="admin-page"><a class="admin-back-link" href="/admin/instellingen">← Terug naar instellingen</a><section class="admin-page-heading"><div><p class="admin-eyebrow">Organisatie</p><h1>Gebruikers & rollen</h1><p>Nieuwe stafaccounts starten met één expliciete rol. Geef alleen de toegang die nodig is; verander nooit rollen via de browser zonder audittrail.</p></div></section>
  {alerts[message] && <div class:list={['admin-login__alert', message === 'created' ? 'admin-login__alert--success' : 'admin-login__alert--error']} role="status"><AdminIcon name={message === 'created' ? 'check' : 'warning'} size={17}/>{alerts[message]}</div>}
  <div class="admin-edit-grid"><section class="admin-panel admin-form-panel"><header class="admin-panel__header"><div><h2>Stafaccount toevoegen</h2><p>Maakt een bevestigd Supabase Auth-account aan, maar verstuurt geen e-mail.</p></div></header><form class="admin-product-form" method="post" action="/api/admin/users"><label><span>Naam *</span><input name="full_name" required minlength="2" maxlength="120" autocomplete="name"/></label><label><span>E-mail *</span><input name="email" type="email" required maxlength="254" autocomplete="email"/></label><label><span>Rol *</span><select name="role" required>{STAFF_ROLES.map((role) => <option value={role}>{labels[role]}</option>)}</select></label><label><span>Tijdelijk wachtwoord *</span><input name="temporary_password" type="password" required minlength="12" maxlength="256" autocomplete="new-password"/><small>Deel dit éénmalig via een veilig kanaal. Dit scherm bewaart het niet.</small></label><button class="admin-button admin-button--primary" type="submit"><AdminIcon name="plus" size={16}/> Account aanmaken</button></form></section>
  <aside class="admin-panel admin-product-aside"><header class="admin-panel__header"><div><h2>Ingebruikname</h2><p>Veilige volgorde</p></div></header><dl><div><dt>1</dt><dd>Maak het account met de minimale rol.</dd></div><div><dt>2</dt><dd>Deel het tijdelijke wachtwoord veilig.</dd></div><div><dt>3</dt><dd>Laat de gebruiker inloggen en wijzigen.</dd></div><div><dt>4</dt><dd>Schakel pas dan de Supabase Auth-admin-login in.</dd></div></dl></aside></div>
  <section class="admin-panel admin-activity"><header class="admin-panel__header"><div><h2>Supabase Auth-accounts</h2><p>{users.length} account{users.length === 1 ? '' : 's'}</p></div></header>{users.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Gebruiker</th><th>Rollen</th><th>Bevestigd</th><th>Laatste login</th></tr></thead><tbody>{users.map((user) => <tr><td data-label="Gebruiker"><strong>{user.fullName || user.email}</strong><small>{user.email}</small></td><td data-label="Rollen">{user.roles.length ? user.roles.map((role) => <span class="admin-state">{labels[role] || role}</span>) : <span class="admin-state admin-state--blocked">Geen app-rol</span>}</td><td data-label="Bevestigd">{user.confirmed ? 'Ja' : 'Nee'}</td><td data-label="Laatste login">{user.lastSignInAt ? <time datetime={user.lastSignInAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(user.lastSignInAt))}</time> : 'Nog nooit'}</td></tr>)}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="customers" size={17}/></span><strong>Nog geen Supabase Auth-stafaccounts</strong><p>Maak eerst de eigenaar aan; de bestaande lokale beheerlogin blijft actief totdat de auth-cutover is afgerond.</p></div></div>}</section></div>
</AdminLayout>
