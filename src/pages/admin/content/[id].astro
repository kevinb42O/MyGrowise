---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ContentForm from '../../../components/admin/ContentForm.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { getContent, listContentVersions } from '../../../lib/adminContent';
import { hasPermission } from '../../../lib/adminAuth';
const content = await getContent(Astro.params.id || '');
if (!content) return Astro.redirect('/admin/content');
const versions = await listContentVersions(content.id);
const canWrite = hasPermission(Astro.locals.adminUser, 'content.write');
const canPublish = hasPermission(Astro.locals.adminUser, 'content.publish');
const canEdit = canWrite && (canPublish || content.status !== 'published');
const saved = Astro.url.searchParams.get('saved') === '1'; const created = Astro.url.searchParams.get('created') === '1'; const error = Astro.url.searchParams.get('error') || '';
---
<AdminLayout title={content.title} description={`Bewerk ${content.title}`}><div class="admin-page admin-page--form"><a class="admin-back-link" href="/admin/content">← Terug naar website & blogs</a><section class="admin-page-heading"><div><p class="admin-eyebrow">{content.kind === 'article' ? 'Artikel' : 'Pagina'}</p><h1>{content.title}</h1><p>Versies worden automatisch vastgelegd bij elke opgeslagen wijziging.</p></div><div class="admin-page-actions"><a class="admin-button" href={`/admin/content/${content.id}/preview`} target="_blank" rel="noreferrer"><AdminIcon name="external" size={16}/> Veilige preview</a><span class={`admin-product-status admin-product-status--${content.status}`}><i></i>{content.status}</span></div></section>{(saved || created) && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/>{created ? 'Content aangemaakt.' : 'Wijzigingen opgeslagen als nieuwe versie.'}</div>}<div class="admin-edit-grid"><section class="admin-panel admin-form-panel">{canEdit ? <ContentForm content={content} action={`/api/admin/content/${content.id}`} canPublish={canPublish} error={error}/> : <div class="admin-empty-row"><div><span><AdminIcon name="lock" size={17}/></span><strong>Alleen-lezen</strong><p>{canWrite ? 'Een gepubliceerde versie blijft beschermd totdat een bevoegde publicatierol de wijziging beheert.' : 'Jouw rol mag deze content bekijken, maar niet wijzigen.'}</p></div></div>}</section><aside class="admin-panel admin-product-aside"><header class="admin-panel__header"><div><h2>Versiegeschiedenis</h2><p>Laatste {versions.length} versie{versions.length === 1 ? '' : 's'}</p></div></header>{versions.length ? <ol class="admin-setup-list">{versions.map((version) => <li><span class="admin-setup-list__number">v{version.versionNumber}</span><span><strong>{version.status}</strong><small>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(version.createdAt))}</small></span></li>)}</ol> : <p>Nog geen versies.</p>}<div class="admin-product-aside__note"><AdminIcon name="lock" size={16}/><p><strong>Preview is intern.</strong> Ongepubliceerde content krijgt geen publieke route of indexering.</p></div></aside></div></div></AdminLayout>
