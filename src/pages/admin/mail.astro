---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminMailWorkspace from '../../components/admin/AdminMailWorkspace.astro';
import {websiteMailReady} from '../../lib/commerce/websiteMail';
import {getAdminMailCounts, getAdminMailPage} from '../../lib/adminMail';
const [counts,result]=await Promise.all([
 getAdminMailCounts(),
 getAdminMailPage(Astro.url.searchParams.get('queue')||'',Astro.url.searchParams.get('status')||'sent',Astro.url.searchParams.get('pagina')),
]);
Astro.response.headers.set('Cache-Control','private, no-store');
---
<AdminLayout title="Mailopvolging"><AdminMailWorkspace counts={counts} result={result} ready={websiteMailReady()} processed={Astro.url.searchParams.has('processed')} processingError={Astro.url.searchParams.has('error')}/></AdminLayout>
