---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {listDeliveries,deliveryStatusLabel} from '../../../lib/catalog/server';
import '../../../styles/catalog-admin.css';
const items=await listDeliveries();const status=Astro.url.searchParams.get('status')||'';const order=Astro.url.searchParams.get('order')||'';const filtered=items.filter(x=>(!status||x.status===status)&&(!order||x.order_items.order_id===order));
---
<AdminLayout title="Afnames & rapporten"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Na betaling</p><h1>Afnames & rapporten</h1><p>Na bevestiging van betaling verschijnt elk gekocht onderdeel automatisch. Beheer instructies, afnamelinks, voortgang en veilige rapportlevering.</p></div></section><section class="admin-panel"><form class="admin-filterbar"><input type="hidden" name="order" value={order}/><select name="status" aria-label="Afnamestatus"><option value="">Alle statussen</option>{Object.entries(deliveryStatusLabel).map(([v,l])=><option value={v} selected={status===v}>{l}</option>)}</select><button class="admin-button">Filteren</button></form><div class="catalog-admin-scroll"><table class="catalog-admin-table"><thead><tr><th>Afname</th><th>Bestelling</th><th>Status</th><th>Rapport</th><th>Beheer</th></tr></thead><tbody>{filtered.map(x=><tr><td><strong>{x.title}</strong><small>{x.order_items.product_title}</small><a href={`/admin/klanten/${x.customer_user_id}`}>Klant bekijken</a></td><td>{x.order_items.orders.provider_reference}<small>{x.order_items.orders.status}</small></td><td>{deliveryStatusLabel[x.status]}</td><td>{x.report_path?'Beschikbaar':'Nog geen rapport'}</td><td><a href={`/admin/afnames/${x.id}`}>Open afname →</a></td></tr>)}</tbody></table>{!items.length&&<p style="padding:2rem">Nog geen afnames. Bevestig eerst een ontvangen betaling bij Bestellingen.</p>}</div></section></div></AdminLayout>
