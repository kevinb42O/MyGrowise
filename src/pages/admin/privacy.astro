---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listDataSubjectRequests } from '../../lib/superAdmin';
import { hasPermission } from '../../lib/adminAuth';
const requests = await listDataSubjectRequests();
const labels: Record<string, string> = { access: 'Inzage', correction: 'Correctie', erasure: 'Verwijdering', portability: 'Overdraagbaarheid', objection: 'Bezwaar', received: 'Ontvangen', in_progress: 'In behandeling', resolved: 'Afgerond', rejected: 'Afgewezen' };
const canManage = hasPermission(Astro.locals.adminUser, 'privacy.manage');
const message = Astro.url.searchParams.get('message');
---
<AdminLayout title="Privacy & retentie" description="AVG-verzoeken en minimale operationele opvolging">
  <div class="admin-page"><a class="admin-back-link" href="/admin/instellingen">← Terug naar instellingen</a><section class="admin-page-heading"><div><p class="admin-eyebrow">Organisatie</p><h1>Privacy & retentie</h1><p>AVG-verzoeken worden als minimale operationele records gevolgd. Gevoelige inhoud, diagnoses en sessienotities worden hier nooit opgeslagen.</p></div></section>
  <section class="admin-catalog-stats"><article><span>Open verzoeken</span><strong>{requests.filter((request) => ['received', 'in_progress'].includes(request.status)).length}</strong></article><article><span>Bijna vervallen</span><strong>{requests.filter((request) => ['received', 'in_progress'].includes(request.status) && new Date(request.dueAt).getTime() < Date.now() + 7 * 86400000).length}</strong></article><article><span>Afgerond</span><strong>{requests.filter((request) => request.status === 'resolved').length}</strong></article><article><span>Bewaartermijn</span><strong>30 d.</strong></article></section>
  {message === 'updated' && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/> Privacyverzoek bijgewerkt en geaudit.</div>}<section class="admin-panel">{requests.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Type</th><th>Ontvangen</th><th>Uiterlijk</th><th>Status</th><th>Referentie</th>{canManage && <th><span class="sr-only">Actie</span></th>}</tr></thead><tbody>{requests.map((request) => <tr><td data-label="Type"><strong>{labels[request.type] || request.type}</strong></td><td data-label="Ontvangen"><time datetime={request.receivedAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(request.receivedAt))}</time></td><td data-label="Uiterlijk"><time datetime={request.dueAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(request.dueAt))}</time></td><td data-label="Status"><span class={`admin-product-status admin-product-status--${request.status === 'resolved' ? 'published' : 'draft'}`}><i></i>{labels[request.status] || request.status}</span></td><td data-label="Referentie"><code>{request.id.slice(0, 8)}…</code></td>{canManage && <td data-label="Actie"><form class="admin-inline-form" method="post" action={`/api/admin/privacy/${request.id}`}><select name="status" aria-label={`Status voor verzoek ${request.id}`}><option value="received" selected={request.status === 'received'}>Ontvangen</option><option value="in_progress" selected={request.status === 'in_progress'}>In behandeling</option><option value="resolved" selected={request.status === 'resolved'}>Afronden</option><option value="rejected" selected={request.status === 'rejected'}>Afwijzen</option></select><button class="admin-button" type="submit">Opslaan</button></form></td>}</tr>)}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="lock" size={17}/></span><strong>Geen privacyverzoeken</strong><p>Wanneer een verzoek wordt ingediend, bewaart dit register alleen status, deadline en een neutrale referentie.</p></div></div>}</section>
  <div class="admin-lock-note"><strong>Procedure:</strong> handel verzoeken niet af vanuit vrije tekst of e-mail alleen. Verifieer identiteit buiten dit dashboard, documenteer de wettelijke grond en voeg een auditgebeurtenis toe.</div></div>
</AdminLayout>
