---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {listOffers} from '../../lib/appointmentCatalog';
const offers=await listOffers({publicOnly:true});
const people=[...new Map(offers.map(o=>[o.practitionerId,{id:o.practitionerId,name:o.practitionerName}])).values()];
const origin=(import.meta.env.PUBLIC_SITE_URL||Astro.url.origin).replace(/\/$/,'');
---
<AdminLayout title="Boekingslinks"><div class="admin-page practice-stack"><header class="admin-page-heading"><div><p class="admin-eyebrow">Praktijkbeheer</p><h1>Boekingslinks</h1><p>Deel de planner voor precies de juiste therapeut en behandeling.</p></div></header><section class="practice-card" data-link-generator data-offers={JSON.stringify(offers.map(o=>({id:o.id,practitionerId:o.practitionerId,name:o.name,duration:o.duration,channel:o.channel})))} data-origin={origin}><div class="practice-grid"><label>Therapeut<select class="practice-input" data-person><option value="">Kies een therapeut</option>{people.map(p=><option value={p.id}>{p.name}</option>)}</select></label><label>Afspraaktype<select class="practice-input" data-type disabled><option value="">Kies eerst een therapeut</option></select></label></div><p data-summary aria-live="polite">Kies een therapeut en een afspraaktype.</p><label class="practice-label">Boekingslink<input class="practice-input" data-link readonly aria-label="Gegenereerde boekingslink"/></label><div class="practice-actions"><button class="admin-button admin-button--primary" data-copy disabled>Kopieer boekingslink</button><a class="admin-button" data-preview hidden target="_blank" rel="noreferrer">Voorbeeld openen</a></div><p data-feedback aria-live="polite"></p></section><section class="practice-card"><h2>Algemene planner</h2><p>Laat de cliënt zelf een therapeut en afspraaktype kiezen.</p><a href="/afspraak" target="_blank" rel="noreferrer">{origin}/afspraak</a></section>{!offers.length&&<p>Er zijn nog geen actieve boekbare combinaties. Configureer eerst het aanbod en de beschikbaarheid.</p>}</div></AdminLayout>
<script>
 const root=document.querySelector<HTMLElement>('[data-link-generator]');
 if(root){const offers=JSON.parse(root.dataset.offers||'[]') as {id:string;practitionerId:string;name:string;duration:number;channel:string}[];
 const person=root.querySelector<HTMLSelectElement>('[data-person]')!,type=root.querySelector<HTMLSelectElement>('[data-type]')!,link=root.querySelector<HTMLInputElement>('[data-link]')!,copy=root.querySelector<HTMLButtonElement>('[data-copy]')!,preview=root.querySelector<HTMLAnchorElement>('[data-preview]')!,summary=root.querySelector<HTMLElement>('[data-summary]')!,feedback=root.querySelector<HTMLElement>('[data-feedback]')!;
 const update=()=>{const offer=offers.find(o=>o.id===type.value&&o.practitionerId===person.value);link.value=offer?`${root.dataset.origin}/afspraak/${offer.id}`:'';copy.disabled=!offer;preview.hidden=!offer;preview.href=link.value;summary.textContent=offer?`${person.selectedOptions[0].text} · ${offer.name} · ${offer.duration} minuten · ${offer.channel==='online'?'Online':'In de praktijk'}`:'Kies een therapeut en een afspraaktype.';feedback.textContent='';};
 person.addEventListener('change',()=>{type.replaceChildren(new Option('Kies een afspraaktype',''));offers.filter(o=>o.practitionerId===person.value).forEach(o=>type.add(new Option(o.name,o.id)));type.disabled=!person.value;update();});type.addEventListener('change',update);
 copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(link.value);feedback.textContent='Boekingslink gekopieerd.';}catch{link.select();feedback.textContent='Selecteer en kopieer de link met je toetsenbord.';}});}
</script>
