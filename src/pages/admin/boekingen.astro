---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAdminBookings } from '../../lib/superAdmin';
import { hasPermission } from '../../lib/adminAuth';
const bookings = await listAdminBookings();
const label: Record<string, string> = { pending: 'Aanvraag', confirmed: 'Bevestigd', declined: 'Afgewezen', cancelled: 'Geannuleerd', completed: 'Afgerond', no_show: 'Niet verschenen' };
const canManage = hasPermission(Astro.locals.adminUser, 'bookings.manage');
const canOpenRecords = hasPermission(Astro.locals.adminUser, 'client_records.read');
const message = Astro.url.searchParams.get('message'); const error = Astro.url.searchParams.get('error');
const nextActions: Record<string, Array<[string, string]>> = { pending: [['confirmed', 'Bevestigen'], ['declined', 'Afwijzen'], ['cancelled', 'Annuleren']], confirmed: [['completed', 'Afronden'], ['no_show', 'No-show'], ['cancelled', 'Annuleren']] };
---
<AdminLayout title="Boekingen" description="Beheer afspraken zonder klinische inhoud">
  <div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Begeleiding</p><h1>Boekingen</h1><p>Operationele afspraakgegevens blijven gescheiden van therapienotities, intake en gezondheidsinformatie.</p></div><div class="admin-page-actions"><a class="admin-button" href="/admin/professionals"><AdminIcon name="professionals" size={16}/> Professionals</a></div></section>
  <section class="admin-catalog-stats"><article><span>Totaal</span><strong>{bookings.length}</strong></article><article><span>Nieuwe aanvragen</span><strong>{bookings.filter((b) => b.status === 'pending').length}</strong></article><article><span>Bevestigd</span><strong>{bookings.filter((b) => b.status === 'confirmed').length}</strong></article><article><span>Deze week</span><strong>{bookings.filter((b) => new Date(b.startsAt).getTime() < Date.now() + 7 * 86400000 && new Date(b.startsAt).getTime() >= Date.now()).length}</strong></article></section>
  {message === 'updated' && <div class="admin-login__alert admin-login__alert--success" role="status"><AdminIcon name="check" size={17}/> Boekingsstatus bijgewerkt en geaudit.</div>}{error && <div class="admin-login__alert admin-login__alert--error" role="alert"><AdminIcon name="warning" size={17}/> Deze statuswijziging is niet toegestaan.</div>}<section class="admin-panel">{bookings.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Moment</th><th>Professional</th><th>Cliënt</th><th>Status</th><th>Aangevraagd</th>{canOpenRecords && <th>Dossier</th>}{canManage && <th><span class="sr-only">Actie</span></th>}</tr></thead><tbody>{bookings.map((booking) => <tr><td data-label="Moment"><strong>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(booking.startsAt))}</strong></td><td data-label="Professional">{booking.practitionerName}</td><td data-label="Cliënt"><span class="admin-product-cell"><span><strong>{booking.clientName}</strong><small>{booking.clientEmail}</small></span></span></td><td data-label="Status"><span class={`admin-product-status admin-product-status--${booking.status === 'confirmed' ? 'published' : 'draft'}`}><i></i>{label[booking.status] || booking.status}</span></td><td data-label="Aangevraagd"><time datetime={booking.createdAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(booking.createdAt))}</time></td>{canOpenRecords && <td data-label="Dossier">{booking.patientId ? <a class="admin-row-action" href={`/admin/clienten/${booking.patientId}`}>Open dossier <AdminIcon name="arrow" size={13}/></a> : ['confirmed', 'completed', 'no_show'].includes(booking.status) ? <a class="admin-row-action" href={`/admin/clienten?boeking=${booking.id}`}>Dossier maken <AdminIcon name="arrow" size={13}/></a> : <span class="admin-state">Na bevestiging</span>}</td>}{canManage && <td data-label="Actie">{nextActions[booking.status]?.length ? <form class="admin-inline-form" method="post" action={`/api/admin/bookings/${booking.id}`}><select name="status" aria-label={`Nieuwe status voor ${booking.clientName}`}>{nextActions[booking.status].map(([value, text]) => <option value={value}>{text}</option>)}</select><button class="admin-button" type="submit">Opslaan</button></form> : <span class="admin-state">Definitief</span>}</td>}</tr>)}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="calendar" size={17}/></span><strong>Geen boekingen</strong><p>Nieuwe aanvragen verschijnen hier zodra de publieke boekingsroute op Supabase is overgezet.</p></div></div>}</section></div>
</AdminLayout>
