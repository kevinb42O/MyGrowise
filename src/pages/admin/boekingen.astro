---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import { listAdminBookings } from '../../lib/superAdmin';
const bookings = await listAdminBookings();
const label: Record<string, string> = { pending: 'Aanvraag', confirmed: 'Bevestigd', declined: 'Afgewezen', cancelled: 'Geannuleerd', completed: 'Afgerond', no_show: 'Niet verschenen' };
---
<AdminLayout title="Boekingen" description="Beheer afspraken zonder klinische inhoud">
  <div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Begeleiding</p><h1>Boekingen</h1><p>Operationele afspraakgegevens blijven gescheiden van therapienotities, intake en gezondheidsinformatie.</p></div><div class="admin-page-actions"><a class="admin-button" href="/admin/professionals"><AdminIcon name="professionals" size={16}/> Professionals</a></div></section>
  <section class="admin-catalog-stats"><article><span>Totaal</span><strong>{bookings.length}</strong></article><article><span>Nieuwe aanvragen</span><strong>{bookings.filter((b) => b.status === 'pending').length}</strong></article><article><span>Bevestigd</span><strong>{bookings.filter((b) => b.status === 'confirmed').length}</strong></article><article><span>Deze week</span><strong>{bookings.filter((b) => new Date(b.startsAt).getTime() < Date.now() + 7 * 86400000 && new Date(b.startsAt).getTime() >= Date.now()).length}</strong></article></section>
  <section class="admin-panel">{bookings.length ? <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Moment</th><th>Professional</th><th>Cliënt</th><th>Status</th><th>Aangevraagd</th></tr></thead><tbody>{bookings.map((booking) => <tr><td data-label="Moment"><strong>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(booking.startsAt))}</strong></td><td data-label="Professional">{booking.practitionerName}</td><td data-label="Cliënt"><span class="admin-product-cell"><span><strong>{booking.clientName}</strong><small>{booking.clientEmail}</small></span></span></td><td data-label="Status"><span class={`admin-product-status admin-product-status--${booking.status === 'confirmed' ? 'published' : 'draft'}`}><i></i>{label[booking.status] || booking.status}</span></td><td data-label="Aangevraagd"><time datetime={booking.createdAt}>{new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(booking.createdAt))}</time></td></tr>)}</tbody></table></div> : <div class="admin-empty-row"><div><span><AdminIcon name="calendar" size={17}/></span><strong>Geen boekingen</strong><p>Nieuwe aanvragen verschijnen hier zodra de publieke boekingsroute op Supabase is overgezet.</p></div></div>}</section></div>
</AdminLayout>
