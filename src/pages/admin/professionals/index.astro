---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminIcon from '../../../components/admin/AdminIcon.astro';
import { listAdminPractitioners } from '../../../lib/superAdmin';
const accounts=await listAdminPractitioners();
const active=accounts.filter((account)=>account.active).length;
const schedules=accounts.filter((account)=>account.availabilityRules>0).length;
---
<AdminLayout title="Professionals" description="Beheer praktijktoegang en beschikbaarheid"><div class="admin-page"><section class="admin-page-heading"><div><p class="admin-eyebrow">Team & toegang</p><h1>Professionals</h1><p>Professionals en hun beschikbaarheid komen uit Supabase; toegang blijft strikt op het eigen professional-ID begrensd.</p></div><div class="admin-page-actions"><button class="admin-button admin-button--primary" type="button" aria-disabled="true" title="De uitnodigingsflow vereist een geconfigureerde Supabase Auth-mailprovider."><AdminIcon name="plus" size={16}/> Professional uitnodigen</button></div></section>
<section class="admin-catalog-stats"><article><span>Professionals</span><strong>{accounts.length}</strong></article><article><span>Actief</span><strong>{active}</strong></article><article><span>Schema ingesteld</span><strong>{schedules}</strong></article><article><span>Open aanvragen</span><strong>{accounts.reduce((sum,a)=>sum+a.pendingBookings,0)}</strong></article></section>
<section class="admin-panel"><header class="admin-panel__header"><div><h2>Praktijkprofielen</h2><p>Toegang is server-side begrensd op het eigen professional-ID</p></div><span class="admin-state admin-state--ready">Supabase gekoppeld</span></header><div class="practice-team-list">{accounts.map((account)=><article><span class="practice-team-avatar">{account.name.charAt(0)}</span><div class="practice-team-person"><strong>{account.name}</strong><small>/{account.slug}</small></div><div><small>Boekingsverzoeken</small><strong>{account.settings?.requests_enabled ? 'Open' : 'Gesloten'}</strong></div><div><small>Beschikbaarheidsblokken</small><strong>{account.availabilityRules}</strong></div><div><small>Open aanvragen</small><strong>{account.pendingBookings}</strong></div><span class={`admin-product-status admin-product-status--${account.active ? 'published' : 'archived'}`}><i></i>{account.active ? 'Actief' : 'Inactief'}</span></article>)}</div></section></div></AdminLayout>
