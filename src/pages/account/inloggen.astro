---
import MainLayout from '../../layouts/MainLayout.astro';
import { sanitizeAppRedirect } from '../../lib/adminAuth';
const error = Astro.url.searchParams.get('error');
const confirmed = Astro.url.searchParams.get('confirmed') === '1';
const next = sanitizeAppRedirect(Astro.url.searchParams.get('next')) || '/account';
const messages: Record<string, string> = { invalid: 'Je e-mailadres of wachtwoord is niet correct.', configuration: 'Aanmelden is nog niet geconfigureerd.', rate_limited: 'Te veel pogingen. Probeer over vijftien minuten opnieuw.', registered: 'Controleer je e-mail en bevestig eerst je account. Daarna kan je veilig inloggen.', verification_sent: 'Als er voor dit adres een onbevestigd account bestaat, sturen we een nieuwe bevestigingslink.', temporarily_unavailable: 'Inloggen lukt momenteel niet door een technische storing. Probeer straks opnieuw.', signed_out: 'Je bent veilig afgemeld.', password_reset: 'Je nieuwe wachtwoord is opgeslagen. Je kan nu inloggen.', customer_required: 'Dit account is een praktijkaccount. Gebruik je MyGrowise-klantaccount om een begeleidingsaanvraag te doen.', email_confirmation: 'Bevestig eerst je e-mailadres voordat je een aanvraag verstuurt.', session_expired: 'Je sessie is verlopen. Log opnieuw in om verder te gaan met je aanvraag.' };
---
<MainLayout title="Inloggen — Mijn Mygrowise" noindex={true}><section class="account-auth"><div class="account-auth__card"><span class="eyebrow">Mijn MyGrowise</span><h1>Welkom terug.</h1><p>Bekijk je aankopen, afspraken en volgende stappen op één rustige plek.</p>{confirmed && <div class="message success">Je e-mailadres is bevestigd. Je kan nu inloggen.</div>}{messages[error || ''] && <div class:list={{ message: true, success: ['registered','verification_sent','signed_out','password_reset'].includes(error || '') }}>{messages[error || '']}</div>}<form action="/api/account/login" method="post"><input type="hidden" name="next" value={next}/><label>E-mailadres<input name="email" type="email" autocomplete="email" required maxlength="254" autofocus /></label><label>Wachtwoord<input name="password" type="password" autocomplete="current-password" required maxlength="256" /></label><button class="button button-primary" type="submit">Inloggen</button></form><form class="resend" action="/api/account/verification-resend" method="post"><input type="hidden" name="next" value={next}/><label>Bevestigingslink verlopen of niet aangekomen?<input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="Je e-mailadres" /></label><button class="button" type="submit">Stuur een nieuwe link</button></form><p><a href="/account/wachtwoord-vergeten">Wachtwoord vergeten?</a></p><p>Nog geen account? <a href={`/account/aanmaken?next=${encodeURIComponent(next)}`}>Maak er één aan</a>.</p></div></section></MainLayout>
<style>.account-auth{padding-block:clamp(4rem,9vw,8rem)}.account-auth__card{max-width:32rem;margin:auto;padding:clamp(1.5rem,5vw,3.25rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white);box-shadow:var(--shadow)}.account-auth h1{margin-bottom:.8rem;font-size:clamp(2.8rem,7vw,4.5rem)}.account-auth p{color:var(--muted);line-height:1.7}.account-auth form{display:grid;gap:1rem;margin:2rem 0}.account-auth .resend{padding-top:1.25rem;border-top:1px solid var(--line)}.account-auth label{display:grid;gap:.45rem;font-size:.78rem;font-weight:700}.account-auth input{min-height:3.1rem;padding:.75rem .9rem;border:1px solid var(--line);border-radius:.65rem;background:var(--paper)}.account-auth .button{justify-self:start;margin-top:.5rem}.message{margin-top:1.4rem;padding:.85rem 1rem;border-left:4px solid var(--pink);background:var(--pink-soft);font-size:.86rem;line-height:1.5}.message.success{border-color:var(--ink);background:#dcece7}</style>
