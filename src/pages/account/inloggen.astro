---
import '../../styles/global.css';
import { sanitizeAppRedirect } from '../../lib/adminAuth';

const error = Astro.url.searchParams.get('error');
const confirmed = Astro.url.searchParams.get('confirmed') === '1';
const next = sanitizeAppRedirect(Astro.url.searchParams.get('next')) || '/account';
const confirmationHelp = `/account/bevestigingslink?next=${encodeURIComponent(next)}`;
const createAccount = `/account/aanmaken?next=${encodeURIComponent(next)}`;
const messages: Record<string, string> = {
  invalid: 'Je e-mailadres of wachtwoord is niet correct.',
  configuration: 'Aanmelden is nog niet geconfigureerd.',
  rate_limited: 'Te veel pogingen. Probeer over vijftien minuten opnieuw.',
  registered: 'Je account is aangemaakt. Bevestig je e-mailadres via de mail die we je stuurden. Daarna kan je inloggen.',
  verification_sent: 'Als er voor dit adres een onbevestigd account bestaat, sturen we een nieuwe bevestigingslink.',
  temporarily_unavailable: 'Inloggen lukt momenteel niet door een technische storing. Probeer straks opnieuw.',
  signed_out: 'Je bent veilig afgemeld.',
  password_reset: 'Je nieuwe wachtwoord is opgeslagen. Je kan nu inloggen.',
  customer_required: 'Dit account is een praktijkaccount. Gebruik je MyGrowise-klantaccount om een begeleidingsaanvraag te doen.',
  email_confirmation: 'Bevestig eerst je e-mailadres voordat je een aanvraag verstuurt.',
  session_expired: 'Je sessie is verlopen. Log opnieuw in om verder te gaan met je aanvraag.',
};
const successMessages = ['registered', 'verification_sent', 'signed_out', 'password_reset'];
const needsConfirmationHelp = error === 'registered' || error === 'email_confirmation';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fbf8f2" />
    <link rel="icon" type="image/png" href="/images/logo-lelie.png" />
    <title>Inloggen — Mijn MyGrowise</title>
  </head>
  <body class="login-page">
    <a class="skip-link" href="#inhoud">Ga naar de inhoud</a>
    <header class="login-header">
      <a class="login-brand" href="/" aria-label="MyGrowise, naar de startpagina">
        <img src="/images/logo-lelie.webp" alt="" width="382" height="289" />
        <span><em>My</em>Growise</span>
      </a>
      <a class="login-header__back" href="/">Terug naar de website <span aria-hidden="true">↗</span></a>
    </header>

    <main id="inhoud" class="login-shell">
      <section class="login-intro" aria-label="Mijn MyGrowise">
        <div class="login-intro__content">
          <span class="login-intro__kicker">Mijn MyGrowise</span>
          <h1>Een plek om<br /><em>verder te groeien.</em></h1>
          <p>Je eigen rustige omgeving voor alles wat je bij MyGrowise hebt gestart.</p>
          <div class="login-intro__features" aria-label="In jouw account">
            <span>Afspraken</span><span>Aankopen</span><span>Jouw volgende stappen</span>
          </div>
        </div>
        <div class="login-intro__flower" aria-hidden="true">
          <span class="login-intro__flower-core"></span>
          <span class="login-intro__petal login-intro__petal--one"></span>
          <span class="login-intro__petal login-intro__petal--two"></span>
          <span class="login-intro__petal login-intro__petal--three"></span>
          <span class="login-intro__petal login-intro__petal--four"></span>
        </div>
        <p class="login-intro__note">Neem de draad weer op, op jouw tempo.</p>
      </section>

      <section class="login-form-panel" aria-labelledby="login-title">
        <div class="login-form-panel__inner">
          <p class="login-form-panel__eyebrow">Welkom terug</p>
          <h2 id="login-title">Log in op jouw plek.</h2>
          <p class="login-form-panel__intro">Vul je gegevens in om verder te gaan.</p>

          {confirmed && <div class="login-message login-message--success" role="status">Je e-mailadres is bevestigd. Je kan nu inloggen.</div>}
          {messages[error || ''] && <div class:list={['login-message', successMessages.includes(error || '') && 'login-message--success']} role={successMessages.includes(error || '') ? 'status' : 'alert'}>{messages[error || '']}{needsConfirmationHelp && <a href={confirmationHelp}>Geen mail ontvangen?</a>}</div>}

          <form class="login-form" action="/api/account/login" method="post">
            <input type="hidden" name="next" value={next} />
            <label for="login-email">E-mailadres</label>
            <input id="login-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="jij@voorbeeld.be" required maxlength="254" autofocus />

            <div class="login-form__label-row">
              <label for="login-password">Wachtwoord</label>
              <a href="/account/wachtwoord-vergeten">Wachtwoord vergeten?</a>
            </div>
            <div class="login-password">
              <input id="login-password" name="password" type="password" autocomplete="current-password" required maxlength="256" />
              <button type="button" data-password-toggle aria-label="Wachtwoord tonen" aria-pressed="false">Toon</button>
            </div>

            <button class="login-form__submit" type="submit">Inloggen <span aria-hidden="true">→</span></button>
          </form>

          <p class="login-form-panel__create">Nog geen account? <a href={createAccount}>Maak er één aan <span aria-hidden="true">→</span></a></p>
        </div>
      </section>
    </main>

    <footer class="login-footer"><span>© {new Date().getFullYear()} MyGrowise</span><a href="/contact">Hulp nodig? Contacteer ons</a></footer>

    <script is:inline>
      const password = document.querySelector('#login-password');
      const toggle = document.querySelector('[data-password-toggle]');
      toggle?.addEventListener('click', () => {
        const visible = password?.getAttribute('type') === 'text';
        password?.setAttribute('type', visible ? 'password' : 'text');
        toggle.textContent = visible ? 'Toon' : 'Verberg';
        toggle.setAttribute('aria-label', visible ? 'Wachtwoord tonen' : 'Wachtwoord verbergen');
        toggle.setAttribute('aria-pressed', String(!visible));
      });
    </script>
  </body>
</html>

<style>
  .login-page { min-height: 100dvh; display: flex; flex-direction: column; background: var(--paper); }
  .login-header { width: min(1380px, calc(100% - clamp(2rem, 7vw, 7rem))); min-height: 5.5rem; margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .login-brand { display: inline-flex; align-items: center; gap: .55rem; color: var(--ink-deep); font-family: 'DM Serif Display', Georgia, serif; font-size: 1.55rem; letter-spacing: -.04em; text-decoration: none; }
  .login-brand img { width: 2.6rem; height: auto; }
  .login-brand em { color: #d85f78; font-weight: 400; }
  .login-header__back { display: inline-flex; align-items: center; gap: .5rem; color: var(--ink); font-size: .78rem; font-weight: 700; text-decoration: none; }
  .login-header__back:hover, .login-footer a:hover { text-decoration: underline; text-underline-offset: .25rem; }
  .login-header__back span { font-size: 1.1rem; }
  .login-shell { width: min(1380px, calc(100% - clamp(2rem, 7vw, 7rem))); min-height: min(730px, calc(100dvh - 9.5rem)); margin: auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .92fr); overflow: hidden; border: 1px solid var(--line); border-radius: 1.8rem; background: var(--white); box-shadow: 0 22px 70px rgba(14, 43, 37, .07); }
  .login-intro { position: relative; display: flex; min-height: 39rem; flex-direction: column; overflow: hidden; padding: clamp(2.7rem, 5vw, 5.4rem); background: #e9eee9; isolation: isolate; }
  .login-intro::before { position: absolute; z-index: -1; right: -11rem; bottom: -19rem; width: 38rem; height: 38rem; border: 1px solid rgba(23,61,53,.11); border-radius: 50%; box-shadow: 0 0 0 4rem rgba(255,253,249,.21), 0 0 0 8rem rgba(255,253,249,.13); content: ''; }
  .login-intro__content { position: relative; z-index: 2; }
  .login-intro__kicker, .login-form-panel__eyebrow { display: inline-flex; align-items: center; gap: .65rem; color: var(--ink); font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .login-intro__kicker::before, .login-form-panel__eyebrow::before { width: 1.6rem; height: 2px; background: var(--pink); content: ''; }
  .login-intro h1 { max-width: 9ch; margin: clamp(2rem, 5vw, 4.6rem) 0 1.4rem; font-size: clamp(3.8rem, 5.5vw, 6.3rem); line-height: .97; }
  .login-intro h1 em { color: #bd6572; font-weight: 400; }
  .login-intro__content > p { max-width: 34ch; color: #48665e; font-size: clamp(.98rem, 1.3vw, 1.13rem); line-height: 1.65; }
  .login-intro__features { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2.3rem; }
  .login-intro__features span { padding: .58rem .86rem; border: 1px solid rgba(23,61,53,.18); border-radius: 99rem; background: rgba(255,253,249,.45); color: var(--ink); font-size: .72rem; font-weight: 700; }
  .login-intro__flower { position: absolute; right: 5%; bottom: -4%; width: min(30vw, 24rem); height: min(30vw, 24rem); opacity: .64; transform: rotate(-18deg); }
  .login-intro__flower-core { position: absolute; top: 50%; left: 50%; z-index: 2; width: 13%; height: 13%; border-radius: 50%; background: #d69b3c; transform: translate(-50%,-50%); }
  .login-intro__petal { position: absolute; top: 10%; left: 35%; width: 30%; height: 44%; border-radius: 60% 60% 48% 48%; background: #f6c8cd; transform-origin: 50% 91%; }
  .login-intro__petal--two { transform: rotate(90deg); }.login-intro__petal--three { transform: rotate(180deg); }.login-intro__petal--four { transform: rotate(270deg); }
  .login-intro__note { position: relative; z-index: 2; margin: auto 0 0; color: #48665e; font-family: 'DM Serif Display', Georgia, serif; font-size: 1.15rem; font-style: italic; }
  .login-form-panel { display: flex; align-items: center; justify-content: center; padding: clamp(2.1rem, 5vw, 5rem); }
  .login-form-panel__inner { width: min(100%, 27rem); }
  .login-form-panel__eyebrow { margin-bottom: 1.4rem; }
  .login-form-panel h2 { margin: 0 0 .65rem; font-size: clamp(2.6rem, 3.8vw, 4rem); line-height: 1.04; }
  .login-form-panel__intro { margin: 0 0 2.3rem; color: var(--muted); font-size: .94rem; line-height: 1.65; }
  .login-message { margin: 0 0 1.5rem; padding: .85rem 1rem; border-left: 3px solid var(--pink); border-radius: .35rem; background: var(--pink-soft); font-size: .82rem; line-height: 1.55; }
  .login-message--success { border-color: var(--ink); background: #e5f0e9; }
  .login-message a { display: inline-block; margin-left: .3rem; font-weight: 700; text-underline-offset: .16rem; }
  .login-form { display: grid; gap: .7rem; }
  .login-form label { color: var(--ink); font-size: .79rem; font-weight: 700; }
  .login-form input { width: 100%; min-height: 3.4rem; padding: .9rem 1rem; border: 1px solid rgba(23,61,53,.23); border-radius: .72rem; outline: none; background: #fff; color: var(--ink-deep); font-size: .93rem; transition: border-color .2s ease, box-shadow .2s ease; }
  .login-form input::placeholder { color: #86948e; }
  .login-form input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(23,61,53,.1); }
  .login-form__label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: .72rem; }
  .login-form__label-row a { color: var(--muted); font-size: .75rem; font-weight: 700; text-decoration: underline; text-underline-offset: .2rem; }
  .login-form__label-row a:hover { color: var(--ink); }
  .login-password { position: relative; }
  .login-password input { padding-right: 5rem; }
  .login-password button { position: absolute; top: 50%; right: .55rem; min-height: 2.35rem; padding: 0 .7rem; border: 0; border-radius: .45rem; background: transparent; color: var(--ink); font-size: .75rem; font-weight: 700; cursor: pointer; transform: translateY(-50%); }
  .login-password button:hover { background: var(--cream); }
  .login-form__submit { display: flex; min-height: 3.55rem; align-items: center; justify-content: space-between; margin-top: 1.3rem; padding: .8rem 1.25rem; border: 1px solid var(--ink); border-radius: .72rem; background: var(--ink); color: #fff; font-size: .88rem; font-weight: 700; cursor: pointer; transition: background .2s ease, transform .2s ease; }
  .login-form__submit:hover { background: var(--ink-deep); transform: translateY(-2px); }
  .login-form__submit span { font-size: 1.25rem; line-height: 1; }
  .login-form-panel__create { margin: 2rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .8rem; line-height: 1.5; }
  .login-form-panel__create a { margin-left: .2rem; color: var(--ink); font-weight: 700; text-decoration: underline; text-underline-offset: .2rem; }
  .login-footer { width: min(1380px, calc(100% - clamp(2rem, 7vw, 7rem))); min-height: 4rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-inline: auto; color: var(--muted); font-size: .72rem; }
  .login-footer a { text-decoration: none; }
  @media (max-width: 850px) {
    .login-shell { min-height: auto; grid-template-columns: 1fr; }
    .login-intro { min-height: auto; padding: 2.5rem; }
    .login-intro h1 { max-width: none; margin: 1.5rem 0 .8rem; font-size: clamp(2.8rem, 7vw, 4.5rem); }
    .login-intro__features, .login-intro__note, .login-intro__flower { display: none; }
    .login-intro__content > p { margin-bottom: 0; }
    .login-form-panel { padding: clamp(2rem, 6vw, 3.5rem); }
    .login-form-panel__inner { width: min(100%, 34rem); }
  }
  @media (max-width: 520px) {
    .login-header { min-height: 4.5rem; }
    .login-brand { font-size: 1.3rem; }.login-brand img { width: 2.2rem; }
    .login-header__back { font-size: .7rem; }.login-header__back span { display: none; }
    .login-shell { width: 100%; border-right: 0; border-left: 0; border-radius: 0; box-shadow: none; }
    .login-intro { padding: 2rem 1.5rem; }
    .login-intro h1 { font-size: clamp(2.65rem, 11vw, 3.6rem); }
    .login-intro__content > p { font-size: .9rem; }
    .login-form-panel { padding: 2.35rem 1.5rem 3rem; }
    .login-form-panel__eyebrow { margin-bottom: 1rem; }
    .login-form-panel h2 { font-size: 2.5rem; }
    .login-form-panel__intro { margin-bottom: 1.75rem; }
  }
</style>
