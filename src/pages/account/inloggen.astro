---
import AuthLayout from '../../layouts/AuthLayout.astro';
import PasswordField from '../../components/auth/PasswordField.astro';
import Icon from '../../components/purchases/PurchaseIcon.astro';
import { sanitizeAppRedirect } from '../../lib/adminAuth';

const error = Astro.url.searchParams.get('error');
const confirmed = Astro.url.searchParams.get('confirmed') === '1';
const next = sanitizeAppRedirect(Astro.url.searchParams.get('next')) || '/account';
const confirmationHelp = `/account/bevestigingslink?next=${encodeURIComponent(next)}`;
const createAccount = `/account/aanmaken?next=${encodeURIComponent(next)}`;
const messages: Record<string, string> = {
  invalid: 'Je e-mailadres of wachtwoord is niet correct.',
  configuration: 'Aanmelden is nog niet geconfigureerd.',
  rate_limited: 'Te veel pogingen. Probeer over vijftien minuten opnieuw.',
  registered: 'Je account is aangemaakt. Bevestig je e-mailadres via de mail die we je stuurden. Daarna kan je inloggen.',
  verification_sent: 'Als er voor dit adres een onbevestigd account bestaat, sturen we een nieuwe bevestigingslink.',
  temporarily_unavailable: 'Inloggen lukt momenteel niet door een technische storing. Probeer straks opnieuw.',
  signed_out: 'Je bent veilig afgemeld.',
  password_reset: 'Je nieuwe wachtwoord is opgeslagen. Je kan nu inloggen.',
  customer_required: 'Dit account is een praktijkaccount. Gebruik je MyGrowise-klantaccount om een afspraak te boeken.',
  email_confirmation: 'Bevestig eerst je e-mailadres voordat je een afspraak boekt.',
  session_expired: 'Je sessie is verlopen. Log opnieuw in om verder te gaan met je boeking.',
};
const successMessages = ['registered', 'verification_sent', 'signed_out', 'password_reset'];
const needsConfirmationHelp = error === 'registered' || error === 'email_confirmation';
---
<AuthLayout title="Inloggen — Mijn MyGrowise" heading="Welkom terug." intro="Log in om je aankopen en afspraken terug te vinden.">
  {confirmed&&<div class="auth-message auth-message--success" role="status">Je e-mailadres is bevestigd. Je kan nu inloggen.</div>}
  {messages[error||'']&&<div class:list={['auth-message',{'auth-message--success':successMessages.includes(error||'')}]} role={successMessages.includes(error||'')?'status':'alert'}>{messages[error||'']}{needsConfirmationHelp&&<a href={confirmationHelp}>Geen mail ontvangen?</a>}</div>}
  <form class="auth-form" action="/api/account/login" method="post" data-auth-form>
    <input type="hidden" name="next" value={next}/>
    <div class="auth-field"><label for="login-email">E-mailadres</label><input id="login-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="jij@voorbeeld.be" required maxlength="254" /></div>
    <PasswordField id="login-password" label="Wachtwoord" autocomplete="current-password" minimum={1}/>
    <a class="auth-recovery-link" href={`/account/wachtwoord-vergeten?next=${encodeURIComponent(next)}`}>Wachtwoord vergeten?</a>
    <button class="purchase-button" type="submit">Inloggen <Icon name="arrow" /></button>
  </form>
  <div class="auth-links"><p>Nog geen account? <a href={createAccount}>Maak er één aan</a></p><p>Alleen je aankopen openen? <a href="/aankopen/toegang">Ontvang een toegangslink</a></p></div>
</AuthLayout>
