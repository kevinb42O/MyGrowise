---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { getSupportConversation, listSupportConversations } from '../../lib/supportInbox';
const user = Astro.locals.currentUser!; const selectedId = Astro.url.searchParams.get('conversation') || ''; const page = Math.max(1, Math.min(1000, Number.parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1)); const [listing, selected] = await Promise.all([listSupportConversations(user.sub, false, page), selectedId ? getSupportConversation(selectedId, user.sub, false) : Promise.resolve(null)]); const conversations = listing.items; const created = Astro.url.searchParams.get('created') === '1'; const sent = Astro.url.searchParams.get('sent') === '1'; const error = Astro.url.searchParams.get('error') === 'invalid'; const date = (value: string) => new Intl.DateTimeFormat('nl-BE', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(value));
---
<AccountLayout title="Berichten"><section class="account-heading"><span class="eyebrow">Praktische ondersteuning</span><h1>Een vraag mag gewoon een vraag zijn.</h1><p>Stel hier praktische vragen over je account, bestelling, toegang of afspraak. Deel geen diagnoses, intake- of sessie-inhoud.</p></section>{(created || sent) && <div class="account-support-alert">Je bericht is veilig verstuurd. We volgen het hier op.</div>}{error && <div class="account-support-alert account-support-alert--error">Controleer je bericht en probeer opnieuw.</div>}<div class="account-support"><aside>{conversations.length ? conversations.map((conversation) => <a href={`/account/ondersteuning?page=${page}&conversation=${conversation.id}`} class:list={{ 'is-active': selected?.id === conversation.id, 'is-unread': conversation.unread }}><strong>{conversation.subject}</strong><span>{conversation.preview || 'Nieuw gesprek'}</span><time>{date(conversation.lastMessageAt)}</time></a>) : <p>Nog geen gesprekken.</p>}{(page > 1 || listing.hasMore) && <nav class="account-support-pages" aria-label="Gesprekkenpagina's">{page > 1 && <a href={`/account/ondersteuning?page=${page - 1}`}>Vorige</a>}{listing.hasMore && <a href={`/account/ondersteuning?page=${page + 1}`}>Volgende</a>}</nav>}<a class="account-button account-button--dark" href="#nieuw">Nieuwe vraag</a></aside><section>{selected ? <><header><span>Ondersteuning</span><h2>{selected.subject}</h2></header><div class="account-support-thread">{selected.messages?.map((message) => <article class:list={{ 'is-own': message.senderId === user.sub }}><small>{message.senderName} · {date(message.createdAt)}</small>{message.body.split(/\n{2,}/).map((paragraph) => <p>{paragraph}</p>)}</article>)}</div><form action={`/api/account/support/${selected.id}`} method="post"><textarea name="body" required maxlength="4000" rows="4" placeholder="Schrijf je antwoord…"></textarea><button class="account-button account-button--dark" type="submit">Verstuur antwoord</button></form></> : <div class="account-support-empty"><h2>Waarmee kunnen we helpen?</h2><p>Kies een bestaand gesprek of start hieronder een nieuwe, praktische vraag.</p></div>}</section></div><section class="account-support-new" id="nieuw"><span class="eyebrow">Nieuwe vraag</span><h2>Stuur ons een bericht.</h2><form action="/api/account/support" method="post"><label>Onderwerp<input name="subject" required minlength="2" maxlength="180"/></label><label>Waarover gaat je vraag?<select name="category"><option value="general">Algemeen</option><option value="order">Bestelling</option><option value="access">Toegang</option><option value="booking">Afspraak</option><option value="privacy">Privacy</option><option value="other">Anders</option></select></label><label>Bericht<textarea name="body" required maxlength="4000" rows="5"></textarea></label><button class="account-button account-button--dark" type="submit">Verstuur bericht</button></form></section></AccountLayout>
<style>.account-heading h1{max-width:12ch;margin:.5rem 0 .8rem;font-size:clamp(2.7rem,6vw,4.7rem);line-height:.95}.account-heading p{max-width:56ch;color:var(--muted);line-height:1.7}.account-support-alert{margin:1.5rem 0;padding:.8rem 1rem;border-radius:.8rem;background:#dcece7;color:var(--ink);font-size:.84rem;font-weight:700}.account-support-alert--error{background:var(--pink-soft)}.account-support{display:grid;gap:1rem;margin-top:2rem}.account-support>aside,.account-support>section,.account-support-new{border:1px solid var(--line);border-radius:1.2rem;background:var(--white)}.account-support>aside{display:grid;align-content:start;gap:.25rem;padding:.65rem}.account-support>aside>a:not(.account-button){position:relative;display:grid;gap:.28rem;padding:.85rem;border-radius:.8rem;color:var(--ink);text-decoration:none}.account-support>aside>a:not(.account-button):hover,.account-support>aside>a.is-active{background:var(--paper)}.account-support>aside strong,.account-support>aside span,.account-support>aside time{display:block}.account-support>aside strong{font-size:.8rem}.account-support>aside span{overflow:hidden;color:var(--muted);font-size:.72rem;text-overflow:ellipsis;white-space:nowrap}.account-support>aside time{color:var(--muted);font-size:.63rem}.account-support>aside .account-button{margin-top:.5rem}.account-support-pages{display:flex;justify-content:space-between;padding:.65rem}.account-support-pages a{font-size:.75rem;font-weight:700;color:var(--ink)}.account-support>section{min-height:28rem;padding:1.2rem}.account-support>section>header span{color:var(--pink);font-size:.65rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.account-support>section h2{margin:.3rem 0 1rem;font-size:1.8rem}.account-support-thread{display:grid;gap:.8rem;max-height:27rem;overflow:auto;padding:1rem 0}.account-support-thread article{max-width:85%;padding:.85rem 1rem;border-radius:.9rem .9rem .9rem .2rem;background:var(--paper)}.account-support-thread article.is-own{justify-self:end;border-radius:.9rem .9rem .2rem .9rem;background:var(--pink-soft)}.account-support-thread small{display:block;margin-bottom:.4rem;color:var(--muted);font-size:.63rem}.account-support-thread p{margin:.35rem 0 0;font-size:.8rem;line-height:1.6}.account-support form{display:grid;gap:.65rem}.account-support textarea,.account-support-new input,.account-support-new select,.account-support-new textarea{width:100%;padding:.75rem .85rem;border:1px solid var(--line);border-radius:.65rem;background:var(--paper);font:inherit}.account-support form .account-button{justify-self:end}.account-support-empty{display:grid;min-height:20rem;place-content:center;text-align:center}.account-support-empty p{color:var(--muted)}.account-support-new{margin-top:1rem;padding:clamp(1.2rem,4vw,2.4rem)}.account-support-new h2{margin:.4rem 0 1.2rem;font-size:2rem}.account-support-new form{display:grid;gap:1rem;max-width:42rem}.account-support-new label{display:grid;gap:.4rem;font-size:.76rem;font-weight:800}.account-support-new .account-button{justify-self:start}@media(min-width:800px){.account-support{grid-template-columns:16rem minmax(0,1fr)}.account-support>aside{max-height:38rem;overflow:auto}}</style>
