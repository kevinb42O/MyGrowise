---
import AuthLayout from '../../layouts/AuthLayout.astro';
import {sanitizeAppRedirect} from '../../lib/adminAuth';
import Icon from '../../components/purchases/PurchaseIcon.astro';
const next=sanitizeAppRedirect(Astro.url.searchParams.get('next'))||'/account';
const sent=Astro.url.searchParams.get('sent')==='1';
const rateLimited=Astro.url.searchParams.get('error')==='rate_limited';
---
<AuthLayout title="Wachtwoord herstellen — Mijn MyGrowise" heading={sent?'Bekijk je e-mail.':'Wachtwoord vergeten?'} intro={sent?'Als dit e-mailadres bij een account hoort, ontvang je een veilige herstellink.':'Vul je e-mailadres in. We sturen je een link om een nieuw wachtwoord te kiezen.'} compact>
  {sent&&<div class="auth-message auth-message--success" role="status">Open de herstelmail van MyGrowise. Kijk ook in je spammap als je niets ziet.</div>}
  {rateLimited&&<div class="auth-message" role="alert">Te veel pogingen. Probeer het over vijftien minuten opnieuw.</div>}
  {!sent?<form class="auth-form" action="/api/account/password-reset" method="post" data-auth-form><input type="hidden" name="next" value={next}/><div class="auth-field"><label for="reset-email">E-mailadres</label><input id="reset-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" placeholder="jij@voorbeeld.be"/></div><button class="purchase-button" type="submit">Stuur herstellink <Icon name="arrow" /></button></form>:<a class="auth-recovery-link" href={`/account/wachtwoord-vergeten?next=${encodeURIComponent(next)}`}>Ander adres gebruiken of opnieuw aanvragen</a>}
  <div class="auth-links"><a href={`/account/inloggen?next=${encodeURIComponent(next)}`}>Terug naar inloggen</a></div>
</AuthLayout>
