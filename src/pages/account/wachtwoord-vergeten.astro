---
import MainLayout from '../../layouts/MainLayout.astro';
const sent = Astro.url.searchParams.get('sent') === '1'; const rateLimited = Astro.url.searchParams.get('error') === 'rate_limited';
---
<MainLayout title="Wachtwoord herstellen — Mijn MyGrowise" noindex={true}><section class="account-auth"><div class="account-auth__card"><span class="eyebrow">Mijn MyGrowise</span><h1>Nieuw wachtwoord.</h1><p>Vul je e-mailadres in. Als er een account bestaat, ontvang je een veilige herstel-link.</p>{sent && <div class="message success">Als dit e-mailadres bij een account hoort, is er een herstel-link verstuurd.</div>}{rateLimited && <div class="message">Te veel pogingen. Probeer het over vijftien minuten opnieuw.</div>}<form action="/api/account/password-reset" method="post"><label>E-mailadres<input name="email" type="email" autocomplete="email" required maxlength="254" autofocus /></label><button class="button button-primary" type="submit">Stuur herstel-link</button></form><p><a href="/account/inloggen">Terug naar inloggen</a></p></div></section></MainLayout>
<style>.account-auth{padding-block:clamp(4rem,9vw,8rem)}.account-auth__card{max-width:32rem;margin:auto;padding:clamp(1.5rem,5vw,3.25rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white);box-shadow:var(--shadow)}.account-auth h1{margin-bottom:.8rem;font-size:clamp(2.8rem,7vw,4.5rem)}.account-auth p{color:var(--muted);line-height:1.7}.account-auth form{display:grid;gap:1rem;margin:2rem 0}.account-auth label{display:grid;gap:.45rem;font-size:.78rem;font-weight:700}.account-auth input{min-height:3.1rem;padding:.75rem .9rem;border:1px solid var(--line);border-radius:.65rem;background:var(--paper)}.account-auth .button{justify-self:start}.message{margin-top:1.4rem;padding:.85rem 1rem;border-left:4px solid var(--pink);background:var(--pink-soft);font-size:.86rem;line-height:1.5}.message.success{border-color:var(--ink);background:#dcece7}</style>
