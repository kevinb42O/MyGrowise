---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { listCustomerTransactions } from '../../lib/supabase/accounts';
const transactions = await listCustomerTransactions(Astro.locals.currentUser!.sub);
const labels: Record<string, string> = { draft: 'In voorbereiding', pending_payment: 'Wacht op betaling', paid: 'Betaald', fulfilled: 'Geleverd', cancelled: 'Geannuleerd', partially_refunded: 'Deels terugbetaald', refunded: 'Terugbetaald', disputed: 'In behandeling' };
---
<AccountLayout title="Transacties"><section class="account-heading"><span class="eyebrow">Transacties</span><h1>Een helder overzicht.</h1><p>Hier zie je de status van je aankopen bij MyGrowise.</p></section>{transactions.length ? <div class="transactions">{transactions.map((transaction) => <article><div><strong>{new Intl.DateTimeFormat('nl-BE',{day:'numeric',month:'long',year:'numeric'}).format(new Date(transaction.createdAt))}</strong><small>Bestelling {transaction.id.slice(-8).toUpperCase()}</small>{transaction.provider === 'wise_manual' && transaction.status === 'pending_payment' && transaction.productSlug && <a class="transaction-details" href={`/aanbod/${transaction.productSlug}?order=${encodeURIComponent(transaction.id)}`}>Bekijk Wise-betaalgegevens en referentie →</a>}</div><span>{labels[transaction.status] || transaction.status}</span><b>{new Intl.NumberFormat('nl-BE',{style:'currency',currency:transaction.currency}).format(transaction.totalCents / 100)}</b></article>)}</div> : <section class="account-empty"><span>€</span><h2>Nog geen transacties.</h2><p>Wanneer je iets koopt, zie je hier de datum, het bedrag en de betaalstatus. We tonen geen gevoelige productdetails in dit overzicht.</p></section>}</AccountLayout>
<style>.account-heading{margin-bottom:2.25rem}.account-heading h1{margin-bottom:.65rem;font-size:clamp(3rem,7vw,5.6rem)}.account-heading p{color:var(--muted);line-height:1.7}.transactions{border:1px solid var(--line);border-radius:var(--radius-md);overflow:hidden;background:var(--white)}.transactions article{display:grid;grid-template-columns:1fr auto;gap:.8rem;padding:1.1rem 1.2rem;border-bottom:1px solid var(--line)}.transactions article:last-child{border:0}.transactions strong,.transactions small{display:block}.transactions small{margin-top:.25rem;color:var(--muted);font-size:.72rem}.transactions span{justify-self:start;padding:.3rem .5rem;border-radius:999px;background:var(--cream);font-size:.7rem;font-weight:700}.transactions b{grid-column:2;grid-row:1;font-size:.9rem}.transaction-details{display:inline-block;margin-top:.45rem;color:var(--green);font-size:.74rem;font-weight:800}.account-empty{max-width:41rem;padding:clamp(2rem,6vw,4rem);border:1px dashed var(--line);border-radius:var(--radius-lg);background:var(--cream);text-align:center}.account-empty>span{display:grid;width:3rem;height:3rem;margin:0 auto 1rem;place-items:center;border-radius:50%;background:var(--yellow-soft)}.account-empty h2{font-size:2.3rem}.account-empty p{color:var(--muted);line-height:1.7}@media(min-width:650px){.transactions article{grid-template-columns:1fr auto auto;align-items:center}.transactions span{justify-self:end}.transactions b{grid-column:auto;grid-row:auto}}</style>
