---
import AuthLayout from '../../layouts/AuthLayout.astro';
import PasswordField from '../../components/auth/PasswordField.astro';
import Icon from '../../components/purchases/PurchaseIcon.astro';
import { sanitizeAppRedirect } from '../../lib/adminAuth';
const error = Astro.url.searchParams.get('error');
const next = sanitizeAppRedirect(Astro.url.searchParams.get('next')) || '/account';
const messages: Record<string, string> = { invalid: 'Controleer je naam, e-mailadres en wachtwoord van minstens 12 tekens.', email_taken: 'Er bestaat al een account met dit e-mailadres.', configuration: 'Accountregistratie is nog niet geconfigureerd.', signup_unavailable: 'Account aanmaken lukt momenteel niet door een probleem met het versturen van de bevestigingsmail. Probeer het later opnieuw.' };
---
<AuthLayout title="Account aanmaken — Mijn MyGrowise" heading="Jouw plek bij MyGrowise." intro="Bewaar je aankopen, volg je afspraken en kom terug wanneer het jou past.">
  {messages[error||'']&&<div class="auth-message" role="alert">{messages[error||'']}</div>}
  <form class="auth-form" action="/api/account/register" method="post" data-auth-form>
    <input type="hidden" name="next" value={next}/>
    <div class="auth-field"><label for="register-name">Voor- en achternaam</label><input id="register-name" name="name" autocomplete="name" required minlength="2" maxlength="100" /></div>
    <div class="auth-field"><label for="register-email">E-mailadres</label><input id="register-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" /></div>
    <PasswordField id="register-password" label="Wachtwoord" help="Gebruik minstens 12 tekens." />
    <PasswordField id="register-confirm" name="confirm_password" label="Herhaal wachtwoord" />
    <button class="purchase-button" type="submit">Account aanmaken <Icon name="arrow" /></button>
  </form>
  <div class="auth-links"><p>Heb je al een account? <a href={`/account/inloggen?next=${encodeURIComponent(next)}`}>Log in</a></p><p>Geen bevestigingsmail ontvangen? <a href={`/account/bevestigingslink?next=${encodeURIComponent(next)}`}>Vraag een nieuwe link aan</a></p></div>
</AuthLayout>
