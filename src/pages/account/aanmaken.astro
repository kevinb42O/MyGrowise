---
import MainLayout from '../../layouts/MainLayout.astro';
const error = Astro.url.searchParams.get('error');
const nextParam = Astro.url.searchParams.get('next') || '/account';
const next = /^\/aanbod\/[a-z0-9]+(?:-[a-z0-9]+)*$/.test(nextParam) ? nextParam : '/account';
const messages: Record<string, string> = { invalid: 'Vul een geldige naam, e-mailadres en wachtwoord van minstens 12 tekens in.', email_taken: 'Er bestaat al een account met dit e-mailadres.', configuration: 'Accountregistratie is nog niet geconfigureerd.' };
---
<MainLayout title="Account aanmaken — Mijn MyGrowise" noindex={true}><section class="account-auth"><div class="account-auth__card"><span class="eyebrow">Mijn MyGrowise</span><h1>Jouw plek bij MyGrowise.</h1><p>Bewaar je aankopen, volg je afspraken en kom rustig terug wanneer het jou past.</p>{messages[error || ''] && <div class="message">{messages[error || '']}</div>}<form action="/api/account/register" method="post"><input type="hidden" name="next" value={next}/><label>Voor- en achternaam<input name="name" autocomplete="name" required minlength="2" maxlength="100" autofocus /></label><label>E-mailadres<input name="email" type="email" autocomplete="email" required maxlength="254" /></label><label>Wachtwoord<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256" /><small>Gebruik minstens 12 tekens.</small></label><label>Herhaal wachtwoord<input name="confirm_password" type="password" autocomplete="new-password" required minlength="12" maxlength="256" /></label><button class="button button-primary" type="submit">Account aanmaken</button></form><p>Heb je al een account? <a href={`/account/inloggen?next=${encodeURIComponent(next)}`}>Log in</a>.</p></div></section></MainLayout>
<style>.account-auth{padding-block:clamp(4rem,9vw,8rem)}.account-auth__card{max-width:32rem;margin:auto;padding:clamp(1.5rem,5vw,3.25rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white);box-shadow:var(--shadow)}.account-auth h1{margin-bottom:.8rem;font-size:clamp(2.8rem,7vw,4.5rem)}.account-auth p{color:var(--muted);line-height:1.7}.account-auth form{display:grid;gap:1rem;margin:2rem 0}.account-auth label{display:grid;gap:.45rem;font-size:.78rem;font-weight:700}.account-auth input{min-height:3.1rem;padding:.75rem .9rem;border:1px solid var(--line);border-radius:.65rem;background:var(--paper)}.account-auth small{color:var(--muted);font-size:.72rem;font-weight:500}.account-auth .button{justify-self:start;margin-top:.5rem}.message{margin-top:1.4rem;padding:.85rem 1rem;border-left:4px solid var(--pink);background:var(--pink-soft);font-size:.86rem;line-height:1.5}</style>
