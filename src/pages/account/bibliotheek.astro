---
import AccountLayout from '../../layouts/AccountLayout.astro';
import {listDeliveries,deliveryStatusLabel} from '../../lib/catalog/server';
import {listCustomerEntitlements} from '../../lib/supabase/accounts';
import {profileUrl} from '../../lib/publicProducts';
const [deliveries,entitlements]=await Promise.all([listDeliveries(Astro.locals.currentUser!.sub),listCustomerEntitlements(Astro.locals.currentUser!.sub)]);
const legacy=entitlements.filter(x=>x.status==='active'&&!deliveries.some(d=>d.order_items.product_title===x.productTitle));
Astro.response.headers.set('Cache-Control','private, no-store');Astro.response.headers.set('Referrer-Policy','no-referrer');
---
<AccountLayout title="Mijn afnames & bibliotheek"><section class="account-heading"><span class="eyebrow">Mijn afnames & bibliotheek</span><h1>Jouw inzicht, stap voor stap.</h1><p>Volg je afnames, open je instructies en vind je beschikbare rapporten.</p></section>{deliveries.length||legacy.length?<div class="library-grid">{deliveries.map(d=><article><span>{deliveryStatusLabel[d.status]}</span><h2>{d.title}</h2><p>{d.order_items.product_title}</p><div class="library-actions"><a class="button button-primary" href={`/account/afnames/${d.id}`}>{d.external_url?'Bekijk instructies & start':'Bekijk afname'} →</a>{d.report_path&&<a class="library-report" href={`/api/account/afnames/${d.id}/rapport`}>Download rapport ↓</a>}</div></article>)}{legacy.map(x=><article><span>Beschikbaar product</span><h2>{x.productTitle}</h2><p>Voor dit product staan nog geen afname-instructies klaar. MyGrowise helpt je met de volgende stap.</p><a class="button button-primary" href={x.productType==='profile'?profileUrl(x.productSlug):`/aanbod/${x.productSlug}`}>Bekijk product</a></article>)}</div>:<section class="account-empty"><span>✳</span><h2>Een nieuw vertrekpunt.</h2><p>Na bevestiging van je betaling verschijnen je afnames hier. Heb je al besteld? Bekijk dan de betalingsgegevens bij je bestellingen.</p><div><a class="button button-primary" href="/vragenlijsten">Ontdek vragenlijsten</a><a href="/account/transacties">Mijn bestellingen →</a></div></section>}</AccountLayout>
<style>.account-heading{margin-bottom:2.25rem}.account-heading h1{margin:.8rem 0;font-size:clamp(3rem,7vw,5.6rem)}.account-heading p{color:var(--muted);line-height:1.7}.library-grid{display:grid;gap:1rem}.library-grid article{display:flex;min-height:17rem;flex-direction:column;padding:1.6rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--white)}.library-grid article>span{color:var(--pink);font-size:.65rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.library-grid h2{margin:1.5rem 0 .6rem;font-size:2rem}.library-grid p{color:var(--muted);font-size:.85rem;line-height:1.7}.library-grid .button{align-self:flex-start;font-size:.75rem}.library-actions{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-top:auto}.library-report{font-size:.75rem;font-weight:700}.account-empty{max-width:41rem;padding:clamp(2rem,6vw,4rem);border:1px dashed var(--line);border-radius:var(--radius-lg);background:var(--cream);text-align:center}.account-empty>span{font-size:2rem;color:var(--pink)}.account-empty h2{font-size:2.3rem}.account-empty p{color:var(--muted);line-height:1.7}.account-empty>div{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;align-items:center;font-size:.8rem}@media(min-width:700px){.library-grid{grid-template-columns:repeat(2,1fr)}}</style>
