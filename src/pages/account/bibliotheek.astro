---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { listCustomerEntitlements } from '../../lib/practiceDb';
const items = listCustomerEntitlements(Astro.locals.currentUser!.sub);
---
<AccountLayout title="Mijn bibliotheek"><section class="account-heading"><span class="eyebrow">Mijn bibliotheek</span><h1>Van jou, op jouw tempo.</h1><p>Alles wat je bij MyGrowise koopt, blijft hier beschikbaar.</p></section>{items.length ? <div class="library-grid">{items.map((item) => <article><span>{item.productType}</span><h2>{item.productTitle}</h2><p>Beschikbaar sinds {new Intl.DateTimeFormat('nl-BE',{day:'numeric',month:'long',year:'numeric'}).format(new Date(item.grantedAt))}</p><a class="button button-primary" href={`/profielen/${item.productSlug}`}>Open</a></article>)}</div> : <section class="account-empty"><span>✦</span><h2>Je bibliotheek is nog rustig.</h2><p>Na een aankoop komt je profiel, module, audio of download automatisch hier terecht. Je behoudt levenslange toegang.</p><a class="button button-primary" href="/profielen">Ontdek profielen</a></section>}</AccountLayout>
<style>.account-heading{margin-bottom:2.25rem}.account-heading h1{margin-bottom:.65rem;font-size:clamp(3rem,7vw,5.6rem)}.account-heading p{color:var(--muted);line-height:1.7}.library-grid{display:grid;gap:1rem}.library-grid article{display:flex;min-height:17rem;flex-direction:column;padding:1.6rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--white)}.library-grid article>span{color:var(--pink);font-size:.7rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.library-grid h2{margin:2rem 0 .6rem;font-size:2rem}.library-grid p{color:var(--muted);font-size:.85rem}.library-grid .button{align-self:flex-start;margin-top:auto}.account-empty{max-width:41rem;padding:clamp(2rem,6vw,4rem);border:1px dashed var(--line);border-radius:var(--radius-lg);background:var(--cream);text-align:center}.account-empty>span{display:grid;width:3rem;height:3rem;margin:0 auto 1rem;place-items:center;border-radius:50%;background:var(--pink-soft)}.account-empty h2{font-size:2.3rem}.account-empty p{color:var(--muted);line-height:1.7}.account-empty .button{margin-top:.8rem}@media(min-width:700px){.library-grid{grid-template-columns:repeat(2,1fr)}}</style>
