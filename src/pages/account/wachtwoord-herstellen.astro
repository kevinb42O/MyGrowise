---
import {sanitizeAppRedirect} from '../../lib/adminAuth';
import AuthLayout from '../../layouts/AuthLayout.astro';
import PasswordField from '../../components/auth/PasswordField.astro';
import Icon from '../../components/purchases/PurchaseIcon.astro';
const next=sanitizeAppRedirect(Astro.url.searchParams.get('next'))||'/account';
---
<AuthLayout title="Kies een wachtwoord — Mijn MyGrowise" heading="Een nieuw wachtwoord." intro="Kies een uniek wachtwoord om opnieuw toegang te krijgen tot je account." compact>
  <p id="recovery-status" data-next={next} class="auth-status" role="status" aria-live="polite">We controleren je herstellink…</p>
  <a id="recovery-retry" class="auth-recovery-link" href={`/account/wachtwoord-vergeten?next=${encodeURIComponent(next)}`} hidden>Vraag een nieuwe herstellink aan</a>
  <form id="recovery-form" class="auth-form" hidden>
    <PasswordField id="recovery-password" label="Nieuw wachtwoord" help="Gebruik minstens 12 tekens." />
    <PasswordField id="recovery-confirm" name="confirm_password" label="Herhaal nieuw wachtwoord" />
    <button class="purchase-button" type="submit">Wachtwoord opslaan <Icon name="arrow" /></button>
  </form>
  <noscript><p>Schakel JavaScript in om je herstellink te gebruiken.</p><a class="auth-recovery-link" href="/contact">Vraag hulp</a></noscript>
  <div class="auth-links"><a href={`/account/inloggen?next=${encodeURIComponent(next)}`}>Terug naar inloggen</a></div>
</AuthLayout>
<script>
  import {createBrowserSupabaseClient} from '../../lib/supabase/browser';
  const status=document.querySelector<HTMLElement>('#recovery-status')!;
  const form=document.querySelector<HTMLFormElement>('#recovery-form')!;
  const retry=document.querySelector<HTMLAnchorElement>('#recovery-retry')!;
  const unavailable=(message:string)=>{status.textContent=message;status.setAttribute('role','alert');retry.hidden=false;};
  try {
    const client=createBrowserSupabaseClient();
    const {data:{session},error}=await client.auth.getSession();
    if(error||!session)unavailable('Deze herstellink is ongeldig of verlopen. Vraag een nieuwe link aan om verder te gaan.');
    else {status.textContent='Gebruik twee gelijke wachtwoorden van minstens 12 tekens.';form.hidden=false;}
    form.addEventListener('submit',async event=>{
      event.preventDefault();const values=new FormData(form);const password=String(values.get('password')||'');
      if(password!==String(values.get('confirm_password')||'')||password.length<12){unavailable('Vul twee gelijke wachtwoorden van minstens 12 tekens in.');return;}
      const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;button.disabled=true;button.textContent='Wachtwoord wordt opgeslagen…';
      try{
        const {error}=await client.auth.updateUser({password});if(error)throw error;
        await client.auth.signOut();window.location.assign(`/account/inloggen?error=password_reset&next=${encodeURIComponent(status.dataset.next||'/account')}`);
      }catch{unavailable('Opslaan lukt nu niet. Probeer opnieuw of vraag een nieuwe herstellink aan.');button.disabled=false;button.textContent='Wachtwoord opslaan';}
    });
  }catch{unavailable('Je herstellink kan nu niet worden gecontroleerd. Vraag een nieuwe link aan of neem contact op.');}
</script>
