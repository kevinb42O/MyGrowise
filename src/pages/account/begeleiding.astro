---
import AccountLayout from '../../layouts/AccountLayout.astro';
import { listCustomerBookings } from '../../lib/supabase/accounts';
const user = Astro.locals.currentUser!; const all = await listCustomerBookings(user.sub); const now = Date.now();
const future = all.filter((booking) => new Date(booking.startsAt).getTime() > now && ['pending', 'confirmed'].includes(booking.status)).sort((a,b) => a.startsAt.localeCompare(b.startsAt));
const past = all.filter((booking) => !future.some((item) => item.id === booking.id));
const status: Record<string, string> = { pending: 'Aanvraag in behandeling', confirmed: 'Bevestigd', declined: 'Niet bevestigd', cancelled: 'Geannuleerd', completed: 'Afgerond', no_show: 'Niet doorgegaan' };
const date = (value: string) => new Intl.DateTimeFormat('nl-BE',{timeZone:'Europe/Brussels',weekday:'long',day:'numeric',month:'long',hour:'2-digit',minute:'2-digit'}).format(new Date(value));
const cancelled = Astro.url.searchParams.get('cancelled') === '1'; const cancelError = Astro.url.searchParams.get('cancel_error');
---
<AccountLayout title="Mijn begeleiding"><section class="account-heading"><span class="eyebrow">Mijn begeleiding</span><h1>Praktisch, wanneer jij het nodig hebt.</h1><p>Bekijk je afspraken en regel alleen de praktische kant van je begeleiding.</p></section>{cancelled && <div class="account-message success">Je afspraak is geannuleerd.</div>}{cancelError && <div class="account-message">Deze afspraak kan niet meer online worden geannuleerd. Neem contact op met je professional.</div>}<section class="care-section"><div class="care-section__top"><div><span class="account-label">Komende afspraken</span><h2>{future.length ? 'Wat er gepland staat' : 'Nog niets gepland'}</h2></div><a class="button button-primary" href="/begeleiding">Plan een afspraak</a></div>{future.length ? <div class="appointments">{future.map((booking) => <article><div class="appointment-date"><strong>{new Intl.DateTimeFormat('nl-BE',{day:'2-digit'}).format(new Date(booking.startsAt))}</strong><span>{new Intl.DateTimeFormat('nl-BE',{month:'short'}).format(new Date(booking.startsAt))}</span></div><div><h3>{booking.practitionerName}</h3><p>{date(booking.startsAt)} · Online afspraak</p><span class:list={{ 'appointment-status': true, pending: booking.status === 'pending' }}>{status[booking.status]}</span></div><div class="appointment-actions"><a href={`/begeleiding/${booking.practitionerSlug}`}>Verplaatsen</a>{booking.status !== 'pending' && <form action={`/api/account/begeleiding/${booking.id}/annuleren`} method="post"><button type="submit">Annuleren</button></form>}</div></article>)}</div> : <div class="care-empty"><p>Wanneer je een afspraak aanvraagt of boekt, verschijnt die hier automatisch. We tonen geen inhoud uit gesprekken of sessies.</p></div>}</section>{past.length ? <section class="care-history"><span class="account-label">Eerdere afspraken</span><h2>Overzicht</h2>{past.map((booking) => <article><span>{new Intl.DateTimeFormat('nl-BE',{day:'numeric',month:'short',year:'numeric'}).format(new Date(booking.startsAt))}</span><strong>{booking.practitionerName}</strong><small>{status[booking.status]}</small></article>)}</section> : null}</AccountLayout>
<style>.account-heading{margin-bottom:2.25rem}.account-heading h1{max-width:12ch;margin-bottom:.65rem;font-size:clamp(3rem,7vw,5.6rem)}.account-heading p{max-width:57ch;color:var(--muted);line-height:1.7}.account-label{display:block;margin-bottom:.7rem;color:var(--pink);font-size:.7rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.account-message{margin-bottom:1rem;padding:.9rem 1rem;border-left:4px solid var(--pink);background:var(--pink-soft);font-size:.86rem}.account-message.success{border-color:var(--ink);background:#dcece7}.care-section{padding:clamp(1.3rem,4vw,2rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white)}.care-section__top{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1.3rem;margin-bottom:1.4rem}.care-section h2,.care-history h2{margin:0;font-size:2rem}.appointments{display:grid;gap:.7rem}.appointments article{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:start;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-sm)}.appointment-date{display:grid;width:3.3rem;height:3.3rem;place-content:center;border-radius:.7rem;background:var(--cream);text-align:center}.appointment-date strong{font-family:'DM Serif Display',Georgia,serif;font-size:1.45rem;line-height:1}.appointment-date span{font-size:.65rem;font-weight:800;text-transform:uppercase}.appointments h3{margin:0 0 .3rem;font-family:'DM Sans',sans-serif;font-size:.95rem;font-weight:800;letter-spacing:0}.appointments p{margin:.25rem 0 .6rem;color:var(--muted);font-size:.8rem;line-height:1.5}.appointment-status{display:inline-flex;padding:.28rem .48rem;border-radius:999px;background:#dcece7;color:var(--ink);font-size:.67rem;font-weight:800}.appointment-status.pending{background:var(--yellow-soft)}.appointment-actions{display:flex;gap:.8rem;grid-column:2;font-size:.75rem;font-weight:800}.appointment-actions a,.appointment-actions button{border:0;background:none;color:var(--ink);font:inherit;font-weight:800;text-decoration:underline;cursor:pointer}.care-empty{padding:1.4rem;border-radius:var(--radius-sm);background:var(--cream)}.care-empty p{max-width:60ch;margin:0;color:var(--muted);font-size:.88rem;line-height:1.7}.care-history{margin-top:2.5rem}.care-history>article{display:grid;grid-template-columns:1fr auto;gap:.4rem;padding:1rem 0;border-bottom:1px solid var(--line)}.care-history span,.care-history small{color:var(--muted);font-size:.78rem}.care-history small{grid-column:2}@media(min-width:700px){.appointments article{grid-template-columns:auto 1fr auto;align-items:center}.appointment-actions{grid-column:auto;justify-content:end}.care-history>article{grid-template-columns:10rem 1fr auto;align-items:center}.care-history small{grid-column:auto}}</style>
