---
import AuthLayout from '../../layouts/AuthLayout.astro';
import Icon from '../../components/purchases/PurchaseIcon.astro';
import {sanitizeAppRedirect} from '../../lib/adminAuth';
const next=sanitizeAppRedirect(Astro.url.searchParams.get('next'))||'/account';
---
<AuthLayout title="Nieuwe bevestigingslink — Mijn MyGrowise" heading="Je e-mailadres bevestigen." intro="Geen bevestigingsmail ontvangen? Kijk eerst in je spammap. Je kunt hieronder een nieuwe link aanvragen." compact>
  <form class="auth-form" action="/api/account/verification-resend" method="post" data-auth-form>
    <input type="hidden" name="next" value={next}/>
    <div class="auth-field"><label for="confirmation-email">E-mailadres van je account</label><input id="confirmation-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="jij@voorbeeld.be" required maxlength="254"/><small>We sturen alleen een link als je account nog bevestigd moet worden.</small></div>
    <button class="purchase-button" type="submit">Stuur een nieuwe link <Icon name="arrow" /></button>
  </form>
  <div class="auth-links"><a href={`/account/inloggen?next=${encodeURIComponent(next)}`}>Terug naar inloggen</a></div>
</AuthLayout>
