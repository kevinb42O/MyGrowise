---
import MainLayout from '../../layouts/MainLayout.astro';
import { sanitizeAppRedirect } from '../../lib/adminAuth';

const next = sanitizeAppRedirect(Astro.url.searchParams.get('next')) || '/account';
const loginHref = `/account/inloggen?next=${encodeURIComponent(next)}`;
---

<MainLayout title="Nieuwe bevestigingslink — Mijn MyGrowise" noindex={true}>
  <section class="confirmation-help">
    <div class="confirmation-help__card">
      <span class="eyebrow">Hulp bij je account</span>
      <h1>Geen bevestigingsmail ontvangen?</h1>
      <p>Controleer eerst je ongewenste e-mail. Nog niets gevonden? Vul het e-mailadres in waarmee je je account hebt aangemaakt. We sturen een nieuwe link als je account nog bevestigd moet worden.</p>
      <form action="/api/account/verification-resend" method="post">
        <input type="hidden" name="next" value={next} />
        <label for="confirmation-email">E-mailadres</label>
        <input id="confirmation-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="jij@voorbeeld.be" required maxlength="254" autofocus />
        <button class="button button-primary" type="submit">Stuur een nieuwe link</button>
      </form>
      <a class="confirmation-help__back" href={loginHref}>← Terug naar inloggen</a>
    </div>
  </section>
</MainLayout>

<style>
  .confirmation-help { padding: clamp(3rem, 8vw, 6rem) 1rem; }
  .confirmation-help__card { max-width: 36rem; margin: auto; padding: clamp(1.7rem, 5vw, 3.25rem); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--white); box-shadow: var(--shadow); }
  .confirmation-help h1 { margin: 0 0 1rem; font-size: clamp(2.7rem, 6vw, 4rem); line-height: 1.05; }
  .confirmation-help p { margin-bottom: 2rem; color: var(--muted); font-size: .95rem; line-height: 1.7; }
  .confirmation-help form { display: grid; gap: .75rem; }
  .confirmation-help label { font-size: .82rem; font-weight: 700; }
  .confirmation-help input { min-height: 3.35rem; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: .7rem; background: white; }
  .confirmation-help .button { justify-self: start; margin-top: .5rem; }
  .confirmation-help__back { display: inline-block; margin-top: 2rem; color: var(--muted); font-size: .82rem; font-weight: 700; text-decoration: underline; text-underline-offset: .2rem; }
</style>
