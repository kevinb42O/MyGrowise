---
import MainLayout from '../layouts/MainLayout.astro';
import { isCustomerAccount } from '../lib/adminAuth';
import { supportMailReady } from '../lib/supportMail';
const customer = isCustomerAccount(Astro.locals.currentUser) ? Astro.locals.currentUser : null;
const available = supportMailReady();
const sent = Astro.url.searchParams.get('sent') === '1';
const reference = Astro.url.searchParams.get('ref') || '';
const error = Astro.url.searchParams.get('error');
const submissionKey = crypto.randomUUID();
const errors: Record<string,string> = { invalid: 'Controleer je e-mailadres en vraag en probeer opnieuw.', limited: 'Er zijn kort na elkaar te veel aanvragen verstuurd. Probeer het later opnieuw of mail ons rechtstreeks.', verify: 'Bevestig eerst je e-mailadres via de link in je accountmail, of stuur ons een gewone e-mail.', unavailable: 'Het berichtenformulier is tijdelijk niet beschikbaar. Mail ons rechtstreeks; je vraag gaat dan niet verloren.' };
---
<MainLayout activeNav="contact" title="Contact — MyGrowise" description="Stuur MyGrowise een praktische vraag zonder account of mail ons rechtstreeks.">
  <section class="contact-hero"><div class="container contact-grid"><div><span class="eyebrow">Contact</span><h1>Een vraag mag ook gewoon een vraag zijn.</h1><p class="lead">Vertel ons wat je nodig hebt. Voor een praktisch antwoord hoef je geen account aan te maken.</p><a class="contact-anchor" href="#formulier">Stuur ons een bericht <span aria-hidden="true">↓</span></a></div><div class="contact-card"><span>Waarmee kunnen we helpen?</span><ul><li>Een vraag over een profiel of module</li><li>Hulp bij een bestelling of toegang</li><li>Praktische informatie over MyGrowise</li><li>Een professionele samenwerking</li></ul><p>Voor een afspraak kies je rechtstreeks een vrij moment via de profielpagina van de professional.</p></div></div></section>
  <section class="section contact-form-section" id="formulier"><div class="container contact-form-grid"><div><span class="eyebrow">Stuur een vraag</span><h2 class="heading-lg">We lezen met je mee.</h2><p>Stuur alleen de informatie die nodig is voor je praktische vraag. Deel hier geen diagnoses, intake- of sessie-inhoud.</p><p>Je krijgt per e-mail bericht wanneer ons antwoord klaarstaat. Met de link in die e-mail lees je het gesprek en kan je reageren.</p><p class="contact-direct">Liever je eigen mailapp gebruiken? <a href="mailto:info@mygrowise.be">Mail info@mygrowise.be</a>.</p></div><div class="contact-form-card">
    {sent && <div class="contact-alert contact-alert--success" role="status"><strong>Je vraag is ontvangen.</strong><p>We sturen een bevestiging naar je e-mailadres. Via de link in die e-mail kan je ons antwoord lezen en reageren. Kijk ook in je spammap.</p>{reference && <p>Referentie: <strong>{reference}</strong></p>}</div>}
    {error && errors[error] && <div class="contact-alert" role="alert">{errors[error]}</div>}
    {available ? <form action="/api/contact" method="post" data-contact-form><input type="hidden" name="submission_key" value={submissionKey}/><div class="contact-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label>Waarover gaat je vraag?<select name="category" required><option value="general">Algemene vraag</option><option value="order">Bestelling</option><option value="access">Toegang tot een product</option><option value="booking">Afspraak</option><option value="privacy">Privacy</option><option value="collaboration">Samenwerking</option><option value="other">Anders</option></select></label><label>Je vraag<textarea name="body" required maxlength="4000" rows="6" placeholder="Hoe kunnen we je praktisch verder helpen?"></textarea></label><div class="contact-form-row"><label>E-mailadres<input name="email" type="email" autocomplete="email" required maxlength="254" value={customer?.email || ''} readonly={Boolean(customer)}/><small>Hier sturen we je de link naar ons antwoord.</small></label><label>Naam <span>(optioneel)</span><input name="name" type="text" autocomplete="name" maxlength="100" value={customer?.name || ''} readonly={Boolean(customer)}/></label></div><button class="button button-primary" type="submit">Verstuur bericht</button><small class="contact-privacy">Je bericht en ons antwoord blijven in een beveiligd gesprek. Lees hoe we je gegevens gebruiken in onze <a href="/privacy">privacyverklaring</a>.</small></form> : <div class="contact-alert"><strong>Berichtenformulier tijdelijk niet beschikbaar.</strong><p>Je kan ons bereiken via <a href="mailto:info@mygrowise.be">info@mygrowise.be</a>.</p></div>}
  </div></div></section>
  <section class="section"><div class="container split"><div><span class="eyebrow">Persoonlijke begeleiding</span><h2 class="heading-lg">Wil je een gesprek plannen?</h2><p class="lead">Bekijk eerst de focus van de verschillende professionals. Zo kom je meteen op de juiste boekingspagina terecht.</p><a class="button button-light" href="/begeleiding">Vind een professional</a></div><div class="crisis"><span>Bij acute nood</span><h2>MyGrowise is geen crisisdienst.</h2><p>Bel bij onmiddellijk gevaar 112. In België kan je bij zelfmoordgedachten gratis en anoniem contact opnemen met Zelfmoordlijn 1813.</p><a href="https://www.zelfmoord1813.be/" target="_blank" rel="noopener noreferrer">Naar Zelfmoordlijn 1813 ↗</a></div></div></section>
</MainLayout>
<script>const form = document.querySelector<HTMLFormElement>('[data-contact-form]'); if (form) { const key = 'mygrowise-contact-draft'; const fields = ['body','email','name','category'] as const; try { const saved = JSON.parse(sessionStorage.getItem(key) || '{}'); if (new URLSearchParams(location.search).has('sent')) sessionStorage.removeItem(key); else { fields.forEach((field) => { const input = form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (input && saved[field] && !input.value) input.value = saved[field]; }); form.addEventListener('input', () => { const draft: Record<string,string> = {}; fields.forEach((field) => { const input = form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (input) draft[field] = input.value; }); sessionStorage.setItem(key, JSON.stringify(draft)); }); } } catch {} }</script>
<style>
.contact-hero{padding-block:clamp(4rem,10vw,9rem);background:var(--pink-soft)}.contact-grid{display:grid;gap:3rem;align-items:center}.contact-grid h1{max-width:10ch;margin-bottom:1.5rem;font-size:clamp(3.5rem,8vw,7rem);line-height:.9}.contact-anchor{display:inline-flex;gap:.6rem;margin-top:1rem;color:var(--ink);font-weight:800;text-underline-offset:.3rem}.contact-card{padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--ink);border-radius:var(--radius-lg);background:var(--yellow)}.contact-card>span,.crisis>span{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.contact-card ul{margin:2rem 0;padding:0;list-style:none}.contact-card li{padding:.9rem 0;border-top:1px solid rgba(23,61,53,.25);font-weight:600}.contact-card li:last-child{border-bottom:1px solid rgba(23,61,53,.25)}.contact-card li::before{content:'→';margin-right:.7rem}.contact-card p{margin:0;font-size:.78rem;line-height:1.6}.contact-form-section{background:var(--paper)}.contact-form-grid{display:grid;gap:2.5rem}.contact-form-grid>div:first-child p{max-width:48ch;color:var(--muted);line-height:1.7}.contact-direct{padding-top:1rem}.contact-direct a,.contact-privacy a{color:var(--ink);font-weight:800}.contact-form-card{align-self:start;padding:clamp(1.25rem,4vw,2.5rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white);box-shadow:var(--shadow)}.contact-form-card form{display:grid;gap:1.2rem}.contact-form-card label{display:grid;gap:.42rem;font-size:.75rem;font-weight:800}.contact-form-card label span{color:var(--muted);font-weight:500}.contact-form-card input,.contact-form-card select,.contact-form-card textarea{width:100%;min-height:3.05rem;padding:.8rem .9rem;border:1px solid var(--line);border-radius:.65rem;background:var(--paper);color:var(--ink);font:inherit;font-size:.85rem}.contact-form-card textarea{resize:vertical}.contact-form-card small{color:var(--muted);font-size:.68rem;line-height:1.5}.contact-form-card .button{justify-self:start}.contact-privacy{max-width:58ch}.contact-form-row{display:grid;gap:1.2rem}.contact-alert{margin-bottom:1.3rem;padding:1rem;border-left:4px solid var(--pink);background:var(--pink-soft);font-size:.85rem;line-height:1.6}.contact-alert p{margin:.3rem 0}.contact-alert--success{border-color:var(--ink);background:#e5f1eb}.contact-honeypot{position:absolute;left:-9999px;opacity:0}.split{display:grid;gap:2rem}.split>div{padding:clamp(1.5rem,4vw,3rem);border-radius:var(--radius-lg)}.split>div:first-child{border:1px solid var(--line);background:var(--white)}.crisis{background:var(--ink);color:white}.crisis>span{color:var(--pink)}.crisis h2{margin:2rem 0 1rem;font-size:2.6rem}.crisis p{color:rgba(255,255,255,.65);line-height:1.7}.crisis a{color:var(--yellow);font-weight:700;text-decoration:none}@media(min-width:750px){.contact-form-row{grid-template-columns:1fr 1fr}}@media(min-width:900px){.contact-grid{grid-template-columns:1.1fr .9fr}.contact-form-grid{grid-template-columns:.8fr 1.2fr}.split{grid-template-columns:1fr 1fr}}
</style>
