---
import MainLayout from '../layouts/MainLayout.astro';
import BusinessDetails from '../components/astro/BusinessDetails.astro';
import { isCustomerAccount } from '../lib/adminAuth';
import { websiteMailReady } from '../lib/commerce/websiteMail';
const customer = isCustomerAccount(Astro.locals.currentUser) ? Astro.locals.currentUser : null;
const available = websiteMailReady();
const sent = Astro.url.searchParams.get('sent') === '1';
const reference = Astro.url.searchParams.get('ref') || '';
const error = Astro.url.searchParams.get('error');
const submissionKey = crypto.randomUUID();
const errors: Record<string,string> = { invalid: 'Controleer je e-mailadres en vraag en probeer opnieuw.', limited: 'Er zijn kort na elkaar te veel aanvragen verstuurd. Probeer het later opnieuw of mail ons rechtstreeks.', verify: 'Bevestig eerst je e-mailadres via de link in je accountmail, of stuur ons een gewone e-mail.', unavailable: 'Het berichtenformulier is tijdelijk niet beschikbaar. Mail ons rechtstreeks; je vraag gaat dan niet verloren.' };
---
<MainLayout activeNav="contact" title="Contact — MyGrowise" description="Stuur MyGrowise een praktische vraag zonder account of mail ons rechtstreeks.">
  <section class="section contact-form-section" id="formulier"><div class="container contact-form-grid" data-no-motion><div class="contact-intro"><h1>Een vraag mag ook <br /><em>gewoon een vraag zijn.</em></h1><p class="contact-intro-lead">Voor een praktisch antwoord hoef je geen account aan te maken.</p><a class="contact-mail" href="mailto:info@mygrowise.be">info@mygrowise.be</a><p class="contact-appointment">Een afspraak plannen? <a href="/begeleiding">Kies een professional en een vrij moment.</a></p></div><div class="contact-form-card">
    {sent && <div class="contact-alert contact-alert--success" role="status"><strong>Je vraag is ontvangen.</strong><p>We beantwoorden je praktische vraag per e-mail. Je hoeft geen account of online gesprek te openen.</p>{reference && <p>Referentie: <strong>{reference}</strong></p>}</div>}
    {error && errors[error] && <div class="contact-alert" role="alert">{errors[error]}</div>}
    {available ? <form aria-label="Stuur een praktische vraag" action="/api/contact" method="post" data-contact-form><input type="hidden" name="submission_key" value={submissionKey}/><div class="contact-honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label>Waarover gaat je vraag?<select name="category" required><option value="Bestelling">Bestelling</option><option value="Module">Module</option><option value="Afspraak">Afspraak</option><option value="Profiel">Profiel</option></select></label><p class="contact-form-safety">Deel hier alleen je praktische vraag, geen diagnoses, intake- of sessie-inhoud. Je krijgt antwoord per e-mail.</p><label>Je vraag<textarea name="body" required maxlength="4000" rows="6" placeholder="Hoe kunnen we je praktisch verder helpen?"></textarea></label><div class="contact-form-row"><label>E-mailadres<input name="email" type="email" autocomplete="email" required maxlength="254" value={customer?.email || ''} readonly={Boolean(customer)}/><small>Hier sturen we ons antwoord naartoe.</small></label><label><span class="contact-name-label">Naam <small>(optioneel)</small></span><input name="name" type="text" autocomplete="name" maxlength="100" value={customer?.name || ''} readonly={Boolean(customer)}/></label></div><button class="button button-primary" type="submit">Verstuur bericht</button><small class="contact-privacy">Je praktische vraag wordt per e-mail behandeld. Lees hoe we je gegevens gebruiken in onze <a href="/privacy">privacyverklaring</a>.</small></form> : <div class="contact-alert"><strong>Berichtenformulier tijdelijk niet beschikbaar.</strong><p>Je kan ons bereiken via <a href="mailto:info@mygrowise.be">info@mygrowise.be</a>.</p></div>}
  </div></div></section>
  <section class="section"><div class="container split"><div><h2 class="heading-lg">Wil je een gesprek plannen?</h2><p class="lead">Bekijk eerst de focus van de verschillende professionals. Zo kom je meteen op de juiste boekingspagina terecht.</p><a class="button button-light" href="/begeleiding">Vind een professional</a></div><div class="crisis"><span>Bij acute nood</span><h2>MyGrowise is geen crisisdienst.</h2><p>Bel bij onmiddellijk gevaar 112. In België kan je bij zelfmoordgedachten gratis en anoniem contact opnemen met Zelfmoordlijn 1813.</p><a href="https://www.zelfmoord1813.be/" target="_blank" rel="noopener noreferrer">Naar Zelfmoordlijn 1813 ↗</a></div></div></section>
  <section class="section"><div class="container"><h2 class="heading-lg">MyGrowise wordt aangeboden door I-Transform SLU.</h2><BusinessDetails /><p><a href="mailto:info@mygrowise.be">info@mygrowise.be</a></p></div></section>
</MainLayout>
<script>const form = document.querySelector<HTMLFormElement>('[data-contact-form]'); if (form) { const key = 'mygrowise-contact-draft'; const fields = ['body','email','name','category'] as const; try { const saved = JSON.parse(sessionStorage.getItem(key) || '{}'); if (new URLSearchParams(location.search).has('sent')) sessionStorage.removeItem(key); else { fields.forEach((field) => { const input = form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (input && saved[field] && !input.value) input.value = saved[field]; }); form.addEventListener('input', () => { const draft: Record<string,string> = {}; fields.forEach((field) => { const input = form.elements.namedItem(field) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null; if (input) draft[field] = input.value; }); sessionStorage.setItem(key, JSON.stringify(draft)); }); } } catch {} }</script>
<style>
.contact-form-section{padding:clamp(2.5rem,6vw,5rem) 0;background:var(--cream);scroll-margin-top:6rem}.contact-form-grid{display:grid;align-items:start;gap:clamp(2rem,5vw,5rem)}.contact-intro{padding-top:1rem}.contact-intro h1{font-size:clamp(2.7rem,4.6vw,4.6rem);line-height:1.04;max-width:14ch;margin:0 0 1.5rem;text-wrap:balance}.contact-intro h1 em{color:#823f49}.contact-intro p{max-width:48ch;font-size:.95rem;line-height:1.8;color:var(--muted)}.contact-intro .contact-intro-lead{font-size:1.1rem;color:var(--ink)}.contact-mail{display:inline-flex;align-items:center;min-height:44px;font-size:1rem;font-weight:600;text-underline-offset:.25rem}.contact-appointment{padding-top:1.25rem;border-top:1px solid var(--line);margin-top:1.5rem}.contact-appointment a{font-weight:600;color:var(--ink)}
.contact-form-card{align-self:start;padding:clamp(1.5rem,3vw,2.25rem);border:1px solid var(--line);border-radius:12px;background:var(--white)}.contact-form-safety{font-size:.85rem;line-height:1.7;color:var(--muted);margin:0}.contact-form-card form{display:grid;gap:1.2rem}.contact-form-card label{line-height:1.5;display:grid;gap:.5rem;font-size:.875rem;font-weight:600}.contact-form-card input,.contact-form-card select,.contact-form-card textarea{width:100%;min-height:52px;padding:.8rem .9rem;border:1px solid var(--line);border-radius:8px;background:var(--white);color:var(--ink);font:inherit;font-size:1rem;caret-color:var(--ink)}.contact-form-card input:hover,.contact-form-card select:hover,.contact-form-card textarea:hover{border-color:var(--muted)}.contact-form-card textarea{resize:vertical}.contact-form-card textarea::placeholder{color:var(--muted);opacity:1}.contact-form-card small{color:var(--muted);font-size:.8rem;line-height:1.7;font-weight:400}.contact-name-label small{line-height:1}.contact-name-label{color:var(--ink);font-weight:600}.contact-form-card .button{justify-self:start;border-radius:8px;box-shadow:none;min-height:52px}.contact-privacy{max-width:58ch}.contact-privacy a{color:var(--ink);font-weight:600}.contact-form-row{display:grid;align-items:start;gap:1.2rem}.contact-alert{margin-bottom:1.3rem;padding:1rem;border-radius:8px;background:var(--pink-soft);font-size:.9rem;line-height:1.7}.contact-alert p{margin:.3rem 0}.contact-alert--success{background:#e8eee7}.contact-honeypot{position:absolute;left:-9999px;opacity:0}
.split{display:grid;gap:2rem}.split>div{padding:clamp(1.5rem,4vw,3rem);border-radius:12px}.split>div:first-child{border:1px solid var(--line);background:var(--white)}.split .heading-lg{font-size:2.5rem}.split .lead{font-size:1rem}.crisis{background:var(--ink);color:white}.crisis>span{font-size:.8rem;font-weight:600;color:var(--pink-soft)}.crisis h2{margin:1.5rem 0 1rem;font-size:2rem;line-height:1.15}.crisis p{color:rgba(255,255,255,.8);line-height:1.75}.crisis a{display:inline-flex;align-items:center;min-height:44px;color:var(--yellow-soft);font-weight:600;text-underline-offset:.25rem}.contact-form-section~.section{padding-block:3.5rem}.contact-form-section~.section .heading-lg{font-size:2.5rem;max-width:24ch}
@media(min-width:750px){.contact-form-row{grid-template-columns:1fr 1fr}}@media(min-width:900px){.contact-form-grid{grid-template-columns:.85fr 1.15fr}.split{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.contact-intro h1{font-size:2.4rem;max-width:none}.contact-appointment{display:none}.contact-form-section{padding-top:2rem}.contact-intro h1 br{display:none}.contact-form-grid{gap:1.5rem}.contact-form-card{padding:1.25rem}.split .heading-lg,.contact-form-section~.section .heading-lg{font-size:2rem}}
</style>
