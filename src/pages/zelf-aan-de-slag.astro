---
import MainLayout from '../layouts/MainLayout.astro';

const routes = [
  {
    title: 'Profielen', direction: 'Een breder beeld',
    description: 'Een samenhangend pakket van vragenlijsten rond jouw thema. Een vertrekpunt om beter te begrijpen wat er speelt.',
    detail: 'Verschillende vragenlijsten, samengebracht in één profiel.',
    href: '/profielen', action: 'Ontdek profielen',
    image: '/images/profiles/stress-en-emotieprofiel-v1.webp',
  },
  {
    title: 'Losse vragenlijsten', direction: 'Een gerichte vraag',
    description: 'Kies gericht wat je over jezelf of je kind wilt begrijpen. Bekijk welke vragenlijst aansluit bij jouw vraag.',
    detail: 'Los te kiezen of te combineren met ander beschikbaar aanbod.',
    href: '/vragenlijsten', action: 'Ontdek vragenlijsten',
    image: '/images/profiles/prikkelverwerkingsprofiel-v1.webp',
  },
  {
    title: 'Online modules', direction: 'Zelf aan de slag',
    description: 'Zelfstandig werken met uitleg, oefeningen en audio. Je hoeft niet eerst een profiel te kopen om een module te volgen.',
    detail: 'Zes modules in voorbereiding. Bekijk per module de beschikbaarheid.',
    href: '/modules', action: 'Ontdek de modules',
    image: '/images/modules/het-meer.webp',
  },
];
---

<MainLayout activeNav="zelf" title="Zelf aan de slag — MyGrowise" description="Ontdek profielen, losse vragenlijsten en zelfstandige modules. Kies jouw eigen ingang.">
  <section class="self-hero" aria-labelledby="self-title">
    <div class="container self-hero-grid" data-no-motion>
      <div class="self-hero-copy">
        <h1 id="self-title">Begin bij wat<br />jij <em>nodig hebt.</em></h1>
        <p class="self-intro">Een profiel, vragenlijst of module kan op zichzelf staan. Kies de ingang die past bij jouw vraag en ga verder op je eigen tempo.</p>
        <div class="self-hero-actions">
          <a class="button button-primary" href="#mogelijkheden">Ontdek jouw mogelijkheden <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" /></svg></a>
          <a class="self-text-link" href="/startpunt">Help mij kiezen <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
        </div>
        <p class="self-reassurance">Je hoeft nog niet precies te weten wat je zoekt.</p>
      </div>
      <figure class="self-hero-image">
        <img src="/images/modules/zelfreflectie-hero-v2.webp" alt="Een vrouw luistert naar audio en schrijft in haar werkboek, op een rustig moment thuis." width="1120" height="1400" fetchpriority="high" />
        <figcaption>Ruimte voor inzicht.<br /><em>Op jouw tempo.</em></figcaption>
      </figure>
    </div>
  </section>

  <section class="self-options" id="mogelijkheden" aria-labelledby="options-title">
    <div class="container" data-no-motion>
      <div class="self-options-heading">
        <h2 id="options-title">Wat past bij<br /> <em>jouw vraag?</em></h2>
        <p>Een breder beeld, een gerichte vraag of zelf oefenen. Hier zie je wat de drie mogelijkheden van elkaar onderscheidt.</p>
      </div>
      <div class="self-route-list">
        {routes.map(route => <article class="self-route">
          <div class="self-route-image"><img src={route.image} alt="" width="600" height="400" loading="lazy" decoding="async" /></div>
          <div class="self-route-copy">
            <p class="self-route-direction">{route.direction}</p>
            <h3><a href={route.href}>{route.title}</a></h3>
            <p class="self-route-description">{route.description}</p>
            <p class="self-route-detail">{route.detail}</p>
          </div>
          <a class="self-route-action" href={route.href}><span>{route.action}</span><span class="self-arrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></span></a>
        </article>)}
      </div>
      <p class="self-profile-note">Een profiel of vragenlijst ondersteunt inzicht en oriëntatie. Het is geen diagnose.</p>
    </div>
  </section>

  <section class="self-practical" aria-label="Combineren en je aankopen openen">
    <div class="container self-practical-grid" data-no-motion>
      <div>
        <h2>Jouw eigen combinatie.</h2>
        <p>Wil je combineren? Stel zelf je selectie samen. De actuele beschikbaarheid en prijs staan bij elk product. Kopen kan zonder verplicht account.</p>
        <a class="self-text-link" href="/samenstellen">Stel je combinatie samen <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
      </div>
      <div>
        <h2>Al iets gekocht?</h2>
        <p>Je hoeft niet opnieuw te kiezen. Ga rechtstreeks naar je bestellingen en aangekochte inhoud.</p>
        <a class="self-text-link" href="/aankopen">Open mijn aankopen <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .self-hero{padding-block:clamp(2.5rem,5.5vw,5rem);background:var(--cream)}
  .self-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,5rem);align-items:center}
  .self-hero h1{margin:0 0 1.75rem;font-size:clamp(3.25rem,6.1vw,5.75rem);line-height:1.02;letter-spacing:-.04em}
  .self-hero h1 em,.self-options-heading h2 em{color:#934c58;font-weight:400}
  .self-intro{max-width:45ch;margin:0;color:var(--muted);font-size:1.06rem;line-height:1.8}
  .self-hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.5rem;margin-top:2rem}
  .self-hero-actions .button{font-size:.84rem;line-height:1.4;text-align:left}
  .self-hero svg,.self-options svg,.self-practical svg{width:20px;height:20px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
  .self-text-link{display:inline-flex;align-items:center;gap:.7rem;min-height:44px;font-size:.85rem;font-weight:600;text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
  .self-text-link svg{transition:transform 180ms ease}
  .self-text-link:hover svg{transform:translateX(4px)}
  .self-reassurance{margin:1.2rem 0 0;color:var(--muted);font-size:.8rem;line-height:1.6}
  .self-hero-image{position:relative;margin:0;isolation:isolate}
  .self-hero-image img{width:100%;height:clamp(400px,39vw,550px);object-fit:cover;object-position:50% 42%;border-radius:46% 46% 12px 12px}
  .self-hero-image figcaption{position:absolute;bottom:1.5rem;left:-1.5rem;max-width:calc(100% - 1.5rem);padding:1.1rem 1.6rem;background:var(--pink-soft);font-family:'DM Serif Display',Georgia,serif;font-size:1.65rem;line-height:1.2;letter-spacing:-.025em}
  .self-hero-image figcaption em{color:#823f49}
  .self-options{padding-block:clamp(3.5rem,6.5vw,6rem);scroll-margin-top:6rem}
  .self-options-heading{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:end;margin-bottom:2.75rem}
  .self-options-heading h2{margin:0;font-size:clamp(2.5rem,4vw,3.75rem);line-height:1.08}
  .self-options-heading>p{max-width:43ch;margin:0 0 .2rem;color:var(--muted);font-size:1rem;line-height:1.8}
  .self-route{display:grid;grid-template-columns:220px minmax(0,1fr) 190px;align-items:center;gap:2.5rem;padding-block:2rem;border-top:1px solid var(--line)}
  .self-route:last-child{border-bottom:1px solid var(--line)}
  .self-route-image{overflow:hidden;border-radius:12px;aspect-ratio:1.2;background:var(--cream)}
  .self-route-image img{height:100%;width:100%;object-fit:cover}
  .self-route-direction{margin:0 0 .5rem;color:#823f49;font-size:.78rem;font-weight:600;line-height:1.5}
  .self-route h3{margin:0 0 .8rem;font-size:clamp(2rem,2.7vw,2.6rem);line-height:1.1}
  .self-route h3 a{text-decoration:none}
  .self-route h3 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px}
  .self-route-description{max-width:51ch;margin:0;color:var(--muted);font-size:.94rem;line-height:1.75}
  .self-route-detail{max-width:55ch;margin:.8rem 0 0;color:var(--muted);font-size:.77rem;line-height:1.6}
  .self-route-action{display:flex;align-items:center;justify-content:space-between;gap:.8rem;min-height:48px;font-size:.81rem;font-weight:600;text-decoration:none;line-height:1.5}
  .self-arrow{display:grid;place-items:center;width:44px;height:44px;flex-shrink:0;border:1px solid var(--line);border-radius:50%;transition:background 180ms ease,color 180ms ease,border-color 180ms ease}
  .self-route-action:hover .self-arrow{background:var(--ink);border-color:var(--ink);color:var(--white)}
  .self-route-action:hover>span:first-child{text-decoration:underline;text-underline-offset:4px}
  .self-profile-note{margin:1.5rem 0 0;color:var(--muted);font-size:.78rem;line-height:1.7}
  .self-practical{padding-block:clamp(3rem,5vw,4.5rem);background:var(--pink-soft)}
  .self-practical-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(3rem,8vw,8rem)}
  .self-practical h2{margin:0 0 1rem;font-size:clamp(1.9rem,3vw,2.5rem);line-height:1.15}
  .self-practical p{max-width:49ch;margin:0 0 1rem;color:#4c6259;font-size:.94rem;line-height:1.8}
  @media(max-width:1050px){.self-route{grid-template-columns:180px minmax(0,1fr);gap:1rem 2rem}.self-route-image{grid-row:span 2}.self-route-action{grid-column:2;justify-content:flex-start;gap:1rem}.self-hero-actions{align-items:flex-start;flex-direction:column;gap:.4rem}}
  @media(max-width:760px){
    .self-hero{padding-block:2.5rem}
    .self-hero-grid{grid-template-columns:1fr;gap:2rem}
    .self-hero h1{font-size:clamp(3.15rem,8.5vw,4.5rem);margin-bottom:1.25rem}
    .self-intro{max-width:48ch;font-size:1rem;line-height:1.75}
    .self-hero-actions{flex-direction:row;align-items:center;gap:.5rem 1.25rem;margin-top:1.5rem}
    .self-reassurance{margin-top:.75rem}
    .self-hero-image img{height:350px;object-position:50% 43%;border-radius:40% 40% 12px 12px}
    .self-hero-image{max-width:520px;width:100%;justify-self:center}
    .self-hero-image figcaption{left:1rem;bottom:1rem;font-size:1.4rem;padding:.9rem 1.1rem}
    .self-options-heading{grid-template-columns:1fr;gap:1.25rem;margin-bottom:2rem}
    .self-options-heading h2 br{display:none}
    .self-options-heading h2{max-width:15ch}
    .self-options-heading>p{font-size:.94rem}
    .self-practical-grid{grid-template-columns:1fr;gap:2rem}
    .self-practical-grid>div+div{padding-top:2rem;border-top:1px solid var(--line)}
  }
  @media(max-width:520px){
    .self-hero-grid,.self-options>.container,.self-practical>.container{width:calc(100% - 3rem)}
    .self-hero h1{font-size:clamp(2.8rem,10.5vw,3.8rem)}
    .self-hero-image img{height:300px}
    .self-route{grid-template-columns:1fr;padding-block:1.75rem;gap:1.25rem}
    .self-route-image{grid-row:auto;aspect-ratio:1.9;max-height:220px}
    .self-route-action{grid-column:auto;justify-content:space-between;gap:1rem}
    .self-route h3{font-size:2.15rem}
    .self-route-detail{font-size:.8rem}
  }
  @media(prefers-reduced-motion:reduce){.self-text-link svg,.self-arrow{transition:none}.self-text-link:hover svg{transform:none}}
</style>
