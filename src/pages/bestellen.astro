---
import {salesEnabled,salesPausedMessage} from '../lib/commerce/readiness';
import MainLayout from '../layouts/MainLayout.astro';
import {digitalContentItems,digitalDeliveryStatement} from '../lib/commerce/terms';
import {parseSelection} from '../lib/modules/validation';
import {ownedModuleIds} from '../lib/modules/server';
import {quoteCatalog} from '../lib/catalog/server';
import {purchaseOrder,CHECKOUT_COOKIE,secret,tokenValid,purchaseCookieOptions} from '../lib/commerce/purchases';
import {money} from '../lib/catalog/pricing';
import {isCustomerAccount} from '../lib/adminAuth';
import {getWiseManualDetails,createEpcSepaQr} from '../lib/wiseCheckout';
import '../styles/catalog.css';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
const newSalesEnabled=salesEnabled();
const user=Astro.locals.currentUser;const signedIn=isCustomerAccount(user);
const orderId=Astro.url.searchParams.get('order');
let selection;try{selection=parseSelection(Astro.url.searchParams);}catch{selection=null;}
const ids=selection?.ids||[];const mode=selection?.mode||'custom';
const owned=signedIn?await ownedModuleIds(user!.sub):[];
let alreadyOwned=false;
let quote=null;let order=null;let unavailable=false;
if(orderId){order=await purchaseOrder(orderId,Astro.cookies,user);if(!order)return Astro.redirect(`/aankopen/toegang?next=${encodeURIComponent(Astro.url.pathname+Astro.url.search)}`,303);}
else{try{quote=await quoteCatalog(ids,mode);alreadyOwned=quote.items.some(p=>p.type==='module'&&owned.includes(p.id));if(alreadyOwned)unavailable=true;}catch{unavailable=true;}}
const details=getWiseManualDetails();
const paid=order&&['paid','fulfilled'].includes(order.status);
const qr=order&&order.status==='pending_payment'&&details?await createEpcSepaQr({details,amountCents:order.total_cents,currency:order.currency,reference:order.provider_reference}):null;
const items=order?order.order_items.map((i:any)=>({title:i.product_title,price:i.price_cents})):quote?.items.map(i=>({title:i.title,price:i.priceCents}))||[];
const total=order?order.total_cents:quote?.totalCents||0;
const immediateDigital=quote?digitalContentItems(quote.items):[];
const returnTo=Astro.url.pathname+Astro.url.search;
if(!signedIn&&!tokenValid(Astro.cookies.get(CHECKOUT_COOKIE)?.value))Astro.cookies.set(CHECKOUT_COOKIE,secret(),purchaseCookieOptions(Astro.url.protocol==='https:'));
---
<MainLayout title="Je bestelling — MyGrowise" noindex>
<section class="checkout-page"><div class="container"><a href="/samenstellen" class="detail-back">← Terug naar het aanbod</a><div class="checkout-grid"><div class="checkout-content"><span class="catalog-kicker">Jouw volgende stap</span><h1>{paid?'Je betaling is bevestigd.':order?'Je bestelling staat klaar.':'Een helder overzicht. Een bewuste keuze.'}</h1><p class="checkout-lead">{paid?'Je betaling is ontvangen. Open je inhoud en volg je vragenlijstafnames via Mijn aankopen, zonder verplicht account.':order?'Betaal met onderstaande gegevens. Na controle van de ontvangen overschrijving bevestigt MyGrowise je betaling.':'Bekijk je keuze en het totaal. Na bestellen ontvang je de gegevens voor je overschrijving.'}</p>
{!order&&!newSalesEnabled?<div class="checkout-notice" role="status"><p>{salesPausedMessage}</p><a href="/contact">Stel je vraag →</a> · <a href="/aankopen">Open bestaande aankopen →</a></div>:unavailable?<div class="checkout-notice" role="alert">{alreadyOwned?'Een gekozen module staat al in je bibliotheek. Je hoeft deze niet opnieuw te kopen.':'Deze bestelling of samenstelling is niet beschikbaar.'} <a href={alreadyOwned?'/account/bibliotheek':'/samenstellen'}>{alreadyOwned?'Open mijn bibliotheek.':'Bekijk het actuele aanbod.'}</a></div>:<>
{Astro.url.searchParams.has('melding')&&<div class="checkout-notice" role="alert">De prijs of beschikbaarheid is gewijzigd. Controleer het nieuwe overzicht voordat je bestelt.</div>}
{paid?<a class="button button-primary" href="/aankopen">Naar mijn aankopen →</a>:order?<>{order.status==='pending_payment'&&details?<div class="checkout-bank"><h2>Betaal via overschrijving</h2><dl><div><dt>Ontvanger</dt><dd>{details.accountName}</dd></div><div><dt>IBAN</dt><dd>{details.iban}</dd></div><div><dt>BIC</dt><dd>{details.bic}</dd></div><div><dt>Bedrag</dt><dd>{money(total)}</dd></div><div><dt>Mededeling</dt><dd><strong>{order.provider_reference}</strong></dd></div></dl>{qr&&<div class="checkout-qr"><img src={qr} alt="QR-code met de overschrijvingsgegevens" width="200" height="200"/><p>Scan in je bankapp en controleer de gegevens. Gebruik altijd de mededeling hierboven.</p></div>}<p>Je hoeft je betaling niet apart te melden. Je status wordt bijgewerkt nadat MyGrowise de overschrijving heeft gecontroleerd.</p></div>:<p>Deze bestelling heeft de status: {order.status==='cancelled'?'geannuleerd':order.status}.</p>}<p>Je krijgt per e-mail toegang tot je aankopen. Geen account of wachtwoord nodig.</p><a href="/aankopen">Mijn aankopen openen →</a></>:<form method="post" action="/api/checkout/catalog-order"><input type="hidden" name="ids" value={ids.join(',')}/><input type="hidden" name="mode" value={mode}/><input type="hidden" name="hash" value={quote!.hash}/><input type="hidden" name="submission" value={crypto.randomUUID()}/><h2>Bestellen zonder verplicht account.</h2><p>Je ontvangt de bevestiging en een veilige toegangslink per e-mail.</p>{!signedIn&&<p>Heb je al een account? <a href={`/account/inloggen?next=${encodeURIComponent(returnTo)}`}>Je kunt ook inloggen</a>.</p>}<label>E-mailadres<input type="email" name="email" autocomplete="email" required maxlength="254" value={signedIn?user!.email:''} readonly={signedIn}/></label><label>Voor wie is de inhoud?<select name="participant"><option value="self">Voor mijzelf</option><option value="child">Voor mijn kind (ik bestel als ouder/verzorger)</option></select></label><p class="checkout-terms">Vul hieronder de gegevens in van degene die de module of vragenlijst gaat gebruiken. Je e-mailadres hierboven is het contactadres voor de bestelling.</p><div class="checkout-fields"><label>Voornaam<input name="first_name" autocomplete="given-name" required maxlength="60"/></label><label>Achternaam<input name="last_name" autocomplete="family-name" required maxlength="60"/></label><label>Geboortedatum<input type="date" name="birth_date" required max={new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Brussels',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}/></label><label>Geslacht<select name="gender" required><option value="">Kies een optie</option><option value="female">Vrouw</option><option value="male">Man</option><option value="other">Anders</option><option value="unspecified">Zeg ik liever niet</option></select></label></div><div hidden aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"/></div><p class="checkout-terms">Je koopt voor één persoon. MyGrowise stemt eventuele vragenlijstafnames met je af. Controleer bij modules de doelgroep op de productpagina.</p><label class="checkout-agreement"><input type="checkbox" required name="terms" value="accepted"/><span>Ik ga akkoord met de <a href="/voorwaarden" target="_blank">voorwaarden</a> en heb mijn keuze gecontroleerd.</span></label>{immediateDigital.length>0&&<><p class="checkout-terms">Directe digitale levering: {immediateDigital.map(item=>item.title).join(', ')}. Na het begin van de levering met jouw toestemming is voor deze inhoud geen terugbetaling mogelijk wegens een veranderde keuze. Je wettelijke rechten bij gebreken of niet-levering blijven gelden.</p><label class="checkout-agreement"><input type="checkbox" required name="digital_delivery" value="accepted"/><span>{digitalDeliveryStatement}</span></label></>}<button class="catalog-checkout" type="submit">Bestellen met betalingsverplichting · {money(total)} →</button></form>}
</>}
</div>{!unavailable&&<aside class="checkout-summary"><span class="catalog-kicker">{order?'Je bestelling':mode==='package'?'Je vaste profiel':'Je eigen combinatie'}</span><h2>Dit heb je gekozen.</h2><ul>{items.map(i=><li><span>{i.title}</span><strong>{money(i.price)}</strong></li>)}</ul>{quote&&quote.discountCents>0&&<p class="checkout-saving">Je bespaart {money(quote.discountCents)} met {quote.discountPercent}% combinatiekorting.</p>}<div class="checkout-total"><span>Totaal incl. toepasselijke belastingen</span><strong>{money(total)}</strong></div><p>Eenmalige aankoop. Na bevestiging van de betaling ontvang je per e-mail toegang en de vervolgstappen. Een account is optioneel.</p>{order&&<small>Referentie {order.provider_reference}</small>}</aside>}</div></div></section>
</MainLayout>
<style>.checkout-grid form>label,.checkout-fields label{display:grid;gap:.5rem;margin:1rem 0;font-size:.85rem}.checkout-grid input:not([type=checkbox]),.checkout-grid select{width:100%;padding:.85rem;border:1px solid var(--line);border-radius:.6rem;background:var(--white);font:inherit}.checkout-fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0 1rem}.checkout-page{padding:3rem 0 5rem}.detail-back{font-size:.8rem}.checkout-grid{display:grid;gap:3rem;margin-top:3rem}.checkout-grid h1{font-size:clamp(3rem,4.5vw,4.8rem);line-height:1.04;margin:1rem 0 1.5rem}.checkout-lead,.checkout-terms{line-height:1.8;color:var(--muted);font-size:.9rem}.checkout-grid form,.checkout-login{max-width:550px;margin-top:2rem}.checkout-login h2{font-size:2rem}.checkout-login>p,.checkout-login>a:last-child{font-size:.85rem;line-height:1.7}.checkout-login>a:last-child{display:block;text-align:center;margin:1rem 0}.checkout-summary{padding:2rem;border:1px solid var(--line);border-radius:1.5rem;background:var(--cream);align-self:start}.checkout-summary h2{font-size:2.2rem;margin:1rem 0 1.5rem}.checkout-summary ul{list-style:none;padding:0}.checkout-summary li{display:flex;gap:1rem;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.8rem}.checkout-summary li strong{white-space:nowrap}.checkout-total{display:flex;align-items:center;justify-content:space-between;margin:2rem 0 1rem}.checkout-total strong{font-family:'DM Serif Display',serif;font-size:2.8rem;font-weight:400}.checkout-summary>p,.checkout-summary>small{font-size:.75rem;color:var(--muted);line-height:1.8}.checkout-summary .checkout-saving{color:#38612c;padding:1rem;border-radius:.5rem;background:#e7eddd}.checkout-bank{margin-top:2rem}.checkout-bank h2{font-size:2rem}.checkout-bank dl{padding:1.3rem;background:var(--cream);border-radius:1rem}.checkout-bank dl>div{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 0;font-size:.8rem}.checkout-bank dd{margin:0;overflow-wrap:anywhere}.checkout-bank dt{color:var(--muted)}.checkout-qr{display:flex;align-items:center;gap:1rem}.checkout-qr img{width:160px}.checkout-bank p{font-size:.8rem;line-height:1.8;color:var(--muted)}.checkout-agreement{display:flex;gap:.4rem;align-items:start;flex-wrap:wrap;font-size:.75rem;line-height:1.5;margin:1.5rem 0}.checkout-notice{padding:1rem;background:var(--yellow-soft);border-radius:.5rem;font-size:.9rem;margin:1rem 0}@media(min-width:900px){.checkout-grid{grid-template-columns:1fr 370px}}
/* Agreement fields keep their own two-column layout at every size. */
.checkout-grid form > .checkout-agreement { display:grid;grid-template-columns:24px minmax(0,1fr);align-items:start;gap:.65rem;min-height:44px;padding-block:.5rem;line-height:1.6 }
.checkout-agreement input[type=checkbox] { width:20px;height:20px;min-height:0;margin:.1rem 0 0;accent-color:var(--ink) }
@media(max-width:899px){
 .checkout-grid input:not([type=checkbox]),.checkout-grid select{font-size:16px}
 .checkout-grid{gap:1.5rem;display:flex;flex-direction:column}
 .checkout-summary{order:-1;width:100%;padding:1.5rem}
 .checkout-summary h2{font-size:1.8rem;margin:.75rem 0}
 .checkout-summary ul{margin-block:0}
 .checkout-total{gap:1rem;margin:1.25rem 0 .5rem}
 .checkout-total span{font-size:.85rem;line-height:1.5}
 .checkout-total strong{font-size:2.2rem;white-space:nowrap}
 .checkout-content h1{font-size:clamp(2.4rem,9vw,3rem)}
 .checkout-content form{margin-top:1.5rem}
 .checkout-qr{flex-wrap:wrap}
}
</style>
