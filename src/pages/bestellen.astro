---
import {salesEnabled,salesPausedMessage} from '../lib/commerce/readiness';
import PurchaseLayout from '../layouts/PurchaseLayout.astro';
import PaymentInstructions from '../components/astro/PaymentInstructions.astro';
import {digitalContentItems,digitalDeliveryStatement} from '../lib/commerce/terms';
import {parseSelection} from '../lib/modules/validation';
import {ownedModuleIds} from '../lib/modules/server';
import {quoteCatalog} from '../lib/catalog/server';
import {purchaseOrder,CHECKOUT_COOKIE,secret,tokenValid,purchaseCookieOptions} from '../lib/commerce/purchases';
import {money} from '../lib/catalog/pricing';
import {isCustomerAccount} from '../lib/adminAuth';
import {getWiseManualDetails,createEpcSepaQr} from '../lib/wiseCheckout';
import '../styles/catalog.css';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
const newSalesEnabled=salesEnabled();
const user=Astro.locals.currentUser;const signedIn=isCustomerAccount(user);
const orderId=Astro.url.searchParams.get('order');
let selection;try{selection=parseSelection(Astro.url.searchParams);}catch{selection=null;}
const ids=selection?.ids||[];const mode=selection?.mode||'custom';
const owned=signedIn?await ownedModuleIds(user!.sub):[];
let alreadyOwned=false;
let quote=null;let order=null;let unavailable=false;
if(orderId){order=await purchaseOrder(orderId,Astro.cookies,user);if(!order)return Astro.redirect(`/aankopen/toegang?next=${encodeURIComponent(Astro.url.pathname+Astro.url.search)}`,303);}
else{try{quote=await quoteCatalog(ids,mode);alreadyOwned=quote.items.some(p=>p.type==='module'&&owned.includes(p.id));if(alreadyOwned)unavailable=true;}catch{unavailable=true;}}
const details=getWiseManualDetails();
const paid=order&&['paid','fulfilled'].includes(order.status);
const qr=order&&order.status==='pending_payment'&&details?await createEpcSepaQr({details,amountCents:order.total_cents,currency:order.currency,reference:order.provider_reference}):null;
const items=order?order.order_items.map((i:any)=>({title:i.product_title,price:i.price_cents})):quote?.items.map(i=>({title:i.title,price:i.priceCents}))||[];
const total=order?order.total_cents:quote?.totalCents||0;
const immediateDigital=quote?digitalContentItems(quote.items):[];
const returnTo=Astro.url.pathname+Astro.url.search;
if(!signedIn&&!tokenValid(Astro.cookies.get(CHECKOUT_COOKIE)?.value))Astro.cookies.set(CHECKOUT_COOKIE,secret(),purchaseCookieOptions(Astro.url.protocol==='https:'));
---
<PurchaseLayout title="Je bestelling">
<section class="checkout-page"><div class="container"><a href="/samenstellen" class="detail-back">← Terug naar het aanbod</a><div class="checkout-grid"><header class="checkout-intro">{order&&<p class:list={['checkout-status',{'checkout-status--paid':paid}]}>{paid?'Betaling bevestigd':order.status==='pending_payment'?'Wacht op betaling':order.status==='cancelled'?'Bestelling geannuleerd':'Bestelling in behandeling'}</p>}<h1>{paid?'Je betaling is bevestigd.':order?order.status==='pending_payment'?'Rond je betaling af.':order.status==='cancelled'?'Je bestelling is geannuleerd.':'Je bestelling is in behandeling.':'Je bestelling'}</h1><p class="checkout-lead">{paid?'Je betaling is ontvangen. Open je inhoud en volg je vragenlijstafnames via Mijn aankopen, zonder verplicht account.':order?order.status==='pending_payment'?'Je bestelling is ontvangen. Je betaalt eenmalig via een bankoverschrijving. Hieronder vind je alle gegevens.':'Bekijk je besteloverzicht. Heb je een vraag over deze bestelling? Neem gerust contact met ons op.':'Bekijk je keuze en het totaal. Na bestellen ontvang je de gegevens voor je overschrijving.'}</p></header><div class="checkout-content">
{!order&&!newSalesEnabled?<div class="checkout-notice" role="status"><p>{salesPausedMessage}</p><a href="/contact">Stel je vraag →</a> · <a href="/aankopen">Open bestaande aankopen →</a></div>:unavailable?<div class="checkout-notice" role="alert">{alreadyOwned?'Een gekozen module staat al in je bibliotheek. Je hoeft deze niet opnieuw te kopen.':'Deze bestelling of samenstelling is niet beschikbaar.'} <a href={alreadyOwned?'/account/bibliotheek':'/samenstellen'}>{alreadyOwned?'Open mijn bibliotheek.':'Bekijk het actuele aanbod.'}</a></div>:<>
{Astro.url.searchParams.has('melding')&&<div class="checkout-notice" role="alert">De prijs of beschikbaarheid is gewijzigd. Controleer het nieuwe overzicht voordat je bestelt.</div>}
{paid?<a class="button button-primary" href="/aankopen">Naar mijn aankopen →</a>:order?<>{order.status==='pending_payment'&&details?<><PaymentInstructions details={details} total={total} reference={order.provider_reference} qr={qr}/><section class="checkout-next" aria-labelledby="checkout-next-heading"><h2 id="checkout-next-heading">Wat gebeurt er na je betaling?</h2><p>MyGrowise controleert de ontvangen overschrijving. Zodra je betaling is bevestigd, ontvang je per e-mail toegang tot je aankoop en de vervolgstappen.</p><p>Je hoeft je betaling niet apart te melden. Je kunt de status volgen bij <a href="/aankopen">Mijn aankopen</a>.</p></section></>:<p class="checkout-notice">{order.status==='pending_payment'?'De betaalgegevens zijn momenteel niet beschikbaar. Neem contact met ons op voordat je betaalt.':order.status==='cancelled'?'Je hoeft voor deze bestelling niet meer te betalen.':'We verwerken je bestelling. Je vindt de actuele status bij Mijn aankopen.'}</p>}<p class="checkout-help">Een vraag over je betaling? <a href="/contact">Neem contact op met MyGrowise</a>.</p></>:<form method="post" action="/api/checkout/catalog-order"><input type="hidden" name="ids" value={ids.join(',')}/><input type="hidden" name="mode" value={mode}/><input type="hidden" name="hash" value={quote!.hash}/><input type="hidden" name="submission" value={crypto.randomUUID()}/><h2>Bestellen zonder verplicht account.</h2><p>Je ontvangt de bevestiging en een veilige toegangslink per e-mail.</p>{!signedIn&&<p>Heb je al een account? <a href={`/account/inloggen?next=${encodeURIComponent(returnTo)}`}>Je kunt ook inloggen</a>.</p>}<label>E-mailadres<input type="email" name="email" autocomplete="email" required maxlength="254" value={signedIn?user!.email:''} readonly={signedIn}/></label><label>Voor wie is de inhoud?<select name="participant"><option value="self">Voor mijzelf</option><option value="child">Voor mijn kind (ik bestel als ouder/verzorger)</option></select></label><p class="checkout-terms">Vul hieronder de gegevens in van degene die de module of vragenlijst gaat gebruiken. Je e-mailadres hierboven is het contactadres voor de bestelling.</p><div class="checkout-fields"><label>Voornaam<input name="first_name" autocomplete="given-name" required maxlength="60"/></label><label>Achternaam<input name="last_name" autocomplete="family-name" required maxlength="60"/></label><label>Geboortedatum<input type="date" name="birth_date" required max={new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Brussels',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date())}/></label><label>Geslacht<select name="gender" required><option value="">Kies een optie</option><option value="female">Vrouw</option><option value="male">Man</option><option value="other">Anders</option><option value="unspecified">Zeg ik liever niet</option></select></label></div><div hidden aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"/></div><p class="checkout-terms">Je koopt voor één persoon. MyGrowise stemt eventuele vragenlijstafnames met je af. Controleer bij modules de doelgroep op de productpagina.</p><label class="checkout-agreement"><input type="checkbox" required name="terms" value="accepted"/><span>Ik ga akkoord met de <a href="/voorwaarden" target="_blank">voorwaarden</a> en heb mijn keuze gecontroleerd.</span></label>{immediateDigital.length>0&&<><p class="checkout-terms">Directe digitale levering: {immediateDigital.map(item=>item.title).join(', ')}. Na het begin van de levering met jouw toestemming is voor deze inhoud geen terugbetaling mogelijk wegens een veranderde keuze. Je wettelijke rechten bij gebreken of niet-levering blijven gelden.</p><label class="checkout-agreement"><input type="checkbox" required name="digital_delivery" value="accepted"/><span>{digitalDeliveryStatement}</span></label></>}<button class="catalog-checkout" type="submit">Bestellen met betalingsverplichting · {money(total)} →</button></form>}
</>}
</div>{!unavailable&&<aside class="checkout-summary"><h2>Je besteloverzicht</h2><ul>{items.map(i=><li><span>{i.title}</span><strong>{money(i.price)}</strong></li>)}</ul>{quote&&quote.discountCents>0&&<p class="checkout-saving">Je bespaart {money(quote.discountCents)} met {quote.discountPercent}% combinatiekorting.</p>}<div class="checkout-total"><span>{paid?'Totaal betaald':order&&order.status!=='pending_payment'?'Totaal bestelling':'Totaal te betalen'}</span><strong>{money(total)}</strong></div><p>Inclusief toepasselijke belastingen.<br/>Eenmalige aankoop, geen abonnement.</p><p>Toegang via e-mail na bevestiging van je betaling. Een account is optioneel.</p>{order&&<small>Referentie {order.provider_reference}</small>}</aside>}</div></div></section>
</PurchaseLayout>
<style>
.checkout-page{padding:.5rem 0 2rem}.checkout-page>.container{width:100%;max-width:1080px}.detail-back{font-size:.875rem;text-underline-offset:4px}
.checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:3rem;margin-top:2rem;align-items:start}.checkout-intro,.checkout-content{min-width:0}.checkout-intro{grid-column:1}.checkout-content{grid-column:1}.checkout-grid{row-gap:1.75rem}.checkout-summary{grid-column:2;grid-row:1 / span 2}
.checkout-grid h1{font-size:2.75rem;line-height:1.15;margin:0 0 1rem}.checkout-lead{font-size:1rem;line-height:1.7;color:var(--muted);margin-bottom:0;max-width:64ch}
.checkout-status{display:inline-flex;align-items:center;gap:.5rem;margin:0 0 1rem;padding:.4rem .7rem;border-radius:6px;background:var(--yellow-soft);color:var(--ink-deep);font-size:.75rem;font-weight:600;line-height:1.5}.checkout-status--paid{background:#e5eddf}
.checkout-grid form{margin-top:1.75rem}.checkout-grid form h2{font:600 1.2rem/1.4 'DM Sans',sans-serif;letter-spacing:0}.checkout-grid form>p{font-size:.875rem;line-height:1.7;color:var(--muted)}
.checkout-grid form>label,.checkout-fields label{display:grid;gap:.5rem;margin:1rem 0;font-size:.875rem}.checkout-grid input:not([type=checkbox]),.checkout-grid select{width:100%;padding:.85rem;border:1px solid var(--line);border-radius:6px;background:var(--white);font:inherit;font-size:1rem;min-width:0}.checkout-grid input{caret-color:var(--ink)}
.checkout-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 1rem}.checkout-terms{line-height:1.7;color:var(--muted);font-size:.875rem}
.checkout-summary{padding:1.5rem;border:1px solid var(--line);border-radius:12px;background:var(--cream);align-self:start}.checkout-summary h2{font:600 1.125rem/1.4 'DM Sans',sans-serif;letter-spacing:0;margin:0 0 1rem}.checkout-summary ul{list-style:none;padding:0;margin:0}.checkout-summary li{display:flex;gap:1rem;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.875rem;line-height:1.6}.checkout-summary li strong{white-space:nowrap;font-weight:500;font-variant-numeric:tabular-nums}
.checkout-total{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:1.5rem 0 .75rem}.checkout-total span{font-size:.875rem}.checkout-total strong{font:600 1.75rem/1.2 'DM Sans',sans-serif;white-space:nowrap;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.checkout-summary>p,.checkout-summary>small{font-size:.8125rem;color:var(--muted);line-height:1.7}.checkout-summary>small{display:block;padding-top:1rem;border-top:1px solid var(--line);overflow-wrap:anywhere}.checkout-summary .checkout-saving{color:#38612c;font-weight:500}
.checkout-next{margin-top:1.75rem}.checkout-next h2{font:600 1.0625rem/1.5 'DM Sans',sans-serif;letter-spacing:0;margin-bottom:.6rem}.checkout-next p,.checkout-help{font-size:.875rem;line-height:1.75;color:var(--muted)}.checkout-next p{margin-bottom:.6rem}.checkout-help{margin-top:1.5rem}.checkout-content a{text-underline-offset:4px}
.checkout-grid form>.checkout-agreement{display:grid;grid-template-columns:24px minmax(0,1fr);align-items:start;gap:.65rem;min-height:44px;padding-block:.5rem;font-size:.8125rem;line-height:1.6;margin:1.5rem 0}.checkout-agreement input[type=checkbox]{width:20px;height:20px;min-height:0;margin:.1rem 0 0;accent-color:var(--ink)}
.checkout-notice{padding:1rem;background:var(--yellow-soft);border-radius:6px;font-size:.9375rem;line-height:1.7;margin:1rem 0}
@media(max-width:899px){.checkout-grid{grid-template-columns:1fr;gap:2rem;max-width:640px;margin-inline:auto}.checkout-page{padding-top:1.5rem}.checkout-intro{grid-row:1}.checkout-summary{width:100%;grid-column:1;grid-row:2}.checkout-content{grid-row:3}.checkout-grid h1{font-size:2.25rem}}
@media(max-width:400px){.checkout-fields{grid-template-columns:1fr}.checkout-summary{padding:1.25rem}.checkout-grid h1{font-size:2rem}}
</style>
