---
import MainLayout from '../layouts/MainLayout.astro';
import {quoteCatalog,getCatalogOrder} from '../lib/catalog/server';
import {money} from '../lib/catalog/pricing';
import {isCustomerAccount} from '../lib/adminAuth';
import {getWiseManualDetails,createEpcSepaQr} from '../lib/wiseCheckout';
import '../styles/catalog.css';
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
const user=Astro.locals.currentUser;const signedIn=isCustomerAccount(user);
const orderId=Astro.url.searchParams.get('order');
const ids=(Astro.url.searchParams.get('pakket')||Astro.url.searchParams.get('vragenlijsten')||'').split(',');
const mode=Astro.url.searchParams.has('pakket')?'package':'custom';
let quote=null;let order=null;let unavailable=false;
if(orderId){if(signedIn)order=await getCatalogOrder(orderId,user!.sub);else return Astro.redirect(`/account/inloggen?next=${encodeURIComponent(Astro.url.pathname+Astro.url.search)}`,303);if(!order)unavailable=true;}
else{try{quote=await quoteCatalog(ids,mode);}catch{unavailable=true;}}
const details=getWiseManualDetails();
const paid=order&&['paid','fulfilled'].includes(order.status);
const qr=order&&order.status==='pending_payment'&&details?await createEpcSepaQr({details,amountCents:order.total_cents,currency:order.currency,reference:order.provider_reference}):null;
const items=order?order.order_items.map((i:any)=>({title:i.product_title,price:i.price_cents})):quote?.items.map(i=>({title:i.title,price:i.priceCents}))||[];
const total=order?order.total_cents:quote?.totalCents||0;
const returnTo=Astro.url.pathname+Astro.url.search;
---
<MainLayout title="Je bestelling — MyGrowise" noindex>
<section class="checkout-page"><div class="container"><a href="/samenstellen" class="detail-back">← Terug naar het aanbod</a><div class="checkout-grid"><div><span class="catalog-kicker">Jouw volgende stap</span><h1>{paid?'Je betaling is bevestigd.':order?'Je bestelling staat klaar.':'Een helder overzicht. Een bewuste keuze.'}</h1><p class="checkout-lead">{paid?'Je afname wordt voorbereid. Volg de voortgang en vind je instructies in je account.':order?'Betaal met onderstaande gegevens. Na controle van de ontvangen overschrijving bevestigt MyGrowise je betaling.':'Bekijk je keuze en het totaal. Na bestellen ontvang je de gegevens voor je overschrijving.'}</p>
{unavailable?<div class="checkout-notice" role="alert">Deze bestelling of samenstelling is niet beschikbaar. <a href="/vragenlijsten">Bekijk het actuele aanbod.</a></div>:<>
{Astro.url.searchParams.has('melding')&&<div class="checkout-notice" role="alert">De prijs of beschikbaarheid is gewijzigd. Controleer het nieuwe overzicht voordat je bestelt.</div>}
{paid?<a class="button button-primary" href="/account/bibliotheek">Naar mijn afnames →</a>:order?<>{order.status==='pending_payment'&&details?<div class="checkout-bank"><h2>Betaal via overschrijving</h2><dl><div><dt>Ontvanger</dt><dd>{details.accountName}</dd></div><div><dt>IBAN</dt><dd>{details.iban}</dd></div><div><dt>BIC</dt><dd>{details.bic}</dd></div><div><dt>Bedrag</dt><dd>{money(total)}</dd></div><div><dt>Mededeling</dt><dd><strong>{order.provider_reference}</strong></dd></div></dl>{qr&&<div class="checkout-qr"><img src={qr} alt="QR-code met de overschrijvingsgegevens" width="200" height="200"/><p>Scan in je bankapp en controleer de gegevens. Gebruik altijd de mededeling hierboven.</p></div>}<p>Je hoeft je betaling niet apart te melden. Je status wordt bijgewerkt nadat MyGrowise de overschrijving heeft gecontroleerd.</p></div>:<p>Deze bestelling heeft de status: {order.status==='cancelled'?'geannuleerd':order.status}.</p>}<a href="/account/transacties">Bekijk mijn bestellingen →</a></>:signedIn?<form method="post" action="/api/checkout/catalog-order"><input type="hidden" name="ids" value={ids.join(',')}/><input type="hidden" name="mode" value={mode}/><input type="hidden" name="hash" value={quote!.hash}/><input type="hidden" name="submission" value={crypto.randomUUID()}/><p class="checkout-terms">Je koopt voor één persoon. Voor een kind of jongere bestelt een ouder of verzorger. MyGrowise stemt de juiste afname met je af.</p><label class="checkout-agreement"><input type="checkbox" required name="terms" value="accepted"/> Ik ga akkoord met de <a href="/voorwaarden" target="_blank">voorwaarden</a> en heb mijn keuze gecontroleerd.</label><button class="catalog-checkout" type="submit">Bestelling plaatsen · {money(total)} →</button></form>:<div class="checkout-login"><h2>Bewaar je bestelling in je account.</h2><p>Met je account volg je de afname en ontvang je beschikbare rapporten veilig.</p><a class="catalog-checkout" href={`/account/inloggen?next=${encodeURIComponent(returnTo)}`}>Inloggen en verder →</a><a href={`/account/aanmaken?next=${encodeURIComponent(returnTo)}`}>Nog geen account? Maak er een aan</a></div>}
</>}
</div>{!unavailable&&<aside class="checkout-summary"><span class="catalog-kicker">{order?'Je bestelling':mode==='package'?'Je vaste profiel':'Je eigen combinatie'}</span><h2>Dit heb je gekozen.</h2><ul>{items.map(i=><li><span>{i.title}</span><strong>{money(i.price)}</strong></li>)}</ul>{quote&&quote.discountCents>0&&<p class="checkout-saving">Je bespaart {money(quote.discountCents)} met {quote.discountPercent}% combinatiekorting.</p>}<div class="checkout-total"><span>Totaal</span><strong>{money(total)}</strong></div><p>Eenmalige aankoop. Na bevestiging van de betaling ontvang je de vervolgstappen in je account.</p>{order&&<small>Referentie {order.provider_reference}</small>}</aside>}</div></div></section>
</MainLayout>
<style>.checkout-page{padding:3rem 0 5rem}.detail-back{font-size:.8rem}.checkout-grid{display:grid;gap:3rem;margin-top:3rem}.checkout-grid h1{font-size:clamp(3rem,4.5vw,4.8rem);line-height:1.04;margin:1rem 0 1.5rem}.checkout-lead,.checkout-terms{line-height:1.8;color:var(--muted);font-size:.9rem}.checkout-grid form,.checkout-login{max-width:550px;margin-top:2rem}.checkout-login h2{font-size:2rem}.checkout-login>p,.checkout-login>a:last-child{font-size:.85rem;line-height:1.7}.checkout-login>a:last-child{display:block;text-align:center;margin:1rem 0}.checkout-summary{padding:2rem;border:1px solid var(--line);border-radius:1.5rem;background:var(--cream);align-self:start}.checkout-summary h2{font-size:2.2rem;margin:1rem 0 1.5rem}.checkout-summary ul{list-style:none;padding:0}.checkout-summary li{display:flex;gap:1rem;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.8rem}.checkout-summary li strong{white-space:nowrap}.checkout-total{display:flex;align-items:center;justify-content:space-between;margin:2rem 0 1rem}.checkout-total strong{font-family:'DM Serif Display',serif;font-size:2.8rem;font-weight:400}.checkout-summary>p,.checkout-summary>small{font-size:.75rem;color:var(--muted);line-height:1.8}.checkout-summary .checkout-saving{color:#38612c;padding:1rem;border-radius:.5rem;background:#e7eddd}.checkout-bank{margin-top:2rem}.checkout-bank h2{font-size:2rem}.checkout-bank dl{padding:1.3rem;background:var(--cream);border-radius:1rem}.checkout-bank dl>div{display:flex;justify-content:space-between;gap:1rem;padding:.6rem 0;font-size:.8rem}.checkout-bank dd{margin:0;overflow-wrap:anywhere}.checkout-bank dt{color:var(--muted)}.checkout-qr{display:flex;align-items:center;gap:1rem}.checkout-qr img{width:160px}.checkout-bank p{font-size:.8rem;line-height:1.8;color:var(--muted)}.checkout-agreement{display:flex;gap:.4rem;align-items:start;flex-wrap:wrap;font-size:.75rem;line-height:1.5;margin:1.5rem 0}.checkout-notice{padding:1rem;background:var(--yellow-soft);border-radius:.5rem;font-size:.9rem;margin:1rem 0}@media(min-width:900px){.checkout-grid{grid-template-columns:1fr 370px}}</style>
