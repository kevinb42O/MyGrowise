---
import MainLayout from '../../layouts/MainLayout.astro';
import { listPublishedArticles } from '../../lib/adminContent';
const articles = await listPublishedArticles();
---
<MainLayout title="Inzichten — MyGrowise" description="Artikelen en inzichten van MyGrowise."><section class="page-hero"><div class="container"><span class="eyebrow">Inzichten</span><h1 class="heading-xl">Ruimte om te begrijpen.</h1><p class="lead">Artikelen die helpen vertragen, ordenen en een volgende stap kiezen.</p></div></section><section class="section"><div class="container article-grid">{articles.length ? articles.map((article) => <article><span>{article.publishedAt ? new Intl.DateTimeFormat('nl-BE', { dateStyle: 'medium' }).format(new Date(article.publishedAt)) : ''}</span><h2>{article.title}</h2><p>{article.excerpt}</p><a class="button button-secondary" href={`/inspiratie/${article.slug}`}>Lees artikel <span aria-hidden="true">→</span></a></article>) : <p class="lead">Binnenkort verschijnen hier nieuwe inzichten.</p>}</div></section></MainLayout>
<style>.article-grid{display:grid;gap:1.25rem}.article-grid article{display:grid;gap:.8rem;padding:1.6rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--white)}.article-grid h2{margin:0;font-size:clamp(1.7rem,3vw,2.4rem)}.article-grid p{margin:0;color:var(--muted);line-height:1.7}.article-grid span{font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--pink)}.article-grid .button{justify-self:start;margin-top:.4rem}@media(min-width:760px){.article-grid{grid-template-columns:repeat(2,1fr)}}</style>
