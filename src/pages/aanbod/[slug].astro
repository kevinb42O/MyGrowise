---
import MainLayout from '../../layouts/MainLayout.astro';
import { SUPABASE_SESSION_COOKIE, verifySupabaseSession } from '../../lib/adminAuth';
import { createEpcSepaQr, getWiseManualDetails, getWiseManualOrder, getWiseManualProduct } from '../../lib/wiseCheckout';

const slug = String(Astro.params.slug || '').toLowerCase();
const product = await getWiseManualProduct(slug);
if (!product) return Astro.redirect('/prijzen', 302);
const session = await verifySupabaseSession(Astro.cookies.get(SUPABASE_SESSION_COOKIE)?.value);
const canCheckout = Boolean(session?.roles.includes('customer'));
const next = `/aanbod/${product.slug}`;
const loginHref = `/account/inloggen?next=${encodeURIComponent(next)}`;
const registerHref = `/account/aanmaken?next=${encodeURIComponent(next)}`;
const money = new Intl.NumberFormat('nl-BE', { style: 'currency', currency: product.currency }).format(product.priceCents / 100);
const type = product.type === 'profile' ? 'Persoonlijk profiel' : product.type === 'module' ? 'Online module' : 'E-book';
const wiseDetails = getWiseManualDetails();
const orderId = Astro.url.searchParams.get('order') || '';
const requestedOrder = canCheckout && orderId ? await getWiseManualOrder(orderId, session!.sub) : null;
const order = requestedOrder?.productSlug === product.slug ? requestedOrder : null;
let paymentQr: string | null = null;
if (order?.status === 'pending_payment' && wiseDetails) {
  try {
    paymentQr = await createEpcSepaQr({ details: wiseDetails, amountCents: order.totalCents, currency: order.currency, reference: order.reference });
  } catch (error) {
    console.error('[wise-sepa-qr] Could not generate payment QR code.', error);
  }
}
const pageMessage = Astro.url.searchParams.get('melding');
const created = Astro.url.searchParams.get('besteld') === '1';
const reported = Astro.url.searchParams.get('gemeld') === '1';
const statusLabels: Record<string, string> = { pending_payment: 'Wacht op betaling', paid: 'Betaling bevestigd', fulfilled: 'Betaling bevestigd', cancelled: 'Geannuleerd' };
---

<MainLayout activeNav="zelf" title={`${product.title} — bestellen bij MyGrowise`} description={`Bestel ${product.title} met een SEPA-overschrijving naar de Wise-rekening van MyGrowise.`}>
  <section class="wise-checkout">
    <div class="container wise-checkout__grid">
      <div>
        <a class="wise-checkout__back" href="/prijzen">← Terug naar het aanbod</a>
        <span class="eyebrow">{type}</span>
        <h1>{product.title}</h1>
        <p class="lead">{product.summary}</p>
        <div class="wise-checkout__price"><span>Te betalen</span><strong>{money}</strong><small>SEPA-overschrijving</small></div>
        <div class="wise-checkout__steps"><div><b>1</b><p>Maak een bestelling aan met je MyGrowise-account.</p></div><div><b>2</b><p>Betaal met de QR-code of neem de gegevens over in je bankapp. Gebruik de unieke betalingsreferentie.</p></div><div><b>3</b><p>Na ontvangst en controle van je betaling activeren we je bestelling.</p></div></div>
      </div>
      <aside class="wise-checkout__card" aria-label="Bestellen en betalen via overschrijving">
        {order ? <>
          <span class="wise-checkout__provider">Bestelling {order.id.slice(-8).toUpperCase()}</span>
          <p class="order-status" role="status">{statusLabels[order.status] || order.status}</p>
          <strong class="payment-amount">{new Intl.NumberFormat('nl-BE', { style: 'currency', currency: order.currency }).format(order.totalCents / 100)}</strong>
          {order.status === 'pending_payment' && wiseDetails ? <>
            {paymentQr && <div class="wise-checkout__qr"><img src={paymentQr} width="240" height="240" alt={`SEPA-betaalcode voor ${order.reference}`} /><div><strong>Scan met je bankapp</strong><p>Bedrag en mededeling staan alvast ingevuld.</p></div></div>}
            <dl class="transfer-details"><div><dt>Begunstigde</dt><dd>{wiseDetails.accountName}</dd></div><div><dt>IBAN</dt><dd>{wiseDetails.iban}</dd></div>{wiseDetails.bic && <div><dt>BIC / SWIFT</dt><dd>{wiseDetails.bic}</dd></div>}<div><dt>Mededeling</dt><dd><strong>{order.reference}</strong></dd></div></dl>
            {reported || order.paymentClaimedAt ? <p class="notice" role="status">Je betaalmelding is ontvangen. Na ontvangst en controle van je Wise-betaling bevestigen we je bestelling.</p> : <>
              <p>Controleer bedrag en mededeling in je bankapp voordat je de overschrijving bevestigt.</p>
              <form action="/api/checkout/wise-claim" method="post"><input type="hidden" name="order" value={order.id}/><input type="hidden" name="product" value={product.slug}/><button class="button button-primary" type="submit">Ik heb betaald</button></form>
            </>}
          </> : order.status === 'pending_payment' ? <p class="notice" role="status">De Wise-rekeninggegevens zijn nog niet ingesteld. Maak de overschrijving nog niet. Je bestelling is bewaard en de betaalinstructies verschijnen zodra ze klaarstaan.</p> : <p>Je bestelling is bevestigd. De vervolgstappen voor jouw profiel verschijnen in je account.</p>}
        </> : <>
          <span class="wise-checkout__provider">Bestel bij MyGrowise</span>
          <p>Maak een account aan of log in. Je bestelling en betalingsreferentie blijven daarna zichtbaar in je account.</p>
          {canCheckout ? wiseDetails ? <form action="/api/checkout/wise-order" method="post"><input type="hidden" name="product" value={product.slug}/><button class="button button-primary" type="submit">Bestel en toon betaalinstructies</button></form> : <div class="notice" role="status">De Wise-rekeninggegevens worden ingesteld. Je kan alvast een account aanmaken; betalen wordt mogelijk zodra de gegevens klaarstaan.</div> : <div class="account-actions"><a class="button button-primary" href={registerHref}>Account aanmaken</a><a class="wise-checkout__fallback" href={loginHref}>Ik heb al een account — inloggen</a></div>}
          {created && <p class="notice" role="status">Je account is aangemaakt. De bestelling kan worden afgerond zodra de Wise-rekeninggegevens zijn ingesteld.</p>}
        </>}
        {pageMessage === 'niet-beschikbaar' && <p class="notice" role="alert">Bestellen is op dit moment niet beschikbaar. Probeer het later opnieuw.</p>}
      </aside>
    </div>
  </section>
</MainLayout>

<style>
  .wise-checkout{padding-block:clamp(3rem,8vw,7rem);background:var(--cream)}.wise-checkout__grid{display:grid;gap:clamp(2rem,7vw,7rem);align-items:center;max-width:1100px}.wise-checkout__back{display:inline-block;margin-bottom:3rem;color:var(--muted);font-size:.76rem;font-weight:700;text-decoration:none}.wise-checkout h1{max-width:12ch;margin:.6rem 0 1.1rem;font-size:clamp(3.2rem,7vw,6rem);line-height:.92}.wise-checkout .lead{max-width:38rem}.wise-checkout__price{display:grid;grid-template-columns:auto 1fr;align-items:end;gap:.25rem 1rem;margin:2rem 0;padding-block:1.25rem;border-block:1px solid var(--line)}.wise-checkout__price span,.wise-checkout__price small{font-size:.74rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.wise-checkout__price strong{grid-row:span 2;font-family:'DM Serif Display',Georgia,serif;font-size:clamp(2.5rem,5vw,4.1rem);font-weight:400;text-align:right}.wise-checkout__price small{color:var(--muted);font-weight:500;text-transform:none;letter-spacing:0}.wise-checkout__steps{display:grid;gap:.9rem;max-width:35rem}.wise-checkout__steps div{display:grid;grid-template-columns:1.7rem 1fr;gap:.7rem;align-items:start}.wise-checkout__steps b{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;background:var(--pink-soft);color:var(--pink);font-size:.68rem}.wise-checkout__steps p{margin:0;color:var(--muted);font-size:.86rem;line-height:1.6}.wise-checkout__card{display:grid;justify-items:center;padding:clamp(1.5rem,4vw,2.5rem);border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white);box-shadow:var(--shadow);text-align:center}.wise-checkout__provider{margin-bottom:1.1rem;color:var(--green);font-size:.75rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.wise-checkout__card p{max-width:26rem;margin:1.25rem 0;color:var(--muted);font-size:.84rem;line-height:1.6}.wise-checkout__card form{width:100%}.wise-checkout__card .button{justify-content:center;width:100%}.wise-checkout__fallback{margin-top:1rem;color:var(--ink);font-size:.78rem;font-weight:700}.wise-checkout__card small{max-width:30rem;margin-top:1.25rem;color:var(--muted);font-size:.68rem;line-height:1.55}.account-actions{display:grid;width:100%;gap:.25rem;justify-items:center}.order-status{padding:.65rem 1rem;border-radius:999px;background:var(--yellow-soft);color:var(--ink)!important;font-weight:800!important}.payment-amount{font-family:'DM Serif Display',Georgia,serif;font-size:2.6rem;font-weight:400}.wise-checkout__qr{display:grid;grid-template-columns:minmax(8rem,12rem) minmax(0,1fr);align-items:center;gap:1rem;width:100%;margin:1.25rem 0;padding:1rem;border:1px solid var(--line);border-radius:var(--radius-md);background:var(--cream);text-align:left}.wise-checkout__qr img{display:block;width:100%;height:auto;image-rendering:pixelated}.wise-checkout__qr strong{font-size:.9rem}.wise-checkout__qr p{margin:.45rem 0;color:var(--muted);font-size:.76rem;line-height:1.5}.wise-checkout__qr a{color:var(--green);font-size:.78rem;font-weight:700;text-decoration:underline;text-underline-offset:.15em}.transfer-details{width:100%;margin:1rem 0;text-align:left}.transfer-details div{padding:.8rem 0;border-bottom:1px solid var(--line)}.transfer-details dt{color:var(--muted);font-size:.69rem;font-weight:700;text-transform:uppercase}.transfer-details dd{margin:.2rem 0 0;overflow-wrap:anywhere;font-size:.9rem}.transfer-details dd strong{font-size:1.05rem;letter-spacing:.05em}.notice{width:100%;padding:1rem;border-left:4px solid var(--pink);background:var(--pink-soft);text-align:left;font-size:.82rem;line-height:1.6}@media(max-width:500px){.wise-checkout__qr{grid-template-columns:1fr;justify-items:center;text-align:center}.wise-checkout__qr img{width:min(100%,220px)}}@media(min-width:850px){.wise-checkout__grid{grid-template-columns:1.15fr .85fr}}
</style>
