---
import MainLayout from '../../layouts/MainLayout.astro';
import { formatPublicPrice, listPublishedProfiles, profileUrl } from '../../lib/publicProducts';
const products = await listPublishedProfiles();
---

<MainLayout activeNav="zelf" title="Persoonlijke profielen — MyGrowise" description="Start met psychologisch inzicht op je eigen tempo. Ontdek de persoonlijke profielen van MyGrowise.">
  <section class="page-hero"><div class="container reveal"><span class="eyebrow">Zelf aan de slag</span><h1 class="heading-xl">Inzicht voor wie niet zomaar een label zoekt.</h1><p class="lead">Een persoonlijk profiel helpt je patronen herkennen en geeft woorden aan wat je misschien al langer voelt. Het is een vertrekpunt, geen eindbesluit.</p></div></section>
  <section class="section"><div class="container">
    <div class="intro-grid"><div><span class="eyebrow">Kies je startpunt</span><h2 class="heading-lg">Waar wil je vandaag meer zicht op?</h2></div><p class="lead">Bekijk de persoonlijke profielen die je nu kan bestellen.</p></div>
    <div class="product-grid">
      {products.map((product, index) => (
        <article class="product-card">
          <div class="product-image"><img src={product.image} alt="" loading="lazy" /><span>{String(index + 1).padStart(2, '0')}</span></div>
          <div class="product-body"><span class="product-kind">Persoonlijk profiel</span><h3>{product.title}</h3><p>{product.summary}</p><ul>{product.features.map((f) => <li>{f}</li>)}</ul><div class="product-footer"><div><small>Prijs</small><strong>{formatPublicPrice(product)}</strong></div><a class="button button-primary" href={profileUrl(product.slug)}>{product.slug === 'stress-en-emotieprofiel' ? 'Bekijk profiel' : 'Bekijk en bestel'}</a></div></div>
        </article>
      ))}
      {!products.length && <p class="lead">Er zijn momenteel geen profielen beschikbaar.</p>}
    </div>
  </div></section>
  <section class="how section-sm"><div class="container"><div class="how-head"><span class="eyebrow">Zo werkt het</span><h2 class="heading-lg">Van herkennen naar richting in drie rustige stappen.</h2></div><div class="steps"><article><span>01</span><h3>Kies je profiel</h3><p>Lees rustig voor wie het bedoeld is en wat je precies ontvangt.</p></article><article><span>02</span><h3>Vul online in</h3><p>Neem de tijd en beantwoord de vragen zo eerlijk mogelijk voor jezelf.</p></article><article><span>03</span><h3>Ga verder met inzicht</h3><p>Gebruik het resultaat zelfstandig of neem het mee naar begeleiding.</p></article></div><div class="notice">Een profiel is geen diagnose en vervangt geen persoonlijk diagnostisch of medisch onderzoek. Bij twijfel of ernstige klachten bespreek je jouw situatie met een bevoegde zorgprofessional.</div></div></section>
</MainLayout>

<style>
  .intro-grid{display:grid;gap:1.5rem;align-items:end;margin-bottom:3rem}.product-grid{display:grid;gap:1.5rem}.product-card{display:grid;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--white)}.product-image{position:relative;min-height:28rem;overflow:hidden;background:var(--cream)}.product-image img{position:absolute;width:100%;height:100%;object-fit:cover}.product-image>span{position:absolute;top:1rem;left:1rem;display:grid;width:2.7rem;height:2.7rem;place-content:center;border-radius:50%;background:var(--yellow);font-size:.7rem;font-weight:700}.product-image b{position:absolute;top:1rem;right:1rem;padding:.55rem .75rem;border-radius:999px;background:var(--white);color:var(--ink);font-size:.68rem;text-transform:uppercase}.unavailable .product-image img{filter:grayscale(.7);opacity:.78}.product-body{display:flex;flex-direction:column;padding:clamp(1.5rem,4vw,3rem)}.product-kind{margin-bottom:.65rem;color:var(--pink);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.product-body h3{margin-bottom:1rem;font-size:clamp(2rem,4vw,3.2rem);line-height:1}.product-body>p{color:var(--muted);line-height:1.7}.product-body ul{margin:1rem 0 2rem;padding:0;border-top:1px solid var(--line);list-style:none}.product-body li{padding:.85rem 0;border-bottom:1px solid var(--line);font-size:.82rem;font-weight:600}.product-body li::before{content:'✓';margin-right:.7rem;color:var(--pink)}.product-footer{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem;margin-top:auto}.product-footer>div{display:flex;flex-direction:column}.product-footer small{color:var(--muted);font-size:.65rem;text-transform:uppercase}.product-footer strong{font-family:'DM Serif Display',Georgia,serif;font-size:2.4rem;font-weight:400}.product-footer .soon{font-family:'DM Sans',sans-serif;font-size:.8rem;font-weight:700}.how{background:var(--cream)}.how-head{margin-bottom:3rem}.steps{display:grid;gap:1px;margin-bottom:2rem;background:var(--line);border:1px solid var(--line)}.steps article{padding:2rem;background:var(--white)}.steps span{color:var(--pink);font-size:.7rem;font-weight:700}.steps h3{margin:2rem 0 .6rem;font-size:1.8rem}.steps p{margin:0;color:var(--muted);font-size:.85rem;line-height:1.6}@media(min-width:800px){.intro-grid{grid-template-columns:1.2fr .8fr}.product-card{grid-template-columns:.9fr 1.1fr}.steps{grid-template-columns:repeat(3,1fr)}}
</style>
