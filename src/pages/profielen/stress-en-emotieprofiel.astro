---
import ProductDetail from '../../components/catalog/ProductDetail.astro';
import {publicCatalog,getPricing,resolveCatalogSlug} from '../../lib/catalog/server';
const [catalog,settings]=await Promise.all([publicCatalog(),getPricing()]);
const product=catalog.find(p=>p.slug==='stress-en-emotieprofiel');
if(!product){const alias=await resolveCatalogSlug('stress-en-emotieprofiel');return Astro.redirect(alias||'/profielen',alias?301:302);}
---
<ProductDetail product={product} priceLabel={settings.priceLabel}/>
