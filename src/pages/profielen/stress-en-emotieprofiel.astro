---
import MainLayout from '../../layouts/MainLayout.astro';
import { products } from '../../content/site';
const product = products[0];
const assessments = [
  ['NEO-PI-3', 'Persoonlijkheid — hoe je denkt, voelt en handelt.'],
  ['FEEL-E', 'Emotieregulatie — hoe je emoties verwerkt en begrijpt.'],
  ['CERQ', 'Cognitieve coping — denkpatronen in stressvolle situaties.'],
  ['CISS', 'Gedragsmatige coping — hoe je handelt onder spanning.'],
  ['RS-NL', 'Veerkracht — omgaan met tegenslag, flexibiliteit en draagkracht.'],
  ['TSI-2', 'Trauma- en stressrespons — hoe stress je systeem beïnvloedt.'],
  ['iTransform arousalprofiel', 'Arousal, energiebalans, herstel en Window of Tolerance.'],
];
---

<MainLayout activeNav="zelf" title="Stress- en emotieprofiel — MyGrowise" description="Krijg zicht op jouw stressreacties, draagkracht en emotionele patronen met het stress- en emotieprofiel van MyGrowise.">
  <section class="product-hero"><div class="container product-hero-grid"><div class="product-copy reveal"><a class="back" href="/profielen">← Alle profielen</a><span class="eyebrow">Een diepgaand vertrekpunt</span><h1>{product.title}</h1><p class="lead">Ontdek hoe jouw lichaam, brein en emoties reageren op stress. Een helder profiel dat je volledig thuis en op je eigen tempo invult.</p><div class="meta"><span>7 vragenlijsten</span><span>Rapport van ±40 pagina's</span><span>Binnen 7 werkdagen</span></div><div class="buy-row"><strong>€{product.price}</strong><a class="button button-primary" href="mailto:info@mygrowise.be?subject=Informatie%20en%20toegang%20stress-%20en%20emotieprofiel">Vraag informatie en toegang aan <span aria-hidden="true">→</span></a></div><p class="micro">Je aanvraag is vrijblijvend. Via e-mail bespreek je eerst de praktische toegang; deze knop is geen betaling.</p></div><div class="product-photo"><img src="/images/editorial/mygrowise-46.jpg" alt="Bespreking van stress en draagkracht" /><span>Inzicht dat je kan gebruiken</span></div></div></section>
  <section class="section"><div class="container detail-grid"><div><span class="eyebrow">Wat je ontvangt</span><h2 class="heading-lg">Geen los cijfer, maar een samenhangend beeld.</h2><p class="body-copy">Je ontvangt een professioneel, helder opgebouwd rapport met je individuele scores, stress- en arousalpatroon, emotionele reactiestijl, denk- en gedragspatronen, veerkracht en kernthema's.</p></div><div class="benefits">{assessments.map(([name, description],index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{name}</h3><p>{description}</p></article>)}</div></div></section>
  <section class="process section-sm"><div class="container"><div><span class="eyebrow">Zo werkt het</span><h2 class="heading-lg">Eerst duidelijkheid, dan pas een volgende stap.</h2></div><ol><li><span>01</span><div><h3>Vraag je profiel aan</h3><p>Je bestelt het Stress- en Emotieprofiel via het formulier en ontvangt alle digitale vragenlijsten per e-mail.</p></div></li><li><span>02</span><div><h3>Vul thuis in, op jouw tempo</h3><p>Je neemt rustig de tijd om de vragenlijsten in te vullen. Er is geen persoonlijke sessie nodig.</p></div></li><li><span>03</span><div><h3>Ontvang jouw persoonlijke rapport</h3><p>Binnen zeven werkdagen ontvang je jouw rapport in PDF, aangevuld met twee oefeningen op maat.</p></div></li></ol></div></section>
  <section class="fit section"><div class="container fit-grid"><div class="fit-image"><img src="/images/editorial/mygrowise-74.jpg" alt="Online werken met MyGrowise" loading="lazy" /></div><div><span class="eyebrow">Voor wie?</span><h2 class="heading-lg">Voor wie voelt dat volhouden steeds meer energie vraagt.</h2><ul><li>Je staat vaak “aan” en komt moeilijk tot rust.</li><li>Emoties komen sneller binnen of blijven langer hangen.</li><li>Je wil patronen begrijpen vóór je keuzes maakt.</li><li>Je zoekt een concreet vertrekpunt voor zelfstandig werk of begeleiding.</li></ul><div class="notice"><strong>Goed om te weten:</strong> dit profiel stelt geen diagnose. Bij acute of ernstige klachten is rechtstreeks contact met een bevoegde zorgprofessional de juiste stap.</div></div></div></section>
  <section class="cta section-sm"><div class="container cta-inner"><div><span class="eyebrow">Klaar om te starten?</span><h2 class="heading-md">Zet wat je voelt om in iets wat je begrijpt.</h2></div><div><strong>€{product.price}</strong><a class="button button-primary" href="mailto:info@mygrowise.be?subject=Informatie%20en%20toegang%20stress-%20en%20emotieprofiel">Vraag informatie aan</a></div></div></section>
</MainLayout>

<style>
