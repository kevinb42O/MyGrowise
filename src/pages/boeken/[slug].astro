---
import MainLayout from '../../layouts/MainLayout.astro';
import {publicCatalog} from '../../lib/catalog/server';
import {money} from '../../lib/catalog/pricing';
import {BOOK_SLUG,BOOK_TITLE,BOOK_COVER,BOOK_PATH,BOOK_LIBRARY_PATH,BOOK_PREVIEW_PATH} from '../../lib/ebooks/book';
const product=Astro.params.slug===BOOK_SLUG?(await publicCatalog()).find(p=>p.slug===BOOK_SLUG&&p.type==='guide'):null;
if(!product)return Astro.redirect('/zelf-aan-de-slag',302);
const available=product.availability==='available'&&product.priceCents!==null;
const checkout=`/bestellen?producten=${product.id}`;
const price=product.priceCents===null?'':money(product.priceCents);
const description='Lees samen met Fien over piekeren, zenuwen en vijf kleine superkrachten. Een rijk geïllustreerd e-book voor 7 tot 12 jaar, om interactief te lezen of te downloaden als PDF en EPUB.';
const faq=[
 ['Wat krijg ik bij mijn aankoop?','De complete digitale editie van 29 pagina’s, inclusief voor- en achterkant, voorwoord en bronnenlijst. Je kunt het hele boek interactief lezen en zowel de PDF als de EPUB downloaden. De illustraties en vaste paginaopmaak van het oorspronkelijke boek blijven behouden.'],
 ['Hoe ontvang ik mijn boek?','Je bestelt via de website en betaalt via overschrijving. Zodra Virginie de ontvangen betaling bevestigt, krijg je een persoonlijke activatiecode per e-mail. Daarmee open je jouw boekomgeving. Je hoeft geen account aan te maken.'],
 ['Waarom werkt mijn activatiecode maar één keer?','Je gebruikt de code om je aankooptoegang te openen. Daarna is dezelfde code niet nogmaals te gebruiken. Op hetzelfde apparaat kun je verder lezen; op een ander apparaat of na uitloggen vraag je een nieuwe persoonlijke e-maillink aan via Mijn aankopen.'],
 ['Kan ik het boek op mijn iPad lezen?','Ja. De PDF kun je openen en bewaren op je iPad, tablet, computer of telefoon. De EPUB is bedoeld voor leesapps die EPUB met vaste opmaak ondersteunen. De tekst zit in de originele illustraties: je kunt inzoomen, maar de letters niet afzonderlijk groter zetten zoals bij een roman.'],
 ['Hoe werkt de interactieve editie?','Open het boek in je browser en veeg, tik of gebruik de pijltjestoetsen om te bladeren. Met twee vingers kun je inzoomen. Onderweg vind je drie momenten om samen bij stil te staan. Je kunt ook rustig bladeren zonder pagina-animatie.'],
];
const schema={'@context':'https://schema.org','@type':'Product',name:BOOK_TITLE,description,image:new URL(BOOK_COVER,Astro.site||'https://www.mygrowise.be').href,offers:available?{'@type':'Offer',priceCurrency:'EUR',price:(product.priceCents!/100).toFixed(2),availability:'https://schema.org/InStock',url:new URL(BOOK_PATH,Astro.site||'https://www.mygrowise.be').href}:undefined};
---
<MainLayout title={`${BOOK_TITLE} — E-book | MyGrowise`} description={description} activeNav="zelf" footerCta={false} ogImage="/images/books/jij-fien-social.jpg" ogImageAlt="De geïllustreerde omslag van Jij, Fien en een toverkist vol superkrachten">
 <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
 <section class="fien-hero" aria-labelledby="fien-title"><div class="container fien-hero-grid" data-no-motion>
  <div class="fien-hero-copy"><a class="fien-back" href="/zelf-aan-de-slag">← Zelf aan de slag</a><h1 id="fien-title">Jij, Fien en een<br/>toverkist vol<br/><em>superkrachten.</em></h1><p class="fien-intro">Voor de grote gevoelens<br/>in een klein mensenleven.</p><p class="fien-description">Een geïllustreerd e-book om samen te lezen over piekeren, zenuwen en de kracht van je eigen fantasie. Voor kinderen van 7 tot 12 jaar.</p><div class="fien-purchase">{available?<a class="button button-primary" href={checkout}>Koop het e-book · {price} <span aria-hidden="true">→</span></a>:<p>Het e-book is tijdelijk niet bestelbaar.</p>}<p>Eenmalige aankoop · Interactief boek, PDF en EPUB<br/>Persoonlijke toegang na bevestiging van je overschrijving.</p></div><a class="fien-preview-link" href={BOOK_PREVIEW_PATH}>Probeer het interactieve boek <span aria-hidden="true">→</span></a></div>
  <figure class="fien-cover-stage"><div class="fien-cover-frame"><img src={BOOK_COVER} alt="Fien in een kleurrijke achtbaan, met haar toverkist vol superkrachten" width="2200" height="1556" fetchpriority="high"/></div><figcaption><span>Tekst &amp; scenario<br/><strong>Virginie Van Zandweghe</strong></span><span>Illustraties<br/><strong>Brent Bourguignon</strong></span></figcaption></figure>
 </div></section>
 <section class="fien-story"><div class="container fien-story-grid"><h2>Een hoofd vol gedachten.<br/>Een kist vol <em>mogelijkheden.</em></h2><div><p>Een toets die tegenvalt. Bang zijn om iets fout te doen. In bed liggen terwijl je hoofd nog verdergaat. Fien kent dat gevoel.</p><p>Op een fantasierijke tocht ontdekt ze vijf superkrachten. Met beelden, kleine aanwijzingen en een toverkist leert ze anders naar haar zenuwen en gedachten kijken.</p><p>Een verhaal om dicht bij elkaar te lezen. Om even stil te staan bij wat je voelt. En om er samen woorden aan te geven.</p></div></div></section>
 <section class="fien-preview" id="kijk-in-het-boek" aria-labelledby="fien-preview-title"><div class="container"><div class="fien-section-heading"><h2 id="fien-preview-title">Stap even in<br/><em>de wereld van Fien.</em></h2><p>Een paar pagina’s uit het boek. De originele tekeningen en handgeschreven tekst blijven ook in de digitale editie helemaal zichzelf.</p></div><div class="fien-preview-grid"><figure><a href="/images/books/jij-fien-voorbeeld-1.webp" target="_blank" rel="noopener noreferrer" aria-label="Vergroot de eerste voorbeeldpagina"><img src="/images/books/jij-fien-voorbeeld-1.webp" alt="Fien vertelt over haar gedachten en de vijf superkrachten die ze heeft ontdekt" width="1600" height="1131" loading="lazy"/></a><figcaption>Maak kennis met Fien. <span>Open groter ↗</span></figcaption></figure><figure><a href="/images/books/jij-fien-voorbeeld-2.webp" target="_blank" rel="noopener noreferrer" aria-label="Vergroot de tweede voorbeeldpagina"><img src="/images/books/jij-fien-voorbeeld-2.webp" alt="Fien, de toverkist en de kleurrijke achtbaan door haar fantasiewereld" width="1600" height="1131" loading="lazy"/></a><figcaption>Een toverkist die met je meereist. <span>Open groter ↗</span></figcaption></figure></div></div></section>
 <section class="fien-practical"><div class="container fien-practical-grid"><div><h2>Een boek om<br/><em>bij terug te komen.</em></h2><p>Voor thuis, voor samen op de bank, of als aanleiding voor een gesprek met een kind. Een persoonlijk exemplaar dat je ook offline kunt bewaren.</p><a class="fien-text-link" href={BOOK_LIBRARY_PATH}>Heb je het boek al? Open jouw exemplaar →</a></div><dl><div><dt>29 pagina’s met originele illustraties</dt><dd>Het complete boek, met omslag, voorwoord en bronnenlijst.</dd></div><div><dt>Drie manieren om te lezen</dt><dd>Blader online, bewaar de PDF of open de EPUB in je leesapp.</dd></div><div><dt>Jouw persoonlijke boekomgeving</dt><dd>Een eigen, eenmalige activatiecode na bevestiging van de betaling.</dd></div><div><dt>Geschreven om samen te lezen</dt><dd>Voor kinderen van 7 tot 12 jaar en de volwassenen die met hen meelezen.</dd></div></dl></div></section>
 <section class="fien-future"><div class="container fien-future-grid"><div><h2>Sla de pagina<br/><em>zelf om.</em></h2><p>Veeg en kijk hoe het papier onder je vinger buigt. Raak Fiens ster aan en volg het licht. Verderop ontdek je het slot van de toverkist, een hart dat met je mee ademt en een ballon die je kunt meetrekken.</p><p>Lees op je iPad, telefoon of computer en zet het boek op volledig scherm als je browser dat ondersteunt. De digitale editie onthoudt waar je op dit apparaat bent gebleven.</p><a class="fien-reader-link" href={BOOK_PREVIEW_PATH}>Open de interactieve inkijk →</a></div><div class="fien-future-art" aria-hidden="true"><img src="/images/books/jij-fien-detail.webp" alt="" width="1000" height="1000" loading="lazy"/></div></div></section>
 <section class="fien-faq"><div class="container fien-faq-grid"><h2>Nog even<br/><em>goed om te weten.</em></h2><div>{faq.map(([question,answer])=><details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div></section>
 <section class="fien-final"><div class="container"><h2>Er zit meer in je<br/>dan je <em>denkt.</em></h2><p>Ontdek samen met Fien de toverkist vol superkrachten.</p>{available&&<a class="button button-primary" href={checkout}>Koop het e-book · {price} <span aria-hidden="true">→</span></a>}<small>Interactieve editie, PDF en EPUB · Betalen via overschrijving</small></div></section>
</MainLayout>
<style>
.fien-hero{background:var(--paper,#fbf8f2);padding:clamp(2rem,4vw,4.5rem) 0 clamp(3.5rem,6vw,6rem)}.fien-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.03fr);gap:clamp(2.5rem,5vw,6rem);align-items:center}.fien-back{display:inline-block;font-size:.875rem;text-underline-offset:4px;margin-bottom:2rem}.fien-hero h1{font-size:clamp(2.8rem,4.5vw,4.8rem);line-height:1.04;letter-spacing:-.035em;margin:0 0 1.8rem}.fien-hero em,.fien-story em,.fien-preview em,.fien-practical em,.fien-faq em,.fien-final em{font-weight:400;color:#823f49}.fien-intro{font-size:clamp(1.25rem,1.8vw,1.6rem);line-height:1.45;color:var(--ink);margin:0 0 1rem}.fien-description{max-width:45ch;color:var(--muted);font-size:1rem;line-height:1.8}.fien-purchase{margin-top:1.8rem}.fien-purchase .button{gap:1.5rem;min-height:54px;padding:1rem 1.4rem;border-radius:6px}.fien-purchase>p{font-size:.8125rem;line-height:1.7;color:var(--muted);margin-top:.8rem}.fien-preview-link{display:inline-flex;gap:1.5rem;align-items:center;min-height:44px;margin-top:.5rem;font-size:.9rem;text-underline-offset:5px}.fien-cover-stage{margin:0;min-width:0}.fien-cover-frame{padding:clamp(1rem,3vw,2.5rem);background:#f3c9c8;transform:rotate(2deg)}.fien-cover-frame img{width:100%;height:auto;display:block;box-shadow:0 14px 24px #173d3526;transform:rotate(-2deg)}.fien-cover-stage figcaption{display:flex;justify-content:space-between;gap:1rem;margin-top:2rem;padding-inline:.3rem;font-size:.75rem;line-height:1.7;color:var(--muted)}.fien-cover-stage figcaption strong{font-weight:500;color:var(--ink)}
.fien-story,.fien-practical,.fien-faq{padding-block:clamp(4rem,7vw,7rem)}.fien-story-grid,.fien-practical-grid,.fien-faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,8rem)}.fien-story h2,.fien-section-heading h2,.fien-practical h2,.fien-faq h2{font-size:clamp(2.4rem,3.8vw,3.8rem);line-height:1.1;letter-spacing:-.03em;margin:0 0 1.5rem}.fien-story p,.fien-practical p{font-size:1.05rem;line-height:1.85;max-width:62ch;color:var(--muted);margin:0 0 1.2rem}.fien-preview{padding-block:clamp(4rem,6vw,6rem);background:#f1eee6;scroll-margin-top:6rem}.fien-section-heading{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:end;margin-bottom:2rem}.fien-section-heading p{font-size:1rem;line-height:1.8;color:var(--muted);max-width:48ch;margin-bottom:1.5rem}.fien-preview-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.fien-preview figure{margin:0;min-width:0}.fien-preview img{display:block;width:100%;height:auto;background:#fff}.fien-preview figcaption{display:flex;justify-content:space-between;gap:1rem;font-size:.8125rem;line-height:1.6;margin-top:1rem;color:var(--muted)}.fien-preview figcaption span{white-space:nowrap;color:var(--ink)}.fien-text-link{display:inline-block;padding-block:.6rem;min-height:44px;font-size:.9375rem;text-underline-offset:5px}.fien-practical dl{margin:0}.fien-practical dl>div{padding:1.4rem 0;border-top:1px solid var(--line)}.fien-practical dt{font-size:1.05rem;font-weight:600;margin-bottom:.5rem}.fien-practical dd{margin:0;color:var(--muted);font-size:.9375rem;line-height:1.8}.fien-future{background:#173d35;color:#fffdf9;overflow:hidden}.fien-future-grid{display:grid;grid-template-columns:1fr .85fr;gap:clamp(2rem,6vw,6rem);align-items:center;padding-block:clamp(3.5rem,6vw,6rem)}.fien-future h2{font-size:clamp(2.6rem,4vw,4rem);line-height:1.08;letter-spacing:-.03em;color:#fffdf9;margin-bottom:1.8rem}.fien-future em{color:#f3c9c8;font-weight:400}.fien-future p{font-size:1rem;line-height:1.85;color:#e1e9df;max-width:53ch}.fien-future p+p{font-size:.875rem;color:#c8d8cc;margin-top:1.5rem}.fien-reader-link{display:inline-flex;align-items:center;min-height:44px;color:#fffdf9;text-underline-offset:5px;font-weight:600}.fien-future-art img{width:100%;height:auto;display:block;border-radius:50%}.fien-faq details{border-bottom:1px solid var(--line)}.fien-faq summary{display:flex;justify-content:space-between;gap:1rem;padding:1.3rem 0;cursor:pointer;list-style:none;font-size:1rem;line-height:1.6}.fien-faq summary::-webkit-details-marker{display:none}.fien-faq summary span{font-size:1.3rem;transition:transform .2s}.fien-faq details[open] summary span{transform:rotate(45deg)}.fien-faq details p{font-size:.9375rem;line-height:1.85;color:var(--muted);margin:0 0 1.6rem;max-width:65ch}.fien-final{text-align:center;background:#fcf0eb;padding-block:clamp(4rem,7vw,7rem)}.fien-final h2{font-size:clamp(3rem,5vw,5rem);line-height:1.05;letter-spacing:-.035em;margin-bottom:1.5rem}.fien-final p{font-size:1.05rem;line-height:1.8;color:var(--muted);margin-bottom:1.8rem}.fien-final .button{min-height:54px;gap:2rem;border-radius:6px}.fien-final small{display:block;margin-top:1rem;font-size:.8125rem;color:var(--muted)}
@media(max-width:900px){.fien-hero-grid{grid-template-columns:1fr 1fr;gap:2rem}.fien-hero h1{font-size:clamp(2.5rem,5vw,3.8rem)}.fien-cover-stage figcaption{flex-direction:column}.fien-story-grid,.fien-practical-grid,.fien-faq-grid{gap:2rem}.fien-preview-grid{gap:1.2rem}.fien-preview figcaption{display:block}.fien-preview figcaption span{display:block;margin-top:.3rem}}
@media(max-width:680px){.fien-hero-grid{grid-template-columns:1fr}.fien-hero-copy{display:contents}.fien-back{grid-row:1;margin:0}.fien-hero h1{grid-row:2;font-size:clamp(2.8rem,9.2vw,4rem);margin-bottom:0}.fien-cover-stage{grid-row:3;margin-block:.5rem}.fien-cover-stage figcaption{flex-direction:row;margin-top:1.2rem;font-size:.6875rem}.fien-cover-frame{padding:1.3rem}.fien-intro{grid-row:4;margin:0;font-size:1.35rem}.fien-description{grid-row:5;margin:0}.fien-purchase{grid-row:6;margin:0}.fien-preview-link{grid-row:7;margin-top:-.8rem;justify-content:space-between}.fien-hero-grid{gap:1.6rem}.fien-purchase .button{width:100%;justify-content:space-between}.fien-story-grid,.fien-practical-grid,.fien-faq-grid,.fien-section-heading,.fien-future-grid{grid-template-columns:1fr;gap:1.5rem}.fien-preview-grid{grid-template-columns:1fr;gap:2.4rem}.fien-section-heading{margin-bottom:1rem}.fien-section-heading h2{margin-bottom:0}.fien-future-art{max-width:330px;margin:1rem auto 0}.fien-story h2,.fien-section-heading h2,.fien-practical h2,.fien-faq h2{font-size:2.5rem}.fien-hero{padding-top:1.5rem}}
@media(prefers-reduced-motion:reduce){.fien-faq summary span{transition:none}}
</style>
