---
import MainLayout from '../../layouts/MainLayout.astro';
import {money} from '../../lib/catalog/pricing';
import type {CatalogProduct} from '../../lib/catalog/server';
import '../../styles/catalog.css';
interface Props { product:CatalogProduct; priceLabel:string }
const {product:p,priceLabel}=Astro.props;
const isPackage=p.type==='profile';const available=p.availability==='available'&&p.priceCents!==null;
const checkout=`/bestellen?${isPackage?'pakket':'vragenlijsten'}=${p.id}`;
---
<MainLayout title={`${p.title} — MyGrowise`} activeNav="zelf" description={p.summary}>
<section class="detail-hero"><div class="container"><a class="detail-back" href={isPackage?'/profielen':'/vragenlijsten'}>← {isPackage?'Alle profielen':'Alle vragenlijsten'}</a><div class="detail-grid"><div><span class="catalog-kicker">{isPackage?'Persoonlijk profiel':p.category}</span><h1>{p.title}</h1><p class="detail-lead">{p.summary}</p><div class="detail-tags"><span>{p.audience}</span><span>{p.ageLabel}</span>{p.version&&<span>{p.version}</span>}</div><div class="detail-price">{available?<><small>{priceLabel} · {isPackage?'vaste pakketprijs':'losse vragenlijst'}</small><strong>{money(p.priceCents!)}</strong><a class="catalog-checkout" href={checkout}>{isPackage?'Kies dit profiel':'Kies deze vragenlijst'} →</a>{!isPackage&&<a class="detail-combine" href={`/samenstellen?voegtoe=${p.id}`}>Voeg toe aan een combinatie</a>}</>:<p>Dit aanbod is {p.availability==='upcoming'?'in ontwikkeling':'tijdelijk niet beschikbaar'}.</p>}</div></div><div class="detail-photo"><img src={p.image} alt=""/><div><span>Inzicht op jouw maat</span><p>Een zorgvuldig vertrekpunt.<br/>Persoonlijk opgevolgd.</p></div></div></div></div></section>
<section class="catalog-section"><div class="container detail-body"><div><span class="catalog-kicker">Wat je ontvangt</span><h2>Ruimte om te begrijpen wat er speelt.</h2><p class="detail-text">{p.description||p.summary}</p><p class="detail-text">{p.includesText}</p>{isPackage&&<><h3>Deze vragenlijsten vormen je profiel</h3><ul class="detail-components">{p.components.map((c,i)=><li><span>{String(i+1).padStart(2,'0')}</span><strong>{c.title}</strong></li>)}</ul><p class="catalog-disclaimer">Dit profiel heeft een vaste prijs. Combinatiekorting geldt bij het zelf samenstellen van losse vragenlijsten.</p></>}</div><aside class="detail-next"><span class="catalog-kicker">Na je aankoop</span><h3>Je volgende stap staat klaar.</h3><p class="detail-text">{p.deliveryText}</p><p>Je afname wordt professioneel opgevolgd. In je account zie je de voortgang en beschikbare rapporten.</p><a href="/contact">Twijfel je of dit past? Laat het ons weten →</a></aside></div></section>
</MainLayout>
<style>.detail-hero{padding:2rem 0 4rem;background:var(--cream)}.detail-back{font-size:.8rem;text-decoration:none;display:inline-block;margin-bottom:2.5rem}.detail-grid{display:grid;gap:3rem;align-items:center}.detail-grid h1{font-size:clamp(3.2rem,5.5vw,5.5rem);line-height:1.02;margin:1rem 0 1.3rem}.detail-lead{font-size:1rem;line-height:1.8;color:var(--muted);max-width:600px}.detail-tags{display:flex;flex-wrap:wrap;gap:.5rem}.detail-tags span{border:1px solid var(--line);padding:.5rem .75rem;border-radius:999px;font-size:.7rem}.detail-price{margin-top:2rem;max-width:350px}.detail-price small{display:block;color:var(--muted);font-size:.7rem}.detail-price strong{display:block;font-family:'DM Serif Display',serif;font-size:3.8rem;font-weight:400;margin:.3rem 0 1rem}.detail-combine{display:block;text-align:center;font-size:.75rem;margin-top:1rem}.detail-photo{height:500px;border-radius:2rem;position:relative;overflow:hidden;background:#ddd}.detail-photo img{width:100%;height:100%;object-fit:cover}.detail-photo>div{position:absolute;bottom:1.4rem;left:1.4rem;right:1.4rem;padding:1.3rem;background:#fbf8f2ee;border-radius:1rem}.detail-photo span{font-size:.65rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--pink)}.detail-photo p{font-family:'DM Serif Display',serif;font-size:1.8rem;line-height:1.1;margin:.6rem 0 0}.detail-body{display:grid;gap:3rem}.detail-body h2{font-size:clamp(2.6rem,4vw,3.8rem);line-height:1.1;margin:1rem 0 1.5rem}.detail-body h3{font-size:1.9rem}.detail-text{white-space:pre-line;font-size:.95rem;line-height:1.8;color:var(--muted)}.detail-components{list-style:none;padding:0;margin:2rem 0}.detail-components li{display:flex;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}.detail-components span{font-size:.7rem;color:var(--pink)}.detail-components strong{font-size:.9rem}.detail-next{padding:2rem;background:var(--cream);border:1px solid var(--line);border-radius:1.2rem;align-self:start}.detail-next h3{margin:1rem 0}.detail-next p,.detail-next a{font-size:.85rem;line-height:1.8;color:var(--muted)}@media(min-width:900px){.detail-grid{grid-template-columns:1.1fr .9fr}.detail-body{grid-template-columns:1fr 360px}}@media(max-width:600px){.detail-photo{height:350px}.detail-grid h1{font-size:3.2rem}}</style>
