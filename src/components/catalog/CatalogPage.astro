---
import MainLayout from '../../layouts/MainLayout.astro';
import CatalogExplorer from './CatalogExplorer';
import CatalogListingHero from './CatalogListingHero.astro';
import { publicCatalog,getPricing } from '../../lib/catalog/server';
import '../../styles/catalog.css';
import '../../styles/questionnaire.css';
import {ownedModuleIds} from '../../lib/modules/server';
import {isCustomerAccount} from '../../lib/adminAuth';
import profileInformation from '../../content/profileInformation.json';
import '../../styles/profiles.css';
import questionnaireInformation from '../../content/questionnaireInformation.json';
interface Props { mode: 'packages'|'questionnaires'|'builder' }
const {mode}=Astro.props;
const [products,settings]=await Promise.all([publicCatalog(),getPricing()]);
const owned=isCustomerAccount(Astro.locals.currentUser)?await ownedModuleIds(Astro.locals.currentUser!.sub):[];
if(Astro.locals.currentUser)Astro.response.headers.set('Cache-Control','private, no-store');
const listingProducts=products.map(({landingContent,profileLanding:c,...product})=>({...product,profileSummary:c?{question:c.question,ageMin:c.ageMin,ageMax:c.ageMax,themes:c.themes,instrumentCount:c.instrumentCount,ownCount:c.ownCount}:null}));
const title=mode==='packages'?'Persoonlijke profielen':mode==='builder'?'Stel je eigen combinatie samen':'Vragenlijsten';
---
<MainLayout title={`${title} — MyGrowise`} activeNav="zelf" description="Kies een persoonlijk profiel of combineer professionele vragenlijsten. Ontdek wat bij jouw vraag past, met heldere prijzen en persoonlijke opvolging.">
{mode==='builder' ? (
  <section class="catalog-hero is-builder">
    <div class="container catalog-hero-grid">
      <div>
        <span class="catalog-kicker">Inzicht begint met jouw vraag</span>
        <h1>Jouw vragen.<br /><em>Jouw combinatie.</em></h1>
        <p>Kies modules en vragenlijsten die aansluiten bij wat je wil begrijpen. Je ziet meteen de inhoud, de prijs en je combinatiekorting.</p>
        <nav class="catalog-tabs" aria-label="Aanbod"><a href="/profielen">Vaste profielen</a><a href="/vragenlijsten">Losse vragenlijsten</a><a href="/modules">Online modules</a><a href="/samenstellen" aria-current="page">Zelf samenstellen ↗</a></nav>
      </div>
      <aside class="catalog-hero-note">
        <span aria-hidden="true">✳</span><h2>Kies wat past. Combineer slim.</h2>
        <p>Eén product voor de gewone prijs. Vanaf {settings.mediumMin} modules en/of vragenlijsten {settings.mediumPercent}% korting, vanaf {settings.largeMin} {settings.largePercent}%.</p>
        <a href="/contact">Hulp bij je keuze →</a>
      </aside>
    </div>
  </section>
) : <CatalogListingHero mode={mode} />}
<section class:list={["catalog-section",{"catalog-offer-section":mode!=='builder'}]} id="aanbod"><div class="container" data-no-motion>{mode!=='builder'&&<nav class="catalog-tabs catalog-offer-tabs" aria-label="Aanbod"><a href="/profielen" aria-current={mode==='packages'?'page':undefined}>Vaste profielen</a><a href="/vragenlijsten" aria-current={mode==='questionnaires'?'page':undefined}>Losse vragenlijsten</a><a href="/modules">Online modules</a><a href="/samenstellen">Zelf samenstellen ↗</a></nav>}<h2 class:list={{"catalog-list-heading":mode==='builder',"catalog-offer-heading":mode!=='builder'}}>{mode==='packages'?'Bekijk de profielen':mode==='builder'?'Bekijk modules, vragenlijsten en extra’s':'Bekijk de vragenlijsten'}</h2><CatalogExplorer client:load products={listingProducts} settings={settings} mode={mode} ownedModuleIds={owned}/><noscript><p>Schakel JavaScript in om te filteren en je combinatie samen te stellen.</p><ul>{products.filter(p=>mode==='builder'?['module','questionnaire','guide'].includes(p.type):p.type===(mode==='packages'?'profile':'questionnaire')).map(p=><li><a href={`/${p.type==='profile'?'profielen':p.type==='module'?'modules':p.type==='guide'?'verdieping':'vragenlijsten'}/${p.slug}`}>{p.title}</a></li>)}</ul></noscript></div></section>
{mode==='packages'&&<><section class="profile-information"><div class="container profile-information-grid">{profileInformation.map(block=><article><h2>{block.title}</h2>{block.paragraphs.map(line=><p>{line}</p>)}</article>)}</div></section><section class="profile-help"><div class="container"><h2>Twijfel je tussen twee profielen?</h2><p>We helpen je de inhoud en doelgroep te vergelijken.</p><a href="/contact">Vraag hulp bij je keuze →</a></div></section>{products.some(p=>p.type==='profile'&&!p.profileLanding&&p.availability==='upcoming')&&<section class="profile-teasers"><div class="container"><h2>In ontwikkeling</h2>{products.filter(p=>p.type==='profile'&&!p.profileLanding&&p.availability==='upcoming').map(p=><a href={`/profielen/${p.slug}`}>{p.title} · In ontwikkeling →</a>)}</div></section>}</>}
{mode==='questionnaires'&&<section class="questionnaire-information" aria-label="Over de MyGrowise-vragenlijsten"><div class="container"><div class="questionnaire-information-grid">{questionnaireInformation.map(block=><article><h2>{block.title}</h2>{block.paragraphs.map(paragraph=><p>{paragraph}</p>)}</article>)}</div><nav class="questionnaire-information-help" aria-label="Hulp en ander aanbod"><a href="/contact">Hulp bij je keuze →</a><a href="/profielen">Bekijk de vaste profielen →</a><a href="/samenstellen">Stel je eigen combinatie samen →</a></nav></div></section>}
<section class:list={["catalog-process",{"catalog-offer-process":mode!=='builder'}]}><div class="container"><span class="catalog-kicker">Persoonlijk opgevolgd</span><h2>Van jouw vraag naar een volgende stap.</h2><div class="catalog-process-grid"><article><span>01 / KIEZEN</span><h3>Begin bij wat je wil begrijpen.</h3><p>Kies een vast profiel of combineer modules en vragenlijsten voor één persoon. Bij twijfel helpen we je kiezen.</p></article><article><span>02 / AFNEMEN</span><h3>Met duidelijke instructies.</h3><p>Na bevestiging van je betaling kun je aangekochte modules openen. MyGrowise bereidt eventuele vragenlijstafnames voor. Je ontvangt per e-mail een veilige link naar je aankopen. Een account is optioneel.</p></article><article><span>03 / VERDER GAAN</span><h3>Gebruik je inzicht.</h3><p>De afname wordt professioneel opgevolgd. Beschikbare resultaten en rapporten ontvang je veilig via Mijn aankopen.</p></article></div><p class="catalog-disclaimer">Een vragenlijst is een hulpmiddel voor inzicht. Geschiktheid, afnamevorm en interpretatie worden professioneel beoordeeld. Een uitkomst is op zichzelf geen diagnose. Voor kinderen verloopt de aankoop via een ouder of verzorger.</p></div></section>
</MainLayout>

<style>
  .catalog-offer-section{padding-block:clamp(3rem,6vw,5rem);scroll-margin-top:6rem}
  .catalog-offer-tabs{margin:0 0 2.5rem;gap:.6rem}
  .catalog-offer-tabs a{min-height:44px;display:inline-flex;align-items:center}
  .catalog-offer-heading{margin:0 0 2rem;font-size:clamp(2.4rem,4vw,3.7rem);line-height:1.1}
  .catalog-offer-process{padding-block:clamp(3rem,6vw,5rem);border-top:0}
  .catalog-offer-process h2{font-size:clamp(2.4rem,4vw,3.7rem);line-height:1.1;margin:0 0 1.3rem}
  @media(max-width:600px){.catalog-offer-tabs{margin-bottom:2rem}.catalog-offer-tabs a{font-size:.75rem;padding:.7rem .9rem}}
</style>
