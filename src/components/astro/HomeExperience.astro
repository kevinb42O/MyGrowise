---
import { practitioners, homeFaqs, recognitionItems } from '../../content/site';
import { listPublishedProfiles, formatPublicPrice, profileUrl } from '../../lib/publicProducts';
import { publicModules } from '../../lib/modules/server';
import { money } from '../../lib/catalog/pricing';
import '../../styles/homeExperience.css';
import HomeLoading from './HomeLoading.astro';

const [profiles, moduleProducts] = await Promise.all([
  listPublishedProfiles(),
  publicModules().catch(() => { console.warn('homepage_modules_unavailable'); return []; }),
]);
const featured = profiles.find(product => product.slug === 'stress-en-emotieprofiel');
const modules = moduleProducts.slice(0, 3);
const recognitionHighlights = ['je lichaam moe is.', 'sneller of intenser binnenkomen.', 'steeds meer energie.'];
---

<div class="home-experience" data-home-experience>
<HomeLoading />
<button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" hidden>
  <span data-motion-label>Rustige weergave</span>
</button>

<div class="journey-track"><div class="journey-stage">
<div class="hero-track" id="welkom" data-hero-track><div class="hero-stage">
  <section class="chapter opening" data-hero aria-labelledby="hero-title">
   <div class="hero-main">
   <div class="hero-world"><img src="/images/hero/inner-world-lake-beyond-portal-v3.webp" alt="Een bergmeer, omringd door bomen en ochtendlicht" fetchpriority="high" width="1586" height="992"></div><div class="hero-shade"></div>
   <div class="hero-portal" aria-hidden="true"><picture><source media="(max-width: 600px)" srcset="/images/hero/inner-world-head-and-ground-mobile-v3.webp" width="887" height="1774" /><img src="/images/hero/inner-world-head-and-ground-v3.webp" alt="" width="1586" height="992" loading="eager" fetchpriority="high" decoding="async" /></picture></div>

   <div class="hero-brand" aria-hidden="true"><img src="/images/logo-lelie.webp" alt="" width="382" height="289" loading="eager" decoding="async" /></div>
   <div class="hero-copy"><h1 id="hero-title"><span class="hero-title-left">Wat je <em>voelt,</em></span> <span class="hero-title-right">verdient aandacht.</span></h1><div class="hero-supporting"><h2 class="hero-statement">Ontdek wat<br> <span class="hero-statement-accent">je nodig hebt.</span></h2><p class="hero-promise">Op jouw tempo.</p><p class="hero-description">MyGrowise helpt je patronen rond stress en emoties te begrijpen. Met persoonlijke profielen, modules en online begeleiding vind je een stap die bij je past.</p><div class="actions"><a class="button light" href="/startpunt">Vind je startpunt <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a><a class="text-link" href="/begeleiding">Bekijk begeleiding</a></div></div></div>
   </div>
   <div class="hero-introduction">
    <div class="hero-introduction-copy"><p>MyGrowise werd opgericht door Virginie vanuit haar ervaring met stress, emotionele belasting en trauma.</p><a class="text-link dark-link" href="/over-ons">Het verhaal van MyGrowise <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div>
   <figure class="hero-portrait"><img src="/images/editorial/mygrowise-74.jpg" alt="Virginie werkt online vanuit haar praktijk" width="1920" height="1529" fetchpriority="high" /><figcaption><span>Virginie</span><span>Oprichter van MyGrowise</span></figcaption></figure>
   <a class="scroll-cue" href="#herkenning">Eerst begrijpen. Dan verder.<span aria-hidden="true">↓</span></a><span class="hero-footnote">Rust · inzicht · richting</span>
   </div>
   <button class="hero-skip" type="button" data-hero-skip hidden>Intro overslaan <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></button>
  </section>
  <section class="recognition" id="herkenning" aria-labelledby="recognition-title">
   <div class="recognition-surface" aria-hidden="true"></div>
   <figure class="recognition-landscape"><img src="/images/hero/inner-world-lake-beyond-portal-v3.webp" width="1586" height="992" alt="Een stil bergmeer met de weerspiegeling van de bergen" loading="eager" /><figcaption>Even stilstaan is ook een stap.</figcaption></figure>
   <div class="recognition-logo" aria-hidden="true"><img src="/images/hero/inner-world-lake-beyond-portal-v3.webp" width="1586" height="992" alt="" loading="eager" /></div>
   <div class="recognition-inner">
    <h2 id="recognition-title">Je houdt veel vol.<br /><em>Maar wat kost het je?</em></h2>
    <div class="recognition-lines">{recognitionItems.slice(0, 3).map((item, index) => {
      const highlight = recognitionHighlights[index];
      const split = item.indexOf(highlight);
      return <p><span class="recognition-lead">{item.slice(0, split)}</span><em class="recognition-emphasis">{highlight}</em></p>;
    })}</div>
    <div class="recognition-closing"><p>Je hoeft nog niet precies te weten wat je nodig hebt.</p><p>Eerst begrijpen wat er gebeurt.</p><a class="text-link" href="#inzicht">Ontdek wat inzicht je kan brengen <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a></div>
   </div>
  </section>
</div></div>

<div class="experience" data-experience><div class="experience-stage">
  <section class="chapter insight" id="inzicht" data-layer="insight" aria-labelledby="insight-title"><div class="insight-image"><img src="/images/hero/insight-alpine-lake-hd-v2.webp" width="1672" height="941" alt="Uitzicht over een bergmeer, met wolken tussen de bergen in warm ochtendlicht"><div class="insight-image-shade" aria-hidden="true"></div><div class="insight-paper" aria-hidden="true"><div class="insight-paper-caption"><p>Het innerlijke<br />landschap.</p><small>Herkennen · begrijpen · verdergaan</small></div></div></div><div class="insight-copy"><div class="insight-heading"><h2 id="insight-title"><span data-insight-line>Inzicht dat</span><br /> <em data-insight-line>ergens naartoe leidt.</em></h2></div>
    <p>{featured ? featured.summary : 'MyGrowise helpt je patronen rond stress en emoties te begrijpen. Je vindt er persoonlijke profielen, zelfstandige modules en online begeleiding.'}</p>
    {featured && <p class="featured-product">{featured.title}<strong>{formatPublicPrice(featured)}</strong></p>}
    <a class="text-link dark-link" href={featured ? profileUrl(featured.slug) : '/profielen'}>{featured ? 'Bekijk wat je ontvangt' : 'Ontdek de profielen'} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a>
    <p class="material-note">Een persoonlijk profiel ondersteunt inzicht en oriëntatie. Het is geen diagnose en vervangt geen individueel klinisch onderzoek.</p>
   </div></section>
  <section class="chapter modules" id="modules" data-layer="modules" aria-labelledby="modules-title"><div class="module-heading"><h2 id="modules-title">Ontdek jouw<br> <em>innerlijke landschap.</em></h2><p>Zelfstandig verdiepen.<br> Op jouw tempo.</p></div><div class="module-deck">{modules.map((product, index) => <article class="module-paper" data-module-paper={index} aria-hidden="true"><img src={product.image} width="512" height="512" alt="" loading="lazy" /><div class="paper-title"><h3>{product.title}</h3><p>{product.module.tagline}</p></div></article>)}</div>
   <div class="module-copies">{modules.map((product, index) => <article class="module-copy" data-module-copy={index}><figure class="fallback-module-visual"><img class="fallback-module-image" src={product.image} width="512" height="512" alt={product.module.image_alt} loading="lazy" /><figcaption class="paper-title"><h3>{product.title}</h3><p>{product.module.tagline}</p></figcaption></figure><h3>{product.module.subtitle}</h3><p>{product.summary}</p><a class="text-link dark-link" href={`/modules/${product.slug}`}>Ontdek {product.title.toLocaleLowerCase('nl-BE')} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a><p class="availability">{product.availability === 'available' ? 'Beschikbaar' : product.availability === 'paused' ? 'Tijdelijk niet bestelbaar' : 'In ontwikkeling'}{product.priceCents !== null && <> · {product.availability === 'available' ? 'Eenmalige prijs' : 'Geplande prijs'} {money(product.priceCents)}</>}</p></article>)}
   {modules.length === 0 && <div class="module-copy-empty"><h3>Een eigen ingang.<br />Een samenhangend landschap.</h3><p>Bekijk de modules en hun actuele beschikbaarheid in het overzicht.</p><a class="text-link dark-link" href="/modules">Bekijk de modules</a></div>}</div>
   <nav class="module-nav" aria-label="Module kiezen">{modules.map((product, index) => <button type="button" data-module-go={index} aria-current={index === 0 ? 'step' : undefined}>{product.title}</button>)}</nav><a class="all-modules" href="/modules">Alle modules <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></section>
  <section class="chapter routes" id="routes" data-layer="routes" aria-labelledby="routes-title"><h2 class="sr-only" id="routes-title">Twee manieren om te starten</h2><article class="route route-self"><img src="/images/modules/innerlijke-landschap-hero-v1.webp" alt="Een rustig meer tussen de bergen" width="1120" height="1400"><div class="route-shade"></div><div class="route-copy"><p>Op je eigen tempo</p><h3>Zelfstandig<br> <em>verder.</em></h3><p>Begin met een persoonlijk profiel, een module of verdiepende informatie.</p><a class="button light" href="/zelf-aan-de-slag">Zelf aan de slag <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div></article><article class="route route-care"><img src="/images/editorial/mygrowise-74.jpg" width="1920" height="1529" alt="Virginie in haar praktijk"><div class="route-shade"></div><div class="route-copy"><p>Met iemand naast je</p><h3>Samen<br> <em>verder.</em></h3><p>Bespreek je verhaal met een professional die aansluit bij je hulpvraag.</p><a class="button light" href="/begeleiding">Ontdek begeleiding <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div></article></section>
  <nav class="chapter-nav" aria-label="Hoofdstukken"><a href="#welkom" data-chapter="hero">Welkom</a><a href="#herkenning" data-chapter="recognition">Herkenning</a><a href="#inzicht" data-chapter="insight">Inzicht</a><a href="#modules" data-chapter="modules">Modules</a><a href="#routes" data-chapter="routes">Jouw route</a></nav>
 </div>
</div>
 </div></div>
<section class="people section" id="mensen"><div class="section-heading"><h2>Een mens tegenover je.<br> <em>Niet nóg een systeem.</em></h2><p>Je hoeft het niet alleen uit te zoeken.<br> Maak kennis met de mensen achter MyGrowise.</p></div><div class="people-grid">{practitioners.map(person => <article class={`person person--${person.slug}`}>
  <a class="person-portrait" href={`/begeleiding/${person.slug}`} aria-label={`Leer ${person.name} kennen`}>
    <figure class="person-print">
      <div class="person-photo"><img src={person.image} alt={person.name} width="600" height="750" loading="lazy" /></div>
      <figcaption><h3>{person.name}</h3></figcaption>
    </figure>
  </a>
  <p class="person-role">{person.role}</p><p class="person-focus">{person.focus}</p><a class="text-link dark-link" href={`/begeleiding/${person.slug}`}>Leer {person.name} kennen <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" /></svg></a></article>)}</div><a class="text-link dark-link" href="/begeleiding">Bekijk alle begeleiding <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></section>
<div class="story-track" id="verhaal"><div class="story-stage"><section class="story-portrait" aria-labelledby="story-title"><div class="story-photo"><img src="/images/practitioners/virginie-real.jpg" width="1200" height="1600" alt="Virginie, oprichter van MyGrowise" loading="lazy"></div><div class="story-copy"><h2 id="story-title">Ontstaan vanuit<br> <em>de praktijk.</em></h2><blockquote>“Mensen hebben niet altijd méér informatie nodig. Ze hebben vooral nood aan inzicht dat ergens naartoe leidt.”</blockquote><p>MyGrowise werd opgericht door Virginie vanuit haar ervaring met stress, emotionele belasting en trauma.</p><a class="text-link dark-link" href="/over-ons">Het verhaal van MyGrowise <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div></section><div class="story-curtain" aria-hidden="true"><img src="/images/editorial/mygrowise-17.jpg" width="1200" height="1600" alt="" loading="lazy"><p class="story-statement"><span>Eerst <em>begrijpen.</em></span><span>Dan <em>verder.</em></span></p></div><section class="story-film" aria-labelledby="film-title"><div class="film-heading"><h2 id="film-title">Maak kennis<br> <em>met MyGrowise.</em></h2><p>Het verhaal en de mensen achter een plek voor inzicht, groei en persoonlijke begeleiding.</p></div><div class="video-frame"><button class="video-play" type="button" aria-label="Speel de brandingvideo van MyGrowise af"><img src="/images/video/mygrowise-branding.jpg" width="1280" height="720" alt="Virginie in de brandingvideo van MyGrowise" loading="lazy"><span class="play-icon" aria-hidden="true">▶</span><span class="video-label">Bekijk het verhaal</span></button></div></section></div></div>
<section class="faq section" id="vragen"><div class="section-heading"><h2>Eerst nog even<br> <em>weten hoe het zit?</em></h2><p>Goede hulp begint met duidelijke informatie.</p></div><div class="faq-list">{homeFaqs.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>


</div>
<script>
  import '../../scripts/homeExperience.js';
</script>
