---
import BusinessDetails from './BusinessDetails.astro';
interface Props { showIntro?: boolean }
const { showIntro = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', { 'site-footer--compact': !showIntro }]}>
  <div class="container footer-main">
    {showIntro && <div class="footer-intro">
      <span class="footer-kicker">Een volgende stap die bij jou past</span>
      <h2>Begrijpen mag ook<br /><em>het begin zijn.</em></h2>
      <div class="footer-actions">
        <a class="button footer-button" href="/startpunt">Vind je startpunt</a>
        <a class="button footer-button ghost" href="/begeleiding">Vind begeleiding</a>
      </div>
    </div>}
    <div class="footer-nav">
      <div class="footer-group">
        <h3>Aanbod</h3>
        <a href="/profielen">Profielen</a><a href="/vragenlijsten">Vragenlijsten</a><a href="/samenstellen">Zelf samenstellen</a>
        <a href="/modules">Online modules</a>
        <a href="/community">Community</a>
        <a href="/begeleiding">Begeleiding</a>
      </div>
      <div class="footer-group">
        <h3>MyGrowise</h3>
        <a href="/over-ons">Over ons</a>
        <a href="/contact">Contact</a>
        <a href="/prijzen">Prijzen</a>
      </div>
      <div class="footer-group">
        <h3>Praktisch</h3>
        <a href="mailto:info@mygrowise.be">info@mygrowise.be</a>
        <a href="/privacy">Privacy</a>
        <a href="/voorwaarden">Voorwaarden</a>
      </div>
      <div class="footer-group footer-company">
        <h3>Bedrijfsgegevens</h3>
        <BusinessDetails variant="footer" />
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <a class="footer-wordmark" href="/" aria-label="MyGrowise home"><img class="footer-mark" src="/images/logo-lelie.webp" alt="" width="45" height="34" /><span>MyGrowise</span></a>
    <p>© {year} MyGrowise. Geen crisisdienst — bij acuut gevaar bel 112.</p>
    <a class="footer-credit" href="https://www.webaanzee.be/">
      <span>Design &amp; development</span>
      <img src="/images/webaanzee-wordmark.png" alt="Webaanzee" width="640" height="77" loading="lazy" decoding="async" />
    </a>
  </div>
</footer>

<style>
  .site-footer {
    overflow: hidden;
    background:
      linear-gradient(180deg, var(--ink-deep), transparent 48%),
      radial-gradient(ellipse at 90% 70%, #6c796035, transparent 62%),
      linear-gradient(125deg, var(--ink-deep), #183b31 58%, #263f34);
    color: white;
  }
  .footer-main { display: grid; gap: 4rem; padding-block: clamp(4rem, 9vw, 8rem); }
  .site-footer--compact .footer-main { grid-template-columns: 1fr; padding-block: clamp(3rem, 5vw, 5rem); }
  .footer-kicker { display: block; margin-bottom: 1.2rem; color: var(--yellow); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .footer-intro h2 { margin-bottom: 2rem; font-size: clamp(3rem, 7vw, 6.5rem); line-height: 0.92; }
  .footer-intro h2 em { color: var(--pink); font-weight: 400; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .footer-button { border-color: white; background: white; color: var(--ink-deep); }
  .footer-button.ghost { background: transparent; color: white; }
  .footer-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 1.5rem; color: rgba(255,255,255,.76); font-size: .9rem; line-height: 1.65; text-align: left; }
  .footer-group { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; gap: .75rem; }
  .footer-group h3 { margin: 0 0 .35rem; color: var(--pink); font-family: inherit; font-size: .75rem; font-weight: 700; line-height: 1.65; letter-spacing: .1em; text-transform: uppercase; }
  .footer-nav a { max-width: 100%; color: inherit; overflow-wrap: anywhere; text-decoration: none; }
  .footer-nav a:hover { color: white; text-decoration: underline; text-underline-offset: 4px; }
  .footer-company { grid-column: 1 / -1; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,.15); }
  .footer-bottom { display: flex; flex-direction: column; gap: 1.2rem; justify-content: space-between; padding-block: 1.5rem; border-top: 1px solid rgba(255,255,255,.15); }
  .footer-wordmark { display: inline-flex; align-items: center; gap: .7rem; font-family: 'DM Serif Display', Georgia, serif; font-size: 1.6rem; text-decoration: none; }
  .footer-mark { display: block; width: 2.8rem; max-width: 2.8rem; height: auto; flex: 0 0 2.8rem; object-fit: contain; }
  .footer-bottom p { margin: 0; color: rgba(255,255,255,.55); font-size: 0.72rem; line-height: 1.5; }
  .footer-credit { display: inline-flex; flex: 0 0 auto; flex-direction: column; align-items: flex-start; justify-content: center; gap: .45rem; align-self: flex-start; min-height: 44px; padding-block: .35rem; color: rgba(255,255,255,.75); font-size: .72rem; line-height: 1.5; text-decoration: none; }
  .footer-credit img { display: block; width: 148px; height: auto; }
  .footer-credit:hover { color: white; }
  .footer-credit:focus-visible { outline: 2px solid var(--yellow); outline-offset: 6px; border-radius: 2px; }
  @media (min-width: 700px) { .footer-nav { grid-template-columns: repeat(3, minmax(0, 1fr)); } .footer-bottom { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 1.5rem 2rem; } .footer-bottom p { flex: 1 1 18rem; } .footer-credit { align-self: center; margin-left: auto; } }
  @media (min-width: 960px) {
    .footer-nav { grid-template-columns: 1fr .85fr 1.1fr 1.65fr; column-gap: 2rem; }
    .footer-company { grid-column: auto; padding-top: 0; border-top: 0; }
  }
</style>
