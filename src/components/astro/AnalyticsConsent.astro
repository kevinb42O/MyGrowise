---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const explanation = 'Met jouw toestemming meten we bezochte pagina’s en enkele website-interacties met een anonieme browser-ID en een geschat land. We bewaren geen IP-adres of gezondheidsgegevens in analytics.';
---
<aside class:list={['analytics-consent', { 'analytics-consent--compact': compact }]} hidden data-analytics-consent aria-labelledby="consent-title">
  <h2 id="consent-title">Ook je privacy verdient aandacht.</h2>
  {compact ? <p class="analytics-consent__intro">Met jouw toestemming helpen bezoekgegevens ons MyGrowise te verbeteren.</p> : <p class="analytics-consent__intro">{explanation}</p>}
  <details class="analytics-consent__details">
    <summary>Welke gegevens meten we?<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 6 3 3 3-3" /></svg></summary>
    <div class="analytics-consent__explanation">
      {compact && <p>{explanation}</p>}
      <a href="/privacy">Lees hoe we meten</a>
    </div>
  </details>
  <div class="analytics-consent__actions">
    <button type="button" data-analytics-accept>Akkoord</button>
    <button type="button" data-analytics-decline>Alleen noodzakelijk</button>
  </div>
</aside>
<script is:inline>
  (() => { const root = document.querySelector('[data-analytics-consent]'); if (!root) return; const updateHeight = () => document.documentElement.style.setProperty('--analytics-consent-height', root.hidden ? '0px' : `${root.getBoundingClientRect().height}px`); new ResizeObserver(updateHeight).observe(root); const consent = document.cookie.match(/(?:^|; )mg_analytics_consent=([^;]+)/)?.[1]; const route = location.pathname.startsWith('/begeleiding') ? 'care' : location.pathname.startsWith('/profielen') || location.pathname.startsWith('/modules') || location.pathname.startsWith('/aanbod') ? 'self' : ''; const track = (event = 'page_view') => fetch('/api/analytics', { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', keepalive: true, body: JSON.stringify({ event, path: location.pathname, route }) }).catch(() => {}); const trackPage = () => { if (/^\/(account|admin|praktijk|api|aankopen|bestellen|berichten)(\/|$)/.test(location.pathname)) return; track(); if (/^\/(profielen|modules|aanbod)\/.+/.test(location.pathname)) track('product_viewed'); else if (/^\/begeleiding\/.+/.test(location.pathname)) track('professional_viewed'); else if (location.pathname === '/profielen' || location.pathname === '/modules' || location.pathname === '/begeleiding') track('route_selected'); }; if (consent === 'granted') trackPage(); else if (!consent) root.hidden = false; const set = (value) => { document.cookie = `mg_analytics_consent=${value}; Path=/; Max-Age=15552000; SameSite=Lax`; root.hidden = true; updateHeight(); if (value === 'granted') trackPage(); }; root.querySelector('[data-analytics-accept]')?.addEventListener('click', () => set('granted')); root.querySelector('[data-analytics-decline]')?.addEventListener('click', () => set('denied')); })();
</script>
<style>
  .analytics-consent {
    position: fixed;
    z-index: 50;
    left: clamp(1.25rem, 3.2vw, 3rem);
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    width: min(26rem, calc(100% - 2.5rem));
    max-height: calc(100svh - 7rem);
    overflow-y: auto;
    padding: 1.5rem;
    border: 1px solid rgb(239 218 188 / 30%);
    border-radius: 12px;
    background: #342e27;
    color: #faf0df;
    color-scheme: dark;
    scrollbar-color: #a18a70 #342e27;
    scrollbar-width: thin;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: .8125rem;
    line-height: 1.6;
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .analytics-consent {
      background: linear-gradient(135deg, rgb(74 57 42 / 88%), rgb(35 33 29 / 92%));
      -webkit-backdrop-filter: blur(24px) saturate(.75);
      backdrop-filter: blur(24px) saturate(.75);
    }
  }
  .analytics-consent[hidden] { display: none; }
  .analytics-consent h2 {
    margin: 0 0 .6rem;
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.02em;
    text-wrap: balance;
  }
  .analytics-consent p { margin: 0; }
  .analytics-consent__intro { color: #ded0bf; }
  .analytics-consent__details { margin-top: .25rem; }
  .analytics-consent__details summary {
    display: flex;
    align-items: center;
    gap: .4rem;
    width: fit-content;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    font-size: .75rem;
    text-decoration: underline;
    text-decoration-color: rgb(239 218 188 / 45%);
    text-underline-offset: .25em;
  }
  .analytics-consent__details summary::-webkit-details-marker { display: none; }
  .analytics-consent__details svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .analytics-consent__details[open] svg { transform: rotate(180deg); }
  .analytics-consent__explanation { padding: 0 0 1rem; color: #ded0bf; }
  .analytics-consent__explanation a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #faf0df;
    text-underline-offset: .25em;
  }
  .analytics-consent__actions {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: .625rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(239 218 188 / 19%);
  }
  .analytics-consent button {
    min-height: 44px;
    padding: .65rem .75rem;
    border: 1px solid rgb(239 218 188 / 52%);
    border-radius: 6px;
    background: transparent;
    color: #faf0df;
    font: inherit;
    font-size: .75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .analytics-consent button[data-analytics-accept] { background: #e8d2b1; border-color: #e8d2b1; color: #342c23; }
  .analytics-consent button:hover { background: rgb(239 218 188 / 12%); border-color: #e8d2b1; }
  .analytics-consent button[data-analytics-accept]:hover { background: #f4e3c9; border-color: #f4e3c9; }
  .analytics-consent button:active { transform: translateY(1px); }
  .analytics-consent summary:hover { text-decoration-color: currentColor; }
  .analytics-consent :focus-visible { outline: 2px solid #e8d2b1; outline-offset: 4px; }
  .analytics-consent ::selection { background: #e8d2b1; color: #342c23; }
  @media (max-width: 699px) {
    .analytics-consent {
      left: 1rem;
      bottom: max(1rem, env(safe-area-inset-bottom));
      width: calc(100% - 2rem);
      padding: 1.2rem;
    }
    .analytics-consent h2 { font-size: 1.375rem; }
  }
  /* Keep the opening controls above the consent panel on smaller screens. */
  @media (max-width: 999px) {
    :global(body:has([data-analytics-consent]:not([hidden])) .home-experience.portal-enhanced .hero-skip:not([hidden])) {
      bottom: calc(var(--analytics-consent-height, 15rem) + 2rem);
    }
  }
  @media (max-width: 699px) {
    :global(body:has([data-analytics-consent]:not([hidden])) .home-experience.portal-enhanced .hero-title-right) {
      top: min(72%, calc(100% - var(--analytics-consent-height, 15rem) - 8rem));
    }
  }
  @media (max-width: 359px) {
    .analytics-consent__actions { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .analytics-consent { background: #342e27; backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
  @media (forced-colors: active) {
    .analytics-consent { background: Canvas; color: CanvasText; border-color: CanvasText; }
    .analytics-consent button { border-color: ButtonText; }
  }
  @media (prefers-reduced-motion: reduce) {
    .analytics-consent button { transition: none; }
  }
</style>
