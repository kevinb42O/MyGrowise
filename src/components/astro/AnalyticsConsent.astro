<div class="analytics-consent" hidden data-analytics-consent role="region" aria-label="Privacyinstellingen"><p><strong>Help MyGrowise verbeteren.</strong> Met jouw toestemming meten we bezochte pagina’s en enkele website-interacties met een anonieme browser-ID en een geschat land. We bewaren geen IP-adres of gezondheidsgegevens in analytics.</p><div><button type="button" data-analytics-accept>Akkoord</button><button type="button" data-analytics-decline>Alleen noodzakelijk</button></div><a href="/privacy">Lees hoe we meten</a></div>
<script is:inline>
  (() => { const root = document.querySelector('[data-analytics-consent]'); if (!root) return; const consent = document.cookie.match(/(?:^|; )mg_analytics_consent=([^;]+)/)?.[1]; const route = location.pathname.startsWith('/begeleiding') ? 'care' : location.pathname.startsWith('/profielen') || location.pathname.startsWith('/modules') || location.pathname.startsWith('/aanbod') ? 'self' : ''; const track = (event = 'page_view') => fetch('/api/analytics', { method: 'POST', headers: { 'content-type': 'application/json' }, credentials: 'same-origin', keepalive: true, body: JSON.stringify({ event, path: location.pathname, route }) }).catch(() => {}); const trackPage = () => { if (/^\/(account|admin|praktijk|api)(\/|$)/.test(location.pathname)) return; track(); if (/^\/(profielen|modules|aanbod)\/.+/.test(location.pathname)) track('product_viewed'); else if (/^\/begeleiding\/.+/.test(location.pathname)) track('professional_viewed'); else if (location.pathname === '/profielen' || location.pathname === '/modules' || location.pathname === '/begeleiding') track('route_selected'); }; if (consent === 'granted') trackPage(); else if (!consent) root.hidden = false; const set = (value) => { document.cookie = `mg_analytics_consent=${value}; Path=/; Max-Age=15552000; SameSite=Lax`; root.hidden = true; if (value === 'granted') trackPage(); }; root.querySelector('[data-analytics-accept]')?.addEventListener('click', () => set('granted')); root.querySelector('[data-analytics-decline]')?.addEventListener('click', () => set('denied')); })();
</script>
<style>.analytics-consent{position:fixed;z-index:50;right:1rem;bottom:1rem;left:1rem;max-width:34rem;padding:1rem 1.1rem;border:1px solid rgba(255,255,255,.16);border-radius:1rem;background:#173d35;color:#fff;box-shadow:0 18px 42px rgba(14,43,37,.28);font-size:.75rem;line-height:1.55}.analytics-consent p{margin:0}.analytics-consent p strong{display:block;margin-bottom:.25rem}.analytics-consent div{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.8rem}.analytics-consent button{min-height:2.35rem;padding:.45rem .75rem;border:1px solid transparent;border-radius:999px;background:#fff;color:#173d35;font:inherit;font-weight:800;cursor:pointer}.analytics-consent button[data-analytics-decline]{border-color:rgba(255,255,255,.35);background:transparent;color:#fff}.analytics-consent a{display:inline-block;margin-top:.65rem;color:#fff;font-size:.68rem}@media(min-width:700px){.analytics-consent{right:1.5rem;left:auto}}</style>
