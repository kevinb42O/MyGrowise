---
import { practitioners } from '../../content/site';
---
<div class="home-experience home-ending-content">
<section class="closing" id="volgende-stap" aria-labelledby="closing-title"><div class="closing-content"><h2 id="closing-title">Begrijpen mag ook<br> <em>het begin zijn.</em></h2><p>Je hoeft nog niet precies te weten wat je nodig hebt.</p><div class="actions"><a class="button light" href="/startpunt">Vind je startpunt <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a><a class="text-link" href="/begeleiding">Vind begeleiding</a></div></div><div class="closing-team" aria-label="Het team van MyGrowise">
  {practitioners.map(person => <a class={`closing-team-person closing-team-person--${person.slug}`} href={`/begeleiding/${person.slug}`} aria-label={`Maak kennis met ${person.name}`}>
    <span class="closing-team-photo"><img src={person.image} alt="" width="600" height="900" loading="lazy" /></span>
  </a>)}
</div></section>
</div>
