---
import type {AppointmentPage} from '../../lib/appointmentDetail';
import {toBrusselsLocalInput} from '../../lib/brusselsTime';
interface Props {data:AppointmentPage;}
const {data}=Astro.props;
const {booking,offers,patients,error,mail,history,canViewPatient,isNew,practice}=data;
const fmt=(v:string)=>new Intl.DateTimeFormat('nl-BE',{timeZone:'Europe/Brussels',dateStyle:'medium',timeStyle:'short'}).format(new Date(v));
const statuses:Record<string,string>={confirmed:'Bevestigd',pending:'Oude aanvraag',cancelled:'Geannuleerd',completed:'Uitgevoerd',no_show:'Niet verschenen',declined:'Geweigerd'};
const mailStatuses:Record<string,string>={pending:'Wacht op verzending',sending:'Wordt verstuurd',sent:'Geaccepteerd door mailserver',failed:'Verzending mislukt',suppressed:'Uitgeschakeld via meldingsvoorkeur'};
const kinds:Record<string,string>={confirmation:'Bevestiging',rescheduled:'Verplaatsing',cancelled:'Annulering'};
---
<div class="admin-page practice-stack"><a class="admin-back-link" href={practice?'/praktijk/agenda':'/admin/agenda'}>← Naar agenda</a><header class="admin-page-heading"><div><p class="admin-eyebrow">Afspraakbeheer</p><h1>{isNew?'Cliëntafspraak plannen':booking.client_name}</h1><p>{isNew?'De afspraak is direct bevestigd.':booking.appointment_name}</p></div></header>
{error&&<div class="practice-alert is-error" role="alert">{error}</div>}{Astro.url.searchParams.has('opgeslagen')&&<div class="practice-alert" role="status">Afspraak bijgewerkt.</div>}
{isNew?<form method="post" class="practice-card practice-stack"><div class="practice-grid"><label>Cliënt<select name="patient_id" required><option value="">Kies een cliënt</option>{patients.filter(p=>p.email).map(p=><option value={p.id} selected={Astro.url.searchParams.get('client')===p.id}>{p.fullName}</option>)}</select></label><label>Therapeut en afspraaktype<select name="offer_id" required><option value="">Kies een afspraaktype</option>{offers.map(o=><option value={o.id}>{o.practitionerName} · {o.name} · {o.duration} min</option>)}</select></label><label>Datum en starttijd<input type="datetime-local" name="starts_at" required/></label></div><p>De eindtijd volgt automatisch uit het afspraaktype. Ook niet-publiek boekbare types kunnen hier worden ingepland.</p><button class="admin-button admin-button--primary" type="submit">Afspraak definitief inplannen</button></form>:<>
<section class="practice-card"><dl class="practice-kv"><div><dt>Therapeut</dt><dd>{booking.practitioners?.name}</dd></div><div><dt>Wanneer</dt><dd>{fmt(booking.starts_at)}</dd></div><div><dt>Einde</dt><dd>{fmt(booking.ends_at)}</dd></div><div><dt>Status</dt><dd>{statuses[booking.status]}</dd></div><div><dt>Uitvoeringsvorm</dt><dd>{booking.channel==='online'?'Online':booking.location}</dd></div><div><dt>E-mail</dt><dd>{booking.client_email}</dd></div></dl>{canViewPatient&&<a class="admin-button" href={`/admin/clienten/${booking.patient_id}`}>Cliëntendossier openen</a>}
<div class="practice-actions">{booking.status==='confirmed'&&<>{Date.parse(booking.ends_at)<=Date.now()&&<form method="post"><input type="hidden" name="operation" value="status"/><button class="admin-button" name="status" value="completed">Als uitgevoerd registreren</button></form>}{Date.parse(booking.starts_at)<=Date.now()&&<form method="post"><input type="hidden" name="operation" value="status"/><button class="admin-button" name="status" value="no_show">Niet verschenen</button></form>}<form method="post" data-confirm="Deze afspraak annuleren?"><input type="hidden" name="operation" value="status"/><button class="admin-button" name="status" value="cancelled">Afspraak annuleren</button></form></>}{booking.status==='pending'&&<form method="post"><input type="hidden" name="operation" value="status"/><button class="admin-button" name="status" value="confirmed">Bestaande aanvraag bevestigen</button><button class="admin-button" name="status" value="declined">Weigeren</button></form>}</div></section>
{booking.status==='confirmed'&&Date.parse(booking.starts_at)>Date.now()&&<form method="post" class="practice-card"><h2>Afspraak verplaatsen</h2><input type="hidden" name="operation" value="reschedule"/><label class="practice-label">Nieuwe datum en starttijd<input class="practice-input" type="datetime-local" name="starts_at" required value={toBrusselsLocalInput(booking.starts_at)}/></label><p class="practice-muted">De oorspronkelijke duur blijft behouden. De cliënt ontvangt een bericht.</p><button class="admin-button" type="submit">Verplaatsen</button></form>}
{history.length>0&&<section class="practice-card"><h2>Verplaatsingshistoriek</h2>{history.map(h=><p>{fmt(h.old_starts_at)} → {fmt(h.new_starts_at)}<small> · gewijzigd {fmt(h.occurred_at)}</small></p>)}</section>}
<section class="practice-card"><h2>Verzendlogboek</h2><p class="practice-muted">Een mailfout verandert de bevestigde afspraak niet. Herverzenden gebruikt de oorspronkelijke berichtgegevens.</p><div class="practice-table-wrap"><table class="practice-table"><thead><tr><th>Bericht</th><th>Status</th><th>Moment</th><th></th></tr></thead><tbody>{mail.map(j=><tr><td>{kinds[j.kind]}</td><td>{mailStatuses[j.status]}<small>{j.attempts} poging(en)</small></td><td>{fmt(j.sent_at||j.created_at)}</td><td><form method="post"><input type="hidden" name="operation" value="mail"/><input type="hidden" name="job_id" value={j.id}/><button class="admin-button" disabled={j.status==='sending'}>Opnieuw versturen</button></form></td></tr>)}</tbody></table>{!mail.length&&<p>Geen verzendopdrachten voor deze historische afspraak.</p>}</div></section>
</>}
</div>
<script>
 document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach(form=>form.addEventListener('submit',event=>{if(!window.confirm(form.dataset.confirm))event.preventDefault();}));
</script>
