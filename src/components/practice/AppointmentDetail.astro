---
import {bookingOutcomeLabel} from '../../lib/bookingOutcome';
import type {AppointmentPage} from '../../lib/appointmentDetail';
import AgendaClientPicker from '../admin/AgendaClientPicker';
import {toBrusselsLocalInput} from '../../lib/brusselsTime';
interface Props {data:AppointmentPage;}
const {data}=Astro.props;
const {submitted,initialNew,outcomeHistory,booking,offers,initialClient,selectedPractitioner,initialStart,agendaHref,error,mail,history,canViewPatient,isNew,practice}=data;
const recordsBase = practice ? '/praktijk/clienten' : '/admin/clienten';
const fmt=(v:string)=>new Intl.DateTimeFormat('nl-BE',{timeZone:'Europe/Brussels',dateStyle:'medium',timeStyle:'short'}).format(new Date(v));
const statuses:Record<string,string>={confirmed:'Bevestigd',pending:'Oude aanvraag',cancelled:'Geannuleerd',completed:'Uitgevoerd',no_show:'Niet verschenen',declined:'Geweigerd'};
const mailStatuses:Record<string,string>={pending:'Wacht op verzending',sending:'Wordt verstuurd',sent:'Geaccepteerd door mailserver',failed:'Verzending mislukt',suppressed:'Uitgeschakeld via meldingsvoorkeur',superseded:'Vervangen door een recentere wijziging',unknown:'Verzendstatus onbekend'};
const savedMail=mailStatuses[Astro.url.searchParams.get('mail') || ''];
const kinds:Record<string,string>={confirmation:'Bevestiging',rescheduled:'Verplaatsing',cancelled:'Annulering',reminder:'Herinnering'};
---
<div class="admin-page practice-stack"><a class="admin-back-link" href={agendaHref}>← Naar agenda</a><header class="admin-page-heading"><div><p class="admin-eyebrow">Afspraakbeheer</p><h1>{isNew?'Cliëntafspraak plannen':booking.client_name}</h1><p>{isNew?'De afspraak is direct bevestigd.':booking.appointment_name}</p></div></header>
{error&&<div class="practice-alert is-error" role="alert">{error}</div>}{Astro.url.searchParams.has('opgeslagen')&&<div class="practice-alert" role="status">Afspraak bijgewerkt.{savedMail && ` Mail · ${savedMail}.`}</div>}
{isNew?<form method="post" class="practice-card practice-stack" data-new-appointment>
  <div class="practice-grid">
    <AgendaClientPicker mode={practice?'practice':'admin'} name="patient_id" initial={initialClient} initialNew={initialNew} client:only="react" />
    <label>Therapeut en afspraaktype<select name="offer_id" required>
      <option value="">Kies een afspraaktype</option>
      {offers.map((o,index)=><option value={o.id} selected={submitted.offer_id?submitted.offer_id===o.id:Boolean(selectedPractitioner&&o.practitionerId===selectedPractitioner&&offers.findIndex(candidate=>candidate.practitionerId===selectedPractitioner)===index)} data-duration={o.duration} data-location={o.channel==='online'?'Online':o.location}>{o.practitionerName} · {o.name} · {o.duration} min</option>)}
    </select></label>
    <label>Datum en starttijd<input type="datetime-local" name="starts_at" value={initialStart} required/></label>
  </div>
  <p data-appointment-preview role="status">De eindtijd volgt uit het afspraaktype.</p>
  <button class="admin-button admin-button--primary" type="submit">Afspraak definitief inplannen</button>
</form>:<>
<section class="practice-card"><dl class="practice-kv"><div><dt>Therapeut</dt><dd>{booking.practitioners?.name}</dd></div><div><dt>Wanneer</dt><dd>{fmt(booking.starts_at)}</dd></div><div><dt>Einde</dt><dd>{fmt(booking.ends_at)}</dd></div><div><dt>Status</dt><dd>{bookingOutcomeLabel({status:booking.status,cancellationCategory:booking.cancellation_category,noShowBilling:booking.no_show_billing})}</dd></div><div><dt>Uitvoeringsvorm</dt><dd>{booking.channel==='online'?'Online':booking.location}</dd></div><div><dt>E-mail</dt><dd>{booking.client_email}</dd></div></dl><div class="practice-actions">
{canViewPatient && <><a class="admin-button" href={`${recordsBase}/${booking.patient_id}`}>Cliëntendossier openen</a><a class="admin-button admin-button--primary" href={`${recordsBase}/${booking.patient_id}?boeking=${booking.id}#nieuw-verslag`}>Verslag schrijven</a><a class="admin-button" href={`${practice ? '/praktijk' : '/admin'}/afspraken/nieuw?client=${booking.patient_id}`}>Vervolgafspraak plannen</a></>}
{!booking.patient_id && ['confirmed', 'completed'].includes(booking.status) && <a class="admin-button admin-button--primary" href={`${recordsBase}?boeking=${booking.id}`}>Dossier openen of aanmaken</a>}
{booking.patient_id && !canViewPatient && <p class="practice-muted">Dit dossier is niet aan jou toegewezen. Vraag een bevoegde beheerder om toegang.</p>}
</div>
<div class="practice-actions">{booking.status==='confirmed'&&<>{Date.parse(booking.ends_at)<=Date.now()&&<form method="post"><input type="hidden" name="operation" value="status"/><input type="hidden" name="revision" value={booking.updated_at}/><button class="admin-button" name="status" value="completed">Als uitgevoerd registreren</button></form>}<form method="post" data-confirm="Deze afspraak annuleren en de cliënt informeren?"><input type="hidden" name="operation" value="status"/><input type="hidden" name="revision" value={booking.updated_at}/><button class="admin-button" name="status" value="cancelled">Annuleren en cliënt informeren</button></form></>}{booking.status==='pending'&&<form method="post"><input type="hidden" name="operation" value="status"/><input type="hidden" name="revision" value={booking.updated_at}/><button class="admin-button" name="status" value="confirmed">Bestaande aanvraag bevestigen</button><button class="admin-button" name="status" value="declined">Weigeren</button></form>}</div></section>
{['confirmed','completed','cancelled','no_show'].includes(booking.status)&&<section class="practice-card" id="registratie"><h2>Intern registreren</h2><p>Deze registratie verstuurt geen e-mail of melding naar de cliënt. De algemene afspraakstatus blijft zichtbaar in diens afsprakenoverzicht. Facturatie is een administratieve registratie; er wordt geen factuur aangemaakt.</p><form method="post" class="practice-stack"><input type="hidden" name="operation" value="outcome"/><input type="hidden" name="revision" value={booking.updated_at}/><div class="practice-grid"><label>Uitkomst<select name="status" required><option value="cancelled" selected={booking.status!=='no_show'}>Geannuleerd</option>{Date.parse(booking.starts_at)<=Date.now()&&<option value="no_show" selected={booking.status==='no_show'}>No-show</option>}</select></label><label>Bij annulering<select name="category"><option value="unknown" selected={booking.cancellation_category==='unknown'}>Nog niet beoordeeld</option><option value="timely" selected={booking.cancellation_category==='timely'}>Tijdig geannuleerd</option><option value="late" selected={booking.cancellation_category==='late'}>Laattijdig geannuleerd</option></select></label><label>Bij no-show<select name="billing"><option value="unreviewed" selected={booking.no_show_billing==='unreviewed'}>Facturatie te beoordelen</option><option value="invoiced" selected={booking.no_show_billing==='invoiced'}>Gefactureerd</option><option value="not_invoiced" selected={booking.no_show_billing==='not_invoiced'}>Niet gefactureerd</option></select></label></div><button class="admin-button" type="submit">Intern opslaan</button></form>
{outcomeHistory.length>0&&<div class="practice-outcome-history"><h3>Registratiehistoriek</h3><ol>{outcomeHistory.map(event=><li><time datetime={event.occurred_at}>{fmt(event.occurred_at)}</time><span>{event.actorName} · {bookingOutcomeLabel({status:event.after_snapshot.status,cancellationCategory:event.after_snapshot.cancellation_category,noShowBilling:event.after_snapshot.no_show_billing})}</span></li>)}</ol></div>}</section>}
{booking.status==='confirmed'&&Date.parse(booking.starts_at)>Date.now()&&<form method="post" class="practice-card"><h2>Afspraak verplaatsen</h2><input type="hidden" name="operation" value="reschedule"/><input type="hidden" name="revision" value={booking.updated_at}/><label class="practice-label">Nieuwe datum en starttijd<input class="practice-input" type="datetime-local" name="starts_at" required value={toBrusselsLocalInput(booking.starts_at)}/></label><p class="practice-muted">De oorspronkelijke duur blijft behouden. De cliënt ontvangt een bericht.</p><button class="admin-button" type="submit">Verplaatsen</button></form>}
{history.length>0&&<section class="practice-card"><h2>Verplaatsingshistoriek</h2>{history.map(h=><p>{fmt(h.old_starts_at)} → {fmt(h.new_starts_at)}<small> · gewijzigd {fmt(h.occurred_at)}</small></p>)}</section>}
<section class="practice-card"><h2>Verzendlogboek</h2><p class="practice-muted">Een mailfout verandert de bevestigde afspraak niet. Herverzenden gebruikt de oorspronkelijke berichtgegevens.</p><div class="practice-table-wrap"><table class="practice-table"><thead><tr><th>Bericht</th><th>Status</th><th>Moment</th><th></th></tr></thead><tbody>{mail.map(j=><tr><td>{kinds[j.kind]}</td><td>{mailStatuses[j.status]}<small>{j.attempts} poging(en)</small></td><td>{fmt(j.sent_at||j.scheduled_for||j.created_at)}{!j.sent_at&&j.kind==='reminder'&&<small>Gepland verzendmoment</small>}</td><td><form method="post"><input type="hidden" name="operation" value="mail"/><input type="hidden" name="job_id" value={j.id}/><button class="admin-button" disabled={['sending','superseded','suppressed'].includes(j.status)}>Opnieuw versturen</button></form></td></tr>)}</tbody></table>{!mail.length&&<p>Geen verzendopdrachten voor deze historische afspraak.</p>}</div></section>
</>}
</div>
<script>
 import {fromBrusselsLocalInput} from '../../lib/brusselsTime';
 const form=document.querySelector<HTMLFormElement>('[data-new-appointment]');
 if(form){
   const offers=form.querySelector<HTMLSelectElement>('[name="offer_id"]');
   const start=form.querySelector<HTMLInputElement>('[name="starts_at"]');
   const preview=form.querySelector<HTMLElement>('[data-appointment-preview]');
   const format=new Intl.DateTimeFormat('nl-BE',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/Brussels'});
   const update=()=>{
     if(!preview)return;
     const option=offers?.selectedOptions[0],duration=Number(option?.dataset.duration);
     if(!duration||!start?.value){preview.textContent='De eindtijd volgt uit het afspraaktype.';return;}
     try {
       const end=new Date(Date.parse(fromBrusselsLocalInput(start.value))+duration*60000);
       preview.textContent=`Tot ${format.format(end)} · ${duration} min${option?.dataset.location?` · ${option.dataset.location}`:''}`;
     } catch {preview.textContent='Kies een geldig starttijdstip.';}
   };
   form.addEventListener('input',update);
   update();
 }

 document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach(form=>form.addEventListener('submit',event=>{if(!window.confirm(form.dataset.confirm))event.preventDefault();}));
</script>
