---
import type {getAdminMailPage} from '../../lib/adminMail';
import AdminPagination from './AdminPagination.astro';
interface Props {result: Awaited<ReturnType<typeof getAdminMailPage>>}
const {result} = Astro.props;
const date=(value:unknown)=>value?new Intl.DateTimeFormat('nl-BE',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/Brussels'}).format(new Date(String(value))):'—';
const timeLabel = result.status==='sent'?'Verzonden op':result.status==='pending'?'Gepland voor':result.status==='sending'?'Verwerking':'Aangemaakt';
const currentTime = Date.now();
const expired=(job:typeof result.items[number])=>!job.lease_until||new Date(job.lease_until).getTime()<currentTime;
const emptyCopy = {
 sent:['Nog geen verzonden e-mails','Zodra er een mail is verzonden, verschijnt die hier.'],
 pending:['Geen geplande e-mails','Er staan momenteel geen e-mails in deze selectie klaar.'],
 failed:['Geen mislukte verzendingen','Er zijn geen mislukte mails die je aandacht vragen.'],
 sending:['Geen e-mails in verwerking','Er wordt momenteel geen mail in deze selectie verwerkt.'],
 unconfirmed:['Geen overgeslagen of onbevestigde taken','Alle afgeronde taken in deze selectie hebben een bevestigde verzending.'],
}[result.status];
---
<div id="mailtaken" class="mail-history" aria-label="E-mailoverzicht">
  {result.status==='unconfirmed'&&<p class="mail-context">Deze taken zijn overgeslagen of hebben geen betrouwbare historische verzendbevestiging. Ze tellen niet mee bij Verzonden.</p>}
  {result.items.length?<>
    <div class="mail-list-heading" aria-hidden="true"><span>E-mail</span><span>Ontvanger</span><span>{timeLabel}</span><span></span></div>
    <ul class="mail-list">
      {result.items.map(job=>{
        const key=`${job.queue}-${job.id}`;
        const timestamp=result.status==='sent'?job.sent_at:result.status==='pending'?job.next_attempt_at:job.created_at;
        return <li class="mail-job">
          <div class="mail-job__row">
            <div class="mail-job__identity"><span class="mail-job__title">{job.title}</span>
              <span class="mail-job__category">{job.category}</span>
              {job.client_name&&job.client_name!==job.recipient_name&&<span class="mail-job__client">Over {job.client_name}</span>}
              {result.status==='failed'&&<span class="mail-job__reason">{job.diagnosis}</span>}
              {result.status==='unconfirmed'&&<span class="mail-job__reason">{job.diagnosis}</span>}
            </div>
            <div class="mail-job__recipient"><span class="mail-job__recipient-name">{job.recipient_name||'Naam niet geregistreerd'}</span><span class="mail-job__recipient-email">{job.recipient_email||'E-mailadres niet geregistreerd'}</span></div>
            {result.status==='sending'?<span class:list={['mail-job__time',{'mail-job__time--warning':expired(job)}]}>{expired(job)?'Verwerking onderbroken':'Wordt verwerkt'}</span>:<time class="mail-job__time" datetime={timestamp||undefined}>{date(timestamp)}</time>}
          </div>
          <details class="mail-job__details" data-mail-disclosure>
            <summary aria-controls={`detail-${key}`} aria-label={`Details van ${job.title}, ${job.recipient_email||job.recipient_name||'ontvanger onbekend'}, ${date(timestamp)}`}><span>Details</span><svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
            <div class="mail-job__detail-body" id={`detail-${key}`}>
              <dl class="mail-job__facts"><div class="mail-job__reference"><dt>Taakreferentie</dt><dd><code>{job.id}</code></dd></div><div><dt>Aangemaakt</dt><dd>{date(job.created_at)}</dd></div><div><dt>Verzendpogingen</dt><dd>{job.attempts}</dd></div>
                {result.status==='sent'&&<div><dt>Verzonden</dt><dd>{date(job.sent_at)}</dd></div>}
                {result.status==='pending'&&<div><dt>Volgende poging</dt><dd>{date(job.next_attempt_at)}</dd></div>}
                {result.status==='sending'&&<div><dt>{expired(job)?'Verwerking onderbroken sinds':'In verwerking tot'}</dt><dd>{date(job.lease_until)}</dd></div>}
              </dl>
              {result.status==='sent'&&(job.recipient_source==='current'||job.recipient_source==='order')&&<p class="mail-recipient-source">De ontvanger is gebaseerd op de huidige {job.recipient_source==='order'?'bestelgegevens':'gespreks- en accountgegevens'}. Het gebruikte adres werd bij deze oudere verzending niet afzonderlijk bewaard.</p>}
              {job.queue==='website_mail_jobs'&&job.recipient_source==='job'&&<p class="mail-recipient-source">Het adres komt uit de oorspronkelijke mailtaak. Een cliëntnaam wordt waar beschikbaar uit de huidige aankoopgegevens aangevuld.</p>}
              {result.status==='sending'&&expired(job)&&<p>De vorige verwerking is niet afgerond. Controleer of de mail al is aangekomen voordat je verdere actie onderneemt.</p>}
              {job.status==='failed'&&<form class="mail-retry" method="post" action="/api/admin/mail" data-mail-action>
                <input type="hidden" name="retry_failed" value="1"/><input type="hidden" name="queue" value={job.queue}/><input type="hidden" name="job_id" value={job.id}/>
                <input type="hidden" name="return_queue" value={result.queue?.table||''}/><input type="hidden" name="return_status" value={result.status}/>
                <p>{job.diagnosis}</p><label><input type="checkbox" required name="checked" value="yes"/> Ik heb de oorzaak gecontroleerd. Een eerdere mail kan al aangekomen zijn.</label>
                <button class="mail-button" type="submit">Opnieuw proberen</button>
              </form>}
            </div>
          </details>
        </li>;
      })}
    </ul>
  </>:<div class="mail-empty"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="1.4"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><h2>{emptyCopy[0]}</h2><p>{emptyCopy[1]}{result.queue&&' Je kunt ook alle categorieën bekijken.'}</p></div>}
  <AdminPagination {...result} hash="#mailtaken" label="E-mails"/>
</div>
