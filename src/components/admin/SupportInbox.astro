---
import AdminIcon from './AdminIcon.astro';
import { getSupportConversation, listSupportAssignees, listSupportConversations } from '../../lib/supportInbox';
interface Props { userId: string; selectedId?: string; }
const { userId, selectedId = '' } = Astro.props;
const [conversations, selected, assignees] = await Promise.all([listSupportConversations(userId, true), selectedId ? getSupportConversation(selectedId, userId, true) : Promise.resolve(null), listSupportAssignees()]);
const label: Record<string, string> = { new: 'Nieuw', in_progress: 'In behandeling', waiting_customer: 'Wacht op klant', resolved: 'Opgelost', closed: 'Gesloten', general: 'Algemeen', order: 'Bestelling', access: 'Toegang', booking: 'Boeking', privacy: 'Privacy', other: 'Anders', low: 'Laag', normal: 'Normaal', high: 'Hoog', urgent: 'Urgent' };
const date = (value: string) => new Intl.DateTimeFormat('nl-BE', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(value));
---
<div class="support-inbox">
  <aside class="support-inbox__queue"><header><div><span>Klantenservice</span><strong>{conversations.length} gesprekken</strong></div></header><nav aria-label="Klantgesprekken">{conversations.length ? conversations.map((item) => <a href={`/admin/berichten?conversation=${item.id}`} class:list={['support-queue-item', { 'is-active': selected?.id === item.id, 'is-unread': item.unread }]}><span class="support-avatar">{item.customerName.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase()}</span><span><small>{item.customerName}</small><strong>{item.subject}</strong><em>{item.preview || 'Nieuw gesprek'}</em></span><time datetime={item.lastMessageAt}>{date(item.lastMessageAt)}</time>{item.unread && <i></i>}</a>) : <div class="support-empty"><AdminIcon name="messages" size={19}/><strong>Nog geen klantvragen</strong><p>Nieuwe vragen uit klantaccounts komen hier terecht.</p></div>}</nav></aside>
  <section class="support-inbox__detail">{selected ? <><header class="support-detail-head"><div><div class="support-detail-head__meta"><span class={`support-pill support-pill--${selected.status}`}>{label[selected.status]}</span><span>{label[selected.category]}</span></div><h2>{selected.subject}</h2><p>{selected.customerName} · <a href={`mailto:${selected.customerEmail}`}>{selected.customerEmail}</a></p></div><form action={`/api/admin/support/${selected.id}`} method="post" class="support-management"><input type="hidden" name="action" value="update"/><select name="status" aria-label="Status">{['new','in_progress','waiting_customer','resolved','closed'].map((status) => <option value={status} selected={selected.status === status}>{label[status]}</option>)}</select><select name="priority" aria-label="Prioriteit">{['low','normal','high','urgent'].map((priority) => <option value={priority} selected={selected.priority === priority}>{label[priority]}</option>)}</select><select name="assigned_to" aria-label="Eigenaar"><option value="">Geen eigenaar</option>{assignees.map((person) => <option value={person.id} selected={selected.assignedTo === person.id}>{person.name}</option>)}</select><button class="admin-button" type="submit">Opslaan</button></form></header><div class="support-thread">{selected.messages?.map((message) => <article class:list={['support-message', { 'is-staff': message.senderId !== selected.customerId, 'is-note': message.internal }]}><header><span>{message.internal ? 'Interne notitie' : message.senderName}</span><time datetime={message.createdAt}>{date(message.createdAt)}</time></header>{message.body.split(/\n{2,}/).map((paragraph) => <p>{paragraph}</p>)}</article>)}</div><div class="support-compose"><form action={`/api/admin/support/${selected.id}`} method="post"><input type="hidden" name="action" value="message"/><label><span>Antwoord aan {selected.customerName}</span><textarea name="body" required maxlength="4000" rows="4" placeholder="Schrijf een helder, praktisch antwoord…"></textarea></label><footer><small>Geen intake-, diagnostische of sessie-inhoud via deze inbox.</small><button class="admin-button admin-button--primary" type="submit">Verstuur antwoord <AdminIcon name="arrow" size={14}/></button></footer></form><details><summary>Interne notitie toevoegen</summary><form action={`/api/admin/support/${selected.id}`} method="post"><input type="hidden" name="action" value="note"/><textarea name="body" required maxlength="4000" rows="3" placeholder="Alleen zichtbaar voor het team"></textarea><button class="admin-button" type="submit">Notitie bewaren</button></form></details></div></> : <div class="support-detail-empty"><span><AdminIcon name="messages" size={24}/></span><h2>Klantenservice, op één plek.</h2><p>Kies een gesprek in de wachtrij. Status, eigenaar, antwoord en interne notitie blijven samen.</p></div>}</section>
</div>
