---
import type {getModuleAdmin} from '../../lib/modules/server';
interface Props{current:NonNullable<Awaited<ReturnType<typeof getModuleAdmin>>>;origin:string|null}
const {current,origin}=Astro.props;const {product:p,module:m,draft,assets}=current;
---
<div data-module-editor data-base={`/api/admin/modules/${p.id}`} data-revision={draft?.revision||0} data-details-revision={m.revision}>
<p class="module-admin-error" role="alert" data-module-error hidden></p>
{!origin&&<p class="module-admin-error">Stel PUBLIC_SITE_URL in voordat je definitieve audiolinks kopieert.</p>}
<form class="catalog-admin-form" data-module-save><input type="hidden" name="revision" value={m.revision}/><section class="catalog-admin-section"><h2>Website en prijs</h2><div class="catalog-admin-grid">{[['title','Naam',p.title],['slug','URL-slug',p.slug],['subtitle','Inhoudelijke kop',m.subtitle],['tagline','Sfeerregel',m.tagline],['price','Prijs (€)',p.priceCents===null?'':(p.priceCents/100).toFixed(2)],['image','Cover: lokaal pad onder /images/',p.image],['imageAlt','Beschrijving cover',m.image_alt]].map(([name,label,value])=><label class="catalog-admin-field"><span>{label}</span><input name={name} value={value} required={['title','slug'].includes(name)||p.type==='module'&&['subtitle','price'].includes(name)} maxlength={name==='image'?500:240}/></label>)}<label class="catalog-admin-field"><span>Website</span><select name="status">{[['draft','Concept'],['review','In review'],['published','Gepubliceerd'],['archived','Gearchiveerd']].map(([value,label])=><option value={value} selected={p.status===value}>{label}</option>)}</select></label><label class="catalog-admin-field"><span>Verkoop</span><select name="availability">{[['upcoming','In ontwikkeling'],['available','Beschikbaar'],['paused','Verkoop gepauzeerd']].map(([value,label])=><option value={value} selected={p.availability===value}>{label}</option>)}</select><small>Beschikbaar vereist gepubliceerd materiaal en ingevulde praktische informatie.</small></label><label class="catalog-admin-field catalog-admin-wide"><span>Korte omschrijving</span><textarea name="summary" required minlength="20" maxlength="320">{p.summary}</textarea></label><label class="catalog-admin-field catalog-admin-wide"><span>Inleiding (lege regel tussen alinea's)</span><textarea name="introduction" rows="6">{m.introduction.join('\n\n')}</textarea></label><label class="catalog-admin-field catalog-admin-wide"><span>Kernonderwerpen (één per regel)</span><textarea name="topics" rows="5">{m.topics.join('\n')}</textarea></label>{[['audienceText','Voor wie is deze inhoud?',m.audience_text],['accessText','Toegangsduur en voorwaarden',m.access_text],['supportText','Wat is inbegrepen aan ondersteuning?',m.support_text]].map(([name,label,value])=><label class="catalog-admin-field catalog-admin-wide"><span>{label}</span><textarea name={name} maxlength="2000">{value}</textarea></label>)}</div><div class="module-actions"><button class="admin-button admin-button--primary" type="submit">Website-inhoud bewaren</button><a href={`/${p.type==='guide'?'verdieping':'modules'}/${p.slug}`} target="_blank">Publieke pagina ↗</a></div></section></form>
{p.type==='module'&&<section class="catalog-admin-section" style="margin-top:2rem"><h2>Optionele verdieping</h2><p>Koppel beschikbare of toekomstige vragenlijsten, profielen, werkboeken en audio. Conceptproducten worden nog niet publiek aangeboden. Vink uit om een koppeling te verbergen.</p><form data-module-recommendations><div class="catalog-admin-grid">{[...current.recommendationOptions].sort((a,b)=>(current.recommendations.find(r=>r.target_product_id===a.id)?.sort_order??999)-(current.recommendations.find(r=>r.target_product_id===b.id)?.sort_order??999)).map(q=><label class="catalog-admin-field"><span><input type="checkbox" name="target" value={q.id} checked={current.recommendations.some(r=>r.target_product_id===q.id)}/>{q.title} · {q.status} / {q.availability}</span><input type="number" min="0" max="999" name={`sort-${q.id}`} value={current.recommendations.find(r=>r.target_product_id===q.id)?.sort_order??100} aria-label={`Volgorde ${q.title}`}/></label>)}</div><button type="submit" class="admin-button admin-button--primary">Verdieping bewaren</button> <a href="/admin/modules/nieuw">Nieuw miniwerkboek of audio aanmaken →</a></form></section>}
<section class="catalog-admin-section" style="margin-top:2rem"><h2>Werkboek en audio</h2><p>Voor een module horen PDF en audio bij elkaar. Een los miniwerkboek vereist alleen PDF; een los audioproduct alleen MP3. Kopieer eventuele vaste audiolinks naar het werkboek voordat je de PDF exporteert. Een materiaalconcept verandert de huidige gepubliceerde versie niet.</p>{!draft?<button class="admin-button admin-button--primary" data-module-action="draft" type="button">Materiaalconcept maken</button>:<><p class="module-admin-preview">Je bewerkt een concept. Alle bestanden en PDF-links moeten gecontroleerd zijn voordat je publiceert.</p><a class="admin-button" href={`/admin/modules/${p.id}/preview?release=${draft.id}`} target="_blank">Bekijk klantvoorbeeld ↗</a><div>{assets.map(a=><article class="module-admin-track"><strong>{a.kind==='pdf'?'Werkboek':'Audio'} · {a.title}</strong><p>{a.status==='verified'?'Upload gecontroleerd':'Upload nog niet compleet'} · {(Number(a.byte_size)/1024/1024).toFixed(1)} MB</p>{a.module_tracks&&origin&&<><code>{`${origin}/account/modules/${p.slug}/audio/${a.module_tracks.key}`}</code><button type="button" class="admin-button" data-copy={`${origin}/account/modules/${p.slug}/audio/${a.module_tracks.key}`}>Kopieer audiolink</button></>}{a.status==='verified'&&<a class="admin-button" target="_blank" href={`/api/admin/modules/${p.id}/material?release=${draft.id}&asset=${a.id}`}>Open bestand ↗</a>}{a.status==='reserved'&&<button type="button" class="admin-button" data-complete={a.id}>Upload opnieuw controleren</button>}<form data-module-asset class="catalog-admin-grid"><input type="hidden" name="asset" value={a.id}/><label class="catalog-admin-field"><span>Titel</span><input name="title" value={a.title} required maxlength="160"/></label><label class="catalog-admin-field"><span>Volgorde</span><input name="sortOrder" type="number" min="0" max="999" value={a.sort_order}/></label><div class="module-actions"><button class="admin-button" type="submit">Bewaren</button><button class="admin-button" type="button" data-remove={a.id}>Uit concept verwijderen</button></div></form></article>)}</div><h3>Bestand toevoegen of vervangen</h3><form data-module-upload class="catalog-admin-grid"><label class="catalog-admin-field"><span>Soort</span><select name="kind"><option value="audio">MP3-audio</option><option value="pdf">PDF-werkboek</option></select></label><label class="catalog-admin-field"><span>Vaste audiocode (alleen audio)</span><input name="key" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="80" placeholder="bijvoorbeeld: oefening-1"/><small>Dezelfde code vervangt dezelfde oefening in dit concept. Gebruik een nieuwe code voor een nieuwe oefening.</small></label><label class="catalog-admin-field"><span>Titel</span><input name="title" required maxlength="160"/></label><label class="catalog-admin-field"><span>Volgorde</span><input name="sortOrder" type="number" min="0" max="999" value="1"/></label><label class="catalog-admin-field catalog-admin-wide"><span>PDF of MP3</span><input name="file" type="file" accept="application/pdf,audio/mpeg,.mp3,.pdf" required/></label><div class="module-actions"><button class="admin-button admin-button--primary" type="submit">Bestand uploaden</button><button class="admin-button" type="button" data-upload-pause hidden>Upload pauzeren</button></div><p class="module-upload-status" role="status" aria-live="polite" data-upload-status></p></form><form data-module-publish style="margin-top:2rem"><label><input type="checkbox" name="checked" required/> Ik heb het materiaal en eventuele audiolinks gecontroleerd.</label><p><button type="submit" class="admin-button admin-button--primary">Materiaalversie publiceren</button></p><small>Publiceren vervangt de materiaalversie. Verkoop inschakelen doe je apart bovenaan.</small></form></>}</section>
{current.releases.some(r=>r.status==='published')&&<section class="catalog-admin-section" style="margin-top:2rem"><h2>Gepubliceerde versies</h2>{current.releases.filter(r=>r.status==='published').map(r=><p>{r.published_at&&new Intl.DateTimeFormat('nl-BE',{dateStyle:'medium',timeStyle:'short',timeZone:'Europe/Brussels'}).format(new Date(r.published_at))} · <a href={`/admin/modules/${p.id}/preview?release=${r.id}`}>Bekijk deze versie</a>{r.id!==m.current_release_id&&<button type="button" class="admin-button" data-restore={r.id}>Deze versie terugzetten</button>}{r.id===m.current_release_id&&<span> · Actuele versie</span>}</p>)}</section>}
</div>
<script>
 import {Upload} from 'tus-js-client';
 const root=document.querySelector<HTMLElement>('[data-module-editor]');
 if(root){
  const error=root.querySelector<HTMLElement>('[data-module-error]')!;const base=root.dataset.base!;const revision=Number(root.dataset.revision);
  const report=(e:unknown)=>{error.textContent=e instanceof Error?e.message:'De wijziging kon niet worden bewaard.';error.hidden=false;error.scrollIntoView({block:'center'});};
  const call=async(action:string,body:unknown)=>{const r=await fetch(`${base}/${action}`,{method:'POST',headers:{'content-type':'application/json'},credentials:'same-origin',body:JSON.stringify(body)});const data=await r.json();if(!r.ok)throw new Error(data.error||'De aanvraag is mislukt.');return data;};
  const perform=async(action:string,body:unknown)=>{try{await call(action,body);location.reload();}catch(e){report(e);}};
  root.querySelector<HTMLFormElement>('[data-module-save]')?.addEventListener('submit',e=>{e.preventDefault();perform('save',Object.fromEntries(new FormData(e.currentTarget as HTMLFormElement)));});
  root.querySelector<HTMLFormElement>('[data-module-recommendations]')?.addEventListener('submit',e=>{e.preventDefault();const fd=new FormData(e.currentTarget as HTMLFormElement);const targets=fd.getAll('target').map(String).sort((a,b)=>Number(fd.get(`sort-${a}`)||0)-Number(fd.get(`sort-${b}`)||0));perform('recommendations',{targets,revision:Number(root.dataset.detailsRevision)});});
  root.querySelector('[data-module-action="draft"]')?.addEventListener('click',()=>perform('draft',{}));
  root.querySelectorAll<HTMLFormElement>('[data-module-asset]').forEach(form=>form.addEventListener('submit',e=>{e.preventDefault();perform('asset',{...Object.fromEntries(new FormData(form)),revision});}));
  root.querySelectorAll<HTMLElement>('[data-restore]').forEach(b=>b.addEventListener('click',()=>perform('restore',{release:b.dataset.restore,revision:Number(root.dataset.detailsRevision)})));
  root.querySelectorAll<HTMLElement>('[data-remove]').forEach(b=>b.addEventListener('click',()=>perform('asset',{asset:b.dataset.remove,revision,remove:true,sortOrder:0,title:''})));
  root.querySelectorAll<HTMLElement>('[data-complete]').forEach(b=>b.addEventListener('click',()=>perform('uploads/complete',{asset:b.dataset.complete})));
  root.querySelectorAll<HTMLElement>('[data-copy]').forEach(b=>b.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(b.dataset.copy!);b.textContent='Link gekopieerd';}catch{report(new Error('Kopieer het zichtbare adres handmatig.'));}}));
  root.querySelector<HTMLFormElement>('[data-module-publish]')?.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;perform('publish',{release:new URL((root.querySelector('a[href*="preview?release="]') as HTMLAnchorElement).href).searchParams.get('release'),revision,checked:new FormData(form).has('checked')});});
  const form=root.querySelector<HTMLFormElement>('[data-module-upload]');
  if(form){const pause=form.querySelector<HTMLButtonElement>('[data-upload-pause]')!;const state=form.querySelector<HTMLElement>('[data-upload-status]')!;let upload:Upload|null=null;let paused=false;
   pause.addEventListener('click',async()=>{if(!upload)return;if(paused){upload.start();pause.textContent='Upload pauzeren';paused=false;}else{await upload.abort();pause.textContent='Upload hervatten';paused=true;state.textContent='Upload gepauzeerd.';}});
   form.addEventListener('submit',async e=>{e.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;button.disabled=true;error.hidden=true;
    try{const fd=new FormData(form);const file=fd.get('file');if(!(file instanceof File)||!file.size)throw new Error('Kies een bestand.');
     const info=await call('uploads/start',{kind:fd.get('kind'),key:fd.get('key'),title:fd.get('title'),sortOrder:fd.get('sortOrder'),size:file.size,revision});
     pause.hidden=false;state.textContent='Upload wordt gestart…';
     upload=new Upload(file,{endpoint:info.endpoint,headers:{'x-signature':info.token,apikey:info.publishableKey},chunkSize:6*1024*1024,retryDelays:[0,1000,3000,5000,10000],removeFingerprintOnSuccess:true,metadata:{bucketName:info.bucket,objectName:info.path,contentType:info.mime,cacheControl:'3600'},onProgress:(sent,total)=>{state.textContent=`${Math.round(sent/total*100)}% geüpload`;},onError:e=>{state.textContent='Upload onderbroken. Hervat de upload of herlaad de pagina om het bestand opnieuw toe te voegen.';pause.textContent='Upload hervatten';paused=true;report(e);},onSuccess:async()=>{state.textContent='Upload controleren…';try{await call('uploads/complete',{asset:info.asset});location.reload();}catch(e){report(e);state.textContent='Controle mislukt. Gebruik “Upload opnieuw controleren” na het herladen van de pagina.';pause.hidden=true;}}});
     const previous=await upload.findPreviousUploads();if(previous.length)upload.resumeFromPreviousUpload(previous[0]);upload.start();
    }catch(e){report(e);button.disabled=false;}
   });
  }
 }
</script>
