---
interface Props { id: string; name?: string; label: string; autocomplete?: string; minimum?: number; help?: string }
const {id,name='password',label,autocomplete='new-password',minimum=12,help}=Astro.props;
---
<div class="auth-field"><label for={id}>{label}</label><div class="auth-password"><input id={id} name={name} type="password" autocomplete={autocomplete} required minlength={minimum} maxlength="256" aria-describedby={help?`${id}-help`:undefined} /><button type="button" data-auth-toggle={id} aria-controls={id} aria-label={`Toon ${name==='confirm_password'?'herhaald wachtwoord':'wachtwoord'}`} aria-pressed="false">Toon</button></div>{help&&<small id={`${id}-help`}>{help}</small>}</div>
