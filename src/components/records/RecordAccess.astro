---
import AdminIcon from '../admin/AdminIcon.astro';
import type { ClientDetailData } from '../../lib/clientDetailPage';
interface Props { data: ClientDetailData }
const { patient, deletionBlocker, detailsError, staff, assignedIds, formatDate, practice } = Astro.props.data;

const activeAssignments = patient.assignments.filter(item=>!item.endedAt);
const endedAssignments = patient.assignments.filter(item=>item.endedAt);
const availableStaff = staff.filter(member=>!assignedIds.has(member.id));
---
<div class="record-access-layout" data-manage={patient.canArchive}><div>        <section class="admin-panel"><header class="admin-panel__header"><div><h2>Teamleden met toegang</h2><p>Deze medewerkers kunnen dit dossier bekijken.</p></div></header><div class="client-assignment-list">
          {activeAssignments.length ? activeAssignments.map((assignment) => <div class="client-assignment-row"><span class="record-staff-photo" aria-hidden="true"><span>{assignment.name.split(/\s+/).map(part=>part[0]).slice(0,2).join('')}</span><img src={`/api/admin/clienten/${patient.id}/teamfoto/${assignment.userId}`} alt="" width="44" height="44" loading="lazy" data-record-photo/></span><span><strong>{assignment.name}</strong><small>{assignment.endedAt ? `Toegang beëindigd ${formatDate(assignment.endedAt)}` : 'Heeft toegang'}</small></span>{patient.canManageAssignments && !assignment.endedAt && <form method="post" action={`/api/admin/clienten/${patient.id}/toewijzingen?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="user_id" value={assignment.userId}/><input type="hidden" name="operation" value="unassign"/><button class="admin-icon-button client-assignment-remove" type="submit" aria-label={`Toegang van ${assignment.name} beëindigen`} title="Toewijzing beëindigen"><span>Toegang beëindigen</span><AdminIcon name="close" size={14}/></button></form>}</div>) : <div class="client-inline-empty">Geen medewerker toegewezen. Beheerders behouden toegang.</div>}
          {patient.canManageAssignments && patient.status === 'active' && availableStaff.length > 0 && <form class="client-assignment-add" method="post" action={`/api/admin/clienten/${patient.id}/toewijzingen?werkruimte=${practice ? 'praktijk' : 'admin'}`}><label><span>Medewerker toevoegen</span><select name="user_id" required><option value="" disabled selected>Kies teamlid</option>{availableStaff.map((member) => <option value={member.id}>{member.name}</option>)}</select></label><input type="hidden" name="operation" value="assign"/><button class="admin-button" type="submit">Toewijzen</button></form>}
        </div></section>

        <section class="client-security-note"><AdminIcon name="lock" size={16}/><div><strong>Vertrouwelijk dossier</strong><p>Toegang wordt beperkt tot toegewezen teamleden en superadmins. Dossierinzage en wijzigingen worden gelogd zonder verslaginhoud.</p></div></section>{patient.canManageAssignments && endedAssignments.length > 0 && <details class="record-access-history"><summary>Eerdere toewijzingen ({endedAssignments.length})</summary>{endedAssignments.map(assignment=><div><strong>{assignment.name}</strong><span>Toegang beëindigd {formatDate(assignment.endedAt!)}</span></div>)}</details>}</div>{patient.canArchive && <section class="record-management"><h2>Dossierbeheer</h2><p>Beheer de status van dit dossier.</p>{detailsError && <div class="record-notice is-error" role="alert">{detailsError}</div>}    {patient.canArchive && <details class="practice-card"><summary>Archiveren of herstellen</summary><div class="practice-stack">        {patient.canArchive && patient.status === 'active' && <form method="post" action={`/api/admin/clienten/${patient.id}/archiveren?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="operation" value="archive"/><button class="admin-button" type="submit">Dossier archiveren</button></form>}
        {patient.canArchive && patient.status === 'archived' && <form method="post" action={`/api/admin/clienten/${patient.id}/archiveren?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="operation" value="restore"/><button class="admin-button admin-button--primary" type="submit">Dossier herstellen</button></form>}    {patient.canArchive && <details class="practice-card"><summary>Foutief dossier definitief verwijderen</summary><p>Alleen voor lege testdossiers, dubbels en foutieve registraties. Deze actie kan niet worden teruggedraaid. Dossiers met afspraken, verslagen, zorggegevens of een gekoppeld account zijn geblokkeerd.</p>{deletionBlocker ? <p role="status">{deletionBlocker}</p> : <form method="post" class="practice-stack"><input type="hidden" name="operation" value="delete_empty"/><label>Reden<select name="delete_reason" required><option value="">Kies een reden</option><option value="test">Testcliënt</option><option value="duplicate">Dubbel dossier</option><option value="incorrect">Foutieve registratie</option></select></label><label>Typ ter bevestiging de volledige cliëntnaam<input name="confirm_name" required autocomplete="off"/></label><label><input type="checkbox" name="confirm_retention" value="yes" required/> Ik heb gecontroleerd dat dit een foutieve registratie is waarvoor geen bewaarplicht geldt.</label><button class="admin-button" type="submit">Definitief verwijderen</button></form>}</details>}</div></details>}</section>}</div>
