---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminIcon from '../admin/AdminIcon.astro';
import PatientFields from '../practice/PatientFields.astro';
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import type { ClientDirectoryData } from '../../lib/clientDirectoryPage';
interface Props { data: ClientDirectoryData }
const { defaultAssignee, submitted, canWrite, canAssign, status, clients, staff, customerSearch, customerAccounts, bookingId, booking, linkedPatient, bookingEmailMatches, showBookingError, formError, errors, date, dateTime, practice, recordsBase } = Astro.props.data;
const Layout = practice ? PracticeLayout : AdminLayout;
---

<Layout title="Cliëntendossiers" description="Beveiligde dossiers en verslagen voor begeleiding">
  <div class="admin-page client-records-page">
    <section class="admin-page-heading">
      <div><p class="admin-eyebrow">Begeleiding · vertrouwelijk</p><h1>Cliëntendossiers</h1><p>Bewaar verslagen per cliënt en volg afspraken en toewijzingen op één beveiligde plek.</p></div>
      {canWrite && <button class="admin-button admin-button--primary" type="button" data-client-create-open><AdminIcon name="plus" size={16}/> Cliënt toevoegen</button>}
    </section>

    {Astro.url.searchParams.get('melding')==='verwijderd' && <p class="practice-alert" role="status">Het lege dossier is definitief verwijderd.</p>}
    {formError && (bookingId || !canWrite) && <div class="admin-login__alert admin-login__alert--error" role="alert"><AdminIcon name="warning" size={17}/><span>{errors[formError] || 'De actie kon niet worden opgeslagen. Controleer je toegang en probeer opnieuw.'}</span></div>}

    {bookingId && <section class="client-source-card" aria-labelledby="client-source-title">
      <span class="client-record-icon"><AdminIcon name="calendar" size={18}/></span>
      <div class="client-source-card__copy">
        <p class="admin-eyebrow">Dossier vanuit afspraak</p>
        {showBookingError ? <><h2 id="client-source-title">Afspraak niet beschikbaar</h2><p>Alleen een bevestigde of afgeronde afspraak uit jouw praktijk kan aan een dossier worden gekoppeld.</p></>
          : linkedPatient ? <><h2 id="client-source-title">Afspraak is al gekoppeld</h2><p>{booking?.clientName} · {dateTime(booking!.startsAt)}</p><a class="admin-row-action" href={`${recordsBase}/${linkedPatient.id}`}>Open dossier <AdminIcon name="arrow" size={13}/></a></>
          : booking?.patientId ? <><h2 id="client-source-title">Afspraak is aan een dossier gekoppeld</h2><p>{booking.clientName} · {dateTime(booking.startsAt)}. Dit dossier valt buiten jouw huidige toewijzingen.</p></>
          : booking ? <><h2 id="client-source-title">{booking.clientName}</h2><p>{booking.clientEmail} · {dateTime(booking.startsAt)} · {booking.practitionerName}</p><p>Een nieuw dossier wordt aan het klantaccount gekoppeld. Een bestaand dossier kan je alleen na controle van de cliënt en het e-mailadres verbinden. Een gastboeking vraagt altijd een expliciete keuze.</p>
            {canWrite && bookingEmailMatches.length > 0 ? <><div class="client-source-matches"><strong>Mogelijk bestaand dossier</strong><p>Deze actieve dossiers gebruiken hetzelfde e-mailadres. Controleer de cliëntidentiteit voordat je een afspraak koppelt.</p>{bookingEmailMatches.map((match) => <form method="post" action={`/api/admin/clienten/${match.id}/afspraken?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="booking_id" value={booking.id}/><span><b>{match.fullName}</b><small>{match.email}</small></span><button class="admin-button" type="submit">Koppel aan dit dossier</button></form>)}</div><details class="client-source-create"><summary>Dit is een andere cliënt</summary><p>Maak alleen een apart dossier als je hebt gecontroleerd dat dit niet om dezelfde cliënt gaat.</p><form method="post" action={`/api/admin/clienten?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="operation" value="from_booking"/><input type="hidden" name="booking_id" value={booking.id}/><button class="admin-button admin-button--primary" type="submit">Toch nieuw dossier maken</button></form></details></>
              : canWrite && <form method="post" action={`/api/admin/clienten?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="operation" value="from_booking"/><input type="hidden" name="booking_id" value={booking.id}/><button class="admin-button admin-button--primary" type="submit">Dossier aanmaken en afspraak koppelen</button></form>}
          </> : null}
      </div>
    </section>}

    <section class="client-directory-panel admin-panel">
      <header class="admin-panel__header"><div><h2>Cliënten</h2><p><span data-client-result-count aria-live="polite">{clients.length} dossier{clients.length === 1 ? '' : 's'}</span> in deze weergave · zoek op naam of e-mailadres</p></div><span class="client-directory-lock"><AdminIcon name="lock" size={14}/> Inhoud alleen zichtbaar in het dossier</span></header>
      <form class="client-directory-toolbar" method="get" action={recordsBase} data-client-search-form>
        {bookingId && <input type="hidden" name="boeking" value={bookingId}/>}
        <label class="client-search"><span class="sr-only">Zoek cliënt</span><AdminIcon name="search" size={16}/><input type="search" data-client-search-input name="q" value={(Astro.url.searchParams.get('q') || '').slice(0, 80)} maxlength="80" placeholder="Naam of e-mailadres" autocomplete="off"/></label>
        <label><span class="sr-only">Dossierstatus</span><select name="status" data-client-status><option value="active" selected={status === 'active'}>Actieve dossiers</option><option value="archived" selected={status === 'archived'}>Gearchiveerd</option><option value="all" selected={status === 'all'}>Alles</option></select></label>
        <button class="admin-button" type="submit">Zoeken</button>
      </form>
      <div class="client-record-list" data-client-results>
        {clients.map((client) => <a class="client-record-row" data-client-row href={`${recordsBase}/${client.id}`}>
          <span class="client-record-avatar" aria-hidden="true">{client.fullName.trim().charAt(0).toUpperCase()}</span>
          <span class="client-record-row__main"><strong>{client.fullName}</strong><small>{client.email || 'Geen e-mailadres opgegeven'}</small></span>
          <span class="client-record-row__meta"><small>Toegewezen aan</small><strong>{client.activeAssignments.length ? client.activeAssignments.join(', ') : 'Nog niet toegewezen'}</strong></span>
          <span class="client-record-row__meta"><small>Laatste verslag</small><strong>{client.latestNoteAt ? date(client.latestNoteAt) : 'Nog geen verslagen'}</strong></span>
          <span class="client-record-row__meta"><small>Volgende afspraak</small><strong>{client.nextAppointmentAt ? dateTime(client.nextAppointmentAt) : 'Geen afspraak gepland'}</strong></span>
          <span class:list={['admin-product-status', client.status === 'active' ? 'admin-product-status--published' : 'admin-product-status--archived']}><i></i>{client.status === 'active' ? 'Actief' : 'Gearchiveerd'}</span>
          <AdminIcon name="arrow" size={15}/>
        </a>)}
      </div>
      <div class="admin-empty-row" data-client-empty hidden={clients.length > 0}><div><span><AdminIcon name="customers" size={17}/></span><strong data-client-empty-title>{Astro.url.searchParams.get('q') ? 'Geen resultaten gevonden' : status === 'archived' ? 'Geen gearchiveerde dossiers' : 'Nog geen cliëntendossiers'}</strong><p data-client-empty-copy>{Astro.url.searchParams.get('q') ? 'Pas de zoekterm aan of kies een andere dossierstatus.' : 'Maak een cliënt aan of open een bevestigde afspraak om het eerste dossier te starten.'}</p></div></div>
    </section>


    {canWrite && <dialog class="client-create-dialog" id="client-record-create" aria-labelledby="client-create-title" aria-describedby="client-create-description" data-reopen={Boolean((formError && !bookingId) || customerSearch || Astro.url.searchParams.has('klantzoek'))}>
      <header class="client-create-dialog__header">
        <div class="client-create-dialog__title-row">
          <span class="client-create-dialog__icon"><AdminIcon name="customers" size={22}/></span>
          <h2 id="client-create-title" tabindex="-1">Cliënt toevoegen</h2>
        </div>
        <button class="client-create-dialog__close" type="button" data-client-create-close aria-label="Sluiten"><AdminIcon name="close" size={20}/></button>
        <p id="client-create-description">{canAssign ? 'Start een dossier voor een nieuwe cliënt of koppel een bestaand online account.' : 'Vul de cliëntgegevens in om een nieuw dossier te starten.'}</p>
      </header>
      {canAssign && <div class="client-create-dialog__tabs" role="tablist" aria-label="Cliënt toevoegen via">
        <button type="button" role="tab" id="client-new-tab" aria-controls="client-new-panel" aria-selected="true" data-client-create-tab="new">Nieuwe cliënt</button>
        <button type="button" role="tab" id="client-account-tab" aria-controls="client-account-create" aria-selected="false" tabindex="-1" data-client-create-tab="account">Bestaand account</button>
      </div>}
      {formError && !bookingId && <div class="client-create-dialog__error" role="alert"><AdminIcon name="warning" size={18}/><span>{errors[formError] || 'Opslaan is niet gelukt. Controleer je gegevens en probeer opnieuw.'}</span></div>}
      <div id="client-new-panel" role={canAssign ? 'tabpanel' : undefined} aria-labelledby={canAssign ? 'client-new-tab' : undefined} data-client-create-panel="new">
        <form class="client-create-dialog__form" method="post" action={`${recordsBase}#client-record-create`}>
          <p class="client-create-dialog__help">Voornaam en achternaam zijn verplicht. De overige gegevens kun je nu invullen of later aanvullen in het dossier.</p>
          <div class="client-create-dialog__details"><PatientFields values={submitted}/></div>
          <div class="client-create-dialog__fields">
            {canAssign && <label class="client-create-dialog__wide"><span>Toegewezen aan <small>Optioneel</small></span><select name="assignee_user_id"><option value="" selected={(submitted.assignee_user_id ?? defaultAssignee)===''}>Nog niet toewijzen</option>{staff.map((member) => <option value={member.id} selected={(submitted.assignee_user_id ?? defaultAssignee)===member.id}>{member.name}{member.roles.includes('practitioner') ? ' · Professional' : member.roles.includes('super_admin') ? ' · Superadmin' : ' · Medewerker'}</option>)}</select></label>}
          </div>
          <p class="client-create-dialog__privacy"><AdminIcon name="lock" size={15}/> Verslagen zijn alleen zichtbaar voor bevoegde medewerkers.</p>
          <footer class="client-create-dialog__footer"><button class="client-create-dialog__cancel" type="button" data-client-create-close>Annuleren</button><button class="client-create-dialog__submit" type="submit"><AdminIcon name="plus" size={16}/><span data-client-submit-label>Cliënt aanmaken</span></button></footer>
        </form>
      </div>
      {canAssign && <div id="client-account-create" role="tabpanel" aria-labelledby="client-account-tab" data-client-create-panel="account" hidden>
        <div class="client-create-dialog__account">
          <p>Kies een online account dat nog geen dossier heeft.</p>
          <form class="client-create-dialog__search" method="get" action={`${recordsBase}#client-account-create`}>
            <label><span class="sr-only">Zoek online account</span><input type="search" name="klantzoek" maxlength="80" value={customerSearch} placeholder="Naam of e-mailadres"/></label>
            <button type="submit" aria-label="Account zoeken"><AdminIcon name="search" size={18}/></button>
          </form>
          {customerSearch && <a class="client-create-dialog__reset" href={`${recordsBase}?klantzoek=#client-account-create`}>Wis zoekterm</a>}
        </div>
        {customerAccounts.length ? <form class="client-create-dialog__form" method="post" action={`/api/admin/clienten?werkruimte=${practice ? 'praktijk' : 'admin'}`}>
          <input type="hidden" name="operation" value="from_customer"/>
          <div class="client-create-dialog__fields">
            <label class="client-create-dialog__wide"><span>Online account</span><select name="customer_user_id" required><option value="" disabled selected>Kies een cliënt</option>{customerAccounts.map((account) => <option value={account.id}>{account.fullName} · {account.email || 'Geen e-mailadres'}</option>)}</select></label>
            <label class="client-create-dialog__wide"><span>Toegewezen aan <small>Optioneel</small></span><select name="assignee_user_id"><option value="" selected={(submitted.assignee_user_id ?? defaultAssignee)===''}>Nog niet toewijzen</option>{staff.map((member) => <option value={member.id} selected={(submitted.assignee_user_id ?? defaultAssignee)===member.id}>{member.name}</option>)}</select></label>
          </div>
          <p class="client-create-dialog__privacy"><AdminIcon name="lock" size={15}/> Verslagen zijn alleen zichtbaar voor bevoegde medewerkers.</p>
          <footer class="client-create-dialog__footer"><button class="client-create-dialog__cancel" type="button" data-client-create-close>Annuleren</button><button class="client-create-dialog__submit" type="submit"><AdminIcon name="check" size={16}/><span data-client-submit-label>Account koppelen</span></button></footer>
        </form> : <><p class="client-create-dialog__empty">{customerSearch ? 'Geen account zonder dossier gevonden. Probeer een andere naam of een ander e-mailadres.' : 'Er zijn geen online accounts zonder dossier. Voeg de cliënt toe via ‘Nieuwe cliënt’.'}</p><footer class="client-create-dialog__footer"><button class="client-create-dialog__cancel" type="button" data-client-create-close>Sluiten</button></footer></>}
      </div>}
    </dialog>}

    <p class="client-records-footnote"><AdminIcon name="lock" size={14}/> Verslaginhoud verschijnt uitsluitend na het openen van een dossier. Toegang en dossierwijzigingen worden vastgelegd voor beveiligingscontrole.</p>
  </div>
</Layout>

<script>
  const createDialog = document.querySelector<HTMLDialogElement>('.client-create-dialog');
  const createTrigger = document.querySelector<HTMLButtonElement>('[data-client-create-open]');
  const createTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-client-create-tab]'));
  const selectCreateTab = (mode: string) => {
    createTabs.forEach((tab) => {
      const active = tab.dataset.clientCreateTab === mode;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    document.querySelectorAll<HTMLElement>('[data-client-create-panel]').forEach((panel) => { panel.hidden = panel.dataset.clientCreatePanel !== mode; });
  };
  const openCreateDialog = () => {
    if (!createDialog || createDialog.open) return;
    createDialog.showModal();
    document.documentElement.classList.add('client-create-is-open');
    if (createDialog.querySelector('[role="alert"]')) createDialog.querySelector<HTMLElement>('#client-create-title')?.focus();
    else createDialog.querySelector<HTMLInputElement>('[data-client-create-panel]:not([hidden]) input:not([type="hidden"])')?.focus();
  };
  createTrigger?.addEventListener('click', openCreateDialog);
  document.querySelectorAll('[data-client-create-close]').forEach((button) => button.addEventListener('click', () => createDialog?.close()));
  createDialog?.addEventListener('close', () => {
    document.documentElement.classList.remove('client-create-is-open');
    if (['#client-record-create', '#client-account-create'].includes(window.location.hash)) {
      window.history.replaceState(null, '', window.location.pathname + window.location.search);
    }
    createTrigger?.focus({ preventScroll: true });
  });
  createTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectCreateTab(tab.dataset.clientCreateTab!));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? createTabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + createTabs.length) % createTabs.length;
      selectCreateTab(createTabs[next].dataset.clientCreateTab!);
      createTabs[next].focus();
    });
  });
  const restoreCreateDialog = () => {
    const account = window.location.hash === '#client-account-create' || new URLSearchParams(window.location.search).has('klantzoek');
    if (account && createTabs.length) selectCreateTab('account');
    if (account || window.location.hash === '#client-record-create' || createDialog?.dataset.reopen === 'true') openCreateDialog();
  };
  restoreCreateDialog();
  window.addEventListener('hashchange', restoreCreateDialog);
  createDialog?.querySelectorAll<HTMLFormElement>('form[method="post"]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (form.getAttribute('aria-busy') === 'true') { event.preventDefault(); return; }
      form.setAttribute('aria-busy', 'true');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) {
        submit.style.minWidth = `${submit.getBoundingClientRect().width}px`;
        submit.disabled = true;
        const label = submit.querySelector<HTMLElement>('[data-client-submit-label]');
        if (label) { label.dataset.idleText = label.textContent || ''; label.textContent = 'Opslaan…'; }
      }
    });
  });

  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    createDialog?.querySelectorAll<HTMLFormElement>('form[aria-busy]').forEach((form) => {
      form.removeAttribute('aria-busy');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) { submit.disabled = false; submit.style.removeProperty('min-width'); }
      const label = form.querySelector<HTMLElement>('[data-client-submit-label]');
      if (label?.dataset.idleText) label.textContent = label.dataset.idleText;
    });
  });

  const recordsBase = window.location.pathname.startsWith('/praktijk') ? '/praktijk/clienten' : '/admin/clienten';
  const form = document.querySelector<HTMLFormElement>('[data-client-search-form]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-client-search-input]');
  const statusInput = document.querySelector<HTMLSelectElement>('[data-client-status]');
  const results = document.querySelector<HTMLElement>('[data-client-results]');
  const emptyState = document.querySelector<HTMLElement>('[data-client-empty]');
  const emptyTitle = document.querySelector<HTMLElement>('[data-client-empty-title]');
  const emptyCopy = document.querySelector<HTMLElement>('[data-client-empty-copy]');
  const resultCount = document.querySelector<HTMLElement>('[data-client-result-count]');
  let searchTimer: ReturnType<typeof setTimeout>;
  let latestRequest = 0;
  const formatDate = (value: string, includeTime = false) => new Intl.DateTimeFormat('nl-BE', { timeZone: 'Europe/Brussels', dateStyle: 'medium', ...(includeTime ? { timeStyle: 'short' as const } : {}) }).format(new Date(value));
  const element = (tag: string, className: string, content: string) => {
    const node = document.createElement(tag);
    node.className = className;
    node.textContent = content;
    return node;
  };
  const renderClient = (client: { id: string; fullName: string; email: string | null; status: string; activeAssignments: string[]; latestNoteAt: string | null; nextAppointmentAt: string | null }) => {
    const row = document.createElement('a');
    row.className = 'client-record-row';
    row.href = `${recordsBase}/${encodeURIComponent(client.id)}`;
    const avatar = element('span', 'client-record-avatar', client.fullName.trim().charAt(0).toUpperCase());
    avatar.setAttribute('aria-hidden', 'true');
    row.append(avatar);
    const person = document.createElement('span'); person.className = 'client-record-row__main';
    person.append(element('strong', '', client.fullName), element('small', '', client.email || 'Geen e-mailadres opgegeven'));
    row.append(person);
    const assignment = document.createElement('span'); assignment.className = 'client-record-row__meta';
    assignment.append(element('small', '', 'Toegewezen aan'), element('strong', '', client.activeAssignments.length ? client.activeAssignments.join(', ') : 'Nog niet toegewezen'));
    row.append(assignment);
    const latest = document.createElement('span'); latest.className = 'client-record-row__meta';
    latest.append(element('small', '', 'Laatste verslag'), element('strong', '', client.latestNoteAt ? formatDate(client.latestNoteAt) : 'Nog geen verslagen'));
    row.append(latest);
    const appointment = document.createElement('span'); appointment.className = 'client-record-row__meta';
    appointment.append(element('small', '', 'Volgende afspraak'), element('strong', '', client.nextAppointmentAt ? formatDate(client.nextAppointmentAt, true) : 'Geen afspraak gepland'));
    row.append(appointment);
    const badge = element('span', `admin-product-status ${client.status === 'active' ? 'admin-product-status--published' : 'admin-product-status--archived'}`, client.status === 'active' ? 'Actief' : 'Gearchiveerd');
    badge.prepend(document.createElement('i')); row.append(badge);
    const arrow = document.createElement('span'); arrow.className = 'client-record-arrow'; arrow.setAttribute('aria-hidden', 'true'); arrow.textContent = '→'; row.append(arrow);
    return row;
  };
  const refresh = async () => {
    if (!form || !results || !searchInput || !statusInput) return;
    const requestNumber = ++latestRequest;
    const currentUrl = new URL(window.location.href);
    if (searchInput.value.trim()) currentUrl.searchParams.set('q', searchInput.value.trim()); else currentUrl.searchParams.delete('q');
    window.history.replaceState(null, '', currentUrl);
    const body = new URLSearchParams({ search: searchInput.value, status: statusInput.value });
    form.setAttribute('aria-busy', 'true');
    try {
      const response = await fetch('/api/admin/clienten/zoeken', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/x-www-form-urlencoded;charset=UTF-8' }, body });
      if (!response.ok) throw new Error('search_failed');
      const payload = await response.json();
      if (requestNumber !== latestRequest || !Array.isArray(payload.clients)) return;
      results.replaceChildren(...payload.clients.map(renderClient));
      if (resultCount) resultCount.textContent = `${payload.clients.length} dossier${payload.clients.length === 1 ? '' : 's'}`;
      if (emptyState) emptyState.hidden = payload.clients.length > 0;
      if (emptyTitle) emptyTitle.textContent = payload.clients.length ? '' : searchInput.value ? 'Geen resultaten gevonden' : statusInput.value === 'archived' ? 'Geen gearchiveerde dossiers' : 'Nog geen cliëntendossiers';
      if (emptyCopy) emptyCopy.textContent = payload.clients.length ? '' : searchInput.value ? 'Pas de zoekterm aan of kies een andere dossierstatus.' : 'Maak een cliënt aan of open een bevestigde afspraak om het eerste dossier te starten.';
    } catch {
      if (requestNumber === latestRequest && emptyTitle && emptyCopy && emptyState) {
        emptyTitle.textContent = 'Zoeken tijdelijk niet beschikbaar';
        emptyCopy.textContent = 'Je bestaande resultaten blijven behouden. Probeer het straks opnieuw.';
        emptyState.hidden = false;
      }
    } finally {
      if (requestNumber === latestRequest) form.removeAttribute('aria-busy');
    }
  };
  searchInput?.addEventListener('input', () => { clearTimeout(searchTimer); searchTimer = setTimeout(refresh, 220); });
  statusInput?.addEventListener('change', () => {
    const url = new URL(window.location.href);
    if (statusInput.value === 'active') url.searchParams.delete('status'); else url.searchParams.set('status', statusInput.value);
    window.history.replaceState(null, '', url);
    if (searchInput?.value) refresh(); else form?.requestSubmit();
  });
  form?.addEventListener('submit', (event) => { event.preventDefault(); clearTimeout(searchTimer); refresh(); });
</script>

<style>
  :global(html.client-create-is-open) { overflow: hidden; }
  .client-create-dialog {
    width: min(680px, calc(100% - 32px)); max-height: calc(100dvh - 48px); margin: auto; padding: 0;
    border: 0; border-radius: 16px; background: #fff; color: var(--admin-text);
    box-shadow: 0 28px 90px rgb(14 43 37 / 24%); overscroll-behavior: contain; scroll-padding-block: 24px 100px; scrollbar-width: thin; scrollbar-color: var(--admin-border-strong) transparent;
  }
  .client-create-dialog::backdrop { background: rgb(16 32 27 / 48%); }
  .client-create-dialog[open] { animation: client-create-enter 180ms cubic-bezier(.16, 1, .3, 1); }
  .client-create-dialog [hidden] { display: none; }
  .client-create-dialog__header { position: relative; padding: 28px 32px 24px; }
  .client-create-dialog__title-row { display: flex; align-items: center; gap: 14px; margin: 0 32px 14px 0; }
  .client-create-dialog__icon { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 42px; height: 42px; border-radius: 10px; background: var(--admin-green-soft); color: var(--admin-green); }
  .client-create-dialog__header h2 { margin: 0; color: var(--admin-text); font-size: 24px; font-weight: 600; letter-spacing: -.025em; line-height: 1.2; }
  .client-create-dialog__header p { max-width: 440px; text-wrap: pretty; margin: 0; color: var(--admin-muted); font-size: 14px; line-height: 1.6; }
