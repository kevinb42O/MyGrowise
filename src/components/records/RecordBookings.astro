---
import AdminIcon from '../admin/AdminIcon.astro';
import { bookingOutcomeLabel } from '../../lib/bookingOutcome';
import { hasPermission } from '../../lib/adminAuth';
import type { ClientDetailData } from '../../lib/clientDetailPage';
interface Props { data: ClientDetailData }
const { patient, bookingStatus, bookingFrom, bookingTo, statusLabel, formatDateTime, selectedBooking, practice, recordsBase, user, canWrite } = Astro.props.data;
const base = `${recordsBase}/${patient.id}`;

---
        <section class="admin-panel" ><header class="admin-panel__header"><div><h2>Afspraken</h2><p>{patient.bookingCount > patient.bookings.length ? `Nieuwste ${patient.bookings.length} van ${patient.bookingCount} gekoppelde afspraken` : `${patient.bookingCount} gekoppelde ${patient.bookingCount === 1 ? 'afspraak' : 'afspraken'}`}</p></div>{canWrite && patient.status==='active' && (user.practitionerId || hasPermission(user,'practice.manage')) && <a class="admin-button admin-button--primary" href={`${practice?'/praktijk':'/admin'}/afspraken/nieuw?client=${patient.id}`}><AdminIcon name="plus" size={15}/> Afspraak plannen</a>}</header>
          <form class="practice-filter practice-card" method="get"><input type="hidden" name="onderdeel" value="afspraken"/><label>Status<select name="status"><option value="">Alle statussen</option>{Object.entries(statusLabel).map(([v,l])=><option value={v} selected={bookingStatus===v}>{l}</option>)}</select></label><label>Van<input type="date" name="van" value={bookingFrom}/></label><label>Tot<input type="date" name="tot" value={bookingTo}/></label><button class="admin-button">Filteren</button><a class="admin-button" href={`/api/admin/clienten/${patient.id}/sessiedata?van=${bookingFrom}&tot=${bookingTo}`}>Uitgevoerde sessiedata downloaden</a></form>
          {patient.bookings.length ? <div class="client-booking-list">{patient.bookings.map((booking) => <article><span class="client-record-icon"><AdminIcon name="calendar" size={15}/></span><div><strong>{formatDateTime(booking.startsAt)}</strong><a href={`${practice ? '/praktijk' : '/admin'}/afspraken/${booking.id}`}>Afspraakdetails</a><small>{booking.appointmentName} · {booking.practitionerName} · {bookingOutcomeLabel(booking)}</small></div></article>)}</div> : <div class="client-inline-empty">{patient.bookingCount ? 'Geen afspraken binnen deze selectie. Pas de filters aan.' : 'Nog geen afspraken gekoppeld aan dit dossier.'}</div>}
          {selectedBooking && <form class="client-booking-link-form" method="post" action={`/api/admin/clienten/${patient.id}/afspraken?werkruimte=${practice ? 'praktijk' : 'admin'}`}><p>Afspraak geselecteerd: {formatDateTime(selectedBooking.startsAt)} · {selectedBooking.practitionerName}</p><input type="hidden" name="booking_id" value={selectedBooking.id}/><button class="admin-button admin-button--primary" type="submit">Afspraak koppelen</button></form>}
          {patient.linkableBookings.length > 0 && !selectedBooking && <div class="client-booking-link-list"><p>Gevonden afspraken met hetzelfde e-mailadres, nog niet gekoppeld:</p>{patient.linkableBookings.map((booking) => <form method="post" action={`/api/admin/clienten/${patient.id}/afspraken?werkruimte=${practice ? 'praktijk' : 'admin'}`}><input type="hidden" name="booking_id" value={booking.id}/><span>{formatDateTime(booking.startsAt)} · {booking.practitionerName}</span><button class="admin-button" type="submit">Koppel</button></form>)}</div>}
          <nav class="practice-actions practice-card" aria-label="Afsprakenpagina's"><span>Pagina {patient.bookingPage} van {patient.bookingPageCount} · {patient.bookingFilterCount} afspraken binnen de selectie</span>{patient.bookingPage>1&&<a class="admin-button" href={`?onderdeel=afspraken&afsprakenpagina=${patient.bookingPage-1}&status=${bookingStatus}&van=${bookingFrom}&tot=${bookingTo}`}>Nieuwere afspraken</a>}{patient.bookingPage<patient.bookingPageCount&&<a class="admin-button" href={`?onderdeel=afspraken&afsprakenpagina=${patient.bookingPage+1}&status=${bookingStatus}&van=${bookingFrom}&tot=${bookingTo}`}>Oudere afspraken</a>}</nav>
        </section>
