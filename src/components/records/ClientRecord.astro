---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PracticeLayout from '../../layouts/PracticeLayout.astro';
import AdminIcon from '../admin/AdminIcon.astro';
import RecordNotes from './RecordNotes.astro';
import RecordDetails from './RecordDetails.astro';
import RecordBookings from './RecordBookings.astro';
import RecordAccess from './RecordAccess.astro';
import { recordHref } from '../../lib/clientRecordWorkspace';
import type { ClientDetailData } from '../../lib/clientDetailPage';
import '../../styles/client-record-workspace.css';
interface Props { data: ClientDetailData }
const { data } = Astro.props;
const { patient, recordsBase, practice, section, message, messages, errorCode, errors, overview } = data;
const Layout = practice ? PracticeLayout : AdminLayout;
const base = `${recordsBase}/${patient.id}`;
const sections = [
  {id:'verslagen', label:'Verslagen', icon:'content', count:patient.noteCount},
  {id:'afspraken', label:'Afspraken', icon:'calendar', count:patient.bookingCount},
  {id:'gegevens', label:'Cliëntgegevens', icon:'professionals'},
  {id:'toegang', label:'Toegang & beheer', icon:'lock'},
] as const;
const initials = patient.fullName.split(/\s+/).filter(Boolean).map(part=>part[0]).slice(0,2).join('');
---
<Layout title={patient.fullName} description="Beveiligd cliëntendossier">
  <div class="admin-page client-records-page record-workspace" data-record-workspace>
    <a class="record-back" href={recordsBase}><span aria-hidden="true">←</span> Cliëntendossiers</a>
    <header class="record-identity">
      <span class="record-identity__initials" aria-hidden="true">{initials}</span>
      <div class="record-identity__main">
        <div class="record-identity__title"><h1>{patient.fullName}</h1><span class:list={['record-status', patient.status==='archived' && 'is-archived']}><i></i>{patient.status==='active'?'Actief dossier':'Gearchiveerd'}</span></div>
        <div class="record-identity__meta">
          {patient.email && <span>{patient.email}</span>}
          {overview.filter(([label,value])=>value && ['Geboortedatum','Mobiel telefoonnummer'].includes(label)).map(([label,value])=><span><span class="sr-only">{label}: </span>{value}</span>)}
          {!patient.email && !patient.details.birth_date && <span>Cliëntgegevens nog aan te vullen</span>}
        </div>
      </div>
      <span class="record-confidential"><AdminIcon name="lock" size={14}/> Vertrouwelijk</span>
    </header>
    <nav class="record-nav" aria-label="Onderdelen van het cliëntendossier">
      {sections.map(item=><a href={recordHref(base,item.id)} aria-current={section===item.id?'page':undefined}><AdminIcon name={item.icon} size={17}/><span>{item.label}</span>{'count' in item && <span class="record-nav__count">{item.count}</span>}</a>)}
    </nav>
    {message && messages[message] && <div class="record-notice" role="status"><AdminIcon name="check" size={18}/><span>{messages[message]}</span></div>}
    {errorCode && <div class="record-notice is-error" role="alert"><AdminIcon name="warning" size={18}/><span>{errors[errorCode] || 'De actie is niet uitgevoerd. Controleer je toegang en probeer opnieuw.'}</span></div>}
    {patient.status==='archived' && <div class="record-archive-notice"><AdminIcon name="lock" size={16}/><span>Dit dossier is gearchiveerd. Je kunt de inhoud raadplegen.{patient.canArchive && <> Herstellen kan bij <a href={recordHref(base,'toegang')}>Toegang & beheer</a>.</>}</span></div>}
    {section==='verslagen' && <RecordNotes data={data}/>}
    {section==='afspraken' && <RecordBookings data={data}/>}
    {section==='gegevens' && <RecordDetails data={data}/>}
    {section==='toegang' && <RecordAccess data={data}/>}
    <footer class="record-footnote"><AdminIcon name="lock" size={13}/><span>Dossierinzage en wijzigingen worden gelogd. Aangemaakt op {data.formatDate(patient.createdAt)}.</span></footer>
  </div>
</Layout>
<script>
  import '../../scripts/noteForms';
  import { recordWorkspace, recordHref } from '../../lib/clientRecordWorkspace';
  // Fragments never reach the server. Translate bookmarks from the previous dossier UI.
  const restoreLegacyLink = () => {
    const url = new URL(location.href);
    if (!url.hash || url.searchParams.has('onderdeel')) return;
    if (!/^#(clientgegevens|afspraken|nieuw-verslag|verslagen|verslag-.+)$/.test(url.hash)) return;
    const state = recordWorkspace(url);
    const params = Object.fromEntries(url.searchParams);
    if (state.note) params.verslag = state.note;
    location.replace(recordHref(url.pathname, state.section, params));
  };
  restoreLegacyLink();
  window.addEventListener('hashchange', restoreLegacyLink);
  document.querySelectorAll<HTMLImageElement>('[data-record-photo]').forEach(photo=>{
    const fallback=()=>photo.hidden=true;
    photo.addEventListener('error',fallback);
    if (photo.complete && !photo.naturalWidth) fallback();
  });
</script>
